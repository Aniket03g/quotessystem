          <span>Creating...</span>
        `;

        console.log('[VERSION] Step 1: Fetching current quote details...');

        // Step 1: Fetch current quote details
        const fetchUrl = `${API_BASE_URL}/proxy/quotes/records/${quoteId}`;
        console.log('[VERSION] Fetch URL:', fetchUrl);
        
        const quoteResponse = await fetch(fetchUrl, {
          method: 'GET',
          headers: {
            'Authorization': `Bearer ${token}`,
            'Content-Type': 'application/json',
          },
        });

        console.log('[VERSION] Quote fetch response status:', quoteResponse.status, quoteResponse.statusText);
        
        if (!quoteResponse.ok) {
          const errorText = await quoteResponse.text();
          console.error('[VERSION] Failed to fetch quote. Response:', errorText);
          throw new Error('Failed to fetch current quote: ' + errorText);
        }

        const currentQuote = await safeJsonParse(quoteResponse);
        console.log('[VERSION] Current quote data:', currentQuote);
        const currentFields = currentQuote.fields || {};
        console.log('[VERSION] Current quote fields:', currentFields);
        
        // Increment version (e.g., "1.2" -> "1.3")
        const currentVersion = currentFields['Quote Version'] || '1.0';
        const newVersion = incrementVersion(currentVersion);
        
        console.log('[VERSION] Version increment:', currentVersion, '->', newVersion);

        console.log('[VERSION] Step 2: Creating new quote record...');
        const newQuotePayload = {
          fields: {
            'Subject': currentFields['Subject'] || 'Quote',
            'Quote Status': 'Draft',
            'Quote Type': currentFields['Quote Type'] || 'Customer',
            'Quote Version': newVersion,
            'Quote Date': new Date().toISOString().split('T')[0],
            'Valid Until': currentFields['Valid Until'] || '',
            'Total Amount': currentFields['Total Amount'] || 0,
            'Notes': currentFields['Notes'] || '',
            'Quote Created By': currentFields['Quote Created By'] || 'Unknown User',
            'Parent Quote': parseInt(quoteId!)
          }
        };

        console.log('[VERSION] New quote payload:', JSON.stringify(newQuotePayload, null, 2));

        const createUrl = `${API_BASE_URL}/proxy/quotes/records`;
        console.log('[VERSION] Create URL:', createUrl);
        
        const createResponse = await fetch(createUrl, {
          method: 'POST',
          headers: {
            'Authorization': `Bearer ${token}`,
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(newQuotePayload)
        });

        console.log('[VERSION] Create response status:', createResponse.status, createResponse.statusText);
        
        if (!createResponse.ok) {
          const errorText = await createResponse.text();
          console.error('[VERSION] Failed to create quote. Response:', errorText);
          throw new Error(`Failed to create new quote: ${errorText}`);
        }

        const createResult = await safeJsonParse(createResponse);
        console.log('[VERSION] Create result:', createResult);
        const newQuoteId = createResult.records ? createResult.records[0]?.id : createResult.id;
        
        if (!newQuoteId) {
          throw new Error('No quote ID returned from create');
        }

        console.log('[VERSION] ✓ New quote created with ID:', newQuoteId);
        console.log('[VERSION] Parent Quote field set to:', quoteId);

        console.log('[VERSION] Step 3: Linking account to new quote...');
        const accountResponse = await fetch(
          `${API_BASE_URL}/proxy/quotes/links/accounts_copy/${quoteId}`,
          {
            method: 'GET',
            headers: {
              'Authorization': `Bearer ${token}`,
              'Content-Type': 'application/json',
            },
          }
        );

        console.log('[VERSION] Account fetch response status:', accountResponse.status);
        
        if (accountResponse.ok) {
          const accountData = await safeJsonParse(accountResponse);
          console.log('[VERSION] Account data:', accountData);
          const accounts = accountData.list || accountData.records || [];
          console.log('[VERSION] Found', accounts.length, 'accounts');
          
          if (accounts.length > 0) {
            const accountId = accounts[0].id;
            console.log('[VERSION] Linking account ID:', accountId, 'to new quote:', newQuoteId);
            
            const linkResponse = await fetch(`${API_BASE_URL}/proxy/quotes/links/accounts_copy/${newQuoteId}`, {
              method: 'POST',
              headers: {
                'Authorization': `Bearer ${token}`,
                'Content-Type': 'application/json',
              },
              body: JSON.stringify([{ id: accountId }])
            });
            
            console.log('[VERSION] Account link response status:', linkResponse.status);
            if (linkResponse.ok) {
              console.log('[VERSION] ✓ Account linked successfully');
            } else {
              const linkError = await linkResponse.text();
              console.error('[VERSION] Account link failed:', linkError);
            }
          } else {
            console.log('[VERSION] No accounts to link');
          }
        } else {
          console.log('[VERSION] Account fetch failed, skipping account link');
        }

        console.log('[VERSION] Step 4: Fetching line items from ProductsForQuotes...');
        
        const lineItemsUrl = `${API_BASE_URL}/proxy/products_for_quotes/records?where=(nc_76_d___Quotes_id,eq,${quoteId})&fields=Quantity,Custom%20Unit%20Price,Discount,nc_76_d__Products_id`;
        console.log('[VERSION] Line items URL:', lineItemsUrl);
        
        const lineItemsResponse = await fetch(lineItemsUrl, {
          method: 'GET',
          headers: {
            'Authorization': `Bearer ${token}`,
            'Content-Type': 'application/json',
          },
        });

        console.log('[VERSION] Line items fetch response status:', lineItemsResponse.status);
        
        if (!lineItemsResponse.ok) {
          const errorText = await lineItemsResponse.text();
          console.error('[VERSION] Failed to fetch line items. Response:', errorText);
          throw new Error('Failed to fetch line items: ' + errorText);
        }

        const lineItemsData = await safeJsonParse(lineItemsResponse);
        console.log('[VERSION] Line items data:', lineItemsData);
        const lineItems = lineItemsData.records || [];
        
        console.log('[VERSION] Found', lineItems.length, 'line items to copy');
        console.log('[VERSION] Line items:', lineItems);

        console.log('[VERSION] Step 5: Linking products to new quote...');
        
        const productIds = lineItems.map((item: any) => item.fields['nc_76_d__Products_id']).filter(Boolean);
        console.log('[VERSION] Product IDs to link:', productIds);
        
        if (productIds.length > 0) {
          console.log('[VERSION] Linking', productIds.length, 'products to new quote');
          
          const linkProductsUrl = `${API_BASE_URL}/proxy/quotes/links/products/${newQuoteId}`;
          console.log('[VERSION] Link products URL:', linkProductsUrl);
          
          const linkProductsResponse = await fetch(linkProductsUrl, {
            method: 'POST',
            headers: {
              'Authorization': `Bearer ${token}`,
              'Content-Type': 'application/json',
            },
            body: JSON.stringify(productIds.map(id => ({ id })))
          });
          
          console.log('[VERSION] Link products response status:', linkProductsResponse.status);
          if (linkProductsResponse.ok) {
            console.log('[VERSION] ✓ Products linked successfully');
          } else {
            const linkError = await linkProductsResponse.text();
            console.error('[VERSION] Products link failed:', linkError);
          }
        } else {
          console.log('[VERSION] No products to link');
        }

        console.log('[VERSION] Step 6: Creating ProductsForQuotes records...');
        
        for (let i = 0; i < lineItems.length; i++) {
          const item = lineItems[i];
          console.log(`[VERSION] Processing line item ${i + 1}/${lineItems.length}:`, item);
          const productId = item.fields['nc_76_d__Products_id'];
          const quantity = item.fields['Quantity'] || 1;
          const customPrice = item.fields['Custom Unit Price'];
          const discount = item.fields['Discount'] || 0;

          if (!productId) continue;

          const lineItemPayload = {
            fields: {
              'Quotes': newQuoteId,
              'Products': productId,
              'Quantity': quantity,
              'Custom Unit Price': customPrice,
              'Discount': discount
            }
          };

          console.log('[VERSION] Line item payload:', JSON.stringify(lineItemPayload, null, 2));

          const lineItemUrl = `${API_BASE_URL}/proxy/products_for_quotes/records`;
          const lineItemResponse = await fetch(lineItemUrl, {
            method: 'POST',
            headers: {
              'Authorization': `Bearer ${token}`,
              'Content-Type': 'application/json',
            },
            body: JSON.stringify(lineItemPayload)
          });

          console.log('[VERSION] Line item response status:', lineItemResponse.status);
          
          if (!lineItemResponse.ok) {
            const lineItemError = await lineItemResponse.text();
            console.error('[VERSION] Failed to create line item for product', productId, '- Error:', lineItemError);
          } else {
            const lineItemResult = await safeJsonParse(lineItemResponse);
            console.log('[VERSION] ✓ Line item created:', lineItemResult);
          }
        }

        console.log('[VERSION] ✓✓✓ Successfully created new version!');
        console.log('[VERSION] New Quote ID:', newQuoteId);
        console.log('[VERSION] Redirecting to new quote page...');
        console.log('=== CREATE NEW VERSION COMPLETED ===\n');

        // Success - redirect to new quote
        window.location.href = `/quote-detail?id=${newQuoteId}`;

      } catch (error) {
        console.error('\n=== CREATE NEW VERSION FAILED ===');
        console.error('[VERSION] Error type:', error?.constructor?.name);
        console.error('[VERSION] Error message:', error instanceof Error ? error.message : 'Unknown error');
        console.error('[VERSION] Error stack:', error instanceof Error ? error.stack : 'No stack trace');
        console.error('[VERSION] Full error object:', error);
        console.error('=================================\n');
        
        alert(`Failed to create new version: ${error instanceof Error ? error.message : 'Unknown error'}`);
        
        // Restore button
        btn.disabled = false;
        btn.innerHTML = originalText;
      }
    }

    /**
     * Increment version number (e.g., "1.2" -> "1.3", "2.9" -> "3.0")
     */
    function incrementVersion(version: string): string {
      const parts = version.split('.');
      if (parts.length === 1) {
        // Single number like "1" -> "2"
        return (parseInt(parts[0]) + 1).toString();
      }
      
      // Decimal version like "1.2" -> "1.3"
      const major = parseInt(parts[0]) || 1;
      const minor = parseInt(parts[1]) || 0;
      
      if (minor >= 9) {
        // Roll over: "1.9" -> "2.0"
        return `${major + 1}.0`;
      } else {
        // Increment minor: "1.2" -> "1.3"
        return `${major}.${minor + 1}`;
      }
    }

    // Load quote details on page load
    loadQuoteDetails();
  </script>
</DashboardLayout>
