    /**
     * Compare two version strings (e.g., "1.0", "1.1", "2.0")
     * Returns: -1 if a < b, 0 if equal, 1 if a > b
     */
    function compareVersions(versionA: string, versionB: string): number {
      const partsA = versionA.split('.').map(n => parseInt(n) || 0);
      const partsB = versionB.split('.').map(n => parseInt(n) || 0);
      
      const maxLength = Math.max(partsA.length, partsB.length);
      
      for (let i = 0; i < maxLength; i++) {
        const a = partsA[i] || 0;
        const b = partsB[i] || 0;
        
        if (a < b) return -1;
        if (a > b) return 1;
      }
      
      return 0;
    }

    /**
     * Traverse backwards through Parent Quote links to find the root (oldest) quote
     */
    async function findRootQuote(startQuoteId: string): Promise<any> {
      let currentQuote: any;
      let currentId = startQuoteId;
      const visited = new Set<string>();
      const maxDepth = 50;
      let depth = 0;

      console.log('[VERSION HISTORY] Finding root quote starting from', startQuoteId);

      while (currentId && depth < maxDepth) {
        if (visited.has(currentId)) {
          console.error('[VERSION HISTORY] Circular reference detected at quote', currentId);
          break;
        }
        visited.add(currentId);

        const response = await fetch(`${API_BASE_URL}/proxy/quotes/records/${currentId}`, {
          method: 'GET',
          headers: {
            'Authorization': `Bearer ${token}`,
            'Content-Type': 'application/json',
          },
        });

        if (!response.ok) {
          console.error('[VERSION HISTORY] Failed to fetch quote', currentId);
          break;
        }

        currentQuote = await safeJsonParse(response);
        const parentField = currentQuote.fields['Parent Quote'];

        if (parentField && typeof parentField === 'object' && parentField.id) {
          currentId = parentField.id.toString();
          depth++;
        } else {
          // No parent, this is the root
          console.log('[VERSION HISTORY] Found root quote:', currentQuote.id, 'after', depth, 'steps');
          return currentQuote;
        }
      }

      console.log('[VERSION HISTORY] Returning quote', currentQuote?.id, 'as root');
      return currentQuote;
    }

    /**
     * Fetch version chain using hybrid approach:
     * 1. Traverse backwards to find root quote
     * 2. Fetch all quotes with same Subject
     * 3. Build chain by following Parent Quote relationships
     * Returns array sorted by version (oldest to newest)
     */
    async function fetchVersionChain(startQuoteId: string): Promise<any[]> {
      console.log('[VERSION HISTORY] Fetching version chain for quote', startQuoteId);

      try {
        // Step 1: Find the root quote by traversing backwards
        const rootQuote = await findRootQuote(startQuoteId);
        
        if (!rootQuote) {
          throw new Error('Failed to find root quote');
        }

        const subject = rootQuote.fields['Subject'];
        if (!subject) {
          console.warn('[VERSION HISTORY] No subject found, returning only root quote');
          return [rootQuote];
        }

        console.log('[VERSION HISTORY] Root quote:', rootQuote.id, 'Subject:', subject);

        // Step 2: Fetch all quotes with same Subject
        // Important: Do NOT encode the subject - NocoDB handles the raw where clause
        const rawWhere = `(Subject,eq,${subject})`;
        console.log('[VERSION HISTORY] Raw where clause:', rawWhere);
        
        const allQuotesResponse = await fetch(
          `${API_BASE_URL}/proxy/quotes/records?where=${rawWhere}`,
          {
            method: 'GET',
            headers: {
              'Authorization': `Bearer ${token}`,
              'Content-Type': 'application/json',
            },
          }
        );

        if (!allQuotesResponse.ok) {
          throw new Error('Failed to fetch quotes by subject');
        }

        const allQuotesData = await safeJsonParse(allQuotesResponse);
        const allQuotes = allQuotesData.records || [];

        console.log('[VERSION HISTORY] Found', allQuotes.length, 'quotes with same subject');
        
        // Log all quotes and their Parent Quote fields for debugging
        console.log('[VERSION HISTORY] All quotes with Parent Quote field:');
        allQuotes.forEach((q: any) => {
          const parentField = q.fields['Parent Quote'];
          console.log(`  Quote ${q.id} (v${q.fields['Quote Version']}):`, 
            'Parent Quote =', parentField, 
            'Type:', typeof parentField,
            'Has id?:', parentField?.id);
        });

        // Step 3: Build chain by following Parent Quote relationships from root
        const chain: any[] = [];
        const quoteMap = new Map(allQuotes.map((q: any) => [q.id, q]));
        
        let currentQuote = rootQuote;
        chain.push(currentQuote);
        console.log('[VERSION HISTORY] Starting chain from root:', currentQuote.id);

        // Find children by looking for quotes that reference current as parent
        let iteration = 0;
        while (true) {
          iteration++;
          console.log(`[VERSION HISTORY] Iteration ${iteration}: Looking for child of quote ${currentQuote.id}`);
          
          const child = allQuotes.find((q: any) => {
            const parentField = q.fields['Parent Quote'];
            const hasParent = parentField && typeof parentField === 'object' && parentField.id === currentQuote.id;
            
            if (parentField) {
              console.log(`  Checking quote ${q.id}: Parent Quote =`, parentField, 
                'Match?', hasParent);
            }
            
            return hasParent;
          });

          if (!child) {
            console.log(`[VERSION HISTORY] No child found for quote ${currentQuote.id}, chain complete`);
            break; // No more children
          }

          console.log(`[VERSION HISTORY] Found child: ${child.id} (v${child.fields['Quote Version']})`);
          chain.push(child);
          currentQuote = child;
          
          if (iteration > 20) {
            console.error('[VERSION HISTORY] Too many iterations, breaking to prevent infinite loop');
            break;
          }
        }

        console.log('[VERSION HISTORY] Built chain with', chain.length, 'versions:', 
          chain.map((q: any) => `${q.id}(v${q.fields['Quote Version']})`).join(' → '));

        return chain;
      } catch (error) {
        console.error('[VERSION HISTORY] Error fetching version chain:', error);
        throw error;
      }
    }

