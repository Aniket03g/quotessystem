    /**
     * Update line item display with real-time calculation (optimistic UI)
     */
    function updateLineItemDisplay(junctionId: string | null) {
      if (!junctionId) return;
      
      const row = document.querySelector(`tr[data-junction-id="${junctionId}"]`);
      if (!row) return;
      
      const qtyInput = row.querySelector('.quantity-input') as HTMLInputElement;
      const priceInput = row.querySelector('.price-input') as HTMLInputElement;
      const discountInput = row.querySelector('.discount-input') as HTMLInputElement;
      const lineTotalCell = row.querySelector('.line-total-cell');
      
      if (!qtyInput || !priceInput || !discountInput || !lineTotalCell) return;
      
      const quantity = parseFloat(qtyInput.value) || 1;
      const unitPrice = parseFloat(priceInput.value) || 0;
      const discount = parseFloat(discountInput.value) || 0;
      
      // Find product to get tax rate
      const product = currentProducts.find(p => p.junctionId === parseInt(junctionId));
      const taxRate = product ? (Number(product.tax) || 0) : 0;
      
      // Calculate line total
      const subtotal = unitPrice * quantity;
      const discountAmount = subtotal * (discount / 100);
      const afterDiscount = subtotal - discountAmount;
      const taxAmount = afterDiscount * (taxRate / 100);
      const lineTotal = afterDiscount + taxAmount;
      
      // Update display
      lineTotalCell.textContent = '₹' + lineTotal.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      
      // Update grand total
      updateGrandTotal();
    }
    
    /**
     * Update grand total display
     * Works in both edit and non-edit modes by using currentProducts array
     */
    function updateGrandTotal() {
      const grandTotalEl = document.getElementById('grandTotal');
      if (!grandTotalEl) return;
      
      let total = 0;
      
      if (isEditMode) {
        // In edit mode, read from input fields for real-time updates
        document.querySelectorAll('tr[data-junction-id]').forEach(row => {
          const qtyInput = row.querySelector('.quantity-input') as HTMLInputElement;
          const priceInput = row.querySelector('.price-input') as HTMLInputElement;
          const discountInput = row.querySelector('.discount-input') as HTMLInputElement;
          
          if (qtyInput && priceInput && discountInput) {
            const quantity = parseFloat(qtyInput.value) || 1;
            const unitPrice = parseFloat(priceInput.value) || 0;
            const discount = parseFloat(discountInput.value) || 0;
            
            const junctionId = row.getAttribute('data-junction-id');
            const product = currentProducts.find(p => p.junctionId === parseInt(junctionId || '0'));
            const taxRate = product ? (Number(product.tax) || 0) : 0;
            
            const subtotal = unitPrice * quantity;
            const discountAmount = subtotal * (discount / 100);
            const afterDiscount = subtotal - discountAmount;
            const taxAmount = afterDiscount * (taxRate / 100);
            const lineTotal = afterDiscount + taxAmount;
            
            total += lineTotal;
          }
        });
      } else {
        // In non-edit mode, calculate from currentProducts array
        total = currentProducts.reduce((sum, product) => {
          const customPrice = product.customUnitPrice ? Number(product.customUnitPrice) : null;
          
          // Skip products without custom price
          if (customPrice === null) {
            return sum;
          }
          
          const quantity = Number(product.quantity) || 1;
          const discount = Number(product.discount) || 0;
          const taxRate = Number(product.tax) || 0;
          
          // Calculate: (price * quantity - discount) * (1 + tax/100)
          const subtotal = customPrice * quantity;
          const discountAmount = subtotal * (discount / 100);
          const afterDiscount = subtotal - discountAmount;
          const taxAmount = afterDiscount * (taxRate / 100);
          const lineTotal = afterDiscount + taxAmount;
          
          return sum + lineTotal;
        }, 0);
      }
      
      grandTotalEl.textContent = '₹' + total.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    /**
     * Toggle edit mode
     */
    function toggleEditMode(enable: boolean) {
      isEditMode = enable;
      const editModePanel = document.getElementById('editModePanel') as HTMLDivElement;
      const editQuoteBtn = document.getElementById('editQuoteBtn') as HTMLButtonElement;
