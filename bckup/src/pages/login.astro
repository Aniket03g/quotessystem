<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login - Generic Proxy System</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
      background: #f5f5f5;
      color: #333;
      line-height: 1.6;
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
    }

    .login-container {
      background: white;
      padding: 2rem;
      border-radius: 8px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
      width: 100%;
      max-width: 400px;
    }

    h1 {
      font-size: 1.75rem;
      margin-bottom: 0.5rem;
      color: #222;
    }

    p {
      color: #666;
      margin-bottom: 1.5rem;
    }

    .form-group {
      margin-bottom: 1rem;
    }

    label {
      display: block;
      margin-bottom: 0.25rem;
      color: #444;
      font-weight: 500;
    }

    input {
      width: 100%;
      padding: 0.75rem;
      border: 1px solid #ddd;
      border-radius: 4px;
      font-size: 1rem;
    }

    input:focus {
      outline: none;
      border-color: #333;
    }

    .btn {
      width: 100%;
      padding: 0.75rem;
      background: #333;
      color: white;
      border: none;
      border-radius: 4px;
      font-size: 1rem;
      cursor: pointer;
      transition: background 0.2s;
    }

    .btn:hover {
      background: #555;
    }

    .btn:disabled {
      background: #999;
      cursor: not-allowed;
    }

    .error {
      background: #fee;
      color: #c33;
      padding: 0.75rem;
      border-radius: 4px;
      margin-bottom: 1rem;
      display: none;
    }

    .error.show {
      display: block;
    }

    .demo-users {
      margin-top: 1.5rem;
      padding-top: 1.5rem;
      border-top: 1px solid #eee;
    }

    .demo-users h3 {
      font-size: 0.875rem;
      color: #666;
      margin-bottom: 0.5rem;
    }

    .demo-users ul {
      list-style: none;
      font-size: 0.875rem;
      color: #888;
    }

    .demo-users li {
      margin-bottom: 0.25rem;
    }

    .back-link {
      display: block;
      text-align: center;
      margin-top: 1rem;
      color: #666;
      text-decoration: none;
    }

    .back-link:hover {
      color: #333;
    }

    .oauth-section {
      margin: 1.5rem 0;
    }

    .oauth-btn {
      width: 100%;
      padding: 0.75rem;
      background: white;
      color: #333;
      border: 2px solid #ddd;
      border-radius: 4px;
      font-size: 1rem;
      cursor: pointer;
      transition: all 0.2s;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.75rem;
      font-weight: 500;
    }

    .oauth-btn:hover {
      border-color: #333;
      background: #f9f9f9;
    }

    .oauth-btn svg {
      width: 20px;
      height: 20px;
    }

    .divider {
      text-align: center;
      margin: 1.5rem 0;
      position: relative;
    }

    .divider::before {
      content: '';
      position: absolute;
      left: 0;
      top: 50%;
      width: 100%;
      height: 1px;
      background: #e0e0e0;
    }

    .divider span {
      background: white;
      padding: 0 1rem;
      position: relative;
      color: #999;
      font-size: 0.85rem;
    }
  </style>
</head>
<body>
  <div class="login-container">
    <h1>Login</h1>
    <p>Enter your credentials to access the system</p>

    <div id="error" class="error"></div>

    <form id="loginForm">
      <div class="form-group">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" required autocomplete="email">
      </div>

      <div class="form-group">
        <label for="password">Password</label>
        <input type="password" id="password" name="password" required autocomplete="current-password">
      </div>

      <button type="submit" class="btn" id="submitBtn">Login</button>
    </form>
  </div>

  <script>
    import { loginUser } from '../lib/api';
    import { decodeJWT } from '../utils/jwt';

    const API_BASE_URL = `http://${window.location.hostname}:8082`;
    const form = document.getElementById('loginForm') as HTMLFormElement;
    const errorDiv = document.getElementById('error') as HTMLDivElement;
    const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement;

    // Email/password login
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const email = (document.getElementById('email') as HTMLInputElement).value;
      const password = (document.getElementById('password') as HTMLInputElement).value;

      // Clear previous errors
      errorDiv.classList.remove('show');
      errorDiv.textContent = '';
      submitBtn.disabled = true;
      submitBtn.textContent = 'Logging in...';

      try {
        const response = await loginUser(email, password);
        // Store email for user profile display
        localStorage.setItem('user_email', email);
        
        // Decode JWT to check for must_change_password
        const claims = decodeJWT(response.token);
        
        if (claims?.must_change_password) {
          // User must change password before accessing system
          window.location.href = '/change-password';
        } else {
          // Check user role and redirect accordingly
          if (response.role === 'admin') {
            window.location.href = '/admin';
          } else {
            window.location.href = '/quotes';
          }
        }
      } catch (error) {
        errorDiv.textContent = error instanceof Error ? error.message : 'Login failed';
        errorDiv.classList.add('show');
        submitBtn.disabled = false;
        submitBtn.textContent = 'Login';
      }
    });
  </script>
</body>
</html>
