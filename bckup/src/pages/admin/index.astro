---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Dashboard" currentPage="dashboard">
  <script>
    import { requireAdmin } from '../../utils/jwt';
    requireAdmin();
  </script>
  <div class="max-w-7xl mx-auto">
    <!-- Welcome Section -->
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-slate-800 mb-2">Dashboard</h1>
      <p class="text-slate-600">System overview and quick actions</p>
    </div>

    <!-- Stats Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
      <!-- Total Users Card -->
      <div class="bg-white rounded-xl border border-slate-200 p-6">
        <div class="flex items-center justify-between mb-4">
          <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center">
            <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
            </svg>
          </div>
          <span class="px-2 py-1 bg-green-100 text-green-700 text-xs font-semibold rounded">Active</span>
        </div>
        <h3 class="text-2xl font-bold text-slate-800 mb-1" id="totalUsers">-</h3>
        <p class="text-sm text-slate-600">Total Users</p>
      </div>

      <!-- System Status Card -->
      <div class="bg-white rounded-xl border border-slate-200 p-6">
        <div class="flex items-center justify-between mb-4">
          <div class="w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center">
            <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <span class="px-2 py-1 bg-green-100 text-green-700 text-xs font-semibold rounded">Online</span>
        </div>
        <h3 class="text-2xl font-bold text-slate-800 mb-1">Healthy</h3>
        <p class="text-sm text-slate-600">System Status</p>
      </div>

      <!-- Quotes Card -->
      <div class="bg-white rounded-xl border border-slate-200 p-6">
        <div class="flex items-center justify-between mb-4">
          <div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center">
            <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
          </div>
        </div>
        <h3 class="text-2xl font-bold text-slate-800 mb-1" id="totalQuotes">56</h3>
        <p class="text-sm text-slate-600">Total Quotes</p>
      </div>

      <!-- Products Card -->
      <div class="bg-white rounded-xl border border-slate-200 p-6">
        <div class="flex items-center justify-between mb-4">
          <div class="w-12 h-12 bg-orange-100 rounded-lg flex items-center justify-center">
            <svg class="w-6 h-6 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
            </svg>
          </div>
        </div>
        <h3 class="text-2xl font-bold text-slate-800 mb-1" id="totalProducts">1441</h3>
        <p class="text-sm text-slate-600">Total Products</p>
      </div>
    </div>

    <!-- Quick Actions -->
    <div class="bg-white rounded-xl border border-slate-200 p-6 mb-8">
      <h2 class="text-lg font-semibold text-slate-800 mb-4">Quick Actions</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        <a href="/admin/users" class="flex items-center gap-3 p-4 border border-slate-200 rounded-lg hover:border-blue-500 hover:bg-blue-50 transition-all group">
          <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center group-hover:bg-blue-200 transition-colors">
            <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
            </svg>
          </div>
          <div>
            <h3 class="font-medium text-slate-800 group-hover:text-blue-700">Create User</h3>
            <p class="text-sm text-slate-500">Add new user account</p>
          </div>
        </a>

        <a href="/quotes" class="flex items-center gap-3 p-4 border border-slate-200 rounded-lg hover:border-purple-500 hover:bg-purple-50 transition-all group">
          <div class="w-10 h-10 bg-purple-100 rounded-lg flex items-center justify-center group-hover:bg-purple-200 transition-colors">
            <svg class="w-5 h-5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
          </div>
          <div>
            <h3 class="font-medium text-slate-800 group-hover:text-purple-700">View Quotes</h3>
            <p class="text-sm text-slate-500">Browse all quotes</p>
          </div>
        </a>

        <a href="/leads" class="flex items-center gap-3 p-4 border border-slate-200 rounded-lg hover:border-green-500 hover:bg-green-50 transition-all group">
          <div class="w-10 h-10 bg-green-100 rounded-lg flex items-center justify-center group-hover:bg-green-200 transition-colors">
            <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
            </svg>
          </div>
          <div>
            <h3 class="font-medium text-slate-800 group-hover:text-green-700">Manage Leads</h3>
            <p class="text-sm text-slate-500">View and track leads</p>
          </div>
        </a>

        <a href="/products" class="flex items-center gap-3 p-4 border border-slate-200 rounded-lg hover:border-orange-500 hover:bg-orange-50 transition-all group">
          <div class="w-10 h-10 bg-orange-100 rounded-lg flex items-center justify-center group-hover:bg-orange-200 transition-colors">
            <svg class="w-5 h-5 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
            </svg>
          </div>
          <div>
            <h3 class="font-medium text-slate-800 group-hover:text-orange-700">Manage Products</h3>
            <p class="text-sm text-slate-500">View product catalog</p>
          </div>
        </a>
      </div>
    </div>

    <!-- System Info -->
    <div class="bg-gradient-to-br from-blue-50 to-purple-50 rounded-xl border border-blue-200 p-6">
      <h3 class="font-semibold text-slate-800 mb-4">System Info</h3>
      <div class="space-y-3">
        <div class="flex items-center justify-between">
          <span class="text-sm text-slate-600">Environment:</span>
          <span class="text-sm font-medium text-slate-800">Production</span>
        </div>
        <div class="flex items-center justify-between">
          <span class="text-sm text-slate-600">API Server:</span>
          <div class="flex items-center gap-2">
            <div class="w-2 h-2 bg-green-500 rounded-full"></div>
            <span class="text-sm font-medium text-slate-800">Connected</span>
          </div>
        </div>
        <div class="flex items-center justify-between">
          <span class="text-sm text-slate-600">Database:</span>
          <div class="flex items-center gap-2">
            <div class="w-2 h-2 bg-green-500 rounded-full"></div>
            <span class="text-sm font-medium text-slate-800">Connected</span>
          </div>
        </div>
        <div class="flex items-center justify-between">
          <span class="text-sm text-slate-600">Auth Provider:</span>
          <span class="text-sm font-medium text-slate-800">JWT + Local</span>
        </div>
        <div class="flex items-center justify-between">
          <span class="text-sm text-slate-600">Your Role:</span>
          <div class="flex items-center gap-2">
            <div class="w-2 h-2 bg-purple-500 rounded-full"></div>
            <span class="text-sm font-medium text-slate-800">Super Admin</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    import { fetchQuotesCount, fetchProductsCount } from '../../lib/api';

    // Load dashboard stats
    async function loadStats() {
      try {
        // Fetch quotes count using count API
        const quotesCount = await fetchQuotesCount();
        const quotesEl = document.getElementById('totalQuotes');
        if (quotesEl) quotesEl.textContent = quotesCount.toString();

        // Fetch products count using count API
        const productsCount = await fetchProductsCount();
        const productsEl = document.getElementById('totalProducts');
        if (productsEl) productsEl.textContent = productsCount.toString();

        // Set placeholder for users (would need backend endpoint)
        const usersEl = document.getElementById('totalUsers');
        if (usersEl) usersEl.textContent = '—';
      } catch (error) {
        console.error('Failed to load stats:', error);
      }
    }

    loadStats();
  </script>
</AdminLayout>
