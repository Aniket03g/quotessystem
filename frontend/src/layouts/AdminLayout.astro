---

interface Props {

  title: string;

  currentPage?: string;

}



const { title, currentPage } = Astro.props;

---



<!DOCTYPE html>

<html lang="en">

<head>

  <meta charset="UTF-8">

  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>{title}</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">

  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

</head>

<body class="bg-slate-50 font-sans antialiased" style="position: relative;">

  <div class="flex h-screen overflow-hidden">

    <!-- Sidebar -->

    <aside id="sidebar" class="hidden lg:flex lg:flex-col w-64 bg-slate-900 border-r border-slate-700">

      <!-- Logo -->

      <div class="flex items-center gap-3 px-6 py-5 border-b border-slate-700">

        <div class="w-10 h-10 rounded-full overflow-hidden flex items-center justify-center">

          <img src="/logos/GR.png" alt="Grove Systems" class="w-full h-full object-cover" />

        </div>

        <div class="flex-1">

          <h1 class="text-lg font-semibold text-white">Grove Systems</h1>

        </div>

        <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">

          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>

        </svg>

      </div>



      <!-- Navigation -->

      <nav class="flex-1 px-3 py-4 space-y-1 overflow-y-auto">

        <a href="/admin" id="dashboardLink" class={`nav-link ${currentPage === 'dashboard' ? 'active' : ''}`}>

          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">

            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>

          </svg>

          <span>Dashboard</span>

        </a>



        <a href="/quotes" class={`nav-link ${currentPage === 'quotes' ? 'active' : ''}`}>

          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">

            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>

          </svg>

          <span id="quotesLabel">My Quotes</span>

        </a>

        <a href="/leads" class={`nav-link ${currentPage === 'leads' ? 'active' : ''}`}>

          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">

            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>

          </svg>

          <span>Manage Leads</span>

        </a>



        <a href="/accounts" class={`nav-link ${currentPage === 'accounts' ? 'active' : ''}`}>

          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">

            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>

          </svg>

          <span>Accounts</span>

        </a>



        <a href="/contacts" class={`nav-link ${currentPage === 'contacts' ? 'active' : ''}`}>

          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">

            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>

          </svg>

          <span>Contacts</span>

        </a>



        <a href="/products" class={`nav-link ${currentPage === 'products' ? 'active' : ''}`}>

          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">

            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>

          </svg>

          <span>Products</span>

        </a>



        <a href="/admin/users" id="userManagementLink" class={`nav-link ${currentPage === 'users' ? 'active' : ''}`}>

          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">

            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>

          </svg>

          <span>User Management</span>

        </a>



      </nav>



      <!-- User Profile -->

      <div class="px-3 py-4 border-t border-slate-700">

        <div class="flex items-center gap-3 px-3 py-2 rounded-xl mb-2">

          <div class="w-10 h-10 bg-slate-700 rounded-full flex items-center justify-center text-white font-semibold text-sm">

            <span id="userInitials">AD</span>

          </div>

          <div class="flex-1 min-w-0">

            <p class="text-sm font-medium text-white truncate" id="userName">admin</p>

            <p class="text-xs text-slate-400 truncate" id="userEmail">admin@example.c...</p>

          </div>

        </div>

        <!-- Logout Button -->

        <button id="logoutBtn" class="w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-300 hover:bg-slate-800 hover:text-white transition-all group">

          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">

            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>

          </svg>

          <span class="text-sm font-medium">Logout</span>

        </button>

      </div>

    </aside>



    <!-- Main Content Area -->

    <div class="flex-1 flex flex-col overflow-hidden">

      <!-- Top Header -->

      <header class="bg-white border-b border-slate-200 px-6 py-4">

        <div class="flex items-center justify-between">

          <!-- Mobile Menu Button -->

          <button id="mobileMenuBtn" class="lg:hidden p-2 rounded-lg hover:bg-slate-100 transition-colors">

            <svg class="w-6 h-6 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">

              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>

            </svg>

          </button>



          <!-- Right Side Actions -->

          <div class="flex items-center gap-3 ml-auto">

            <!-- Help -->

            <button class="p-2 rounded-lg hover:bg-slate-100 transition-colors">

              <svg class="w-5 h-5 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">

                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>

              </svg>

            </button>

          </div>

        </div>

      </header>



      <!-- Page Content -->

      <main class="flex-1 overflow-y-auto bg-slate-50 p-6">

        <slot />

      </main>

    </div>

  </div>



  <!-- Mobile Sidebar Overlay -->

  <div id="mobileOverlay" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-40 lg:hidden hidden"></div>

  

  <!-- Mobile Sidebar -->

  <aside id="mobileSidebar" class="fixed inset-y-0 left-0 w-64 bg-slate-900 border-r border-slate-700 z-50 lg:hidden transform -translate-x-full transition-transform duration-300">

    <!-- Same content as desktop sidebar -->

    <div class="flex items-center gap-3 px-6 py-5 border-b border-slate-700">

      <div class="w-10 h-10 rounded-full overflow-hidden flex items-center justify-center">

        <img src="/logos/GR.png" alt="Grove Systems" class="w-full h-full object-cover" />

      </div>

      <div class="flex-1">

        <h1 class="text-lg font-semibold text-white">Grove Systems</h1>

      </div>

      <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">

        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>

      </svg>

    </div>



    <nav class="flex-1 px-3 py-4 space-y-1 overflow-y-auto">

      <a href="/admin" id="dashboardLinkMobile" class={`nav-link ${currentPage === 'dashboard' ? 'active' : ''}`}>

        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">

          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>

        </svg>

        <span>Dashboard</span>

      </a>



      <a href="/quotes" class={`nav-link ${currentPage === 'quotes' ? 'active' : ''}`}>

        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">

          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>

        </svg>

        <span id="quotesLabelMobile">My Quotes</span>

      </a>

      <a href="/leads" class={`nav-link ${currentPage === 'leads' ? 'active' : ''}`}>

        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">

          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>

        </svg>

        <span>Manage Leads</span>

      </a>



      <a href="/accounts" class={`nav-link ${currentPage === 'accounts' ? 'active' : ''}`}>

        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">

          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>

        </svg>

        <span>Accounts</span>

      </a>



      <a href="/contacts" class={`nav-link ${currentPage === 'contacts' ? 'active' : ''}`}>

        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">

          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>

        </svg>

        <span>Contacts</span>

      </a>



      <a href="/products" class={`nav-link ${currentPage === 'products' ? 'active' : ''}`}>

        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">

          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>

        </svg>

        <span>Products</span>

      </a>



      <a href="/admin/users" id="userManagementLinkMobile" class={`nav-link ${currentPage === 'users' ? 'active' : ''}`}>

        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">

          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>

        </svg>

        <span>User Management</span>

      </a>



    </nav>



    <!-- User Profile -->

    <div class="px-3 py-4 border-t border-slate-700">

      <div class="flex items-center gap-3 px-3 py-2 rounded-xl mb-2">

        <div class="w-10 h-10 bg-slate-700 rounded-full flex items-center justify-center text-white font-semibold text-sm">

          <span id="userInitials">AD</span>

        </div>

        <div class="flex-1 min-w-0">

          <p class="text-sm font-medium text-white truncate" id="userName">admin</p>

          <p class="text-xs text-slate-400 truncate" id="userEmail">admin@example.c...</p>

        </div>

      </div>

      <!-- Logout Button -->

      <button id="logoutBtnMobile" class="w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-300 hover:bg-slate-800 hover:text-white transition-all group">

        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">

          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>

        </svg>

        <span class="text-sm font-medium">Logout</span>

      </button>

    </div>

  </aside>



  <style>

    .nav-link {

      @apply flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium text-slate-400 hover:bg-slate-800 hover:text-white transition-all duration-200;

    }



    .nav-link.active {

      @apply bg-blue-600 text-white hover:bg-blue-700;

    }



    .nav-link svg {

      @apply flex-shrink-0;

    }

    

    /* Hide admin-only elements by default to prevent flash */
    #dashboardLink,
    #dashboardLinkMobile,
    #userManagementLink,
    #userManagementLinkMobile {
      display: none;
    }

  </style>



  <script>

    import { logout } from '../lib/api';

    import { checkPasswordChangeRequired, getTokenClaims } from '../utils/jwt';



    // Check if password change is required

    checkPasswordChangeRequired();



    // Load user info from JWT

    function loadUserInfo() {

      const claims = getTokenClaims();

      if (!claims) return;

      

      const userEmail = claims.email || localStorage.getItem('user_email') || 'admin@example.com';

      const emailParts = userEmail.split('@')[0];

      const initials = emailParts.substring(0, 2).toUpperCase();

      

      const userInitialsEl = document.getElementById('userInitials');

      const userNameEl = document.getElementById('userName');

      const userEmailEl = document.getElementById('userEmail');

      

      if (userInitialsEl) userInitialsEl.textContent = initials;

      if (userNameEl) userNameEl.textContent = emailParts;

      if (userEmailEl) userEmailEl.textContent = userEmail.substring(0, 15) + '...';

    }



    // Mobile menu toggle

    const mobileMenuBtn = document.getElementById('mobileMenuBtn');

    const mobileSidebar = document.getElementById('mobileSidebar');

    const mobileOverlay = document.getElementById('mobileOverlay');



    function toggleMobileMenu() {

      mobileSidebar?.classList.toggle('-translate-x-full');

      mobileOverlay?.classList.toggle('hidden');

    }



    if (mobileMenuBtn) {

      mobileMenuBtn.addEventListener('click', toggleMobileMenu);

    }

    mobileOverlay?.addEventListener('click', toggleMobileMenu);



    // Logout functionality

    async function handleLogout() {

      try {

        await logout();

        window.location.href = '/login';

      } catch (error) {

        console.error('Logout failed:', error);

        // Clear tokens anyway and redirect

        localStorage.removeItem('token');

        localStorage.removeItem('user_email');

        window.location.href = '/login';

      }

    }



    // Attach logout handlers

    const logoutBtn = document.getElementById('logoutBtn');

    const logoutBtnMobile = document.getElementById('logoutBtnMobile');

    

    if (logoutBtn) {

      logoutBtn.addEventListener('click', handleLogout);

    }

    

    if (logoutBtnMobile) {

      logoutBtnMobile.addEventListener('click', handleLogout);

    }



    // Customize sidebar based on user role

    function customizeSidebarForRole() {

      const claims = getTokenClaims();

      if (!claims) return;

      

      const userRole = claims.role;

      const quotesLabel = document.getElementById('quotesLabel');

      const quotesLabelMobile = document.getElementById('quotesLabelMobile');

      

      // If user is admin, show admin-only elements and update labels

      if (userRole === 'admin') {

        // Show admin-only navigation links

        const dashboardLink = document.getElementById('dashboardLink');

        const dashboardLinkMobile = document.getElementById('dashboardLinkMobile');

        const userManagementLink = document.getElementById('userManagementLink');

        const userManagementLinkMobile = document.getElementById('userManagementLinkMobile');

        

        if (dashboardLink) {

          dashboardLink.style.display = 'flex';

        }

        

        if (dashboardLinkMobile) {

          dashboardLinkMobile.style.display = 'flex';

        }

        

        if (userManagementLink) {

          userManagementLink.style.display = 'flex';

        }

        

        if (userManagementLinkMobile) {

          userManagementLinkMobile.style.display = 'flex';

        }

        

        // Change 'My Quotes' to 'Quotes' for admin

        if (quotesLabel) {

          quotesLabel.textContent = 'Quotes';

        }

        if (quotesLabelMobile) {

          quotesLabelMobile.textContent = 'Quotes';

        }

      }

      // For non-admin users, admin links remain hidden by CSS

    }



    // Load user info on page load

    loadUserInfo();

    

    // Customize sidebar based on user role

    customizeSidebarForRole();

  </script>

</body>

</html>

