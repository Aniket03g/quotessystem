    /**
     * Traverse UPWARD to find root quote
     * Uses Parent Quote nested object: { "id": 126, "fields": { ... } }
     * Root has Parent Quote = null
     */
    async function findRootQuote(startQuoteId: string): Promise<any> {
      let currentQuote: any;
      let currentId = startQuoteId;
      const visited = new Set<string>();
      const maxDepth = 50;
      let depth = 0;

      console.log('[VERSION] Step 1: Traversing UPWARD to find root from quote', startQuoteId);

      while (currentId && depth < maxDepth) {
        if (visited.has(currentId)) {
          console.error('[VERSION] Circular reference detected at quote', currentId);
          throw new Error('Circular reference in version chain');
        }
        visited.add(currentId);

        const response = await fetch(
          `${API_BASE_URL}/proxy/quotes/records/${currentId}?fields=Id,Subject,Quote Version,Quote Date,Quote Status,Total Amount,Parent Quote,nc_76_d___Quotes_id`,
          {
            method: 'GET',
            headers: {
              'Authorization': `Bearer ${token}`,
              'Content-Type': 'application/json',
            },
          }
        );

        if (!response.ok) {
          console.error('[VERSION] Failed to fetch quote', currentId);
          throw new Error(`Failed to fetch quote ${currentId}`);
        }

        currentQuote = await safeJsonParse(response);
        const parentField = currentQuote.fields['Parent Quote'];

        console.log(`[VERSION] Quote ${currentId}: Parent Quote =`, parentField);

        // Parent Quote is a nested object with .id property, or null for root
        if (parentField && typeof parentField === 'object' && parentField.id) {
          currentId = parentField.id.toString();
          depth++;
          console.log(`[VERSION] Moving up to parent quote ${currentId}`);
        } else {
          // No parent, this is the root
          console.log(`[VERSION] ✓ Found root quote: ${currentQuote.id} (v${currentQuote.fields['Quote Version']}) after ${depth} steps`);
          return currentQuote;
        }
      }

      if (depth >= maxDepth) {
        throw new Error('Max depth exceeded while finding root');
      }

      return currentQuote;
    }

    /**
     * Traverse DOWNWARD from root to build complete version chain
     * Uses nc_76_d___Quotes_id field which points to the child quote
     * Returns array ordered from root (v1.0) to latest version
     */
    async function buildVersionChainFromRoot(rootQuote: any): Promise<any[]> {
      console.log('[VERSION] Step 2: Traversing DOWNWARD from root to build chain');
      
      const chain: any[] = [];
      const visited = new Set<number>();
      const maxDepth = 50;
      
      let currentQuote = rootQuote;
      let depth = 0;

      while (currentQuote && depth < maxDepth) {
        if (visited.has(currentQuote.id)) {
          console.error('[VERSION] Circular reference detected at quote', currentQuote.id);
          throw new Error('Circular reference in version chain');
        }
        
        visited.add(currentQuote.id);
        chain.push(currentQuote);
        
        console.log(`[VERSION] Added to chain: ${currentQuote.id} (v${currentQuote.fields['Quote Version']})`);
        
        // Check for child quote using nc_76_d___Quotes_id field
        const childId = currentQuote.fields['nc_76_d___Quotes_id'];
        
        if (childId) {
          console.log(`[VERSION] Found child quote ID: ${childId}`);
          
          // Fetch the child quote
          const response = await fetch(
            `${API_BASE_URL}/proxy/quotes/records/${childId}?fields=Id,Subject,Quote Version,Quote Date,Quote Status,Total Amount,Parent Quote,nc_76_d___Quotes_id`,
            {
              method: 'GET',
              headers: {
                'Authorization': `Bearer ${token}`,
                'Content-Type': 'application/json',
              },
            }
          );

          if (!response.ok) {
            console.warn(`[VERSION] Failed to fetch child quote ${childId}, stopping chain`);
            break;
          }

          currentQuote = await safeJsonParse(response);
          depth++;
        } else {
          // No child, this is the latest version
          console.log(`[VERSION] ✓ Reached latest version: ${currentQuote.id} (v${currentQuote.fields['Quote Version']})`);
          break;
        }
      }

      if (depth >= maxDepth) {
        throw new Error('Max depth exceeded while building chain');
      }

      console.log('[VERSION] ✓ Built complete chain with', chain.length, 'versions:', 
        chain.map((q: any) => `${q.id}(v${q.fields['Quote Version']})`).join(' → '));

      return chain;
    }

    /**
     * Fetch complete version chain using upward then downward traversal
     * Step 1: Traverse upward to find root (using Parent Quote nested object)
     * Step 2: Traverse downward from root (using nc_76_d___Quotes_id field)
     * Returns array ordered from root to latest
     */
    async function fetchVersionChain(startQuoteId: string): Promise<any[]> {
      console.log('\n=== FETCHING VERSION CHAIN ===');
      console.log('[VERSION] Starting from quote', startQuoteId);

      try {
        // Step 1: Find root by traversing upward
        const rootQuote = await findRootQuote(startQuoteId);
        
        if (!rootQuote) {
          throw new Error('Failed to find root quote');
        }

        // Step 2: Build chain by traversing downward from root
        const chain = await buildVersionChainFromRoot(rootQuote);

        console.log('=== VERSION CHAIN COMPLETE ===\n');
        return chain;
      } catch (error) {
        console.error('[VERSION] Error fetching version chain:', error);
        throw error;
      }
    }

    /**
     * Fetch version chain and render in dropdown
     * Shows loading spinner while fetching
     */
    async function fetchAndRenderVersionHistory() {
      const versionList = document.getElementById('versionList') as HTMLDivElement;
      
      // Show loading spinner
      versionList.innerHTML = `
        <div class="flex items-center justify-center py-8">
          <svg class="animate-spin w-5 h-5 text-blue-600" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          <span class="ml-2 text-sm text-slate-600">Loading versions...</span>
        </div>
      `;
      
      try {
        versionChain = await fetchVersionChain(quoteId!);
        versionChainLoaded = true;
        
        renderVersionHistory();
      } catch (error) {
        console.error('[VERSION] Error loading version history:', error);
        versionList.innerHTML = `
          <div class="px-4 py-8 text-center text-sm text-red-600">
            Failed to load version history
          </div>
        `;
      }
    }

    /**
     * Render version history list from cached chain
     */
    function renderVersionHistory() {
      console.log('\n=== RENDERING VERSION HISTORY ===');
      console.log('[RENDER] Version chain length:', versionChain.length);
      console.log('[RENDER] Current quote ID:', quoteId);
      
      const versionList = document.getElementById('versionList') as HTMLDivElement;
      
      if (versionChain.length === 0) {
        versionList.innerHTML = `
          <div class="px-4 py-8 text-center text-sm text-slate-500">
            No version history available
          </div>
        `;
        return;
      }

      versionList.innerHTML = versionChain.map((quote) => {
        const fields = quote.fields || {};
        const version = fields['Quote Version'] || '1.0';
        const date = fields['Quote Date'] || 'N/A';
        const status = fields['Quote Status'] || 'Draft';
        const total = fields['Total Amount'] || 0;
        const isCurrent = quote.id.toString() === quoteId;

        let statusColor = 'text-slate-600';
        if (status === 'Sent') statusColor = 'text-blue-600';
        if (status === 'Approved' || status === 'Accepted') statusColor = 'text-emerald-600';
        if (status === 'Rejected') statusColor = 'text-red-600';

        return `
          <button 
            class="version-item w-full px-3 py-2.5 text-left hover:bg-slate-50 rounded-lg transition-colors ${isCurrent ? 'bg-blue-50 border border-blue-200' : ''}"
            data-quote-id="${quote.id}"
            ${isCurrent ? 'disabled' : ''}
          >
            <div class="flex items-start justify-between mb-1">
              <span class="text-sm font-semibold text-slate-800">Version ${version}</span>
              ${isCurrent ? '<span class="text-xs font-medium text-blue-600 bg-blue-100 px-2 py-0.5 rounded">Current</span>' : ''}
            </div>
            <div class="text-xs text-slate-600 space-y-0.5">
              <div>${date}</div>
              <div class="flex items-center gap-2">
                <span class="${statusColor}">${status}</span>
                <span class="text-slate-400">•</span>
                <span class="font-medium">₹${Number(total).toLocaleString('en-IN')}</span>
              </div>
            </div>
          </button>
        `;
      }).join('');

      // Add click handlers for version navigation
      document.querySelectorAll('.version-item').forEach(btn => {
        btn.addEventListener('click', () => {
          const targetQuoteId = btn.getAttribute('data-quote-id');
          if (targetQuoteId && targetQuoteId !== quoteId) {
            window.location.href = `/quote-detail?id=${targetQuoteId}`;
          }
        });
      });
      
      console.log('[RENDER] ✓ Rendered', versionChain.length, 'versions');
    }

    /**
     * Create a new version of the current quote
     * Copies quote fields, increments version, sets parent quote, and copies all line items
     */
    async function createNewVersion() {
      const btn = document.getElementById('createNewVersionBtn') as HTMLButtonElement;
      const originalText = btn.innerHTML;
      
      try {
        // Show loading state
        btn.disabled = true;
        btn.innerHTML = `
          <svg class="animate-spin w-4 h-4" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          <span>Creating...</span>
        `;

        console.log('[VERSION] Creating new version of quote', quoteId);

        // Step 1: Fetch current quote details
        const quoteResponse = await fetch(`${API_BASE_URL}/proxy/quotes/records/${quoteId}`, {
          method: 'GET',
          headers: {
            'Authorization': `Bearer ${token}`,
            'Content-Type': 'application/json',
          },
        });

        if (!quoteResponse.ok) {
          throw new Error('Failed to fetch current quote');
        }

        const currentQuote = await safeJsonParse(quoteResponse);
        const currentFields = currentQuote.fields || {};
        
        // Increment version (e.g., "1.2" -> "1.3")
        const currentVersion = currentFields['Quote Version'] || '1.0';
        const newVersion = incrementVersion(currentVersion);

        // Step 2: Create new quote record
        const newQuotePayload = {
          fields: {
            'Subject': currentFields['Subject'] || 'Quote',
            'Quote Status': 'Draft',
            'Quote Type': currentFields['Quote Type'] || 'Customer',
            'Quote Version': newVersion,
            'Quote Date': new Date().toISOString().split('T')[0],
            'Valid Until': currentFields['Valid Until'] || '',
            'Total Amount': currentFields['Total Amount'] || 0,
            'Notes': currentFields['Notes'] || '',
            'Quote Created By': currentFields['Quote Created By'] || 'Unknown User',
            'Parent Quote': parseInt(quoteId!)
          }
        };

        // Creating new quote version

        const createResponse = await fetch(`${API_BASE_URL}/proxy/quotes/records`, {
          method: 'POST',
          headers: {
            'Authorization': `Bearer ${token}`,
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(newQuotePayload)
        });

        if (!createResponse.ok) {
          const errorText = await createResponse.text();
          throw new Error(`Failed to create new quote: ${errorText}`);
        }

        const createResult = await safeJsonParse(createResponse);
        const newQuoteId = createResult.records ? createResult.records[0]?.id : createResult.id;
        
        if (!newQuoteId) {
          throw new Error('No quote ID returned from create');
        }

        // New quote created

        // Step 3: Link new quote to SAME case (reuse caseId from parent)
        const parentCaseId = currentFields['nc_6n5b___Cases_id'];
        
        console.log('[CASE LINK] Parent quote caseId:', parentCaseId);
        console.log('[CASE LINK] New quote ID to link:', newQuoteId);
        
        if (parentCaseId) {
          const linkUrl = `${API_BASE_URL}/proxy/cases/links/quotes/${parentCaseId}`;
          const linkPayload = [{ id: newQuoteId }];
          
          console.log('[CASE LINK] URL:', linkUrl);
          console.log('[CASE LINK] Payload:', JSON.stringify(linkPayload));
          
          const linkQuoteResponse = await fetch(linkUrl, {
            method: 'POST',
            headers: {
              'Authorization': `Bearer ${token}`,
              'Content-Type': 'application/json',
            },
            body: JSON.stringify(linkPayload)
          });

          console.log('[CASE LINK] Response status:', linkQuoteResponse.status);
          
          if (linkQuoteResponse.ok) {
            console.log('[CASE LINK] ✓ Successfully linked quote to case');
          } else {
            const errorText = await linkQuoteResponse.text();
            console.error('[CASE LINK] ✗ Failed:', errorText);
          }
        } else {
          // LEGACY QUOTE: Create new Case for the new version
          console.log('[CASE LINK] No caseId - creating new case for legacy quote');
          
          // First, get the account from the old quote
          const legacyAccountUrl = `${API_BASE_URL}/proxy/quotes/links/accounts_duplicate1/${quoteId}`;
          console.log('[CASE LINK] Fetching legacy account from:', legacyAccountUrl);
          
          const accountResponse = await fetch(legacyAccountUrl, {
            method: 'GET',
            headers: {
              'Authorization': `Bearer ${token}`,
              'Content-Type': 'application/json',
            },
          });

          console.log('[CASE LINK] Legacy account response status:', accountResponse.status);

          if (accountResponse.ok) {
            const accountData = await safeJsonParse(accountResponse);
            console.log('[CASE LINK] Account data:', accountData);
            
            const accounts = accountData.list || accountData.records || [];
            console.log('[CASE LINK] Found', accounts.length, 'account(s)');
            
            if (accounts.length > 0) {
              const accountId = accounts[0].id;
              const accountName = accounts[0].fields?.['Company Name'] || 'Unknown Account';
              console.log('[CASE LINK] Account ID:', accountId, 'Name:', accountName);
              
              // Create new Case for this version
              const casePayload = {
                fields: {
                  'Title': currentFields['Subject'] || `Quote for ${accountName}`,
                  'Status': 'Open',
                  'Created': new Date().toISOString().split('T')[0]
                }
              };
              
              console.log('[CASE LINK] Creating case with payload:', casePayload);
              
              const caseResponse = await fetch(`${API_BASE_URL}/proxy/cases/records`, {
                method: 'POST',
                headers: {
                  'Authorization': `Bearer ${token}`,
                  'Content-Type': 'application/json',
                },
                body: JSON.stringify(casePayload)
              });

              console.log('[CASE LINK] Case creation status:', caseResponse.status);

              if (caseResponse.ok) {
                const caseResult = await safeJsonParse(caseResponse);
                const newCaseId = caseResult.records ? caseResult.records[0]?.id : caseResult.id;
                console.log('[CASE LINK] Created case ID:', newCaseId);

                // Link account to case
                const linkAccountUrl = `${API_BASE_URL}/proxy/cases/links/accounts_duplicate/${newCaseId}`;
                const linkAccountPayload = [{ id: accountId }];
                
                console.log('[CASE LINK] Linking account - URL:', linkAccountUrl);
                console.log('[CASE LINK] Linking account - Payload:', JSON.stringify(linkAccountPayload));
                
                const linkAccountResp = await fetch(linkAccountUrl, {
                  method: 'POST',
                  headers: {
                    'Authorization': `Bearer ${token}`,
                    'Content-Type': 'application/json',
                  },
                  body: JSON.stringify(linkAccountPayload)
                });
                
                console.log('[CASE LINK] Account link status:', linkAccountResp.status);

                // Link new quote to case
                const linkQuoteUrl = `${API_BASE_URL}/proxy/cases/links/quotes/${newCaseId}`;
                const linkQuotePayload = [{ id: newQuoteId }];
                
                console.log('[CASE LINK] Linking quote - URL:', linkQuoteUrl);
                console.log('[CASE LINK] Linking quote - Payload:', JSON.stringify(linkQuotePayload));
                
                const linkQuoteResp = await fetch(linkQuoteUrl, {
                  method: 'POST',
                  headers: {
                    'Authorization': `Bearer ${token}`,
                    'Content-Type': 'application/json',
                  },
                  body: JSON.stringify(linkQuotePayload)
                });
                
                console.log('[CASE LINK] Quote link status:', linkQuoteResp.status);
                
                if (linkQuoteResp.ok) {
                  console.log('[CASE LINK] ✓ Successfully created case and linked everything');
                } else {
                  const errorText = await linkQuoteResp.text();
                  console.error('[CASE LINK] ✗ Failed to link quote:', errorText);
                }
              } else {
                const errorText = await caseResponse.text();
                console.error('[CASE LINK] ✗ Failed to create case:', errorText);
              }
            } else {
              console.error('[CASE LINK] ✗ No accounts found in legacy link');
            }
          } else {
            const errorText = await accountResponse.text();
            console.error('[CASE LINK] ✗ Failed to fetch legacy account:', errorText);
          }
        }

        // Step 4: Fetch current line items from ProductsForQuotes
        const lineItemsResponse = await fetch(
          `${API_BASE_URL}/proxy/products_for_quotes/records?where=(nc_76_d___Quotes_id,eq,${quoteId})&fields=Quantity,Custom%20Unit%20Price,Discount,nc_76_d__Products_id`,
          {
            method: 'GET',
            headers: {
              'Authorization': `Bearer ${token}`,
              'Content-Type': 'application/json',
            },
          }
        );

        if (!lineItemsResponse.ok) {
          throw new Error('Failed to fetch line items');
        }

        const lineItemsData = await safeJsonParse(lineItemsResponse);
        const lineItems = lineItemsData.records || [];
        
        // Found line items to copy

        // Step 5: Link products to new quote first
        const productIds = lineItems.map((item: any) => item.fields['nc_76_d__Products_id']).filter(Boolean);
        
        if (productIds.length > 0) {
          // Linking products to new quote
          
          await fetch(`${API_BASE_URL}/proxy/quotes/links/products/${newQuoteId}`, {
            method: 'POST',
            headers: {
              'Authorization': `Bearer ${token}`,
              'Content-Type': 'application/json',
            },
            body: JSON.stringify(productIds.map((id: string) => ({ id })))
          });
        }

        // Step 6: Create new ProductsForQuotes records
        for (const item of lineItems) {
          const productId = item.fields['nc_76_d__Products_id'];
          const quantity = item.fields['Quantity'] || 1;
          const customPrice = item.fields['Custom Unit Price'];
          const discount = item.fields['Discount'] || 0;

          if (!productId) continue;

          const lineItemPayload = {
            fields: {
              'Quotes': newQuoteId,
              'Products': productId,
              'Quantity': quantity,
              'Custom Unit Price': customPrice,
              'Discount': discount
            }
          };

          // Creating line item
          const lineItemResponse = await fetch(`${API_BASE_URL}/proxy/products_for_quotes/records`, {
            method: 'POST',
            headers: {
              'Authorization': `Bearer ${token}`,
              'Content-Type': 'application/json',
            },
            body: JSON.stringify(lineItemPayload)
          });

          if (!lineItemResponse.ok) {
            console.error('[VERSION] Failed to create line item for product', productId);
          }
        }

        console.log('✓ New version created. Redirecting...');

        // Success - redirect to new quote
        window.location.href = `/quote-detail?id=${newQuoteId}`;

      } catch (error) {
        console.error('[VERSION] Error creating new version:', error);
        showToast(`Failed to create new version: ${error instanceof Error ? error.message : 'Unknown error'}`, 'error');
        
        // Restore button
        btn.disabled = false;
        btn.innerHTML = originalText;
      }
    }

    /**
     * Increment version number (e.g., "1.2" -> "1.3", "2.9" -> "3.0")
     */
    function incrementVersion(version: string): string {
      const parts = version.split('.');
      if (parts.length === 1) {
        // Single number like "1" -> "2"
        return (parseInt(parts[0]) + 1).toString();
      }
      
      // Decimal version like "1.2" -> "1.3"
      const major = parseInt(parts[0]) || 1;
      const minor = parseInt(parts[1]) || 0;
      
      if (minor >= 9) {
        // Roll over: "1.9" -> "2.0"
        return `${major + 1}.0`;
      } else {
        // Increment minor: "1.2" -> "1.3"
        return `${major}.${minor + 1}`;
      }
    }

    // ── DELETE QUOTE ────────────────────────────────────────────────────────
    document.getElementById('deleteQuoteBtn')?.addEventListener('click', () => {
      document.getElementById('deleteQuoteModal')!.classList.remove('hidden');
    });

    document.getElementById('deleteQuoteCancel')?.addEventListener('click', () => {
      document.getElementById('deleteQuoteModal')!.classList.add('hidden');
    });

    document.getElementById('deleteQuoteConfirm')?.addEventListener('click', async () => {
      const confirmBtn = document.getElementById('deleteQuoteConfirm') as HTMLButtonElement;
      confirmBtn.disabled = true;
      confirmBtn.textContent = 'Deleting...';

      try {
        const response = await fetch(`${API_BASE_URL}/proxy/quotes/records`, {
          method: 'DELETE',
          headers: {
            'Authorization': `Bearer ${token}`,
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ id: parseInt(quoteId) }),
        });

        if (response.status === 401) {
          logout();
          return;
        }

        if (!response.ok) {
          const errorText = await response.text();
          console.error('[DELETE QUOTE] Failed:', errorText);
          showToast('Failed to delete quote. Please try again.', 'error');
          confirmBtn.disabled = false;
          confirmBtn.textContent = 'Delete';
          return;
        }

        window.location.href = '/quotes';
      } catch (error) {
        console.error('[DELETE QUOTE] Error:', error);
        showToast('An error occurred while deleting the quote.', 'error');
        confirmBtn.disabled = false;
        confirmBtn.textContent = 'Delete';
      }
    });

    // Load quote details on page load
    loadQuoteDetails();
  </script>

  <!-- PDF Terms Modal -->
  <div id="pdfTermsModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/40">
    <div class="bg-white rounded-xl shadow-xl w-full max-w-md mx-4 p-6">
      <h3 id="pdfTermsModalTitle" class="text-base font-semibold text-slate-800 mb-1">PDF Terms</h3>
      <p id="pdfTermsModalDesc" class="text-sm text-slate-500 mb-5">Leave blank to keep the fields empty on the PDF.</p>
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">Delivery Terms</label>
          <input
            type="text"
            id="deliveryTermsInput"
            placeholder="e.g. Within 7 working days"
            class="w-full px-3 py-2.5 bg-slate-50 border border-slate-200 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
          />
        </div>
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">Payment Terms</label>
          <input
            type="text"
            id="paymentTermsInput"
            placeholder="e.g. 50% advance, 50% on delivery"
            class="w-full px-3 py-2.5 bg-slate-50 border border-slate-200 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
          />
        </div>
      </div>
      <div class="flex justify-end gap-3 mt-6">
        <button id="pdfTermsCancel" class="px-4 py-2 text-sm text-slate-600 border border-slate-200 rounded-md hover:bg-slate-50 transition-colors">
          Cancel
        </button>
        <button id="pdfTermsConfirm" class="px-4 py-2 text-sm bg-indigo-600 text-white rounded-md hover:bg-indigo-700 transition-colors">
          Generate PDF
        </button>
      </div>
    </div>
  </div>

  <!-- Delete Quote Confirmation Modal -->
  <div id="deleteQuoteModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/40">
    <div class="bg-white rounded-xl shadow-xl w-full max-w-sm mx-4 p-6">
      <div class="flex items-center gap-3 mb-3">
        <div class="flex-shrink-0 w-10 h-10 bg-red-100 rounded-full flex items-center justify-center">
          <svg class="w-5 h-5 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
          </svg>
        </div>
        <h3 class="text-base font-semibold text-slate-800">Delete Quote</h3>
      </div>
      <p class="text-sm text-slate-600 mb-6">Are you sure you want to delete this quote? This action cannot be undone.</p>
      <div class="flex justify-end gap-3">
        <button id="deleteQuoteCancel" class="px-4 py-2 text-sm text-slate-600 border border-slate-200 rounded-md hover:bg-slate-50 transition-colors">Cancel</button>
        <button id="deleteQuoteConfirm" class="px-4 py-2 text-sm bg-red-600 text-white rounded-md hover:bg-red-700 transition-colors">Delete</button>
      </div>
    </div>
  </div>

  <!-- Toast Container -->
  <div id="toastContainer" class="fixed top-4 right-4 z-[9999] flex flex-col gap-2 pointer-events-none"></div>

  <!-- Confirm Dialog -->
  <div id="confirmDialog" class="hidden fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-[9998] flex items-center justify-center p-4">
    <div class="bg-white rounded-xl shadow-2xl w-full max-w-sm p-6">
      <p class="text-slate-800 font-semibold text-sm mb-5" id="confirmMessage"></p>
      <div class="flex gap-3 justify-end">
        <button id="confirmCancelBtn" class="px-4 py-2 bg-white border border-slate-300 text-slate-700 text-sm font-medium rounded-lg hover:bg-slate-50 transition-colors">Cancel</button>
        <button id="confirmOkBtn" class="px-4 py-2 text-white text-sm font-medium rounded-lg transition-colors"></button>
      </div>
    </div>
  </div>
</DashboardLayout>
