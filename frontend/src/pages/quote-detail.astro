---
import AdminLayout from '../layouts/AdminLayout.astro';
---

<AdminLayout title="Quote Details - Grove Systems" currentPage="quotes">
  <!-- Back Button -->
  <div class="mb-6">
    <a href="/quotes" class="inline-flex items-center gap-2 text-sm text-slate-600 hover:text-slate-900 transition-colors">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
      </svg>
      Back to Quotes
    </a>
  </div>

  <!-- Loading State -->
  <div id="loading" class="py-12 text-center">
    <svg class="animate-spin w-8 h-8 text-blue-600 mx-auto mb-3" fill="none" viewBox="0 0 24 24">
      <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
      <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
    </svg>
    <p class="text-sm text-slate-600">Loading quote details...</p>
  </div>

  <!-- Error State -->
  <div id="error" class="hidden mx-auto max-w-2xl p-4 bg-red-50 border border-red-200 rounded-lg">
    <div class="flex items-start gap-3">
      <svg class="w-5 h-5 text-red-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
      </svg>
      <p class="text-sm text-red-800" id="errorText"></p>
    </div>
  </div>

  <!-- Quote Details Content -->
  <div id="quoteContent" class="hidden space-y-5">
    <!-- Header Card -->
    <div class="bg-white rounded-lg shadow-sm border border-slate-200 p-6">
      <div class="flex items-start justify-between mb-6">
        <div class="flex-1">
          <h1 id="quoteSubject" class="text-2xl font-bold text-slate-900 mb-3">Loading...</h1>
          <div class="flex items-center gap-4 text-sm text-slate-600">
            <span id="quoteNumberBadge" class="hidden font-medium text-slate-700"></span>
            <span id="quoteNumberSep" class="hidden text-slate-300">•</span>
            <span id="quoteDate" class="font-medium">Date: --</span>
            <span class="text-slate-300">•</span>
            <div class="relative">
              <button id="versionBadge" class="inline-flex items-center gap-2 px-3 py-1.5 bg-white hover:bg-slate-50 border border-slate-300 text-slate-700 text-sm font-medium rounded-md transition-colors">
                <span id="versionText">Version --</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                </svg>
              </button>
              <div id="versionDropdown" class="hidden absolute top-full left-0 mt-2 w-80 bg-white rounded-lg shadow-xl border border-slate-200 z-50 max-h-96 overflow-y-auto">
                <div class="p-3 border-b border-slate-200 bg-slate-50">
                  <h3 class="text-sm font-semibold text-slate-700">Version History</h3>
                </div>
                <div id="versionList" class="p-2">
                  <div class="flex items-center justify-center py-8">
                    <svg class="animate-spin w-5 h-5 text-blue-600" fill="none" viewBox="0 0 24 24">
                      <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                      <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                    <span class="ml-2 text-sm text-slate-600">Loading versions...</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="flex gap-2 items-center">
          <button id="createNewVersionBtn" class="inline-flex items-center gap-2 px-4 py-2 bg-indigo-600 text-white text-sm font-medium rounded-md hover:bg-indigo-700 transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7v8a2 2 0 002 2h6M8 7V5a2 2 0 012-2h4.586a1 1 0 01.707.293l4.414 4.414a1 1 0 01.293.707V15a2 2 0 01-2 2h-2M8 7H6a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2v-2"></path>
            </svg>
            New Version
          </button>
          <button id="deleteQuoteBtn" class="inline-flex items-center justify-center p-2 bg-white border border-red-300 text-red-600 rounded-md hover:bg-red-50 transition-colors" title="Delete Quote">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
            </svg>
          </button>
          <button id="requestRsDiscountBtn" class="hidden inline-flex items-center gap-1.5 px-3 py-2 bg-violet-600 text-white text-xs font-medium rounded-md hover:bg-violet-700 transition-colors" title="Request ₹ Discount from Admin">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            Request ₹ Discount
          </button>
          <button id="editQuoteBtn" class="inline-flex items-center justify-center p-2 bg-white border border-slate-300 text-slate-700 rounded-md hover:bg-slate-50 transition-colors" title="Edit Products">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
            </svg>
          </button>
          <button id="changeTermsBtn" class="inline-flex items-center justify-center p-2 bg-white border border-slate-300 text-slate-700 rounded-md hover:bg-slate-50 transition-colors" title="Change PDF Terms">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
          </button>
          <button id="sendEmailBtn" class="inline-flex items-center justify-center p-2 bg-white border border-slate-300 text-slate-700 rounded-md hover:bg-slate-50 transition-colors" title="Send to Customer">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
          </button>
          <button id="whatsappShareBtn" class="inline-flex items-center justify-center p-2 bg-white border border-slate-300 text-slate-700 rounded-md hover:bg-green-50 hover:border-green-300 hover:text-green-600 transition-colors" title="Share on WhatsApp">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
          </button>
          <button id="previewPdfBtn" class="inline-flex items-center justify-center p-2 bg-white border border-slate-300 text-slate-700 rounded-md hover:bg-slate-50 transition-colors" title="Preview PDF">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
            </svg>
          </button>
          <button id="downloadPdfBtn" class="inline-flex items-center justify-center p-2 bg-indigo-600 text-white rounded-md hover:bg-indigo-700 transition-colors" title="Download PDF">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
            </svg>
          </button>
          <button id="downloadExcelBtn" class="inline-flex items-center justify-center p-2 bg-emerald-600 text-white rounded-md hover:bg-emerald-700 transition-colors" title="Download Excel">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
          </button>
          <button id="previewSectionedPdfBtn" class="hidden inline-flex items-center justify-center p-2 bg-white border border-slate-300 text-slate-700 rounded-md hover:bg-slate-50 transition-colors" title="Preview room-wise PDF (grouped by floor and room)">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
            </svg>
          </button>
          <button id="downloadSectionedPdfBtn" class="inline-flex items-center justify-center p-2 bg-indigo-600 text-white rounded-md hover:bg-indigo-700 transition-colors" title="Download room-wise PDF (grouped by floor and room)">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 21h18M5 21V7l7-4 7 4v14M9 9h1m4 0h1M9 13h1m4 0h1M9 17h1m4 0h1"></path>
            </svg>
          </button>
        </div>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 pt-4 border-t border-slate-200">
        <div>
          <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">STATUS</p>
          <span id="quoteStatus" class="inline-flex items-center px-3 py-1 rounded-md text-sm font-medium bg-slate-100 text-slate-800">
            Draft
          </span>
        </div>
        <div>
          <p id="quoteTotalLabel" class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">SUB TOTAL</p>
          <p id="quoteTotal" class="text-xl font-bold text-slate-900">₹0</p>
          <!--
            One figure per priced alternative, filled in for room-wise quotes.
            A two-option quote has two prices and the customer buys one of them,
            so showing only the first reads as the quote's price when it isn't.
          -->
          <div id="quoteTotalOptions" class="hidden mt-2 space-y-1"></div>
        </div>
        <div>
          <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">VALID UNTIL</p>
          <p id="quoteValidUntil" class="text-sm font-medium text-slate-700">N/A</p>
        </div>
        <div>
          <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">SHARED VIA</p>
          <div id="shareBadges" class="flex flex-wrap gap-1.5 mt-0.5">
            <span class="text-xs text-slate-400 italic">Not shared</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Approval Banner (shown for pending discount approval) -->
    <div id="approvalBanner" class="hidden"></div>

    <!-- Confirm Modal -->
    <div id="confirmModal" class="fixed inset-0 z-50 hidden items-center justify-center p-4">
      <div class="absolute inset-0 bg-slate-900/50 backdrop-blur-sm" id="confirmModalBackdrop"></div>
      <div class="relative bg-white rounded-2xl shadow-2xl w-full max-w-md overflow-hidden">
        <div class="px-6 py-5 flex items-start gap-4">
          <div id="confirmModalIcon" class="w-11 h-11 rounded-xl flex items-center justify-center shrink-0 mt-0.5"></div>
          <div>
            <h3 id="confirmModalTitle" class="text-base font-bold text-slate-900 mb-1"></h3>
            <p id="confirmModalBody" class="text-sm text-slate-600 leading-relaxed"></p>
          </div>
        </div>
        <div class="px-6 pb-6 flex gap-3 justify-end">
          <button id="confirmModalCancel" class="px-5 py-2.5 text-sm font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-xl transition-colors">Cancel</button>
          <button id="confirmModalConfirm" class="px-5 py-2.5 text-sm font-semibold text-white rounded-xl transition-colors"></button>
        </div>
      </div>
    </div>

    <!-- Account Information Card -->
    <div class="bg-white rounded-lg shadow-sm border border-slate-200 p-6">
      <h2 class="text-base font-semibold text-slate-800 mb-4">Account Information</h2>
      <div id="accountInfo" class="space-y-2">
        <div class="flex items-start gap-3">
          <svg class="w-5 h-5 text-slate-400 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
          </svg>
          <div>
            <p class="text-sm font-semibold text-slate-800" id="accountName">Loading...</p>
            <p class="text-xs text-slate-500" id="accountDetails"></p>
          </div>
        </div>
      </div>
    </div>

    <!-- Edit Mode Panel (shown when editing) -->
    <div id="editModePanel" class="hidden">
      <!-- Sticky Header -->
      <div class="bg-gradient-to-r from-blue-600 to-indigo-600 rounded-2xl shadow-xl mb-6 overflow-hidden">
        <div class="px-8 py-6">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-4">
              <div class="w-12 h-12 bg-white/20 rounded-xl flex items-center justify-center backdrop-blur-sm">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                </svg>
              </div>
              <div>
                <h3 class="text-2xl font-bold text-white mb-1">Edit Quote</h3>
                <p class="text-blue-100 text-sm">Modify products, quantities, pricing, and quote status</p>
              </div>
            </div>
            <div class="flex gap-3">
              <button id="cancelEditBtn" class="inline-flex items-center gap-2 px-5 py-2.5 bg-white/10 backdrop-blur-sm border-2 border-white/30 text-white text-sm font-semibold rounded-xl hover:bg-white/20 transition-all shadow-lg hover:shadow-xl">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
                Cancel
              </button>
              <button id="saveEditBtn" class="inline-flex items-center gap-2 px-6 py-2.5 bg-white text-blue-600 text-sm font-bold rounded-xl hover:bg-blue-50 transition-all shadow-lg hover:shadow-xl">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                Save Changes
              </button>
            </div>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
        <!-- Quote Status Section -->
        <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 hover:shadow-md transition-shadow">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 bg-blue-100 rounded-xl flex items-center justify-center">
              <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
            <div>
              <label class="block text-sm font-bold text-slate-800">Quote Status</label>
              <p class="text-xs text-slate-500">Update the current status</p>
            </div>
          </div>
          <select id="editQuoteStatus" class="w-full px-4 py-3 bg-slate-50 border-2 border-slate-200 rounded-xl text-sm font-medium text-slate-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all hover:border-slate-300">
            <option value="Draft">📝 Draft</option>
            <option value="Sent">📤 Sent</option>
            <option value="Approved">✅ Approved</option>
            <option value="Rejected">❌ Rejected</option>
            <option value="Final">🎯 Final</option>
            <option value="Pending Approval">⏳ Pending Approval</option>
            <option value="Pending Super Admin Approval">🔒 Pending Super Admin Approval</option>
            <option value="Pending Rs Discount">💜 Pending Rs Discount</option>
          </select>
        </div>

        <!-- Add Product Section -->
        <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 hover:shadow-md transition-shadow">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 bg-emerald-100 rounded-xl flex items-center justify-center">
              <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
              </svg>
            </div>
            <div>
              <label class="block text-sm font-bold text-slate-800">Add Product</label>
              <p class="text-xs text-slate-500">Search catalog or add an outsourced product</p>
            </div>
          </div>
          <!--
            Destination picker. A room-wise quote's line items only mean anything
            once they sit under a floor/room (and, when the quote prices
            alternatives, under one option) — so on those quotes the product is
            not added until the user says where it goes. Rendered from JS because
            the floors and rooms come from the quote itself; hidden entirely on
            an ordinary quote, which has nowhere to put a product but the list.
          -->
          <div id="addDestination" class="hidden mb-4 rounded-xl border-2 border-dashed border-emerald-300 bg-emerald-50/50 p-4">
            <p class="text-xs font-bold text-emerald-800 uppercase tracking-wider mb-3">Where should this go?</p>
            <div id="addDestinationFields" class="space-y-3"></div>
          </div>
          <div class="mb-3">
            <button type="button" id="toggleOutsourcedBtn" class="text-xs font-semibold text-emerald-700 hover:text-emerald-800 underline underline-offset-2">
              + Add outsourced product
            </button>
          </div>
          <div id="catalogAddSection" class="flex gap-3">
            <div class="flex-1 relative">
              <div class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                </svg>
              </div>
              <input
                type="text"
                id="newProductSearch"
                placeholder="Search by name or code..."
                autocomplete="off"
                class="w-full pl-10 pr-4 py-3 bg-slate-50 border-2 border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition-all hover:border-slate-300"
              />
              <div id="newProductDropdown" class="hidden absolute z-10 w-full mt-2 bg-white border-2 border-slate-200 rounded-xl shadow-2xl max-h-60 overflow-y-auto">
                <div id="newProductResults" class="py-1"></div>
                <div id="newProductLoading" class="hidden px-4 py-3 text-sm text-slate-500 text-center">
                  <svg class="animate-spin w-4 h-4 inline-block mr-2" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                  </svg>
                  Searching...
                </div>
                <div id="newProductEmpty" class="hidden px-4 py-3 text-sm text-slate-500 text-center">No products found</div>
              </div>
            </div>
            <button id="addProductToQuoteBtn" class="inline-flex items-center gap-2 px-6 py-3 bg-emerald-600 text-white text-sm font-bold rounded-xl hover:bg-emerald-700 transition-all shadow-md hover:shadow-lg disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:shadow-md" disabled>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
              </svg>
              Add
            </button>
          </div>
          <div id="outsourcedAddSection" class="hidden space-y-3">
            <div class="grid grid-cols-2 gap-3">
              <input type="text" id="outsourcedName" placeholder="Product name *" class="px-3 py-2.5 bg-slate-50 border-2 border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500" />
              <input type="text" id="outsourcedBrand" placeholder="Brand" class="px-3 py-2.5 bg-slate-50 border-2 border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500" />
              <input type="text" id="outsourcedModel" placeholder="Model No" class="px-3 py-2.5 bg-slate-50 border-2 border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500" />
              <input type="text" id="outsourcedHsn" placeholder="HSN Code" class="px-3 py-2.5 bg-slate-50 border-2 border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500" />
              <input type="number" id="outsourcedTax" placeholder="Tax %" min="0" step="0.01" class="px-3 py-2.5 bg-slate-50 border-2 border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500" />
              <input type="number" id="outsourcedWarranty" placeholder="Warranty (months)" min="0" class="px-3 py-2.5 bg-slate-50 border-2 border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500" />
              <input type="text" id="outsourcedUom" placeholder="UOM (e.g. pcs, box) *" class="px-3 py-2.5 bg-slate-50 border-2 border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500" />
              <input type="number" id="outsourcedPrice" placeholder="Unit Price *" min="0" step="0.01" class="px-3 py-2.5 bg-slate-50 border-2 border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500" />
              <input type="number" id="outsourcedQty" placeholder="Quantity *" min="1" value="1" class="px-3 py-2.5 bg-slate-50 border-2 border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500" />
            </div>
            <textarea id="outsourcedDescription" placeholder="Description (optional)" rows="2" class="w-full px-3 py-2.5 bg-slate-50 border-2 border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500"></textarea>
            <button id="addOutsourcedProductBtn" class="w-full inline-flex items-center justify-center gap-2 px-6 py-3 bg-emerald-600 text-white text-sm font-bold rounded-xl hover:bg-emerald-700 transition-all shadow-md hover:shadow-lg">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
              </svg>
              Add Outsourced Product
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Products Card -->
    <div class="bg-white rounded-2xl shadow-lg border border-slate-200 overflow-hidden">
      <div class="bg-gradient-to-r from-slate-50 to-slate-100 px-6 py-5 border-b border-slate-200">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 bg-blue-600 rounded-xl flex items-center justify-center">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
            </svg>
          </div>
          <div>
            <h2 class="text-lg font-bold text-slate-800">Products</h2>
            <p class="text-xs text-slate-500">Quote line items with pricing and quantities</p>
          </div>
        </div>
      </div>
      <div id="productsContainer" class="p-6">
        <div class="text-sm text-slate-500">Loading products...</div>
      </div>
    </div>

    <!-- Notes Card (if exists) -->
    <div id="notesCard" class="hidden bg-white rounded-lg shadow-sm border border-slate-200 p-6">
      <h2 class="text-base font-semibold text-slate-800 mb-4">Notes</h2>
      <p id="quoteNotes" class="text-sm text-slate-700 whitespace-pre-wrap"></p>
    </div>
  </div>

  <script>
    import { getToken, logout, safeJsonParse } from '../lib/api';
    import { debounce } from '../utils/debounce';
    import { isAdmin, isSuperAdmin } from '../utils/jwt';

    const API_BASE_URL = import.meta.env.PUBLIC_API_BASE_URL ||
      `${window.location.protocol}//${window.location.hostname}:8082`;

    function showConfirm(message: string, okLabel = 'Confirm', okClass = 'bg-red-600 hover:bg-red-700'): Promise<boolean> {
      return new Promise((resolve) => {
        const dialog = document.getElementById('confirmDialog') as HTMLDivElement;
        const okBtn = document.getElementById('confirmOkBtn') as HTMLButtonElement;
        const cancelBtn = document.getElementById('confirmCancelBtn') as HTMLButtonElement;
        (document.getElementById('confirmMessage') as HTMLElement).textContent = message;
        okBtn.textContent = okLabel;
        okBtn.className = `px-4 py-2 text-white text-sm font-medium rounded-lg transition-colors ${okClass}`;
        dialog.classList.remove('hidden');
        function cleanup(result: boolean) {
          dialog.classList.add('hidden');
          okBtn.removeEventListener('click', onOk);
          cancelBtn.removeEventListener('click', onCancel);
          dialog.removeEventListener('click', onOutside);
          resolve(result);
        }
        const onOk = () => cleanup(true);
        const onCancel = () => cleanup(false);
        const onOutside = (e: MouseEvent) => { if (e.target === dialog) cleanup(false); };
        okBtn.addEventListener('click', onOk);
        cancelBtn.addEventListener('click', onCancel);
        dialog.addEventListener('click', onOutside);
      });
    }

    function showToast(message: string, type: 'success' | 'error' | 'info' = 'info') {
      const container = document.getElementById('toastContainer')!;
      const toast = document.createElement('div');
      const bg = type === 'success' ? 'bg-emerald-500' : type === 'error' ? 'bg-red-500' : 'bg-slate-700';
      const icon = type === 'success'
        ? `<svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>`
        : type === 'error'
        ? `<svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`
        : `<svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`;
      toast.setAttribute('data-toast', '');
      toast.className = `pointer-events-auto flex items-center gap-3 px-4 py-3 rounded-xl text-white text-sm font-semibold shadow-xl max-w-sm ${bg} opacity-0 translate-x-4 transition-all duration-200`;
      toast.innerHTML = `${icon}<span class="flex-1 leading-snug">${message}</span><button class="ml-2 opacity-60 hover:opacity-100 text-base leading-none transition-opacity" onclick="this.closest('[data-toast]').remove()">✕</button>`;
      container.appendChild(toast);
      requestAnimationFrame(() => requestAnimationFrame(() => toast.classList.remove('opacity-0', 'translate-x-4')));
      setTimeout(() => { toast.classList.add('opacity-0', 'translate-x-4'); setTimeout(() => toast.remove(), 200); }, 3500);
    }

    const token = getToken();
    if (!token) { 
      window.location.href = '/login';
    }
    
    // Get quote ID from URL query parameter
    const urlParams = new URLSearchParams(window.location.search);
    const quoteId = urlParams.get('id');

    if (!quoteId) {
      window.location.href = '/quotes';
    }

    const loadingDiv = document.getElementById('loading') as HTMLDivElement;
    const errorDiv = document.getElementById('error') as HTMLDivElement;
    const errorText = document.getElementById('errorText') as HTMLParagraphElement;
    const quoteContent = document.getElementById('quoteContent') as HTMLDivElement;

    // Store quote data for PDF generation
    let currentQuoteData: any = null;

    /**
     * Whether the Section/Option columns could be read for this quote. False
     * means the lookup errored — the columns may not exist in NocoDB yet — and
     * the page must not conclude from that silence that the quote has no rooms.
     */
    let sectionLookupOk = true;

    async function logShare(method: 'email' | 'whatsapp') {
      try {
        const current = currentQuoteFields?.['Shared Via'];
        let shareData: Record<string, string> = {};
        if (current) { try { shareData = JSON.parse(current); } catch {} }
        shareData[method] = new Date().toISOString();
        await fetch(`${API_BASE_URL}/proxy/quotes/records`, {
          method: 'PATCH',
          headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: parseInt(quoteId!), fields: { 'Shared Via': JSON.stringify(shareData), 'Quote Status': 'Sent' } }),
        });
        if (currentQuoteFields) {
          currentQuoteFields['Shared Via'] = JSON.stringify(shareData);
          currentQuoteFields['Quote Status'] = 'Sent';
        }
        updateShareBadges(shareData);
        // Update status badge live
        const statusEl = document.getElementById('quoteStatus');
        if (statusEl) {
          statusEl.textContent = 'Sent';
          statusEl.className = 'inline-flex items-center px-3 py-1 rounded-md text-sm font-medium bg-blue-100 text-blue-800';
        }
      } catch (e) {
        console.warn('[SHARE LOG] Failed to log share:', e);
      }
    }

    function renderApprovalBanner(status: string) {
      const banner = document.getElementById('approvalBanner');
      if (!banner) return;

      const userIsAdmin = isAdmin();
      const userIsSuperAdmin = isSuperAdmin();

      if (status === 'Pending Approval' && userIsAdmin) {
        banner.innerHTML = `
          <div class="bg-amber-50 border border-amber-300 rounded-lg px-5 py-4 flex items-center justify-between gap-4">
            <div class="flex items-center gap-3">
              <svg class="w-5 h-5 text-amber-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M12 3a9 9 0 100 18A9 9 0 0012 3z"/></svg>
              <div>
                <p class="text-sm font-semibold text-amber-800">Discount Approval Required</p>
                <p class="text-xs text-amber-600">A product in this quote has a discount between 5–10%. Your approval is needed.</p>
              </div>
            </div>
            <div class="flex gap-2 shrink-0">
              <button id="approveQuoteBtn" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold rounded-lg transition-colors">Approve</button>
              <button id="rejectQuoteBtn" class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white text-sm font-semibold rounded-lg transition-colors">Reject</button>
            </div>
          </div>`;
        banner.classList.remove('hidden');
        setupApprovalButtons();
      } else if (status === 'Pending Super Admin Approval' && userIsSuperAdmin) {
        banner.innerHTML = `
          <div class="bg-orange-50 border border-orange-300 rounded-lg px-5 py-4 flex items-center justify-between gap-4">
            <div class="flex items-center gap-3">
              <svg class="w-5 h-5 text-orange-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M12 3a9 9 0 100 18A9 9 0 0012 3z"/></svg>
              <div>
                <p class="text-sm font-semibold text-orange-800">Super Admin Approval Required</p>
                <p class="text-xs text-orange-600">A product in this quote has a discount above 10%. Super Admin approval is needed.</p>
              </div>
            </div>
            <div class="flex gap-2 shrink-0">
              <button id="approveQuoteBtn" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold rounded-lg transition-colors">Approve</button>
              <button id="rejectQuoteBtn" class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white text-sm font-semibold rounded-lg transition-colors">Reject</button>
            </div>
          </div>`;
        banner.classList.remove('hidden');
        setupApprovalButtons();
      } else if ((status === 'Pending Approval' || status === 'Pending Super Admin Approval') && !userIsAdmin) {
        banner.innerHTML = `
          <div class="bg-amber-50 border border-amber-300 rounded-lg px-5 py-4 flex items-center gap-3">
            <svg class="w-5 h-5 text-amber-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M12 3a9 9 0 100 18A9 9 0 0012 3z"/></svg>
            <p class="text-sm text-amber-800">This quote is pending approval due to the discount applied. You will be notified once it is reviewed.</p>
          </div>`;
        banner.classList.remove('hidden');
      } else if (status === 'Pending Rs Discount' && userIsAdmin) {
        banner.innerHTML = `
          <div class="bg-violet-50 border border-violet-300 rounded-lg px-5 py-4 flex items-center justify-between gap-4">
            <div class="flex items-center gap-3">
              <svg class="w-5 h-5 text-violet-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              <div>
                <p class="text-sm font-semibold text-violet-800">Rupee Discount Requested</p>
                <p class="text-xs text-violet-600">A user has requested a rupee discount for this quote. Edit the line items to apply it, then change the status to Draft.</p>
              </div>
            </div>
            <button id="openEditForRsBtn" class="shrink-0 px-4 py-2 text-sm font-semibold text-white bg-violet-600 hover:bg-violet-700 rounded-lg transition-colors">Edit Quote</button>
          </div>`;
        banner.classList.remove('hidden');
        setupApprovalButtons();
      } else if (status === 'Pending Rs Discount' && !userIsAdmin) {
        banner.innerHTML = `
          <div class="bg-violet-50 border border-violet-300 rounded-lg px-5 py-4 flex items-center gap-3">
            <svg class="w-5 h-5 text-violet-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <p class="text-sm text-violet-800">This quote is pending a rupee discount from an admin. You will be notified once it is applied.</p>
          </div>`;
        banner.classList.remove('hidden');
      } else {
        banner.classList.add('hidden');
      }
    }

    function showConfirmModal(opts: { title: string; body: string; confirmLabel: string; confirmClass: string; iconBg: string; iconSvg: string }): Promise<boolean> {
      return new Promise((resolve) => {
        const modal = document.getElementById('confirmModal')!;
        const icon = document.getElementById('confirmModalIcon')!;
        const title = document.getElementById('confirmModalTitle')!;
        const body = document.getElementById('confirmModalBody')!;
        const confirmBtn = document.getElementById('confirmModalConfirm')!;
        const cancelBtn = document.getElementById('confirmModalCancel')!;
        const backdrop = document.getElementById('confirmModalBackdrop')!;

        icon.className = `w-11 h-11 rounded-xl flex items-center justify-center shrink-0 mt-0.5 ${opts.iconBg}`;
        icon.innerHTML = opts.iconSvg;
        title.textContent = opts.title;
        body.textContent = opts.body;
        confirmBtn.className = `px-5 py-2.5 text-sm font-semibold text-white rounded-xl transition-colors ${opts.confirmClass}`;
        confirmBtn.textContent = opts.confirmLabel;

        modal.classList.remove('hidden');
        modal.classList.add('flex');

        const close = (result: boolean) => {
          modal.classList.add('hidden');
          modal.classList.remove('flex');
          confirmBtn.removeEventListener('click', onConfirm);
          cancelBtn.removeEventListener('click', onCancel);
          backdrop.removeEventListener('click', onCancel);
          resolve(result);
        };
        const onConfirm = () => close(true);
        const onCancel = () => close(false);
        confirmBtn.addEventListener('click', onConfirm);
        cancelBtn.addEventListener('click', onCancel);
        backdrop.addEventListener('click', onCancel);
      });
    }

    function setupApprovalButtons() {
      const quoteId = new URLSearchParams(window.location.search).get('id');
      document.getElementById('approveQuoteBtn')?.addEventListener('click', async () => {
        const confirmed = await showConfirmModal({
          title: 'Approve this quote?',
          body: 'The quote will move to Draft status and can be processed normally.',
          confirmLabel: 'Approve',
          confirmClass: 'bg-emerald-600 hover:bg-emerald-700',
          iconBg: 'bg-emerald-100',
          iconSvg: `<svg class="w-6 h-6 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>`,
        });
        if (!confirmed) return;
        await updateApprovalStatus(quoteId!, 'Draft');
      });
      document.getElementById('rejectQuoteBtn')?.addEventListener('click', async () => {
        const confirmed = await showConfirmModal({
          title: 'Reject this quote?',
          body: 'The quote will be marked as Rejected. This action cannot be undone.',
          confirmLabel: 'Reject',
          confirmClass: 'bg-red-600 hover:bg-red-700',
          iconBg: 'bg-red-100',
          iconSvg: `<svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>`,
        });
        if (!confirmed) return;
        await updateApprovalStatus(quoteId!, 'Rejected');
      });
      document.getElementById('openEditForRsBtn')?.addEventListener('click', () => {
        toggleEditMode(true);
        // Pre-set status to Draft so saving automatically resolves the pending state
        const editQuoteStatus = document.getElementById('editQuoteStatus') as HTMLSelectElement;
        if (editQuoteStatus) editQuoteStatus.value = 'Draft';
      });
    }

    async function updateApprovalStatus(quoteId: string, newStatus: string) {
      const token = getToken();
      try {
        const response = await fetch(`${API_BASE_URL}/proxy/quotes/records`, {
          method: 'PATCH',
          headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: parseInt(quoteId), fields: { 'Quote Status': newStatus } }),
        });
        if (!response.ok) throw new Error('Failed to update status');
        const statusEl = document.getElementById('quoteStatus') as HTMLSpanElement;
        if (statusEl) {
          statusEl.textContent = newStatus;
          let cls = 'bg-slate-100 text-slate-800';
          if (newStatus === 'Rejected') cls = 'bg-red-100 text-red-800';
          statusEl.className = `inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ${cls}`;
        }
        originalQuoteStatus = newStatus;
        renderApprovalBanner(newStatus);
      } catch (e) {
        await showConfirmModal({
          title: 'Something went wrong',
          body: 'Failed to update the quote status. Please try again.',
          confirmLabel: 'OK',
          confirmClass: 'bg-slate-700 hover:bg-slate-800',
          iconBg: 'bg-red-100',
          iconSvg: `<svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M12 3a9 9 0 100 18A9 9 0 0012 3z"/></svg>`,
        });
      }
    }

    function updateShareBadges(shareData: Record<string, string>) {
      const container = document.getElementById('shareBadges');
      if (!container) return;
      const fmt = (iso: string) => new Date(iso).toLocaleDateString('en-IN', { day: 'numeric', month: 'short' });
      const parts: string[] = [];
      if (shareData.email) {
        parts.push(`<span title="Last emailed ${fmt(shareData.email)}" class="inline-flex items-center gap-1 px-2 py-0.5 bg-blue-50 text-blue-700 border border-blue-200 rounded-full text-xs font-medium">
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          ${fmt(shareData.email)}
        </span>`);
      }
      if (shareData.whatsapp) {
        parts.push(`<span title="Last shared on WhatsApp ${fmt(shareData.whatsapp)}" class="inline-flex items-center gap-1 px-2 py-0.5 bg-green-50 text-green-700 border border-green-200 rounded-full text-xs font-medium">
          <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          ${fmt(shareData.whatsapp)}
        </span>`);
      }
      container.innerHTML = parts.length ? parts.join('') : '<span class="text-xs text-slate-400 italic">Not shared</span>';
    }
    
    // Edit mode state
    let isEditMode = false;
    let currentProducts: any[] = [];
    let lineItems: any[] = []; // ProductsForQuotes junction records
    let selectedNewProduct: { id: string; name: string; price: string } | null = null;
    let originalQuoteStatus = '';
    let currentQuoteFields: any = {};
    
    // Version history state
    let versionChain: any[] = [];
    let versionChainLoaded = false;

    /**
     * Fetch quote details - same method as PDF download
     * Fetches quote, account, and products in parallel
     */
    async function loadQuoteDetails() {
      try {
        // Fetch quote record to get basic details
        const quoteResponse = await fetch(`${API_BASE_URL}/proxy/quotes/records/${quoteId}`, {
          method: 'GET',
          headers: {
            'Authorization': `Bearer ${token}`,
            'Content-Type': 'application/json',
          },
        });

        if (quoteResponse.status === 401) {
          logout();
          return;
        }

        if (!quoteResponse.ok) {
          throw new Error('Failed to fetch quote details');
        }

        const quoteData = await safeJsonParse(quoteResponse);
        const fields = quoteData.fields || {};

        let accountName = 'N/A';
        let accountData = null;
        let caseData = null;
        const caseId = fields['nc_6n5b___Cases_id'];

        console.log('[ACCOUNT FETCH] Quote caseId:', caseId);

        // NEW: Fetch account via Case (if caseId exists)
        if (caseId) {
          console.log('[ACCOUNT FETCH] Using Cases flow');
          console.log('[ACCOUNT FETCH] Fetching case record to get linked account');
          
          // Fetch case record which includes the linked account data
          const caseUrl = `${API_BASE_URL}/proxy/cases/records/${caseId}?fields=Title,Status,Accounts duplicate`;
          console.log('[ACCOUNT FETCH] Case URL:', caseUrl);
          
          const caseResponse = await fetch(caseUrl, {
            method: 'GET',
            headers: {
              'Authorization': `Bearer ${token}`,
              'Content-Type': 'application/json',
            },
          });

          console.log('[ACCOUNT FETCH] Case response status:', caseResponse.status);

          if (caseResponse.ok) {
            const caseResult = await safeJsonParse(caseResponse);
            console.log('[ACCOUNT FETCH] Case data:', caseResult);
            
            caseData = caseResult.fields || {};
            const accountsField = caseData['Accounts duplicate'];
            
            console.log('[ACCOUNT FETCH] Accounts duplicate field:', accountsField);
            
            if (accountsField) {
              // The account data is nested in the Accounts duplicate field
              const accountId = accountsField.id;
              const accountFields = accountsField.fields || {};
              
              accountName = accountFields['Account Name'] || 'N/A';
              console.log('[ACCOUNT FETCH] ✓ Account found via case:', accountName);
              console.log('[ACCOUNT FETCH] Account ID:', accountId);
              
              // Now fetch full account details if needed
              if (accountId) {
                const fullAccountUrl = `${API_BASE_URL}/proxy/accounts_duplicate/records/${accountId}?fields=Account Name,Company Name,Phone Number,Billing Street,Billing City,Billing State,Billing Code,Billing Country`;
                console.log('[ACCOUNT FETCH] Fetching full account details:', fullAccountUrl);
                
                const fullAccountResponse = await fetch(fullAccountUrl, {
                  method: 'GET',
                  headers: {
                    'Authorization': `Bearer ${token}`,
                    'Content-Type': 'application/json',
                  },
                });
                
                if (fullAccountResponse.ok) {
                  const fullAccountResult = await safeJsonParse(fullAccountResponse);
                  accountData = fullAccountResult.fields || {};
                  // Update accountName from full data — nested link responses only return the
                  // primary/title field, which may differ between NocoDB instances
                  accountName = accountData['Account Name'] || accountData['Company Name'] || accountName;
                  console.log('[ACCOUNT FETCH] ✓ Full account data fetched:', accountData);
                } else {
                  console.warn('[ACCOUNT FETCH] Could not fetch full account details, using basic data');
                  accountData = accountFields;
                  accountName = accountFields['Account Name'] || accountFields['Company Name'] || accountName;
                }
              }
            } else {
              console.warn('[ACCOUNT FETCH] ❌ No account linked to case');
            }
          } else {
            const errorText = await caseResponse.text();
            console.error('[ACCOUNT FETCH] ❌ Failed to fetch case');
            console.error('[ACCOUNT FETCH] Error response:', errorText);
          }
        } else {
          // LEGACY: Direct account fetch for old quotes
          console.log('[ACCOUNT FETCH] Using LEGACY direct account link');
          
          const accountResponse = await fetch(
            `${API_BASE_URL}/proxy/quotes/links/accounts_duplicate1/${quoteId}?fields=Company Name,Phone Number,Billing Street,Billing City`,
            {
              method: 'GET',
              headers: {
                'Authorization': `Bearer ${token}`,
                'Content-Type': 'application/json',
              },
            }
          );

          if (accountResponse.ok) {
            const accountResult = await safeJsonParse(accountResponse);
            const accounts = accountResult.list || accountResult.records || [];
            
            if (accounts.length > 0) {
              accountData = accounts[0].fields;
              accountName = accountData['Company Name'] || 'N/A';
              console.log('[ACCOUNT FETCH] ✓ Account found (legacy):', accountName);
            } else {
              console.warn('[ACCOUNT FETCH] No accounts in legacy link');
            }
          } else {
            console.error('[ACCOUNT FETCH] Legacy account fetch failed');
          }
        }

        // Step 1: Fetch catalog products via links endpoint (WITHOUT Unit Price)
        console.log('[QUOTE DETAIL] Step 1: Fetching catalog products from links endpoint...');
        const catalogResponse = await fetch(
          `${API_BASE_URL}/proxy/quotes/links/products/${quoteId}?fields=Id,Product Name,Brand,HSN/SAC Code,Model No,Tax,Description,Unit of Measurement UOM,warranty`,
          {
            method: 'GET',
            headers: {
              'Authorization': `Bearer ${token}`,
              'Content-Type': 'application/json',
            },
          }
        );

        let products: Array<{ name: string; price?: number }> = [];
        let productRecords: any[] = [];
        
        if (!catalogResponse.ok) {
          console.error('[QUOTE DETAIL] Failed to fetch catalog products');
          throw new Error('Failed to fetch catalog products');
        }

        const catalogData = await safeJsonParse(catalogResponse);
        const catalogProducts = catalogData.list || catalogData.records || [];
        console.log('[QUOTE DETAIL] Catalog products fetched:', catalogProducts.length);
        console.log('[QUOTE DETAIL] Sample catalog product:', catalogProducts[0]);

        // Step 2: Fetch junction table data for custom prices and quantities
        console.log('[QUOTE DETAIL] Step 2: Fetching custom prices from junction table...');
        const junctionResponse = await fetch(
          `${API_BASE_URL}/proxy/products_for_quotes/records?where=(nc_76_d___Quotes_id,eq,${quoteId})&fields=Id,Quantity,Custom%20Unit%20Price,Discount,Discount%20Rs,nc_76_d__Products_id,Is%20Outsourced,Custom%20Product%20Name,Custom%20HSN,Custom%20Tax,Custom%20Description,Custom%20Brand,Custom%20Model%20No,Custom%20Warranty,Custom%20UOM`,
          {
            method: 'GET',
            headers: {
              'Authorization': `Bearer ${token}`,
              'Content-Type': 'application/json',
            },
          }
        );

        let junctionRecords: any[] = [];
        if (junctionResponse.ok) {
          const junctionData = await safeJsonParse(junctionResponse);
          junctionRecords = junctionData.records || [];
          console.log('[QUOTE DETAIL] Junction records fetched:', junctionRecords.length);
          console.log('[QUOTE DETAIL] Sample junction record:', junctionRecords[0]);
        } else {
          console.warn('[QUOTE DETAIL] Failed to fetch junction records - products will show without custom pricing');
        }

        // Section ("1st Floor > Meeting Room 4 PAX") drives the room-wise PDF.
        // Fetched on its own rather than added to the query above on purpose: if
        // the field hasn't been created in NocoDB yet that request 422s, and we
        // want an ungrouped PDF, not a broken quote page.
        const sectionById = new Map<number, string>();
        const optionById = new Map<number, string>();
        sectionLookupOk = true;
        try {
          const sectionResponse = await fetch(
            `${API_BASE_URL}/proxy/products_for_quotes/records?where=(nc_76_d___Quotes_id,eq,${quoteId})&fields=Id,Section,Option`,
            {
              method: 'GET',
              headers: {
                'Authorization': `Bearer ${token}`,
                'Content-Type': 'application/json',
              },
            }
          );
          if (sectionResponse.ok) {
            const sectionData = await safeJsonParse(sectionResponse);
            (sectionData.records || []).forEach((r: any) => {
              const value = r.fields?.['Section'];
              if (value) sectionById.set(r.id, String(value));
              const option = r.fields?.['Option'];
              if (option) optionById.set(r.id, String(option));
            });
            console.log('[QUOTE DETAIL] Sections fetched:', sectionById.size, 'options:', optionById.size);
          } else {
            sectionLookupOk = false;
            console.warn(
              '[QUOTE DETAIL] Could not read Section/Option (HTTP ' + sectionResponse.status + ') - ' +
              'the Section and Option columns are probably missing from ProductsForQuotes in NocoDB. ' +
              'Both PDF layouts will be offered and the room-wise one will print ungrouped.',
              await sectionResponse.text(),
            );
          }
        } catch (error) {
          sectionLookupOk = false;
          console.warn('[QUOTE DETAIL] Section lookup failed:', error);
        }

        // Step 3: Merge catalog products with junction data. Junction records are the
        // source of truth for line items (some may have no catalog link — outsourced products).
        console.log('[QUOTE DETAIL] Step 3: Merging catalog and junction data...');
        const catalogMap = new Map<number, any>(catalogProducts.map((cp: any) => [cp.id, cp]));
        const matchedProductIds = new Set<number>();

        productRecords = junctionRecords.map((jr: any) => {
          const productId = jr.fields['nc_76_d__Products_id'] ?? null;
          if (productId) matchedProductIds.add(productId);
          const isOutsourced = !!jr.fields['Is Outsourced'] || !productId;
          const discount = Number(jr.fields['Discount']) || 0;
          const discountRs = jr.fields['Discount Rs'] != null ? Number(jr.fields['Discount Rs']) : null;

          const common = {
            junctionId: jr.id,
            productId,
            section: sectionById.get(jr.id) || '',
            option: optionById.get(jr.id) || '',
            quantity: jr.fields['Quantity'] || 1,
            customUnitPrice: jr.fields['Custom Unit Price'],
            discount,
            discountRs,
            catalogUnitPrice: null,
            isOutsourced,
          };

          if (isOutsourced) {
            return {
              ...common,
              productName: jr.fields['Custom Product Name'] || 'Outsourced Product',
              brand: jr.fields['Custom Brand'] || '',
              hsnCode: jr.fields['Custom HSN'] || '',
              model: '',
              productCode: jr.fields['Custom Model No'] || '',
              tax: jr.fields['Custom Tax'] || 0,
              description: jr.fields['Custom Description'] || '',
              uom: jr.fields['Custom UOM'] || '',
              warranty: jr.fields['Custom Warranty'] ?? null,
            };
          }

          const catalogProduct = catalogMap.get(productId);
          return {
            ...common,
            productName: catalogProduct?.fields?.['Product Name'] || 'Unnamed Product',
            brand: catalogProduct?.fields?.['Brand'],
            hsnCode: catalogProduct?.fields?.['HSN/SAC Code'],
            model: '',
            productCode: catalogProduct?.fields?.['Model No'],
            tax: catalogProduct?.fields?.['Tax'],
            description: catalogProduct?.fields?.['Description'],
            uom: catalogProduct?.fields?.['Unit of Measurement UOM'] || '',
            warranty: catalogProduct?.fields?.['warranty'] ?? null
          };
        });

        // Legacy fallback: catalog products linked via the links table but missing a junction row
        catalogProducts.forEach((catalogProduct: any) => {
          if (matchedProductIds.has(catalogProduct.id)) return;
          console.warn(`[QUOTE DETAIL] No junction record found for product ${catalogProduct.id} - using defaults`);
          productRecords.push({
            junctionId: null,
            productId: catalogProduct.id,
            section: '',
            option: '',
            quantity: 1,
            customUnitPrice: null,
            discount: 0,
            discountRs: null,
            catalogUnitPrice: null,
            isOutsourced: false,
            productName: catalogProduct.fields['Product Name'],
            brand: catalogProduct.fields['Brand'],
            hsnCode: catalogProduct.fields['HSN/SAC Code'],
            model: '',
            productCode: catalogProduct.fields['Model No'],
            tax: catalogProduct.fields['Tax'],
            description: catalogProduct.fields['Description'],
            uom: catalogProduct.fields['Unit of Measurement UOM'] || '',
            warranty: catalogProduct.fields['warranty'] ?? null
          });
        });

        console.log('[QUOTE DETAIL] Merged product records:', productRecords.length);
        
        // Map for PDF generation compatibility
        products = productRecords.map((record: any) => ({
          name: record.productName || 'Unnamed Product',
          brand: record.brand,
          price: record.customUnitPrice || 0,
          quantity: record.quantity || 1,
          discount: record.discount || 0,
          discountRs: record.discountRs ?? null,
          model: record.model,
          productCode: record.productCode,
          tax: record.tax,
          hsnCode: record.hsnCode,
          description: record.description,
          uom: record.uom || '',
          warranty: record.warranty ?? null,
          // Ignored by the standard PDF, used by the room-wise one to group rows.
          // `model` is already set above; the sectioned generator falls back to
          // productCode when it's blank, which is the usual case here.
          section: record.section || '',
          // Which alternative this line belongs to. Ignored everywhere except
          // the room-wise PDF, which prints one option per page.
          option: record.option || '',
          make: record.brand
        }));

        // Store for PDF generation (same structure as download function)
        currentQuoteData = {
          id: parseInt(quoteId || '0'),
          subject: fields['Subject'] || `Quote #${quoteId || 'Unknown'}`,
          date: fields['Quote Date'] || new Date().toISOString().split('T')[0],
          validUntil: fields['Valid Until'] || '',
          version: fields['Quote Version'] || '1.0',
          total: fields['Total Amount'] || 0,
          logo: fields['Company'] === 'Grove Systems' ? 'grove' : 'greenocare',
          quoteNumber: fields['Quote Number'] || '',
          endUser: fields['End User'] || '',
          endUserLocation: fields['End User Location'] || '',
          // Option names in print order. Stored as JSON text; a quote written
          // before options existed simply has none, and prints as it always did.
          options: parseQuoteOptions(fields['Options']),
          account: {
            name: accountName,
            street: accountData?.['Billing Street'] || '',
            city: accountData?.['Billing City'] || '',
            state: accountData?.['Billing State'] || '',
            pinCode: accountData?.['Billing Code'] || '',
            country: accountData?.['Billing Country'] || '',
          },
          products: products
        };

        // Display quote details in UI
        displayQuoteDetails(fields, accountData, productRecords);

        loadingDiv.classList.add('hidden');
        quoteContent.classList.remove('hidden');
      } catch (error) {
        console.error('Error loading quote details:', error);
        loadingDiv.classList.add('hidden');
        errorText.textContent = error instanceof Error ? error.message : 'Failed to load quote details';
        errorDiv.classList.remove('hidden');
      }
    }

    function displayQuoteDetails(fields: any, accountData: any, products: any[]) {
      // Store current quote fields
      currentQuoteFields = fields;
      try {
        updateShareBadges(fields['Shared Via'] ? JSON.parse(fields['Shared Via']) : {});
      } catch { updateShareBadges({}); }
      
      // Header
      (document.getElementById('quoteSubject') as HTMLHeadingElement).textContent = fields['Subject'] || 'Untitled Quote';
      const quoteNumberBadge = document.getElementById('quoteNumberBadge') as HTMLSpanElement;
      const quoteNumberSep = document.getElementById('quoteNumberSep') as HTMLSpanElement;
      if (fields['Quote Number']) {
        quoteNumberBadge.textContent = fields['Quote Number'];
        quoteNumberBadge.classList.remove('hidden');
        quoteNumberSep.classList.remove('hidden');
      } else {
        quoteNumberBadge.classList.add('hidden');
        quoteNumberSep.classList.add('hidden');
      }
      (document.getElementById('quoteDate') as HTMLSpanElement).textContent = `Date: ${fields['Quote Date'] || 'N/A'}`;
      (document.getElementById('versionText') as HTMLSpanElement).textContent = `Version ${fields['Quote Version'] || '1.0'}`;
      
      // Style version badge as green for current version
      const versionBadge = document.getElementById('versionBadge') as HTMLButtonElement;
      if (versionBadge) {
        versionBadge.className = 'inline-flex items-center gap-2 px-4 py-2 bg-emerald-50 hover:bg-emerald-100 border border-emerald-300 text-emerald-700 text-base font-semibold rounded-full transition-colors shadow-sm';
      }

      // Status
      const status = fields['Quote Status'] || 'Draft';
      originalQuoteStatus = status;
      const statusEl = document.getElementById('quoteStatus') as HTMLSpanElement;
      statusEl.textContent = status;
      
      let statusClasses = 'bg-slate-100 text-slate-800';
      if (status === 'Sent') statusClasses = 'bg-blue-100 text-blue-800';
      if (status === 'Accepted' || status === 'Approved') statusClasses = 'bg-emerald-100 text-emerald-800';
      if (status === 'Rejected') statusClasses = 'bg-red-100 text-red-800';
      if (status === 'Final') statusClasses = 'bg-purple-100 text-purple-800';
      if (status === 'Pending Approval') statusClasses = 'bg-amber-100 text-amber-800';
      if (status === 'Pending Super Admin Approval') statusClasses = 'bg-orange-100 text-orange-800';
      if (status === 'Pending Rs Discount') statusClasses = 'bg-violet-100 text-violet-800';
      statusEl.className = `inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ${statusClasses}`;

      // Show/hide approval banner
      renderApprovalBanner(status);

      // Total
      const total = fields['Total Amount'] || 0;
      (document.getElementById('quoteTotal') as HTMLParagraphElement).textContent = 
        `₹${Number(total).toLocaleString('en-IN', { minimumFractionDigits: 0, maximumFractionDigits: 0 })}`;

      // Valid Until
      (document.getElementById('quoteValidUntil') as HTMLParagraphElement).textContent = fields['Valid Until'] || 'N/A';

      // Account
      const accountName = accountData?.['Company Name'] || 'No account linked';
      (document.getElementById('accountName') as HTMLParagraphElement).textContent = accountName;
      
      const accountDetails: string[] = [];
      if (accountData?.['Phone Number']) accountDetails.push(accountData['Phone Number']);
      if (accountData?.['Billing City']) accountDetails.push(accountData['Billing City']);
      
      const accountDetailsEl = document.getElementById('accountDetails') as HTMLParagraphElement;
      if (accountDetails.length > 0) {
        accountDetailsEl.textContent = accountDetails.join(' • ');
      } else {
        accountDetailsEl.textContent = '';
      }

      // Products
      currentProducts = products;
      renderProducts();

      // Notes
      if (fields['Notes']) {
        const notesCard = document.getElementById('notesCard') as HTMLDivElement;
        const notesText = document.getElementById('quoteNotes') as HTMLParagraphElement;
        notesText.textContent = fields['Notes'];
        notesCard.classList.remove('hidden');
      }
    }

    /**
     * Generate PDF - reuses the same data already fetched
     */
    async function generatePDF(preview: boolean = false, deliveryTerms: string = '', paymentTerms: string = '', extraTerms: string = '') {
      console.log('=== PDF GENERATION START ===');
      console.log('Preview mode:', preview);
      
      if (!currentQuoteData) {
        console.error('ERROR: Quote data not loaded');
        showToast('Quote data not loaded', 'error');
        return;
      }

      console.log('Quote data:', currentQuoteData);

      try {
        const requestBody = {
          ...currentQuoteData,
          deliveryTerms,
          paymentTerms,
          extraTerms,
        };
        console.log('Request body:', requestBody);

        console.log('Sending POST request to /api/quotes/pdf...');
        const response = await fetch('/api/quotes/pdf', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(requestBody)
        });

        console.log('Response status:', response.status, response.statusText);
        console.log('Response headers:', Object.fromEntries(response.headers.entries()));

        if (!response.ok) {
          const contentType = response.headers.get('content-type');
          let errorDetails = `Status: ${response.status} ${response.statusText}`;
          
          if (contentType?.includes('application/json')) {
            const errorData = await response.json();
            console.error('ERROR Response (JSON):', errorData);
            errorDetails += `\nDetails: ${JSON.stringify(errorData, null, 2)}`;
          } else {
            const errorText = await response.text();
            console.error('ERROR Response (Text):', errorText);
            errorDetails += `\nResponse: ${errorText}`;
          }
          
          console.error('=== PDF GENERATION FAILED ===');
          console.error(errorDetails);
          showToast('Failed to generate PDF: ' + errorDetails, 'error');
          throw new Error(errorDetails);
        }

        console.log('Response OK, creating blob...');

        const blob = await response.blob();
        console.log('Blob created, size:', blob.size, 'bytes, type:', blob.type);
        
        const url = window.URL.createObjectURL(blob);
        console.log('Object URL created:', url);

        if (preview) {
          window.open(url, '_blank');
          setTimeout(() => window.URL.revokeObjectURL(url), 10000);
        } else {
          const a = document.createElement('a');
          a.href = url;
          a.download = `quote-${quoteId}.pdf`;
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
          // Delay revocation so Chrome can read the blob after the Save As dialog
          setTimeout(() => window.URL.revokeObjectURL(url), 60000);
        }
      } catch (error) {
        console.error('Failed to generate PDF:', error);
        showToast('Failed to generate PDF. Please try again.', 'error');
      }
    }

    // ---------------------------------------------------------- room-wise ---
    // A room-wise quote carries its structure on the line items: `Section`
    // ("1st Floor > Meeting Room 4 PAX") and `Option` ("Wired Solution"). The
    // PDF groups by option → floor → room; the page has to read the same way or
    // it disagrees with the document the customer is holding. Everything below
    // deliberately mirrors pdf-generator-sectioned.ts rule for rule.

    /** Which option tab is on screen. Null on a quote with no options. */
    let activeOptionKey: string | null = null;

    /** Banner for lines nobody gave a floor or room. */
    const UNGROUPED_LABEL = 'Other Items';

    /** Split "1st Floor > Meeting Room 4 PAX"; any tail past the first ">" is the room. */
    function splitSection(section: any): { floor: string | null; room: string | null } {
      const parts = String(section || '').split('>').map(s => s.trim()).filter(Boolean);
      if (!parts.length) return { floor: null, room: null };
      return { floor: parts[0], room: parts.slice(1).join(' - ') || null };
    }

    /**
     * Split line items into alternatives. The quote's own declared order wins —
     * an option set up but not yet priced owns no rows to be inferred from — and
     * a line carrying an option the quote never declared is still shown rather
     * than silently dropped. Lines with no option belong to the first option,
     * the same choice the PDF makes for shared cabling and installation.
     */
    function buildOptionGroups(): Array<{ option: string | null; products: any[] }> {
      const declared: string[] = ((currentQuoteData?.options || []) as any[])
        .map((o: any) => String(o).trim())
        .filter(Boolean);
      const names: string[] = [];
      const push = (n: string) => { if (n && !names.includes(n)) names.push(n); };
      declared.forEach(push);
      currentProducts.forEach((p: any) => push(String(p.option || '').trim()));

      if (!names.length) return [{ option: null, products: currentProducts }];

      const groups = names.map(option => ({ option, products: [] as any[] }));
      const orphans: any[] = [];
      currentProducts.forEach((p: any) => {
        const label = String(p.option || '').trim();
        const group = label ? groups.find(g => g.option === label) : undefined;
        if (group) group.products.push(p);
        else orphans.push(p);
      });
      if (orphans.length) groups[0].products.push(...orphans);

      return groups.filter(g => g.products.length > 0 || declared.includes(g.option as string));
    }

    /**
     * Floor → room buckets in the order lines were added. Unsectioned lines are
     * pooled into a single trailing group: left in place, a later row re-joins
     * the floor an earlier row opened and the loose row reads as part of the
     * last room instead of belonging to nothing.
     */
    function groupByFloorRoom(items: any[]) {
      const floors: Array<{ floor: string | null; rooms: Array<{ room: string | null; items: any[] }> }> = [];
      for (const item of items) {
        const { floor, room } = splitSection(item.section);
        let floorGroup = floors.find(f => f.floor === floor);
        if (!floorGroup) { floorGroup = { floor, rooms: [] }; floors.push(floorGroup); }
        let roomGroup = floorGroup.rooms.find(r => r.room === room);
        if (!roomGroup) { roomGroup = { room, items: [] }; floorGroup.rooms.push(roomGroup); }
        roomGroup.items.push(item);
      }
      const loose = floors.findIndex(f => f.floor === null);
      if (loose !== -1 && loose !== floors.length - 1) floors.push(floors.splice(loose, 1)[0]);
      return floors;
    }

    /** Saved line total for one product. Same maths as the PDF and calculateTotal(). */
    function lineTotalOf(product: any): number {
      const customPrice = product.customUnitPrice ? Number(product.customUnitPrice) : null;
      if (customPrice === null) return 0;
      const quantity = Number(product.quantity) || 1;
      const discountRs = product.discountRs != null ? Number(product.discountRs) : null;
      const discount = Number(product.discount) || 0;
      const taxRate = Number(product.tax) || 0;
      const subtotal = customPrice * quantity;
      const discountAmount = discountRs !== null ? discountRs : subtotal * (discount / 100);
      const afterDiscount = subtotal - discountAmount;
      return afterDiscount + afterDiscount * (taxRate / 100);
    }

    const formatMoney = (n: number) =>
      '₹' + n.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

    const escapeHtml = (s: any) => String(s ?? '')
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

    /** The rows currently on screen: one option's worth, or everything. */
    function visibleProducts(): any[] {
      const groups = buildOptionGroups();
      if (groups.length === 1 && groups[0].option === null) return currentProducts;
      return (groups.find(g => g.option === activeOptionKey) || groups[0]).products;
    }

    /**
     * The header's SUB TOTAL for a quote with priced alternatives. The saved
     * Total Amount is option 1's price by design (see calculateTotal), so on a
     * two-option quote the one figure in the header is only half the answer.
     * Every option is listed instead, and picking one here drives the same
     * switch the option tabs below do — the header and the table always agree.
     *
     * Left alone on an ordinary quote, which keeps the saved figure it has
     * always shown.
     */
    function renderHeaderTotals() {
      const label = document.getElementById('quoteTotalLabel');
      const totalEl = document.getElementById('quoteTotal');
      const list = document.getElementById('quoteTotalOptions');
      if (!label || !totalEl || !list) return;

      const groups = buildOptionGroups();
      if (groups.length === 1 && groups[0].option === null) {
        label.textContent = 'SUB TOTAL';
        list.classList.add('hidden');
        list.innerHTML = '';
        return;
      }

      // Whole rupees, the way this header has always shown the figure — the
      // paise live in the table below.
      const roundMoney = (n: number) =>
        '₹' + Math.round(n).toLocaleString('en-IN');
      const optionTotal = (group: { products: any[] }) =>
        group.products.reduce((sum: number, p: any) => sum + lineTotalOf(p), 0);

      const active = groups.find(g => g.option === activeOptionKey) || groups[0];
      label.textContent = 'SUB TOTAL';
      totalEl.textContent = roundMoney(optionTotal(active));

      list.classList.remove('hidden');
      list.innerHTML = groups.map((group, i) => {
        const total = optionTotal(group);
        const isActive = group.option === active.option;
        return `
          <button type="button" data-option="${escapeHtml(group.option)}"
            class="header-option-total flex w-full items-baseline justify-between gap-2 rounded-md px-2 py-1 text-left transition-colors ${
              isActive ? 'bg-indigo-50 ring-1 ring-indigo-200' : 'hover:bg-slate-50'
            }"
            aria-pressed="${isActive}">
            <span class="truncate text-[11px] font-semibold ${isActive ? 'text-indigo-800' : 'text-slate-500'}">${i + 1}. ${escapeHtml(group.option)}</span>
            <span class="shrink-0 text-xs font-bold tabular-nums ${isActive ? 'text-indigo-900' : 'text-slate-600'}">${roundMoney(total)}</span>
          </button>`;
      }).join('') +
        `<p class="px-2 pt-0.5 text-[10px] leading-snug text-slate-400">Alternatives &middot; only one is bought. Option 1 is the saved quote total.</p>`;

      list.querySelectorAll('.header-option-total').forEach(button => {
        button.addEventListener('click', () => {
          const key = (button as HTMLElement).getAttribute('data-option');
          if (key === activeOptionKey) return;
          activeOptionKey = key;
          // renderProducts() redraws the table, the option tabs and, at its end,
          // this block — so the two stay in step from a single switch.
          renderProducts();
        });
      });
    }

    // ------------------------------------------------- add-product target ---
    // A room-wise quote is read floor by floor: a line item with no section is
    // homeless — it lands in "Other Items" at the bottom of the page and of the
    // PDF. So on those quotes adding a product asks where it goes first, and
    // writes Section/Option along with the junction row.

    /** Sentinel for the "new floor/room" entry in the destination selects. */
    const DEST_NEW = '__new__';

    /** Kept across re-renders so adding five things to one room isn't five trips through the selects. */
    let destinationDraft = { option: '', floor: '', newFloor: '', room: '', newRoom: '' };

    /**
     * Whether this quote is read room by room. Same test renderProducts() uses
     * to pick its layout: any line placed in a section, or any priced
     * alternative. Drives the destination picker and the header's PDF buttons.
     */
    function isRoomWiseQuote(): boolean {
      if ((currentQuoteData?.options || []).length) return true;
      return currentProducts.some((p: any) => String(p.section || '').trim() || String(p.option || '').trim());
    }

    /**
     * Floors already used anywhere in the quote, with the rooms under each.
     * Pooled across options on purpose — the same rooms are usually quoted both
     * ways, so a room opened under "Wired" is a valid target under "Wireless".
     */
    function knownFloors(): Array<{ floor: string; rooms: string[] }> {
      const floors: Array<{ floor: string; rooms: string[] }> = [];
      currentProducts.forEach((p: any) => {
        const { floor, room } = splitSection(p.section);
        if (!floor) return;
        let entry = floors.find(f => f.floor === floor);
        if (!entry) { entry = { floor, rooms: [] }; floors.push(entry); }
        if (room && !entry.rooms.includes(room)) entry.rooms.push(room);
      });
      return floors;
    }

    /** Option names in print order; empty on a quote with no alternatives. */
    function knownOptions(): string[] {
      return buildOptionGroups().map(g => g.option).filter(Boolean) as string[];
    }

    /** Draw the picker from the quote's own floors, rooms and options. */
    function renderAddDestination() {
      const wrap = document.getElementById('addDestination') as HTMLDivElement;
      const fields = document.getElementById('addDestinationFields') as HTMLDivElement;
      if (!wrap || !fields) return;
      if (!isEditMode || !isRoomWiseQuote()) { wrap.classList.add('hidden'); return; }
      wrap.classList.remove('hidden');

      const options = knownOptions();
      const floors = knownFloors();

      // A draft can go stale between renders — the room it pointed at may have
      // had its last row deleted, or the user may have switched option tabs.
      if (options.length && !options.includes(destinationDraft.option)) {
        destinationDraft.option = activeOptionKey && options.includes(activeOptionKey) ? activeOptionKey : options[0];
      }
      if (destinationDraft.floor !== DEST_NEW && destinationDraft.floor && !floors.some(f => f.floor === destinationDraft.floor)) {
        destinationDraft.floor = '';
        destinationDraft.room = '';
      }
      const floorEntry = floors.find(f => f.floor === destinationDraft.floor);
      const rooms = floorEntry ? floorEntry.rooms : [];
      if (destinationDraft.room !== DEST_NEW && destinationDraft.room && !rooms.includes(destinationDraft.room)) {
        destinationDraft.room = '';
      }
      // A brand-new floor has no rooms to pick from, so its room field is a
      // free-text one from the start rather than a select with nothing in it.
      const floorIsNew = destinationDraft.floor === DEST_NEW;
      const roomIsNew = floorIsNew || destinationDraft.room === DEST_NEW;

      const selectClass = 'w-full px-3 py-2.5 bg-white border-2 border-slate-200 rounded-xl text-sm font-medium text-slate-700 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500';
      const inputClass = 'w-full px-3 py-2.5 bg-white border-2 border-emerald-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500';
      const labelClass = 'block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-1.5';
      const opt = (value: string, label: string, selected: boolean) =>
        `<option value="${escapeHtml(value)}"${selected ? ' selected' : ''}>${escapeHtml(label)}</option>`;

      const optionField = !options.length ? '' : `
        <div>
          <label class="${labelClass}" for="destOption">Option</label>
          <select id="destOption" class="${selectClass}">
            ${options.map(o => opt(o, o, o === destinationDraft.option)).join('')}
          </select>
        </div>`;

      const floorField = `
        <div>
          <label class="${labelClass}" for="destFloor">Floor</label>
          <select id="destFloor" class="${selectClass}">
            ${opt('', 'Select a floor...', !destinationDraft.floor)}
            ${floors.map(f => opt(f.floor, f.floor, f.floor === destinationDraft.floor)).join('')}
            ${opt(DEST_NEW, '+ New floor', floorIsNew)}
          </select>
          ${floorIsNew ? `<input type="text" id="destNewFloor" placeholder="New floor name, e.g. 3rd Floor" value="${escapeHtml(destinationDraft.newFloor)}" class="mt-2 ${inputClass}" />` : ''}
        </div>`;

      const roomField = `
        <div>
          <label class="${labelClass}" for="destRoom">Room</label>
          ${floorIsNew ? '' : `
          <select id="destRoom" class="${selectClass}">
            ${opt('', 'No room (floor level)', !destinationDraft.room)}
            ${rooms.map(r => opt(r, r, r === destinationDraft.room)).join('')}
            ${opt(DEST_NEW, '+ New room', destinationDraft.room === DEST_NEW)}
          </select>`}
          ${roomIsNew ? `<input type="text" id="destNewRoom" placeholder="${floorIsNew ? 'Room name (optional)' : 'New room name, e.g. Boardroom 12 PAX'}" value="${escapeHtml(destinationDraft.newRoom)}" class="${floorIsNew ? '' : 'mt-2 '}${inputClass}" />` : ''}
        </div>`;

      fields.innerHTML = `<div class="grid gap-3 ${optionField ? 'sm:grid-cols-3' : 'sm:grid-cols-2'}">${optionField}${floorField}${roomField}</div>`;

      document.getElementById('destOption')?.addEventListener('change', (e) => {
        destinationDraft.option = (e.target as HTMLSelectElement).value;
      });
      document.getElementById('destFloor')?.addEventListener('change', (e) => {
        destinationDraft.floor = (e.target as HTMLSelectElement).value;
        destinationDraft.room = '';
        destinationDraft.newRoom = '';
        renderAddDestination();
        (document.getElementById('destNewFloor') as HTMLInputElement | null)?.focus();
      });
      document.getElementById('destRoom')?.addEventListener('change', (e) => {
        destinationDraft.room = (e.target as HTMLSelectElement).value;
        renderAddDestination();
        (document.getElementById('destNewRoom') as HTMLInputElement | null)?.focus();
      });
      document.getElementById('destNewFloor')?.addEventListener('input', (e) => {
        destinationDraft.newFloor = (e.target as HTMLInputElement).value;
      });
      document.getElementById('destNewRoom')?.addEventListener('input', (e) => {
        destinationDraft.newRoom = (e.target as HTMLInputElement).value;
      });
    }

    /**
     * The Section/Option fields for a product about to be added, or null if the
     * user hasn't said where it goes. Returns empty fields on an ordinary quote,
     * which has nowhere to put a product but the list.
     */
    function takeAddDestination(): { Section?: string; Option?: string } | null {
      if (!isRoomWiseQuote()) return {};

      const floor = (destinationDraft.floor === DEST_NEW ? destinationDraft.newFloor : destinationDraft.floor).trim();
      if (!floor) {
        showToast('Choose the floor this product belongs to', 'error');
        (document.getElementById('destNewFloor') || document.getElementById('destFloor'))?.focus();
        return null;
      }
      const room = (roomIsFreeText() ? destinationDraft.newRoom : destinationDraft.room).trim();
      if (destinationDraft.room === DEST_NEW && !room) {
        showToast('Name the new room, or pick "No room (floor level)"', 'error');
        (document.getElementById('destNewRoom') as HTMLInputElement | null)?.focus();
        return null;
      }

      const options = knownOptions();
      if (options.length && !destinationDraft.option) {
        showToast('Choose which option this product belongs to', 'error');
        return null;
      }

      // Fold the typed names back into the draft: once the row is saved they are
      // ordinary floors and rooms, and the next product should find them listed.
      destinationDraft.floor = floor;
      destinationDraft.room = room;
      destinationDraft.newFloor = '';
      destinationDraft.newRoom = '';

      const fields: { Section?: string; Option?: string } = { Section: room ? `${floor} > ${room}` : floor };
      if (options.length) fields.Option = destinationDraft.option;
      return fields;
    }

    /** Whether the room is being typed rather than picked. */
    function roomIsFreeText(): boolean {
      return destinationDraft.floor === DEST_NEW || destinationDraft.room === DEST_NEW;
    }

    /**
     * A room-wise quote gets the room-wise PDF buttons and nothing else. The
     * plain PDF prints the line items as one flat list with the floors and rooms
     * thrown away — on a quote built room by room that document is simply wrong,
     * so it isn't offered. Ordinary quotes keep the plain buttons only.
     */
    function applyPdfButtonVisibility() {
      const roomWise = isRoomWiseQuote();
      // A quote whose Section/Option columns could not be read is not a quote
      // without rooms — we simply don't know. Hiding the room-wise buttons on a
      // guess would leave no way to produce that PDF at all, so an unreadable
      // lookup falls back to offering both layouts, as the page did before.
      const unknown = !sectionLookupOk;
      const show = (id: string, visible: boolean) =>
        document.getElementById(id)?.classList.toggle('hidden', !visible);
      show('previewPdfBtn', !roomWise);
      show('downloadPdfBtn', !roomWise);
      // The workbook is the flat quote's line items, so it follows the plain
      // PDF: offered on an ordinary quote, withheld on a room-wise one where a
      // flat list of items would throw the floors and rooms away.
      show('downloadExcelBtn', !roomWise);
      show('previewSectionedPdfBtn', roomWise || unknown);
      show('downloadSectionedPdfBtn', roomWise || unknown);
    }

    /**
     * Render products table based on edit mode
     * Shows products from ProductsForQuotes junction with custom prices
     */
    function renderProducts() {
      const productsContainer = document.getElementById('productsContainer') as HTMLDivElement;

      // Both read the line items, so they are refreshed from here — a delete that
      // empties the last room changes where a product may be added, and a quote
      // that has just become room-wise changes which PDF buttons make sense.
      applyPdfButtonVisibility();
      renderAddDestination();
      renderHeaderTotals();

      if (currentProducts.length === 0) {
        productsContainer.innerHTML = '<p class="text-sm text-slate-500">No products linked to this quote</p>';
        return;
      }

      // Lay the rows out option → floor → room, the way the room-wise PDF prints
      // them. Only the active option is put in the DOM: every line-item handler
      // below keys off `tr[data-junction-id]`, so rows that aren't on screen must
      // not be there to be counted.
      const optionGroups = buildOptionGroups();
      const hasOptions = !(optionGroups.length === 1 && optionGroups[0].option === null);
      if (hasOptions && !optionGroups.some(g => g.option === activeOptionKey)) {
        activeOptionKey = optionGroups[0].option;
      }
      const shown = visibleProducts();
      const floors = groupByFloorRoom(shown);
      // No Section anywhere means an ordinary quote — one null floor group, and a
      // lone "Other Items" banner over the whole table would be pure noise.
      const hasSections = floors.some(f => f.floor !== null || f.rooms.some(r => r.room !== null));

      // Room-wise quotes get the compact layout. A room-wise quote is read room
      // by room, and eleven columns of which five are identity means the prices
      // sit off the right edge behind a scrollbar — so Brand/Model/HSN/Warranty
      // fold into a second line under the product name. Ordinary quotes are left
      // on the wide layout they have always had.
      const roomWise = hasSections || hasOptions;
      const colCount = (roomWise ? 6 : 10) + (isEditMode ? 1 : 0);

      // Flattened so the row template below stays a single map, with banners
      // interleaved. `index` is the zebra counter over visible product rows only.
      // The floor/room keys let updateGrandTotal() refresh each banner's subtotal
      // from the rows underneath it while someone is typing in edit mode.
      const rowPlan: any[] = [];
      let visibleIndex = 0;
      if (!hasSections) {
        shown.forEach((product: any) => rowPlan.push({ kind: 'item', product, index: visibleIndex++ }));
      } else {
        floors.forEach((floorGroup, fi) => {
          const floorKey = `f${fi}`;
          rowPlan.push({
            kind: 'floor',
            key: floorKey,
            label: floorGroup.floor || UNGROUPED_LABEL,
            unplaced: floorGroup.floor === null,
            rooms: floorGroup.rooms.filter(r => r.room).length,
            count: floorGroup.rooms.reduce((n, r) => n + r.items.length, 0),
          });
          floorGroup.rooms.forEach((roomGroup, ri) => {
            const roomKey = `${floorKey}r${ri}`;
            if (roomGroup.room) {
              rowPlan.push({ kind: 'room', key: roomKey, label: roomGroup.room, count: roomGroup.items.length });
            }
            roomGroup.items.forEach((product: any) =>
              rowPlan.push({ kind: 'item', product, index: visibleIndex++, floorKey, roomKey: roomGroup.room ? roomKey : '' }));
          });
        });
      }

      const optionTabs = !hasOptions ? '' : `
        <div class="mb-6">
          <div class="flex items-center gap-2 mb-2.5">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-500">Priced alternatives</span>
            <span class="flex-1 h-px bg-slate-200"></span>
            <span class="text-xs text-slate-500">Only one is bought &middot; the quote's saved total is Option 1</span>
          </div>
          <div class="grid gap-3 ${optionGroups.length > 2 ? 'sm:grid-cols-3' : 'sm:grid-cols-2'}">
            ${optionGroups.map((group, i) => {
              const optionTotal = group.products.reduce((sum: number, p: any) => sum + lineTotalOf(p), 0);
              const active = group.option === activeOptionKey;
              return `
                <button type="button" class="option-tab group relative text-left rounded-xl border p-4 transition-all ${
                  active
                    ? 'border-indigo-500 bg-indigo-50/70 ring-2 ring-indigo-500/20 shadow-sm'
                    : 'border-slate-200 bg-white hover:border-slate-300 hover:bg-slate-50'
                }" data-option="${escapeHtml(group.option)}" aria-pressed="${active}">
                  <div class="flex items-start justify-between gap-3">
                    <div class="min-w-0">
                      <div class="flex items-center gap-2">
                        <span class="inline-flex items-center justify-center w-5 h-5 rounded text-[11px] font-bold ${active ? 'bg-indigo-600 text-white' : 'bg-slate-200 text-slate-600'}">${i + 1}</span>
                        <span class="truncate text-sm font-semibold ${active ? 'text-indigo-900' : 'text-slate-700'}">${escapeHtml(group.option)}</span>
                      </div>
                      <div class="mt-2 text-lg font-bold tabular-nums ${active ? 'text-indigo-900' : 'text-slate-800'}">${formatMoney(optionTotal)}</div>
                      <div class="text-xs ${active ? 'text-indigo-600' : 'text-slate-500'}">${group.products.length} line item${group.products.length === 1 ? '' : 's'}${i === 0 ? ' &middot; saved as quote total' : ''}</div>
                    </div>
                    ${active ? `
                      <svg class="w-5 h-5 shrink-0 text-indigo-600" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-7.5 7.5a1 1 0 01-1.4 0L3.3 9.7a1 1 0 111.4-1.4l3.3 3.3 6.8-6.8a1 1 0 011.4 0z" clip-rule="evenodd"/>
                      </svg>` : ''}
                  </div>
                </button>`;
            }).join('')}
          </div>
        </div>
      `;

      const th = (label: string, align = 'left', extra = '') =>
        `<th class="px-4 py-3 text-${align} text-[11px] font-bold text-slate-500 uppercase tracking-wider ${extra}">${label}</th>`;
      const headerCells = roomWise
        ? [th('Item'), th('Qty', 'center'), th('Unit Price', 'right'), th('Discount', 'center'), th('Tax', 'center'), th('Line Total', 'right')]
        : [th('Product'), th('Brand'), th('Model No'), th('HSN Code'), th('Warranty (months)', 'center'),
           th('Qty', 'center'), th('Unit Price', 'right'), th('Discount %', 'center'), th('Tax %', 'center'), th('Line Total', 'right')];
      if (isEditMode) headerCells.push(th('', 'right'));

      productsContainer.innerHTML = `
        ${optionTabs}
        <div class="overflow-x-auto rounded-xl border border-slate-200">
          <table class="w-full border-collapse">
            <thead class="bg-slate-50 border-b border-slate-200">
              <tr>${headerCells.join('')}</tr>
            </thead>
            <tbody>
              ${rowPlan.map((entry: any) => {
                if (entry.kind === 'floor') {
                  // Floors are the loudest thing in the table on purpose — they
                  // are how someone finds their way around a 100-line quote.
                  const icon = entry.unplaced
                    ? '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M5 19h14a2 2 0 001.8-2.9l-7-12a2 2 0 00-3.6 0l-7 12A2 2 0 005 19z"/>'
                    : '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>';
                  return `
                    <tr class="bg-slate-800 text-white">
                      <td colspan="${colCount}" class="px-4 py-2.5">
                        <div class="flex items-center gap-2.5">
                          <svg class="w-4 h-4 shrink-0 ${entry.unplaced ? 'text-amber-300' : 'text-slate-300'}" fill="none" stroke="currentColor" viewBox="0 0 24 24">${icon}</svg>
                          <span class="text-xs font-bold uppercase tracking-wider">${escapeHtml(entry.label)}</span>
                          <span class="text-[11px] text-slate-300">${entry.rooms ? `${entry.rooms} room${entry.rooms === 1 ? '' : 's'} &middot; ` : ''}${entry.count} item${entry.count === 1 ? '' : 's'}</span>
                          <span class="flex-1"></span>
                          <span class="text-sm font-bold tabular-nums group-total" data-group-key="${entry.key}">&mdash;</span>
                        </div>
                      </td>
                    </tr>`;
                }
                if (entry.kind === 'room') {
                  return `
                    <tr class="bg-slate-100/80 border-y border-slate-200">
                      <td colspan="${colCount}" class="px-4 py-2">
                        <div class="flex items-center gap-2.5">
                          <span class="w-1 h-4 rounded-full bg-indigo-400 shrink-0"></span>
                          <span class="text-xs font-semibold text-slate-700">${escapeHtml(entry.label)}</span>
                          <span class="text-[11px] text-slate-500">${entry.count} item${entry.count === 1 ? '' : 's'}</span>
                          <span class="flex-1"></span>
                          <span class="text-xs font-semibold text-slate-600 tabular-nums group-total" data-group-key="${entry.key}">&mdash;</span>
                        </div>
                      </td>
                    </tr>`;
                }

                const product = entry.product;
                const name = product.productName || 'Unnamed Product';
                const brand = product.brand || '-';
                const productCode = product.productCode || '-';
                const code = product.hsnCode || '-';
                const warranty = product.warranty != null ? `${product.warranty}` : '-';
                const customPrice = product.customUnitPrice ? Number(product.customUnitPrice) : null;
                const unitPrice = customPrice !== null ? customPrice : 0;
                const quantity = Number(product.quantity) || 1;
                const discount = Number(product.discount) || 0;
                const lineDRs = product.discountRs != null ? Number(product.discountRs) : null;
                const taxRate = Number(product.tax) || 0;
                const junctionId = product.junctionId;

                // Calculate line total with discount and tax
                const subtotal = unitPrice * quantity;
                const discountAmount = lineDRs !== null ? lineDRs : subtotal * (discount / 100);
                const afterDiscount = subtotal - discountAmount;
                const taxAmount = afterDiscount * (taxRate / 100);
                const lineTotal = afterDiscount + taxAmount;
                
                // Editable fields in edit mode
                const qtyCell = isEditMode ? `
                  <td class="px-4 py-3.5 text-center">
                    <input type="number" min="1" value="${quantity}" 
                      class="quantity-input w-20 px-3 py-2 text-sm text-center border-2 border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all" 
                      data-junction-id="${junctionId}" 
                      ${!junctionId ? 'disabled title="No junction record"' : ''} />
                  </td>
                ` : `<td class="px-4 py-3.5 text-sm font-medium text-slate-900 text-center tabular-nums">${quantity}</td>`;
                
                const priceCell = isEditMode ? `
                  <td class="px-4 py-3.5 text-right">
                    <input type="number" min="0" step="0.01" value="${unitPrice || ''}" 
                      class="price-input w-32 px-3 py-2 text-sm text-right border-2 border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all" 
                      data-junction-id="${junctionId}" 
                      placeholder="Set price" 
                      ${!junctionId ? 'disabled title="No junction record"' : ''} />
                  </td>
                ` : `<td class="px-4 py-3.5 text-sm font-medium text-slate-900 text-right tabular-nums">${customPrice !== null && customPrice !== undefined ? '₹' + Number(customPrice).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : '<span class="text-slate-400">No price set</span>'}</td>`;
                
                const discountRs = product.discountRs != null ? Number(product.discountRs) : null;
                const discountMode = discountRs !== null ? 'rupees' : 'percent';
                const discountValue = discountRs !== null ? discountRs : discount;
                const discountDisplay = discountRs !== null
                  ? '₹' + Number(discountRs).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })
                  : discount + '%';
                const discountCell = isEditMode ? `
                  <td class="px-4 py-3.5 text-center">
                    ${isAdmin() || isSuperAdmin() ? `
                    <div class="flex flex-col items-center gap-1">
                      <div class="flex rounded-md overflow-hidden border border-slate-200">
                        <button type="button" class="discount-mode-pct px-2 py-1 text-xs font-semibold ${discountMode === 'percent' ? 'bg-indigo-600 text-white' : 'bg-white text-slate-600 hover:bg-slate-50'} transition-colors" data-junction-id="${junctionId}">%</button>
                        <button type="button" class="discount-mode-rs px-2 py-1 text-xs font-semibold ${discountMode === 'rupees' ? 'bg-indigo-600 text-white' : 'bg-white text-slate-600 hover:bg-slate-50'} transition-colors" data-junction-id="${junctionId}">₹</button>
                      </div>
                      <input type="number" min="0" ${discountMode === 'percent' ? 'max="100"' : ''} step="0.01" value="${discountValue}"
                        class="discount-input w-20 px-3 py-2 text-sm text-center border-2 border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all"
                        data-junction-id="${junctionId}"
                        data-mode="${discountMode}"
                        ${!junctionId ? 'disabled title="No junction record"' : ''} />
                    </div>
                    ` : `
                    <input type="number" min="0" max="100" step="0.1" value="${discount}"
                      class="discount-input w-20 px-3 py-2 text-sm text-center border-2 border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all"
                      data-junction-id="${junctionId}"
                      data-mode="percent"
                      ${!junctionId ? 'disabled title="No junction record"' : ''} />
                    `}
                  </td>
                ` : `<td class="px-4 py-3.5 text-sm font-medium text-slate-700 text-center tabular-nums">${discountDisplay}</td>`;
                
                const actionCell = isEditMode ? `
                  <td class="px-4 py-3">
                    <button class="remove-product-btn p-1.5 text-red-600 hover:bg-red-50 rounded-lg transition-colors" data-junction-id="${junctionId}" title="Remove product">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                      </svg>
                    </button>
                  </td>
                ` : '';
                
                // Compact layout: everything that identifies the product collapses
                // into one cell — name on top, the specs that used to own four
                // columns as a muted second line. Nothing is dropped, and the
                // money columns come back onto the screen.
                const meta = roomWise
                  ? [
                      product.brand ? `<span class="font-medium text-slate-600">${escapeHtml(product.brand)}</span>` : '',
                      product.productCode ? escapeHtml(product.productCode) : '',
                      product.hsnCode ? `HSN ${escapeHtml(product.hsnCode)}` : '',
                      product.warranty != null ? `${escapeHtml(product.warranty)} mo warranty` : '',
                      product.uom ? escapeHtml(product.uom) : '',
                    ].filter(Boolean)
                  : [];

                const identityCells = roomWise ? `
                  <td class="px-4 py-3">
                    <div class="text-sm font-semibold text-slate-900 leading-snug">${escapeHtml(name)}${product.isOutsourced ? ' <span class="ml-1.5 align-middle inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-semibold bg-amber-100 text-amber-700">Outsourced</span>' : ''}</div>
                    ${meta.length ? `<div class="mt-0.5 text-xs text-slate-400 leading-snug">${meta.join('<span class="mx-1.5 text-slate-300">&middot;</span>')}</div>` : ''}
                  </td>
                ` : `
                  <td class="px-4 py-3.5 text-sm font-medium text-slate-900">${name}</td>
                  <td class="px-4 py-3.5 text-sm text-slate-600">${brand}</td>
                  <td class="px-4 py-3.5 text-sm text-slate-600">${productCode}</td>
                  <td class="px-4 py-3.5 text-sm text-slate-600">${code}</td>
                  <td class="px-4 py-3.5 text-sm text-slate-600 text-center">${warranty}</td>
                `;

                // Zebra striping fights the floor/room banners for the reader's
                // eye, so the compact layout uses hairlines between rows instead.
                const rowClass = roomWise
                  ? 'bg-white border-b border-slate-100'
                  : (entry.index % 2 === 0 ? 'bg-white' : 'bg-slate-50');
                return `
                  <tr data-junction-id="${junctionId}" data-floor-key="${entry.floorKey || ''}" data-room-key="${entry.roomKey || ''}" class="${rowClass} hover:bg-indigo-50/50 transition-colors">
                    ${identityCells}
                    ${qtyCell}
                    ${priceCell}
                    ${discountCell}
                    <td class="px-4 py-3.5 text-sm text-slate-500 text-center tabular-nums">${taxRate}%</td>
                    <td class="px-4 py-3.5 text-sm font-bold text-slate-900 text-right tabular-nums line-total-cell" data-junction-id="${junctionId}">₹${lineTotal.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</td>
                    ${actionCell}
                  </tr>
                `;
              }).join('')}
            </tbody>
          </table>
        </div>
        <div class="mt-6 flex justify-end">
          <div class="bg-gradient-to-br from-blue-50 to-indigo-50 rounded-xl px-8 py-5 border border-blue-200 shadow-sm text-right">
            <div class="text-xs font-bold text-slate-500 uppercase tracking-wider">${hasOptions ? escapeHtml(activeOptionKey) : 'Grand Total'}</div>
            <div id="grandTotal" class="mt-1 text-4xl font-bold text-blue-900 tabular-nums">₹0.00</div>
            <div class="mt-1 text-xs text-slate-500">after discount &amp; tax${hasOptions ? ' &middot; this option only' : ''}</div>
          </div>
        </div>
      `;

      // Update grand total
      updateGrandTotal();

      // Option tabs. A re-render is the whole switch: the row plan is rebuilt
      // from the new active option and every handler below is re-attached with it.
      document.querySelectorAll('.option-tab').forEach(tab => {
        tab.addEventListener('click', () => {
          const key = (tab as HTMLElement).getAttribute('data-option');
          if (key === activeOptionKey) return;
          activeOptionKey = key;
          renderProducts();
        });
      });

      // Attach event handlers in edit mode
      if (isEditMode) {
        // Remove button handlers
        document.querySelectorAll('.remove-product-btn').forEach(btn => {
          btn.addEventListener('click', async (e) => {
            const junctionId = (btn as HTMLElement).getAttribute('data-junction-id');
            if (junctionId && await showConfirm('Remove this product from the quote?', 'Remove', 'bg-red-600 hover:bg-red-700')) {
              await removeLineItem(junctionId);
            }
          });
        });
        
        // Quantity input handlers with debounce
        document.querySelectorAll('.quantity-input').forEach(input => {
          let timeout: number;
          input.addEventListener('input', (e) => {
            clearTimeout(timeout);
            timeout = window.setTimeout(async () => {
              const junctionId = (input as HTMLElement).getAttribute('data-junction-id');
              const newQuantity = parseInt((input as HTMLInputElement).value);
              if (junctionId && newQuantity > 0) {
                await updateLineItemQuantity(junctionId, newQuantity);
              }
            }, 800);
          });
        });
        
        // Price input handlers with debounce
        document.querySelectorAll('.price-input').forEach(input => {
          let timeout: number;
          input.addEventListener('input', (e) => {
            clearTimeout(timeout);
            // Immediate optimistic update
            const junctionId = (input as HTMLElement).getAttribute('data-junction-id');
            updateLineItemDisplay(junctionId);
            
            timeout = window.setTimeout(async () => {
              const newPrice = parseFloat((input as HTMLInputElement).value);
              if (junctionId && newPrice >= 0) {
                await updateLineItemPrice(junctionId, newPrice);
              }
            }, 800);
          });
        });
        
        // Discount input handlers with debounce
        document.querySelectorAll('.discount-input').forEach(input => {
          let timeout: number;
          input.addEventListener('input', () => {
            clearTimeout(timeout);
            const junctionId = (input as HTMLElement).getAttribute('data-junction-id');
            updateLineItemDisplay(junctionId);

            timeout = window.setTimeout(async () => {
              const newDiscount = parseFloat((input as HTMLInputElement).value);
              const mode = (input as HTMLElement).getAttribute('data-mode') || 'percent';
              if (junctionId && newDiscount >= 0) {
                if (mode === 'rupees' || newDiscount <= 100) {
                  await updateLineItemDiscount(junctionId, newDiscount, mode);
                }
              }
            }, 800);
          });
        });

        // Discount mode toggle handlers (admin only)
        document.querySelectorAll('.discount-mode-pct, .discount-mode-rs').forEach(btn => {
          btn.addEventListener('click', async () => {
            const target = btn as HTMLButtonElement;
            const junctionId = target.getAttribute('data-junction-id');
            if (!junctionId) return;

            const row = document.querySelector(`tr[data-junction-id="${junctionId}"]`);
            if (!row) return;

            const discountInput = row.querySelector('.discount-input') as HTMLInputElement;
            const pctBtn = row.querySelector('.discount-mode-pct') as HTMLButtonElement;
            const rsBtn = row.querySelector('.discount-mode-rs') as HTMLButtonElement;

            const isRs = target.classList.contains('discount-mode-rs');
            const newMode = isRs ? 'rupees' : 'percent';
            if (discountInput.getAttribute('data-mode') === newMode) return;

            discountInput.setAttribute('data-mode', newMode);
            discountInput.value = '0';

            if (isRs) {
              discountInput.removeAttribute('max');
              rsBtn.className = 'discount-mode-rs px-2 py-1 text-xs font-semibold bg-indigo-600 text-white transition-colors';
              pctBtn.className = 'discount-mode-pct px-2 py-1 text-xs font-semibold bg-white text-slate-600 hover:bg-slate-50 transition-colors';
              await updateLineItemDiscount(junctionId, 0, 'rupees');
            } else {
              discountInput.setAttribute('max', '100');
              pctBtn.className = 'discount-mode-pct px-2 py-1 text-xs font-semibold bg-indigo-600 text-white transition-colors';
              rsBtn.className = 'discount-mode-rs px-2 py-1 text-xs font-semibold bg-white text-slate-600 hover:bg-slate-50 transition-colors';
              await clearLineItemDiscountRs(junctionId);
            }

            updateLineItemDisplay(junctionId);
          });
        });
      }
    }
    
    /**
     * Update line item display with real-time calculation (optimistic UI)
     */
    function updateLineItemDisplay(junctionId: string | null) {
      if (!junctionId) return;

      const row = document.querySelector(`tr[data-junction-id="${junctionId}"]`);
      if (!row) return;

      const qtyInput = row.querySelector('.quantity-input') as HTMLInputElement;
      const priceInput = row.querySelector('.price-input') as HTMLInputElement;
      const discountInput = row.querySelector('.discount-input') as HTMLInputElement;
      const lineTotalCell = row.querySelector('.line-total-cell');

      if (!qtyInput || !priceInput || !discountInput || !lineTotalCell) return;

      const quantity = parseFloat(qtyInput.value) || 1;
      const unitPrice = parseFloat(priceInput.value) || 0;
      const discountVal = parseFloat(discountInput.value) || 0;
      const mode = discountInput.getAttribute('data-mode') || 'percent';

      // Find product to get tax rate
      const product = currentProducts.find(p => p.junctionId === parseInt(junctionId));
      const taxRate = product ? (Number(product.tax) || 0) : 0;

      // Calculate line total
      const subtotal = unitPrice * quantity;
      const discountAmount = mode === 'rupees' ? discountVal : subtotal * (discountVal / 100);
      const afterDiscount = subtotal - discountAmount;
      const taxAmount = afterDiscount * (taxRate / 100);
      const lineTotal = afterDiscount + taxAmount;

      // Update display
      lineTotalCell.textContent = '₹' + lineTotal.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

      // Update grand total
      updateGrandTotal();
    }
    
    /**
     * Update grand total display
     * Works in both edit and non-edit modes by using currentProducts array
     */
    function updateGrandTotal() {
      const grandTotalEl = document.getElementById('grandTotal');
      if (!grandTotalEl) return;

      // Floor and room subtotals are rebuilt from the same pass that builds the
      // grand total, so they stay honest while someone is typing in edit mode.
      const groupSums = new Map<string, number>();
      const addToGroups = (row: Element | null, amount: number) => {
        if (!row) return;
        for (const attr of ['data-floor-key', 'data-room-key']) {
          const key = row.getAttribute(attr);
          if (key) groupSums.set(key, (groupSums.get(key) || 0) + amount);
        }
      };

      let total = 0;

      if (isEditMode) {
        // In edit mode, read from input fields for real-time updates
        document.querySelectorAll('tr[data-junction-id]').forEach(row => {
          const qtyInput = row.querySelector('.quantity-input') as HTMLInputElement;
          const priceInput = row.querySelector('.price-input') as HTMLInputElement;
          const discountInput = row.querySelector('.discount-input') as HTMLInputElement;

          if (qtyInput && priceInput && discountInput) {
            const quantity = parseFloat(qtyInput.value) || 1;
            const unitPrice = parseFloat(priceInput.value) || 0;
            const discountVal = parseFloat(discountInput.value) || 0;
            const mode = discountInput.getAttribute('data-mode') || 'percent';

            const junctionId = row.getAttribute('data-junction-id');
            const product = currentProducts.find(p => p.junctionId === parseInt(junctionId || '0'));
            const taxRate = product ? (Number(product.tax) || 0) : 0;

            const subtotal = unitPrice * quantity;
            const discountAmount = mode === 'rupees' ? discountVal : subtotal * (discountVal / 100);
            const afterDiscount = subtotal - discountAmount;
            const taxAmount = afterDiscount * (taxRate / 100);
            const lineTotal = afterDiscount + taxAmount;

            total += lineTotal;
            addToGroups(row, lineTotal);
          }
        });
      } else {
        // Non-edit mode reads the saved values. Scoped to the option on screen —
        // the edit branch above gets that for free, since only the active
        // option's rows are ever in the DOM.
        visibleProducts().forEach(product => {
          const lineTotal = lineTotalOf(product);
          total += lineTotal;
          addToGroups(document.querySelector(`tr[data-junction-id="${product.junctionId}"]`), lineTotal);
        });
      }

      document.querySelectorAll('.group-total').forEach(el => {
        const key = el.getAttribute('data-group-key') || '';
        el.textContent = formatMoney(groupSums.get(key) || 0);
      });

      grandTotalEl.textContent = '₹' + total.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    /**
     * Toggle edit mode
     */
    function toggleEditMode(enable: boolean) {
      isEditMode = enable;
      const editModePanel = document.getElementById('editModePanel') as HTMLDivElement;
      const editQuoteBtn = document.getElementById('editQuoteBtn') as HTMLButtonElement;
      const editQuoteStatus = document.getElementById('editQuoteStatus') as HTMLSelectElement;
      
      if (enable) {
        editModePanel.classList.remove('hidden');
        editQuoteBtn.classList.add('hidden');
        // Set current status in dropdown
        if (editQuoteStatus) {
          editQuoteStatus.value = originalQuoteStatus;
        }
        // Scroll to edit panel
        editModePanel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      } else {
        editModePanel.classList.add('hidden');
        editQuoteBtn.classList.remove('hidden');
        // Clear search
        const newProductSearch = document.getElementById('newProductSearch') as HTMLInputElement;
        if (newProductSearch) newProductSearch.value = '';
        selectedNewProduct = null;
        const addBtn = document.getElementById('addProductToQuoteBtn') as HTMLButtonElement;
        if (addBtn) addBtn.disabled = true;
        document.getElementById('outsourcedAddSection')?.classList.add('hidden');
        document.getElementById('catalogAddSection')?.classList.remove('hidden');
        const toggleBtn = document.getElementById('toggleOutsourcedBtn') as HTMLButtonElement;
        if (toggleBtn) toggleBtn.textContent = '+ Add outsourced product';
      }
      
      renderProducts();
    }

    /**
     * Calculate the quote's Total Amount from the current products, including
     * discount and tax. Only products with a custom price set count.
     *
     * On a quote with options this is the FIRST option's total, not the sum of
     * all of them — the same rule create-room-quote.astro applies when it writes
     * the quote. The alternatives are never both bought, so pooling them would
     * roughly double every pipeline figure that reads this field. Without this,
     * editing one line on a two-option quote would quietly rewrite Total Amount
     * to the pooled figure.
     */
    function calculateTotal(): number {
      const groups = buildOptionGroups();
      const scope = groups[0].option === null ? currentProducts : groups[0].products;
      return scope.reduce((sum, product) => sum + lineTotalOf(product), 0);
    }

    /**
     * Update line item discount in ProductsForQuotes junction table
     */
    async function updateLineItemDiscount(junctionId: string, newDiscount: number, mode: string = 'percent') {
      try {
        console.log(`[LINE ITEM] Updating discount for junction ${junctionId} to ${newDiscount} (${mode})`);

        const fields: Record<string, any> = mode === 'rupees'
          ? { 'Discount Rs': newDiscount, 'Discount': 0 }
          : { 'Discount': newDiscount };

        const response = await fetch(
          `${API_BASE_URL}/proxy/products_for_quotes/records`,
          {
            method: 'PATCH',
            headers: {
              'Authorization': `Bearer ${token}`,
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({ id: junctionId, fields })
          }
        );

        if (!response.ok) {
          const errorText = await response.text();
          throw new Error(`Failed to update discount: ${errorText}`);
        }

        // Update local state
        const product = currentProducts.find(p => p.junctionId === parseInt(junctionId));
        if (product) {
          if (mode === 'rupees') {
            product.discountRs = newDiscount;
            product.discount = 0;
          } else {
            product.discount = newDiscount;
          }
        }

        const newTotal = calculateTotal();
        await updateQuote({ "Total Amount": newTotal });

      } catch (error) {
        console.error('[LINE ITEM] Error updating discount:', error);
        showToast('Failed to update discount. Please try again.', 'error');
        await loadQuoteDetails();
      }
    }

    async function clearLineItemDiscountRs(junctionId: string) {
      try {
        await fetch(`${API_BASE_URL}/proxy/products_for_quotes/records`, {
          method: 'PATCH',
          headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: junctionId, fields: { 'Discount Rs': null, 'Discount': 0 } })
        });

        const product = currentProducts.find(p => p.junctionId === parseInt(junctionId));
        if (product) {
          product.discountRs = null;
          product.discount = 0;
        }

        const newTotal = calculateTotal();
        await updateQuote({ "Total Amount": newTotal });
      } catch (error) {
        showToast('Failed to clear rupee discount. Please try again.', 'error');
        await loadQuoteDetails();
      }
    }
    
    /**
     * Update line item quantity in ProductsForQuotes junction table
     */
    async function updateLineItemQuantity(junctionId: string, newQuantity: number) {
      try {
        console.log(`[LINE ITEM] Updating quantity for junction ${junctionId} to ${newQuantity}`);
        
        const response = await fetch(
          `${API_BASE_URL}/proxy/products_for_quotes/records`,
          {
            method: 'PATCH',
            headers: {
              'Authorization': `Bearer ${token}`,
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              id: junctionId,
              fields: {
                'Quantity': newQuantity
              }
            })
          }
        );

        if (response.status === 401) {
          logout();
          return;
        }

        if (!response.ok) {
          const errorText = await response.text();
          console.error('[LINE ITEM] Failed to update quantity:', errorText);
          throw new Error('Failed to update quantity');
        }

        console.log('[LINE ITEM] Quantity updated successfully');
        
        // Update local state
        const product = currentProducts.find(p => p.junctionId === parseInt(junctionId));
        if (product) {
          product.quantity = newQuantity;
        }
        
        // Recalculate and update quote total
        const newTotal = calculateTotal();
        await updateQuote({ "Total Amount": newTotal });
        
        // Update the subtotal display
        updateSubtotalDisplay(junctionId);
      } catch (error) {
        console.error('Error updating quantity:', error);
        showToast('Failed to update quantity. Please try again.', 'error');
      }
    }

