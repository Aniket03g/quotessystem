    /**
     * Room-wise PDF. Kept entirely separate from generatePDF() above — its own
     * endpoint, its own handler — so nothing here can affect the standard quote
     * PDF. Reuses the saved terms but never prompts for them.
     */
    /**
     * The quote's option list, which NocoDB holds as a JSON array in a text
     * field. Anything unparseable is treated as "no options" rather than
     * thrown: a malformed field must not cost the user their PDF.
     */
    function parseQuoteOptions(raw: any): string[] {
      if (!raw) return [];
      if (Array.isArray(raw)) return raw.map((v) => String(v).trim()).filter(Boolean);
      try {
        const parsed = JSON.parse(String(raw));
        return Array.isArray(parsed) ? parsed.map((v) => String(v).trim()).filter(Boolean) : [];
      } catch {
        console.warn('[QUOTE DETAIL] Options field is not valid JSON:', raw);
        return [];
      }
    }

    async function generateSectionedPDF(preview: boolean = false) {
      if (!currentQuoteData) {
        showToast('Quote data not loaded', 'error');
        return;
      }

      const grouped = (currentQuoteData.products || []).some((p: any) => p.section);
      if (!grouped) {
        showToast('No floor/room set on this quote — the PDF will be ungrouped', 'info');
      }

      try {
