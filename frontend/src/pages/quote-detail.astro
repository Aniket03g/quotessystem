    /**
     * Add a new product to the quote via ProductsForQuotes junction table
     * Creates junction record with custom price (defaults to catalog price)
     */
    async function linkProduct(productId: string) {
      // Asked before anything is written: on a room-wise quote a line with no
      // Section is homeless, and the link below is not worth undoing.
      const destination = takeAddDestination();
      if (!destination) return;

      try {
        console.log(`[ADD PRODUCT] Adding product ${productId} to quote ${quoteId}`, destination);

        // Get the catalog price from selectedNewProduct
        const catalogPrice = selectedNewProduct?.price ? parseFloat(selectedNewProduct.price) : 0;
        
        // Step 1: Link product to quote (for compatibility)
        console.log('[ADD PRODUCT] Step 1: Linking product via links endpoint');
        const linkResponse = await fetch(
          `${API_BASE_URL}/proxy/quotes/links/products/${quoteId}`,
          {
            method: 'POST',
            headers: {
              'Authorization': `Bearer ${token}`,
              'Content-Type': 'application/json',
            },
            body: JSON.stringify([parseInt(productId)])
          }
        );

        if (linkResponse.status === 401) {
          logout();
          return;
        }

        if (!linkResponse.ok) {
          const errorText = await linkResponse.text();
          console.error('[ADD PRODUCT] Failed to link product:', errorText);
          throw new Error('Failed to link product');
        }

        console.log('[ADD PRODUCT] Product linked successfully');

        // Step 2: Create ProductsForQuotes junction record with custom price
        console.log('[ADD PRODUCT] Step 2: Creating ProductsForQuotes junction record');
        const junctionPayload = {
          fields: {
            'Quotes': parseInt(quoteId!),
            'Products': parseInt(productId),
            'Quantity': 1,
            'Custom Unit Price': catalogPrice,
            ...destination
          }
        };

        console.log('[ADD PRODUCT] Junction payload:', JSON.stringify(junctionPayload));

        const junctionResponse = await fetch(
          `${API_BASE_URL}/proxy/products_for_quotes/records`,
          {
            method: 'POST',
            headers: {
              'Authorization': `Bearer ${token}`,
              'Content-Type': 'application/json',
            },
            body: JSON.stringify(junctionPayload)
          }
        );

        if (junctionResponse.status === 401) {
          logout();
          return;
        }

        if (!junctionResponse.ok) {
          const errorText = await junctionResponse.text();
          console.error('[ADD PRODUCT] Failed to create junction record:', errorText);
          throw new Error('Failed to create ProductsForQuotes record');
        }

        const junctionResult = await safeJsonParse(junctionResponse);
        console.log('[ADD PRODUCT] Junction record created:', junctionResult);

        // Follow the product to where it landed, otherwise adding to the option
        // that isn't on screen looks like nothing happened.
        if (destination.Option) activeOptionKey = destination.Option;
        if (destination.Section) showToast(`Added to ${destination.Section}`, 'success');

        // Clear selection
        selectedNewProduct = null;
        const newProductSearch = document.getElementById('newProductSearch') as HTMLInputElement;
        newProductSearch.value = '';
        const addBtn = document.getElementById('addProductToQuoteBtn') as HTMLButtonElement;
        addBtn.disabled = true;
        
        // Reload quote to get updated products
        await loadQuoteDetails();
        
        // Recalculate total and update quote
        const newTotal = calculateTotal();
        await updateQuote({ "Total Amount": newTotal });
        
        console.log('[ADD PRODUCT] Product added successfully');
      } catch (error) {
        console.error('Error adding product:', error);
        showToast('Failed to add product. Please try again.', 'error');
      }
    }

    /**
     * Add an outsourced product (not in the Products catalog) directly to the
     * ProductsForQuotes junction table. No catalog link is created — the
     * "Products" field is left empty and custom fields carry the line item data.
     */
    async function addOutsourcedProduct() {
      const nameInput = document.getElementById('outsourcedName') as HTMLInputElement;
      const brandInput = document.getElementById('outsourcedBrand') as HTMLInputElement;
      const modelInput = document.getElementById('outsourcedModel') as HTMLInputElement;
      const hsnInput = document.getElementById('outsourcedHsn') as HTMLInputElement;
      const taxInput = document.getElementById('outsourcedTax') as HTMLInputElement;
      const warrantyInput = document.getElementById('outsourcedWarranty') as HTMLInputElement;
      const uomInput = document.getElementById('outsourcedUom') as HTMLInputElement;
      const priceInput = document.getElementById('outsourcedPrice') as HTMLInputElement;
      const qtyInput = document.getElementById('outsourcedQty') as HTMLInputElement;
      const descInput = document.getElementById('outsourcedDescription') as HTMLTextAreaElement;

      const name = nameInput.value.trim();
      const price = parseFloat(priceInput.value);
      const qty = parseInt(qtyInput.value || '1');
      const uom = uomInput.value.trim();

      if (!name || !price || !qty || !uom) {
        showToast('Please fill in product name, unit price, quantity and UOM', 'error');
        return;
      }

      const destination = takeAddDestination();
      if (!destination) return;

      try {
        const junctionPayload = {
          fields: {
            'Quotes': parseInt(quoteId!),
            'Quantity': qty,
            'Custom Unit Price': price,
            'Is Outsourced': true,
            'Custom Product Name': name,
            'Custom Brand': brandInput.value.trim() || null,
            'Custom Model No': modelInput.value.trim() || null,
            'Custom HSN': hsnInput.value.trim() || null,
            'Custom Tax': taxInput.value ? parseFloat(taxInput.value) : null,
            'Custom Warranty': warrantyInput.value ? parseInt(warrantyInput.value) : null,
            'Custom UOM': uom,
            'Custom Description': descInput.value.trim() || null,
            ...destination
          }
        };

        const response = await fetch(`${API_BASE_URL}/proxy/products_for_quotes/records`, {
          method: 'POST',
          headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
          body: JSON.stringify(junctionPayload)
        });

        if (response.status === 401) { logout(); return; }
        if (!response.ok) {
          const errorText = await response.text();
          console.error('[ADD OUTSOURCED] Failed to create junction record:', errorText);
          throw new Error('Failed to add outsourced product');
        }

        // Clear form
        nameInput.value = '';
        brandInput.value = '';
        modelInput.value = '';
        hsnInput.value = '';
        taxInput.value = '';
        warrantyInput.value = '';
        uomInput.value = '';
        priceInput.value = '';
        qtyInput.value = '1';
        descInput.value = '';

        if (destination.Option) activeOptionKey = destination.Option;

        await loadQuoteDetails();
        const newTotal = calculateTotal();
        await updateQuote({ "Total Amount": newTotal });

        showToast(destination.Section ? `Outsourced product added to ${destination.Section}` : 'Outsourced product added', 'success');
      } catch (error) {
        console.error('Error adding outsourced product:', error);
        showToast('Failed to add outsourced product. Please try again.', 'error');
      }
    }

    document.getElementById('toggleOutsourcedBtn')?.addEventListener('click', () => {
