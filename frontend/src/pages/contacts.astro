---
import AdminLayout from '../layouts/AdminLayout.astro';
---

<AdminLayout title="Contacts" currentPage="contacts">
  <!-- Page Header -->
  <div class="mb-6">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <h1 class="text-2xl font-semibold text-slate-800">Contacts</h1>
      </div>
      <a
        href="/add-contact"
        class="inline-flex items-center gap-2 px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
        </svg>
        Add Contact
      </a>
    </div>
  </div>

  <!-- Search and Filter Bar -->
  <div class="bg-white rounded-xl border border-slate-200 p-4 mb-6">
    <div class="flex flex-col lg:flex-row gap-3">
      <!-- Search -->
      <div class="flex-1 relative">
        <svg class="absolute left-3 top-3 w-5 h-5 text-slate-400 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
        <input
          type="text"
          id="searchInput"
          placeholder="Search by name or email..."
          class="w-full pl-10 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all"
          autocomplete="off"
        />
      </div>

      <!-- Account Filter -->
      <select
        id="accountFilter"
        class="px-3 py-2.5 bg-slate-50 border border-slate-200 rounded-lg text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all min-w-[200px]"
      >
        <option value="">All Accounts</option>
      </select>

      <!-- Sort -->
      <select
        id="sortBy"
        class="px-3 py-2.5 bg-slate-50 border border-slate-200 rounded-lg text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all min-w-[180px]"
      >
        <option value="name-asc" selected>Name A → Z</option>
        <option value="name-desc">Name Z → A</option>
      </select>

      <!-- Reset -->
      <button
        id="resetFilters"
        class="px-4 py-2.5 text-sm text-slate-600 border border-slate-200 bg-slate-50 rounded-lg hover:bg-slate-100 transition-colors whitespace-nowrap"
      >
        Reset
      </button>
    </div>

    <!-- Status line -->
    <div class="flex items-center gap-2 mt-3">
      <div id="searchSpinner" class="hidden animate-spin w-4 h-4 text-blue-600">
        <svg class="w-full h-full" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
      </div>
      <span id="searchStatus" class="text-sm text-slate-600"></span>
    </div>
  </div>

  <!-- Edit Modal -->
  <div id="editModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/40">
    <div class="bg-white rounded-xl shadow-xl w-full max-w-lg mx-4">
      <div class="flex items-center justify-between px-6 py-4 border-b border-slate-200">
        <h2 class="text-lg font-semibold text-slate-800">Edit Contact</h2>
        <button id="closeEditModal" class="text-slate-400 hover:text-slate-600 transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
      <div id="editModalError" class="hidden mx-6 mt-4 p-3 bg-red-50 border border-red-200 rounded-lg">
        <p class="text-sm text-red-800" id="editModalErrorText"></p>
      </div>
      <form id="editForm" class="p-6 grid grid-cols-1 md:grid-cols-2 gap-4">
        <input type="hidden" id="editContactId" />
        <input type="hidden" id="editSelectedAccountId" />
        <div class="md:col-span-2">
          <label class="block text-sm font-medium text-slate-700 mb-1">Contact Name <span class="text-red-500">*</span></label>
          <input type="text" id="editName" class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />
        </div>
        <div class="md:col-span-2 relative">
          <label class="block text-sm font-medium text-slate-700 mb-1">Account</label>
          <input
            type="text"
            id="editAccountSearch"
            placeholder="Search accounts..."
            autocomplete="off"
            class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
          />
          <div id="editAccountDropdown" class="hidden absolute z-10 w-full mt-1 bg-white border border-slate-200 rounded-lg shadow-lg max-h-48 overflow-y-auto">
            <div id="editAccountResults" class="py-1"></div>
            <div id="editAccountLoading" class="hidden px-4 py-3 text-sm text-slate-500 text-center">Searching...</div>
            <div id="editAccountEmpty" class="hidden px-4 py-3 text-sm text-slate-500 text-center">No accounts found</div>
          </div>
        </div>
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">Email</label>
          <input type="email" id="editEmail" class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />
        </div>
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">Phone Number</label>
          <input type="tel" id="editPhone" class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />
        </div>
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">Other Phone</label>
          <input type="tel" id="editOtherPhone" class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />
        </div>
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">Birth Date</label>
          <input type="date" id="editBirthDate" class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />
        </div>
        <div class="md:col-span-2">
          <label class="block text-sm font-medium text-slate-700 mb-1">Department</label>
          <input type="text" id="editDepartment" class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />
        </div>
      </form>
      <div class="px-6 py-4 bg-slate-50 rounded-b-xl flex justify-end gap-3">
        <button id="cancelEditBtn" class="px-4 py-2 text-slate-700 bg-white border border-slate-300 rounded-lg hover:bg-slate-50 transition-colors">Cancel</button>
        <button id="saveEditBtn" class="px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors font-medium disabled:opacity-50 disabled:cursor-not-allowed">Save Changes</button>
      </div>
    </div>
  </div>

  <!-- Contacts Table -->
  <div class="bg-white rounded-xl border border-slate-200 overflow-hidden">
    <!-- Loading State -->
    <div id="loading" class="hidden py-12 text-center">
      <svg class="animate-spin w-8 h-8 text-blue-600 mx-auto mb-3" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
      </svg>
      <p class="text-sm text-slate-600">Loading contacts...</p>
    </div>

    <!-- Error State -->
    <div id="error" class="hidden mx-6 my-4 p-4 bg-red-50 border border-red-200 rounded-lg">
      <div class="flex items-start gap-3">
        <svg class="w-5 h-5 text-red-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <p class="text-sm text-red-800" id="errorText"></p>
      </div>
    </div>

    <!-- Table -->
    <div id="contactsTable" class="hidden overflow-x-auto">
      <table class="w-full">
        <thead class="bg-slate-50 border-b border-slate-200">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-semibold text-slate-600 uppercase tracking-wider">#</th>
            <th class="px-6 py-3 text-left text-xs font-semibold text-slate-600 uppercase tracking-wider">CONTACT NAME</th>
            <th class="px-6 py-3 text-left text-xs font-semibold text-slate-600 uppercase tracking-wider">ACCOUNT</th>
            <th class="px-6 py-3 text-left text-xs font-semibold text-slate-600 uppercase tracking-wider">EMAIL</th>
            <th class="px-6 py-3 text-left text-xs font-semibold text-slate-600 uppercase tracking-wider">PHONE</th>
            <th class="px-6 py-3 text-left text-xs font-semibold text-slate-600 uppercase tracking-wider">ACTIONS</th>
          </tr>
        </thead>
        <tbody id="contactsBody" class="divide-y divide-slate-200"></tbody>
      </table>
    </div>

    <!-- Empty State -->
    <div id="emptyState" class="hidden py-12 text-center">
      <svg class="w-16 h-16 text-slate-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
      </svg>
      <p class="text-slate-600 font-medium mb-1">No contacts found</p>
      <p class="text-sm text-slate-500">Try adjusting your search or filters</p>
    </div>
  </div>


  <script>
    import { getToken, safeJsonParse } from '../lib/api';
    import { debounce } from '../utils/debounce';

    // Wait for DOM to be ready
    document.addEventListener('DOMContentLoaded', () => {
      const API_BASE_URL = `http://${window.location.hostname}:8082`;
      const token = getToken();

      function showConfirm(message, okLabel = 'Confirm', okClass = 'bg-red-600 hover:bg-red-700') {
        return new Promise((resolve) => {
          const dialog = document.getElementById('confirmDialog');
          const okBtn = document.getElementById('confirmOkBtn');
          const cancelBtn = document.getElementById('confirmCancelBtn');
          document.getElementById('confirmMessage').textContent = message;
          okBtn.textContent = okLabel;
          okBtn.className = `px-4 py-2 text-white text-sm font-medium rounded-lg transition-colors ${okClass}`;
          dialog.classList.remove('hidden');
          function cleanup(result) {
            dialog.classList.add('hidden');
            okBtn.removeEventListener('click', onOk);
            cancelBtn.removeEventListener('click', onCancel);
            dialog.removeEventListener('click', onOutside);
            resolve(result);
          }
          const onOk = () => cleanup(true);
          const onCancel = () => cleanup(false);
          const onOutside = (e) => { if (e.target === dialog) cleanup(false); };
          okBtn.addEventListener('click', onOk);
          cancelBtn.addEventListener('click', onCancel);
          dialog.addEventListener('click', onOutside);
        });
      }

      function showToast(message, type = 'info') {
        const container = document.getElementById('toastContainer');
        const toast = document.createElement('div');
        const bg = type === 'success' ? 'bg-emerald-500' : type === 'error' ? 'bg-red-500' : 'bg-slate-700';
        const icon = type === 'success'
          ? `<svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>`
          : type === 'error'
          ? `<svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`
          : `<svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`;
        toast.setAttribute('data-toast', '');
        toast.className = `pointer-events-auto flex items-center gap-3 px-4 py-3 rounded-xl text-white text-sm font-semibold shadow-xl max-w-sm ${bg} opacity-0 translate-x-4 transition-all duration-200`;
        toast.innerHTML = `${icon}<span class="flex-1 leading-snug">${message}</span><button class="ml-2 opacity-60 hover:opacity-100 text-base leading-none transition-opacity" onclick="this.closest('[data-toast]').remove()">✕</button>`;
        container.appendChild(toast);
        requestAnimationFrame(() => requestAnimationFrame(() => toast.classList.remove('opacity-0', 'translate-x-4')));
        setTimeout(() => { toast.classList.add('opacity-0', 'translate-x-4'); setTimeout(() => toast.remove(), 200); }, 3500);
      }

      if (!token) {
        window.location.href = '/login';
        return;
      }

      const loadingDiv = document.getElementById('loading') as HTMLDivElement;
      const errorDiv = document.getElementById('error') as HTMLDivElement;
      const errorText = document.getElementById('errorText') as HTMLParagraphElement;
      const contactsTable = document.getElementById('contactsTable') as HTMLDivElement;
      const contactsBody = document.getElementById('contactsBody') as HTMLTableSectionElement;
      const emptyState = document.getElementById('emptyState') as HTMLDivElement;
      const searchInput = document.getElementById('searchInput') as HTMLInputElement;
      const searchSpinner = document.getElementById('searchSpinner') as HTMLDivElement;
      const searchStatus = document.getElementById('searchStatus') as HTMLSpanElement;
      const accountFilter = document.getElementById('accountFilter') as HTMLSelectElement;
      const sortBy = document.getElementById('sortBy') as HTMLSelectElement;
      const resetFilters = document.getElementById('resetFilters') as HTMLButtonElement;

      if (!loadingDiv || !errorDiv || !errorText || !contactsTable || !contactsBody || !emptyState || !searchInput || !searchSpinner || !searchStatus) {
        console.error('[CONTACT LOOKUP] Some DOM elements not found');
        return;
      }

    let allContacts: any[] = [];

    async function loadContacts() {
      try {
        loadingDiv.classList.remove('hidden');
        contactsTable.classList.add('hidden');
        emptyState.classList.add('hidden');
        errorDiv.classList.add('hidden');

        const response = await fetch(`${API_BASE_URL}/proxy/contacts/records`, {
          method: 'GET',
          headers: {
            'Authorization': `Bearer ${token}`,
            'Content-Type': 'application/json',
          },
        });

        if (response.status === 401) {
          throw new Error('Unauthorized - please login again');
        }

        const data = await safeJsonParse(response);
        allContacts = data.records || [];
        populateAccountFilter();
        applyFilters();

      } catch (error) {
        console.error('[CONTACT LOAD ERROR]', error);
        loadingDiv.classList.add('hidden');
        errorText.textContent = error instanceof Error ? error.message : 'Failed to load contacts';
        errorDiv.classList.remove('hidden');

        if (error instanceof Error && error.message.includes('Unauthorized')) {
          setTimeout(() => { window.location.href = '/login'; }, 2000);
        }
      }
    }

    function populateAccountFilter() {
      const currentValue = accountFilter.value;
      const names = [...new Set(
        allContacts
          .map((r: any) => r.fields?.['Accounts duplicate']?.fields?.['Account Name'])
          .filter(Boolean)
      )].sort() as string[];

      accountFilter.innerHTML = '<option value="">All Accounts</option>' +
        names.map(n => `<option value="${n}"${n === currentValue ? ' selected' : ''}>${n}</option>`).join('');
    }

    function applyFilters() {
      const search = searchInput.value.trim().toLowerCase();
      const selectedAccount = accountFilter.value;
      const sort = sortBy.value;

      let result = allContacts.filter((record: any) => {
        const fields = record.fields || {};
        const name = (fields['Name'] || '').toLowerCase();
        const email = (fields['Email'] || '').toLowerCase();
        const accountName = fields['Accounts duplicate']?.fields?.['Account Name'] || '';
        if (search && !name.includes(search) && !email.includes(search)) return false;
        if (selectedAccount && accountName !== selectedAccount) return false;
        return true;
      });

      if (sort === 'name-asc') {
        result.sort((a: any, b: any) => (a.fields['Name'] || '').localeCompare(b.fields['Name'] || ''));
      } else if (sort === 'name-desc') {
        result.sort((a: any, b: any) => (b.fields['Name'] || '').localeCompare(a.fields['Name'] || ''));
      }

      displayResults(result);
    }

    function displayResults(contacts: any[]) {
      searchSpinner.classList.add('hidden');
      loadingDiv.classList.add('hidden');

      if (contacts.length === 0) {
        const search = searchInput.value.trim();
        searchStatus.textContent = search ? `No results for "${search}"` : 'No contacts found';
        searchStatus.classList.remove('text-blue-600');
        emptyState.classList.remove('hidden');
        contactsTable.classList.add('hidden');
        return;
      }

      searchStatus.textContent = `Showing ${contacts.length} contact${contacts.length !== 1 ? 's' : ''}`;
      searchStatus.classList.remove('text-blue-600');

      contactsBody.innerHTML = contacts.map((record: any, index: number) => {
        const fields = record.fields || {};
        const contactName = fields['Name'] || 'N/A';
        const accountObj = fields['Accounts duplicate'];
        const account = accountObj?.fields?.['Account Name'] || 'N/A';
        const email = fields['Email'] || 'N/A';
        const phone = fields['Phone Number'] || 'N/A';

        return `
          <tr class="hover:bg-slate-50 transition-colors">
            <td class="px-6 py-4 text-sm font-medium text-slate-900">${index + 1}</td>
            <td class="px-6 py-4 text-sm text-slate-900">${contactName}</td>
            <td class="px-6 py-4 text-sm text-slate-600">${account}</td>
            <td class="px-6 py-4 text-sm text-slate-600">${email}</td>
            <td class="px-6 py-4 text-sm text-slate-600">${phone}</td>
            <td class="px-6 py-4 text-sm">
              <div class="flex items-center gap-2">
                <button
                  class="edit-btn p-1.5 text-slate-400 hover:text-blue-600 hover:bg-blue-50 rounded transition-colors"
                  title="Edit"
                  data-id="${record.id}"
                  data-name="${contactName !== 'N/A' ? contactName : ''}"
                  data-email="${email !== 'N/A' ? email : ''}"
                  data-phone="${phone !== 'N/A' ? phone : ''}"
                  data-other-phone="${fields['Other Phone'] || ''}"
                  data-birth-date="${fields['Birth date'] || ''}"
                  data-department="${fields['Department'] || ''}"
                  data-account-id="${accountObj?.id || ''}"
                  data-account-name="${account !== 'N/A' ? account : ''}"
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                  </svg>
                </button>
                <button
                  class="delete-btn p-1.5 text-slate-400 hover:text-red-600 hover:bg-red-50 rounded transition-colors"
                  title="Delete"
                  data-id="${record.id}"
                  data-name="${contactName !== 'N/A' ? contactName : 'this contact'}"
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                  </svg>
                </button>
              </div>
            </td>
          </tr>
        `;
      }).join('');

      contactsTable.classList.remove('hidden');
      emptyState.classList.add('hidden');
    }

    // Initial load
    loadContacts();

    searchInput.addEventListener('input', debounce(() => applyFilters(), 300));
    accountFilter.addEventListener('change', applyFilters);
    sortBy.addEventListener('change', applyFilters);
    resetFilters.addEventListener('click', () => {
      searchInput.value = '';
      accountFilter.value = '';
      sortBy.value = 'name-asc';
      applyFilters();
    });

    // --- Edit / Delete via event delegation ---
    const editModal = document.getElementById('editModal') as HTMLDivElement;
    const editContactId = document.getElementById('editContactId') as HTMLInputElement;
    const editSelectedAccountId = document.getElementById('editSelectedAccountId') as HTMLInputElement;
    const editName = document.getElementById('editName') as HTMLInputElement;
    const editEmail = document.getElementById('editEmail') as HTMLInputElement;
    const editPhone = document.getElementById('editPhone') as HTMLInputElement;
    const editOtherPhone = document.getElementById('editOtherPhone') as HTMLInputElement;
    const editBirthDate = document.getElementById('editBirthDate') as HTMLInputElement;
    const editDepartment = document.getElementById('editDepartment') as HTMLInputElement;
    const saveEditBtn = document.getElementById('saveEditBtn') as HTMLButtonElement;
    const editModalError = document.getElementById('editModalError') as HTMLDivElement;
    const editModalErrorText = document.getElementById('editModalErrorText') as HTMLParagraphElement;
    const editAccountSearch = document.getElementById('editAccountSearch') as HTMLInputElement;
    const editAccountDropdown = document.getElementById('editAccountDropdown') as HTMLDivElement;
    const editAccountResults = document.getElementById('editAccountResults') as HTMLDivElement;
    const editAccountLoading = document.getElementById('editAccountLoading') as HTMLDivElement;
    const editAccountEmpty = document.getElementById('editAccountEmpty') as HTMLDivElement;

    // Account search inside edit modal
    let editAccountTimer: ReturnType<typeof setTimeout>;
    editAccountSearch.addEventListener('input', () => {
      clearTimeout(editAccountTimer);
      editSelectedAccountId.value = '';
      const q = editAccountSearch.value.trim();
      if (!q) { editAccountDropdown.classList.add('hidden'); return; }
      editAccountTimer = setTimeout(() => searchEditAccounts(q), 350);
    });
    editAccountSearch.addEventListener('focus', () => {
      if (editAccountSearch.value.trim() && editAccountResults.children.length > 0) {
        editAccountDropdown.classList.remove('hidden');
      }
    });
    document.addEventListener('click', (e) => {
      if (!editAccountSearch.contains(e.target as Node) && !editAccountDropdown.contains(e.target as Node)) {
        editAccountDropdown.classList.add('hidden');
      }
    });

    async function searchEditAccounts(q: string) {
      editAccountLoading.classList.remove('hidden');
      editAccountEmpty.classList.add('hidden');
      editAccountResults.innerHTML = '';
      editAccountDropdown.classList.remove('hidden');
      try {
        const where = encodeURIComponent(`(Company Name,like,%${q}%)`);
        const res = await fetch(`${API_BASE_URL}/proxy/accounts_duplicate/records?where=${where}&limit=10&fields=Id,Company%20Name`, {
          headers: { 'Authorization': `Bearer ${token}` }
        });
        const data = await res.json();
        const records = data.records || [];
        editAccountLoading.classList.add('hidden');
        if (records.length === 0) { editAccountEmpty.classList.remove('hidden'); return; }
        editAccountResults.innerHTML = records.map((r: any) => `
          <button type="button" class="w-full text-left px-4 py-2.5 hover:bg-slate-50 transition-colors border-b border-slate-100 last:border-0"
            data-id="${r.id}" data-name="${r.fields['Company Name'] || ''}">
            <span class="text-sm font-medium text-slate-800">${r.fields['Company Name'] || 'Unknown'}</span>
          </button>
        `).join('');
        editAccountResults.querySelectorAll('button').forEach(btn => {
          btn.addEventListener('click', () => {
            editSelectedAccountId.value = (btn as HTMLElement).dataset.id || '';
            editAccountSearch.value = (btn as HTMLElement).dataset.name || '';
            editAccountDropdown.classList.add('hidden');
          });
        });
      } catch {
        editAccountLoading.classList.add('hidden');
        editAccountEmpty.classList.remove('hidden');
      }
    }

    function openEditModal(btn: HTMLElement) {
      const ds = btn.dataset;
      editContactId.value = ds.id || '';
      editName.value = ds.name || '';
      editEmail.value = ds.email || '';
      editPhone.value = ds.phone || '';
      editOtherPhone.value = ds.otherPhone || '';
      editBirthDate.value = ds.birthDate || '';
      editDepartment.value = ds.department || '';
      // Pre-fill account
      editSelectedAccountId.value = ds.accountId || '';
      editAccountSearch.value = ds.accountName || '';
      editAccountDropdown.classList.add('hidden');
      editModalError.classList.add('hidden');
      saveEditBtn.disabled = false;
      saveEditBtn.textContent = 'Save Changes';
      editModal.classList.remove('hidden');
      editName.focus();
    }

    function closeModal() {
      editModal.classList.add('hidden');
    }

    document.getElementById('closeEditModal')!.addEventListener('click', closeModal);
    document.getElementById('cancelEditBtn')!.addEventListener('click', closeModal);
    editModal.addEventListener('click', (e) => {
      if (e.target === editModal) closeModal();
    });

    saveEditBtn.addEventListener('click', async () => {
      const id = editContactId.value;
      const name = editName.value.trim();
      if (!name) {
        editModalErrorText.textContent = 'Contact Name is required.';
        editModalError.classList.remove('hidden');
        return;
      }

      const fields: Record<string, string> = { 'Name': name };
      if (editEmail.value.trim()) fields['Email'] = editEmail.value.trim();
      if (editPhone.value.trim()) fields['Phone Number'] = editPhone.value.trim();
      if (editOtherPhone.value.trim()) fields['Other Phone'] = editOtherPhone.value.trim();
      if (editBirthDate.value.trim()) fields['Birth date'] = editBirthDate.value.trim();
      if (editDepartment.value.trim()) fields['Department'] = editDepartment.value.trim();

      saveEditBtn.disabled = true;
      saveEditBtn.textContent = 'Saving...';
      editModalError.classList.add('hidden');

      try {
        // Update contact fields
        const res = await fetch(`${API_BASE_URL}/proxy/contacts/records`, {
          method: 'PATCH',
          headers: {
            'Authorization': `Bearer ${token}`,
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ id, fields }),
        });

        if (!res.ok) {
          const errText = await res.text();
          console.error('[EDIT CONTACT] Failed:', errText);
          throw new Error('Failed to save changes');
        }

        // Link to account if a new account was selected
        const newAccountId = editSelectedAccountId.value;
        if (newAccountId) {
          const linkRes = await fetch(`${API_BASE_URL}/proxy/contacts/links/accounts_duplicate/${id}`, {
            method: 'POST',
            headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
            body: JSON.stringify([{ id: newAccountId }]),
          });
          if (!linkRes.ok) {
            console.error('[EDIT CONTACT] Account link failed:', await linkRes.text());
          }
        }

        closeModal();
        await loadContacts();
      } catch (err: any) {
        editModalErrorText.textContent = err.message || 'Failed to save changes';
        editModalError.classList.remove('hidden');
        saveEditBtn.disabled = false;
        saveEditBtn.textContent = 'Save Changes';
      }
    });

    async function deleteContact(id: string, name: string) {
      if (!await showConfirm(`Delete "${name}"? This cannot be undone.`, 'Delete')) return;

      try {
        const res = await fetch(`${API_BASE_URL}/proxy/contacts/records`, {
          method: 'DELETE',
          headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
          body: JSON.stringify({ id }),
        });

        if (!res.ok) {
          const errText = await res.text();
          console.error('[DELETE CONTACT] Failed:', errText);
          throw new Error('Failed to delete contact');
        }

        await loadContacts();
      } catch (err: any) {
        errorText.textContent = err.message || 'Failed to delete contact';
        errorDiv.classList.remove('hidden');
      }
    }

    contactsBody.addEventListener('click', (e) => {
      const editBtn = (e.target as Element).closest('.edit-btn') as HTMLElement | null;
      const deleteBtn = (e.target as Element).closest('.delete-btn') as HTMLElement | null;

      if (editBtn) openEditModal(editBtn);
      if (deleteBtn) deleteContact(deleteBtn.dataset.id || '', deleteBtn.dataset.name || 'this contact');
    });

    }); // Close DOMContentLoaded event listener
  </script>

  <!-- Toast Container -->
  <div id="toastContainer" class="fixed top-4 right-4 z-[9999] flex flex-col gap-2 pointer-events-none"></div>

  <!-- Confirm Dialog -->
  <div id="confirmDialog" class="hidden fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-[9998] flex items-center justify-center p-4">
    <div class="bg-white rounded-xl shadow-2xl w-full max-w-sm p-6">
      <p class="text-slate-800 font-semibold text-sm mb-5" id="confirmMessage"></p>
      <div class="flex gap-3 justify-end">
        <button id="confirmCancelBtn" class="px-4 py-2 bg-white border border-slate-300 text-slate-700 text-sm font-medium rounded-lg hover:bg-slate-50 transition-colors">Cancel</button>
        <button id="confirmOkBtn" class="px-4 py-2 text-white text-sm font-medium rounded-lg transition-colors"></button>
      </div>
    </div>
  </div>
</AdminLayout>
