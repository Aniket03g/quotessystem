    // Close Edit Modal
    function closeEditModal() {
      editLeadModal.classList.add('hidden');
      document.body.style.overflow = 'auto';
      currentEditingLead = null;
      editLeadForm.reset();
    }

    // Handle Edit Form Submission
    editLeadForm.addEventListener('submit', async (e) => {
      e.preventDefault();

      if (!currentEditingLead) return;

      const leadId = (document.getElementById('editLeadId') as HTMLInputElement).value;
      const leadName = (document.getElementById('editLeadName') as HTMLInputElement).value;
      const company = (document.getElementById('editCompany') as HTMLInputElement).value;
      const contactPerson = (document.getElementById('editContactPerson') as HTMLInputElement).value;
      const phoneNumber = (document.getElementById('editPhoneNumber') as HTMLInputElement).value;
      const email = (document.getElementById('editEmail') as HTMLInputElement).value;
      const source = (document.getElementById('editSource') as HTMLSelectElement).value;
      const status = (document.getElementById('editStatus') as HTMLSelectElement).value;
      const assignedTo = (document.getElementById('editAssignedTo') as HTMLSelectElement).value;
      const lastContacted = (document.getElementById('editLastContacted') as HTMLInputElement).value;
      const nextFollowUp = (document.getElementById('editNextFollowUp') as HTMLInputElement).value;
      const notes = (document.getElementById('editNotes') as HTMLTextAreaElement).value;

      if (!leadName || !phoneNumber || !source || !status) {
        showToast('Please fill in all required fields', 'error');
        return;
      }

      saveEditBtn.disabled = true;
      saveEditBtn.textContent = 'Saving...';

      try {
        const updatePayload = {
          id: leadId,
          fields: {
            'Lead Name': leadName,
            'Company': company || '',
            'Contact Person': contactPerson || '',
            'Phone Number': phoneNumber,
            'Email': email || '',
            'Source': source,
            'Status': status,
            'Assigned to': assignedTo || '',
            'Last Contacted': lastContacted || null,
            'Next Follow-up': nextFollowUp || null,
            'Notes': notes || ''
          }
        };

        console.log('[LEAD UPDATE] Payload:', JSON.stringify(updatePayload, null, 2));

        const updateResponse = await fetch(`${API_BASE_URL}/proxy/leads/records`, {
          method: 'PATCH',
          headers: {
            'Authorization': `Bearer ${token}`,
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(updatePayload)
        });

        console.log('[LEAD UPDATE] Response status:', updateResponse.status);

        if (!updateResponse.ok) {
          const errorText = await updateResponse.text();
          console.error('[LEAD UPDATE] Error response:', errorText);
          throw new Error('Failed to update lead');
        }

        const result = await safeJsonParse(updateResponse);
        console.log('[LEAD UPDATE] Response data:', result);

        // Close modal
        closeEditModal();

        // Reload leads to reflect changes
        await loadLeads();

        showToast('Lead updated successfully!', 'success');
      } catch (error) {
        console.error('[LEAD UPDATE] Error:', error);
        showToast(error instanceof Error ? error.message : 'Failed to update lead', 'error');
      } finally {
        saveEditBtn.disabled = false;
        saveEditBtn.textContent = 'Save Changes';
      }
    });

    // Modal close handlers
    closeModalBtn.addEventListener('click', closeEditModal);
    cancelEditBtn.addEventListener('click', closeEditModal);
    
    // Close modal when clicking outside
    editLeadModal.addEventListener('click', (e) => {
      if (e.target === editLeadModal) {
        closeEditModal();
      }
    });

    // Delete Lead Function (Admin Only)
    async function deleteLead(leadId: number) {
      const userRole = getUserRole();
      
      // Check if user is admin
      if (userRole !== 'admin') {
        showToast('Only administrators can delete leads.', 'error');
        return;
      }

      // Confirm deletion
      const lead = allLeads.find((l: any) => l.id === leadId);
      const leadName = lead?.fields?.['Lead Name'] || 'this lead';
      
      if (!await showConfirm(`Delete "${leadName}"? This cannot be undone.`, 'Delete')) {
        return;
      }

      try {
        console.log('[LEAD DELETE] Deleting lead ID:', leadId);

        const deleteResponse = await fetch(`${API_BASE_URL}/proxy/leads/records`, {
          method: 'DELETE',
          headers: {
            'Authorization': `Bearer ${token}`,
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ id: leadId })
        });

        console.log('[LEAD DELETE] Response status:', deleteResponse.status);

        if (!deleteResponse.ok) {
          const errorText = await deleteResponse.text();
          console.error('[LEAD DELETE] Error response:', errorText);
          throw new Error('Failed to delete lead');
        }

        console.log('[LEAD DELETE] Lead deleted successfully');

        // Reload leads to reflect changes
        await loadLeads();

        showToast('Lead deleted successfully!', 'success');
      } catch (error) {
        console.error('[LEAD DELETE] Error:', error);
        showToast(error instanceof Error ? error.message : 'Failed to delete lead', 'error');
      }
    }

    // Quick action: mark as Contacted + set Last Contacted = today
    async function markContacted(leadId: number) {
      const lead = allLeads.find((l: any) => l.id === leadId);
      if (!lead) return;

      const today = new Date().toISOString().split('T')[0];

      // Optimistic update
      lead.fields['Status'] = 'Contacted';
      lead.fields['Last Contacted'] = today;
      updateStats(allLeads);
      applyFilters();

      try {
        const res = await fetch(`${API_BASE_URL}/proxy/leads/records`, {
          method: 'PATCH',
          headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: leadId, fields: { 'Status': 'Contacted', 'Last Contacted': today } })
        });
        if (!res.ok) throw new Error('PATCH failed');
      } catch {
        await loadLeads();
        showToast('Failed to mark as contacted. Changes reverted.', 'error');
      }
    }

    // Quick action: push Next Follow-up forward by 1 day
    async function snoozeFollowUp(leadId: number) {
      const lead = allLeads.find((l: any) => l.id === leadId);
      if (!lead) return;

      const current = lead.fields?.['Next Follow-up'];
      if (!current) return;

      const d = new Date(current);
      d.setDate(d.getDate() + 1);
      const newDate = d.toISOString().split('T')[0];

      const updatedPushLog = [...getPushLog(lead.fields), { by: userEmail || 'unknown', at: new Date().toISOString() }];

      // Optimistic update
      lead.fields['Next Follow-up'] = newDate;
      lead.fields['Push Log'] = updatedPushLog;
      updateStats(allLeads);
      applyFilters();

      try {
        const res = await fetch(`${API_BASE_URL}/proxy/leads/records`, {
          method: 'PATCH',
          headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: leadId, fields: { 'Next Follow-up': newDate, 'Push Log': updatedPushLog } })
        });
        if (!res.ok) throw new Error('PATCH failed');
      } catch {
        await loadLeads();
        showToast('Failed to snooze follow-up. Changes reverted.', 'error');
      }
    }

