---
import AdminLayout from '../layouts/AdminLayout.astro';
---

<AdminLayout title="Manage Leads - Grove Systems" currentPage="leads">
  <!-- Page Header -->
  <div class="mb-6">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <h1 class="text-2xl font-semibold text-slate-800">Lead Management</h1>
      </div>
      <div class="flex items-center gap-3">
        <button id="holidayModeBtn" class="inline-flex items-center gap-2 px-4 py-3 bg-amber-50 text-amber-700 text-sm font-semibold rounded-lg hover:bg-amber-100 transition-all border border-amber-200">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
          </svg>
          Away / Holiday
        </button>
        <a href="/create-lead" class="inline-flex items-center gap-2 px-6 py-3 bg-green-500 text-white text-base font-semibold rounded-lg hover:bg-green-600 transition-all shadow-lg hover:shadow-xl">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
          </svg>
          Add New Lead
        </a>
      </div>
    </div>
  </div>

  <!-- Holiday / Away Panel -->
  <div id="holidayPanel" class="hidden bg-amber-50 border border-amber-200 rounded-xl p-4 mb-5">
    <div class="flex flex-col sm:flex-row sm:items-center gap-3 flex-wrap">
      <div class="flex items-center gap-2 text-amber-800 font-semibold text-sm">
        <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
        </svg>
        Away / Holiday — showing leads needing attention while you're out
      </div>
      <div class="flex items-center gap-2 flex-wrap sm:ml-auto">
        <div class="flex items-center gap-2">
          <label class="text-xs font-medium text-amber-700 whitespace-nowrap">From</label>
          <input type="date" id="holidayStart" class="px-3 py-1.5 border border-amber-300 rounded-lg text-sm bg-white focus:outline-none focus:ring-2 focus:ring-amber-400" />
        </div>
        <div class="flex items-center gap-2">
          <label class="text-xs font-medium text-amber-700 whitespace-nowrap">To</label>
          <input type="date" id="holidayEnd" class="px-3 py-1.5 border border-amber-300 rounded-lg text-sm bg-white focus:outline-none focus:ring-2 focus:ring-amber-400" />
        </div>
        <span id="holidaySummary" class="text-xs font-semibold text-amber-700 bg-amber-100 px-2.5 py-1 rounded-full"></span>
        <button id="exitHolidayBtn" class="px-3 py-1.5 bg-white border border-amber-300 text-amber-700 text-xs font-semibold rounded-lg hover:bg-amber-50 transition-colors">
          Exit
        </button>
      </div>
    </div>
  </div>

  <!-- Smart Action Tabs -->
  <div class="flex gap-2 mb-6 flex-wrap">
    <button class="smart-tab px-4 py-2 rounded-full text-sm font-semibold bg-slate-800 text-white shadow-sm transition-all" data-tab="all">
      All <span class="tab-count ml-1.5 bg-white/20 px-1.5 py-0.5 rounded-full text-xs font-bold text-white" id="tabAll">0</span>
    </button>
    <button class="smart-tab px-4 py-2 rounded-full text-sm font-semibold bg-white text-slate-600 border border-slate-200 hover:bg-slate-50 shadow-sm transition-all" data-tab="overdue">
      <span class="inline-block w-2 h-2 rounded-full bg-red-500 mr-1.5 align-middle"></span>Overdue <span class="tab-count ml-1 bg-slate-100 px-1.5 py-0.5 rounded-full text-xs font-bold text-slate-700" id="tabOverdue">0</span>
    </button>
    <button class="smart-tab px-4 py-2 rounded-full text-sm font-semibold bg-white text-slate-600 border border-slate-200 hover:bg-slate-50 shadow-sm transition-all" data-tab="today">
      <span class="inline-block w-2 h-2 rounded-full bg-amber-400 mr-1.5 align-middle"></span>Today <span class="tab-count ml-1 bg-slate-100 px-1.5 py-0.5 rounded-full text-xs font-bold text-slate-700" id="tabToday">0</span>
    </button>
    <button class="smart-tab px-4 py-2 rounded-full text-sm font-semibold bg-white text-slate-600 border border-slate-200 hover:bg-slate-50 shadow-sm transition-all" data-tab="tomorrow">
      <span class="inline-block w-2 h-2 rounded-full bg-blue-400 mr-1.5 align-middle"></span>Tomorrow <span class="tab-count ml-1 bg-slate-100 px-1.5 py-0.5 rounded-full text-xs font-bold text-slate-700" id="tabTomorrow">0</span>
    </button>
    <button class="smart-tab px-4 py-2 rounded-full text-sm font-semibold bg-white text-slate-600 border border-slate-200 hover:bg-slate-50 shadow-sm transition-all" data-tab="week">
      <span class="inline-block w-2 h-2 rounded-full bg-green-400 mr-1.5 align-middle"></span>This Week <span class="tab-count ml-1 bg-slate-100 px-1.5 py-0.5 rounded-full text-xs font-bold text-slate-700" id="tabWeek">0</span>
    </button>
    <button class="smart-tab px-4 py-2 rounded-full text-sm font-semibold bg-white text-slate-600 border border-slate-200 hover:bg-slate-50 shadow-sm transition-all" data-tab="no-date">
      <span class="inline-block w-2 h-2 rounded-full bg-slate-400 mr-1.5 align-middle"></span>No Date <span class="tab-count ml-1 bg-slate-100 px-1.5 py-0.5 rounded-full text-xs font-bold text-slate-700" id="tabNoDate">0</span>
    </button>
  </div>

  <!-- Search and Filter Bar -->
  <div class="bg-white rounded-xl border border-slate-200 p-4 mb-6">
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-4">
      <!-- Search -->
      <div class="relative">
        <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
        <input 
          type="text" 
          id="searchInput" 
          placeholder="Name, company, phone..." 
          class="w-full pl-10 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all"
          autocomplete="off"
        />
      </div>

      <!-- Status Filter -->
      <div>
        <select 
          id="statusFilter" 
          class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all"
        >
          <option value="">All Status</option>
          <option value="New">New</option>
          <option value="Contacted">Contacted</option>
          <option value="Qualified">Qualified</option>
          <option value="Proposal Sent">Proposal Sent</option>
          <option value="Negotiation">Negotiation</option>
          <option value="Converted">Converted</option>
          <option value="Lost">Lost</option>
        </select>
      </div>

      <!-- Lead Source Filter -->
      <div>
        <select 
          id="sourceFilter" 
          class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all"
        >
          <option value="">All Types</option>
          <option value="Website">Website</option>
          <option value="Referral">Referral</option>
          <option value="Cold Call">Cold Call</option>
          <option value="IndiaMart">IndiaMart</option>
          <option value="Event">Event</option>
        </select>
      </div>

      <!-- Assigned To Filter -->
      <div>
        <select 
          id="assignedToFilter" 
          class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all"
        >
          <option value="">All Users</option>
        </select>
      </div>
    </div>

    <!-- Filter Button -->
    <div class="mt-4 flex gap-2">
      <button 
        id="filterBtn"
        class="px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors"
      >
        <svg class="w-4 h-4 inline-block mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"></path>
        </svg>
        Filter
      </button>
      <button 
        id="clearBtn"
        class="px-4 py-2 bg-slate-200 text-slate-700 text-sm font-medium rounded-lg hover:bg-slate-300 transition-colors"
      >
        Clear
      </button>
    </div>
  </div>

  <!-- Leads Table -->
  <div class="bg-white rounded-xl border border-slate-200 overflow-hidden">
    <!-- Loading State -->
    <div id="loading" class="py-12 text-center">
      <svg class="animate-spin w-8 h-8 text-blue-600 mx-auto mb-3" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
      </svg>
      <p class="text-sm text-slate-600">Loading leads...</p>
    </div>

    <!-- Error State -->
    <div id="error" class="hidden mx-6 my-4 p-4 bg-red-50 border border-red-200 rounded-lg">
      <div class="flex items-start gap-3">
        <svg class="w-5 h-5 text-red-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <p class="text-sm text-red-800" id="errorText"></p>
      </div>
    </div>

    <!-- Table -->
    <div id="leadsTable" class="hidden">
      <div id="leadsDesktopTable">
        <table class="w-full table-fixed">
          <thead class="bg-slate-50 border-b border-slate-200">
            <tr>
              <th class="w-[20%] px-4 py-3 text-left text-xs font-semibold text-slate-600 uppercase tracking-wider">Lead Info</th>
              <th class="w-[16%] px-4 py-3 text-left text-xs font-semibold text-slate-600 uppercase tracking-wider">Contact</th>
              <th class="w-[13%] px-4 py-3 text-left text-xs font-semibold text-slate-600 uppercase tracking-wider">Status</th>
              <th class="w-[10%] px-4 py-3 text-left text-xs font-semibold text-slate-600 uppercase tracking-wider">Type</th>
              <th class="w-[11%] px-4 py-3 text-left text-xs font-semibold text-slate-600 uppercase tracking-wider">Assigned</th>
              <th class="w-[10%] px-4 py-3 text-left text-xs font-semibold text-slate-600 uppercase tracking-wider">Last Contact</th>
              <th class="w-[10%] px-4 py-3 text-left text-xs font-semibold text-slate-600 uppercase tracking-wider">Follow-up</th>
              <th class="w-[10%] px-4 py-3 text-left text-xs font-semibold text-slate-600 uppercase tracking-wider">Actions</th>
            </tr>
          </thead>
          <tbody id="leadsBody" class="divide-y divide-slate-200"></tbody>
        </table>
      </div>
      <div id="leadsMobileList" class="divide-y divide-slate-100"></div>
    </div>

    <!-- Empty State -->
    <div id="emptyState" class="hidden py-12 text-center">
      <svg class="w-16 h-16 text-slate-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
      </svg>
      <p class="text-slate-600 font-medium mb-1">No leads found</p>
      <p class="text-sm text-slate-500">Click "Add New Lead" to get started</p>
    </div>
  </div>

  <!-- Edit Lead Modal -->
  <div id="editLeadModal" class="hidden fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-xl shadow-2xl max-w-3xl w-full max-h-[90vh] overflow-y-auto">
      <!-- Modal Header -->
      <div class="sticky top-0 bg-white border-b border-slate-200 px-6 py-4 flex items-center justify-between">
        <h2 class="text-xl font-bold text-slate-800">Edit Lead</h2>
        <button id="closeModalBtn" class="p-2 hover:bg-slate-100 rounded-lg transition-colors">
          <svg class="w-5 h-5 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>

      <!-- Modal Body -->
      <form id="editLeadForm" class="p-6 space-y-6">
        <input type="hidden" id="editLeadId" />

        <!-- Lead Information -->
        <div>
          <h3 class="text-base font-semibold text-slate-800 mb-4">Lead Information</h3>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <!-- Lead Name -->
            <div>
              <label for="editLeadName" class="block text-sm font-medium text-slate-700 mb-2">Lead Name *</label>
              <input 
                type="text" 
                id="editLeadName" 
                required 
                class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all" 
              />
            </div>

            <!-- Company -->
            <div>
              <label for="editCompany" class="block text-sm font-medium text-slate-700 mb-2">Company</label>
              <input 
                type="text" 
                id="editCompany" 
                class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all" 
              />
            </div>

            <!-- Contact Person -->
            <div>
              <label for="editContactPerson" class="block text-sm font-medium text-slate-700 mb-2">Contact Person</label>
              <input 
                type="text" 
                id="editContactPerson" 
                class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all" 
              />
            </div>

            <!-- Phone Number -->
            <div>
              <label for="editPhoneNumber" class="block text-sm font-medium text-slate-700 mb-2">Phone Number *</label>
              <input 
                type="tel" 
                id="editPhoneNumber" 
                required 
                class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all" 
              />
            </div>

            <!-- Email -->
            <div>
              <label for="editEmail" class="block text-sm font-medium text-slate-700 mb-2">Email</label>
              <input 
                type="email" 
                id="editEmail" 
                class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all" 
              />
            </div>

            <!-- Lead Source -->
            <div>
              <label for="editSource" class="block text-sm font-medium text-slate-700 mb-2">Lead Source *</label>
              <select 
                id="editSource" 
                required 
                class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all"
              >
                <option value="">Select Lead Source</option>
                <option value="Website">Website</option>
                <option value="Referral">Referral</option>
                <option value="Cold Call">Cold Call</option>
                <option value="IndiaMart">IndiaMart</option>
                <option value="Event">Event</option>
              </select>
            </div>

            <!-- Status -->
            <div>
              <label for="editStatus" class="block text-sm font-medium text-slate-700 mb-2">Status <span class="text-xs text-slate-500"></span></label>
              <select 
                id="editStatus" 
                required 
                class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all"
              >
                <option value="New">New</option>
                <option value="Contacted">Contacted</option>
                <option value="Qualified">Qualified</option>
                <option value="Proposal Sent">Proposal Sent</option>
                <option value="Negotiation">Negotiation</option>
                <option value="Converted">Converted</option>
                <option value="Lost">Lost</option>
              </select>
            </div>

            <!-- Assign To (Admin Only) -->
            <div id="editAssignedToContainer">
              <label for="editAssignedTo" class="block text-sm font-medium text-slate-700 mb-2">
                Assign To 
                <span class="text-xs text-orange-600"></span>
              </label>
              <select 
                id="editAssignedTo" 
                class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all"
              >
                <option value="">Select User (Optional)</option>
              </select>
            </div>

            <!-- Last Contacted -->
            <div>
              <label for="editLastContacted" class="block text-sm font-medium text-slate-700 mb-2">Last Contacted</label>
              <input 
                type="date" 
                id="editLastContacted" 
                class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all" 
              />
            </div>

            <!-- Next Follow-up -->
            <div>
              <label for="editNextFollowUp" class="block text-sm font-medium text-slate-700 mb-2">Next Follow-up</label>
              <input 
                type="date" 
                id="editNextFollowUp" 
                class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all" 
              />
            </div>
          </div>
        </div>

        <!-- Notes -->
        <div>
          <label for="editNotes" class="block text-sm font-medium text-slate-700 mb-2">Notes / Requirements</label>
          <textarea 
            id="editNotes" 
            rows="4" 
            class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all" 
            placeholder="Additional notes about the lead..."
          ></textarea>
        </div>

        <!-- Modal Footer -->
        <div class="flex gap-3 justify-end pt-4 border-t border-slate-200">
          <button 
            type="button"
            id="cancelEditBtn"
            class="px-6 py-2.5 bg-white border border-slate-300 text-slate-700 text-sm font-medium rounded-md hover:bg-slate-50 transition-colors"
          >
            Cancel
          </button>
          <button 
            type="submit" 
            id="saveEditBtn"
            class="px-6 py-2.5 bg-indigo-600 text-white text-sm font-medium rounded-md hover:bg-indigo-700 transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
          >
            Save Changes
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Convert to Account Modal -->
  <div id="convertModal" class="hidden fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-xl shadow-2xl max-w-xl w-full">
      <div class="px-6 py-4 border-b border-slate-200 flex items-center justify-between">
        <div>
          <h2 class="text-lg font-bold text-slate-800">Convert Lead to Account</h2>
          <p class="text-xs text-slate-500 mt-0.5">The following data will be copied to a new Account</p>
        </div>
        <button id="closeConvertModalBtn" class="p-2 hover:bg-slate-100 rounded-lg transition-colors">
          <svg class="w-5 h-5 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>

      <div class="p-6 space-y-4">
        <div id="convertPreview" class="bg-slate-50 rounded-lg p-4 space-y-2.5 border border-slate-200 max-h-[55vh] overflow-y-auto"></div>

        <div id="convertSuccess" class="hidden p-4 bg-green-50 border border-green-200 rounded-lg space-y-2">
          <p class="text-green-800 text-sm font-medium" id="convertSuccessText"></p>
          <a id="viewAccountLink" href="#" class="inline-flex items-center gap-1 text-sm text-green-700 font-semibold hover:underline">
            View Account
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </a>
        </div>

        <div id="convertError" class="hidden p-4 bg-red-50 border border-red-200 rounded-lg">
          <p class="text-red-800 text-sm" id="convertErrorText"></p>
        </div>
      </div>

      <div id="convertModalFooter" class="px-6 py-4 border-t border-slate-200 flex justify-end gap-3">
        <button id="cancelConvertBtn" class="px-4 py-2 text-slate-700 bg-white border border-slate-300 rounded-lg text-sm font-medium hover:bg-slate-50 transition-colors">
          Cancel
        </button>
        <button id="confirmConvertBtn" class="px-5 py-2 bg-emerald-600 text-white rounded-lg text-sm font-semibold hover:bg-emerald-700 transition-colors disabled:opacity-50 disabled:cursor-not-allowed flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path>
          </svg>
          Convert to Account
        </button>
      </div>
    </div>
  </div>

  <!-- Toast Container -->
  <div id="toastContainer" class="fixed top-4 right-4 z-[9999] flex flex-col gap-2 pointer-events-none"></div>

  <!-- Confirm Dialog -->
  <div id="confirmDialog" class="hidden fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-[9998] flex items-center justify-center p-4">
    <div class="bg-white rounded-xl shadow-2xl w-full max-w-sm p-6">
      <p class="text-slate-800 font-semibold text-sm mb-5" id="confirmMessage"></p>
      <div class="flex gap-3 justify-end">
        <button id="confirmCancelBtn" class="px-4 py-2 bg-white border border-slate-300 text-slate-700 text-sm font-medium rounded-lg hover:bg-slate-50 transition-colors">Cancel</button>
        <button id="confirmOkBtn" class="px-4 py-2 text-white text-sm font-medium rounded-lg transition-colors"></button>
      </div>
    </div>
  </div>


  <script>
    import { getToken, logout, safeJsonParse, getUserInfo } from '../lib/api';
    import { debounce } from '../utils/debounce';

    const API_BASE_URL = import.meta.env.PUBLIC_API_BASE_URL ||
      `${window.location.protocol}//${window.location.hostname}:8082`;

    function showConfirm(message: string, okLabel = 'Confirm', okClass = 'bg-red-600 hover:bg-red-700'): Promise<boolean> {
      return new Promise((resolve) => {
        const dialog = document.getElementById('confirmDialog') as HTMLDivElement;
        const okBtn = document.getElementById('confirmOkBtn') as HTMLButtonElement;
        const cancelBtn = document.getElementById('confirmCancelBtn') as HTMLButtonElement;
        (document.getElementById('confirmMessage') as HTMLElement).textContent = message;
        okBtn.textContent = okLabel;
        okBtn.className = `px-4 py-2 text-white text-sm font-medium rounded-lg transition-colors ${okClass}`;
        dialog.classList.remove('hidden');
        function cleanup(result: boolean) {
          dialog.classList.add('hidden');
          okBtn.removeEventListener('click', onOk);
          cancelBtn.removeEventListener('click', onCancel);
          dialog.removeEventListener('click', onOutside);
          resolve(result);
        }
        const onOk = () => cleanup(true);
        const onCancel = () => cleanup(false);
        const onOutside = (e: MouseEvent) => { if (e.target === dialog) cleanup(false); };
        okBtn.addEventListener('click', onOk);
        cancelBtn.addEventListener('click', onCancel);
        dialog.addEventListener('click', onOutside);
      });
    }

    function showToast(message: string, type: 'success' | 'error' | 'info' = 'info') {
      const container = document.getElementById('toastContainer')!;
      const toast = document.createElement('div');
      const bg = type === 'success' ? 'bg-emerald-500' : type === 'error' ? 'bg-red-500' : 'bg-slate-700';
      const icon = type === 'success'
        ? `<svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>`
        : type === 'error'
        ? `<svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`
        : `<svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`;
      toast.setAttribute('data-toast', '');
      toast.className = `pointer-events-auto flex items-center gap-3 px-4 py-3 rounded-xl text-white text-sm font-semibold shadow-xl max-w-sm ${bg} opacity-0 translate-x-4 transition-all duration-200`;
      toast.innerHTML = `${icon}<span class="flex-1 leading-snug">${message}</span><button class="ml-2 opacity-60 hover:opacity-100 text-base leading-none transition-opacity" onclick="this.closest('[data-toast]').remove()">✕</button>`;
      container.appendChild(toast);
      requestAnimationFrame(() => requestAnimationFrame(() => {
        toast.classList.remove('opacity-0', 'translate-x-4');
      }));
      setTimeout(() => {
        toast.classList.add('opacity-0', 'translate-x-4');
        setTimeout(() => toast.remove(), 200);
      }, 3500);
    }

    function getUserEmail(): string | null {
      return localStorage.getItem('user_email');
    }

    function getUserRole(): string | null {
      const userInfo = getUserInfo();
      return userInfo ? userInfo.role : null;
    }

    const token = getToken();
    if (!token) {
      window.location.href = '/login';
    }

    const userRole = getUserRole();
    const userEmail = getUserEmail();

    const loadingDiv = document.getElementById('loading') as HTMLDivElement;
    const errorDiv = document.getElementById('error') as HTMLDivElement;
    const leadsTable = document.getElementById('leadsTable') as HTMLDivElement;
    const leadsBody = document.getElementById('leadsBody') as HTMLTableSectionElement;
    const emptyState = document.getElementById('emptyState') as HTMLDivElement;
    const leadsMobileList = document.getElementById('leadsMobileList') as HTMLDivElement;
    const searchInput = document.getElementById('searchInput') as HTMLInputElement;
    const statusFilter = document.getElementById('statusFilter') as HTMLSelectElement;
    const sourceFilter = document.getElementById('sourceFilter') as HTMLSelectElement;
    const assignedToFilter = document.getElementById('assignedToFilter') as HTMLSelectElement;
    const filterBtn = document.getElementById('filterBtn') as HTMLButtonElement;
    const clearBtn = document.getElementById('clearBtn') as HTMLButtonElement;

    let allLeads: any[] = [];
    let usersMap: Map<string, string> = new Map(); // email -> name mapping

    // Relative date formatting
    function getRelativeTime(dateString: string): { relative: string; exact: string } {
      if (!dateString) return { relative: '-', exact: '' };
      
      const date = new Date(dateString);
      const now = new Date();
      const diffMs = date.getTime() - now.getTime();
      const diffHours = Math.floor(diffMs / (1000 * 60 * 60));

      // Calendar-day diff (midnight-to-midnight, local timezone) so this stays
      // in sync with getFollowUpCategory and the smart-chip counts.
      const dateNorm = new Date(dateString);
      dateNorm.setHours(0, 0, 0, 0);
      const todayNorm = new Date();
      todayNorm.setHours(0, 0, 0, 0);
      const diffDays = Math.round((dateNorm.getTime() - todayNorm.getTime()) / (1000 * 60 * 60 * 24));
      
      let relative = '';
      
      if (diffDays === 0) {
        if (diffHours === 0) {
          relative = 'Today';
        } else if (diffHours > 0) {
          relative = `In ${diffHours}h`;
        } else {
          relative = `${Math.abs(diffHours)}h ago`;
        }
      } else if (diffDays === 1) {
        relative = 'Tomorrow';
      } else if (diffDays === -1) {
        relative = 'Yesterday';
      } else if (diffDays > 1 && diffDays <= 7) {
        relative = `In ${diffDays} days`;
      } else if (diffDays > 7 && diffDays <= 30) {
        const weeks = Math.floor(diffDays / 7);
        relative = `In ${weeks} week${weeks > 1 ? 's' : ''}`;
      } else if (diffDays > 30) {
        const months = Math.floor(diffDays / 30);
        relative = `In ${months} month${months > 1 ? 's' : ''}`;
      } else if (diffDays < -1 && diffDays >= -7) {
        relative = `${Math.abs(diffDays)} days ago`;
      } else if (diffDays < -7 && diffDays >= -30) {
        const weeks = Math.floor(Math.abs(diffDays) / 7);
        relative = `${weeks} week${weeks > 1 ? 's' : ''} ago`;
      } else if (diffDays < -30) {
        const months = Math.floor(Math.abs(diffDays) / 30);
        relative = `${months} month${months > 1 ? 's' : ''} ago`;
      }
      
      const exact = date.toLocaleDateString('en-IN', { 
        year: 'numeric', 
        month: 'short', 
        day: 'numeric',
        hour: '2-digit',
        minute: '2-digit',
        timeZone: 'Asia/Kolkata'
      });
      
      return { relative, exact };
    }

    async function loadUsers() {
      try {
        const response = await fetch(`${API_BASE_URL}/api/admin/users`, {
          headers: {
            'Authorization': `Bearer ${token}`,
          }
        });

        if (!response.ok) throw new Error('Failed to fetch users');

        const data = await response.json();
        const users = data.users || [];

        users.forEach((user: any) => {
          // Build email -> name mapping
          usersMap.set(user.email, user.name);
          
          // Populate filter dropdown
          const option = document.createElement('option');
          option.value = user.email;
          option.textContent = user.name;
          assignedToFilter.appendChild(option);
        });
      } catch (error) {
        console.error('Failed to load users:', error);
      }
    }

    async function loadLeads() {
      try {
        const userEmail = getUserEmail();
        const userRole = getUserRole();
        
        let url = `${API_BASE_URL}/proxy/leads/records`;
        
        if (userRole === 'admin') {
          console.log('[LEADS] Admin user - loading all leads');
        } else {
          const rawWhere = `(Lead Created By,eq,${userEmail})~or(Assigned to,eq,${userEmail})`;
          url = `${url}?where=${encodeURIComponent(rawWhere)}`;
          console.log('[LEADS] Loading leads for user:', userEmail);
        }
        
        console.log('[LEADS] Query URL:', url);
        
        const response = await fetch(url, {
          method: 'GET',
          headers: {
            'Authorization': `Bearer ${token}`,
            'Content-Type': 'application/json',
          },
        });

        if (response.status === 401) {
          logout();
          return;
        }

        if (!response.ok) {
          throw new Error('Failed to fetch leads');
        }

        const data = await safeJsonParse(response);
        console.log('[LEADS] Response received, records count:', data.records?.length || 0);
        
        allLeads = data.records || [];

        loadingDiv.classList.add('hidden');

        updateStats(allLeads);
        renderLeads(allLeads);
      } catch (error) {
        loadingDiv.classList.add('hidden');
        const errorText = errorDiv.querySelector('#errorText');
        if (errorText) {
          errorText.textContent = error instanceof Error ? error.message : 'Failed to load leads';
        }
        errorDiv.classList.remove('hidden');
      }
    }

    // Push Log: array of { by: string, at: ISO string }. NocoDB JSON field may
    // come back already parsed (array/object) or as a JSON string — handle both.
    function getPushLog(fields: any): Array<{ by: string; at: string }> {
      const raw = fields?.['Push Log'];
      if (!raw) return [];
      if (Array.isArray(raw)) return raw;
      if (typeof raw === 'string') {
        try {
          const parsed = JSON.parse(raw);
          return Array.isArray(parsed) ? parsed : [];
        } catch {
          return [];
        }
      }
      return [];
    }

    function getFollowUpCategory(dateStr: string): string {
      if (!dateStr) return 'no-date';
      const d = new Date(dateStr);
      d.setHours(0, 0, 0, 0);
      const today = new Date();
      today.setHours(0, 0, 0, 0);
      const diffDays = Math.floor((d.getTime() - today.getTime()) / (1000 * 60 * 60 * 24));
      if (diffDays < 0) return 'overdue';
      if (diffDays === 0) return 'today';
      if (diffDays === 1) return 'tomorrow';
      if (diffDays <= 7) return 'week';
      return 'future';
    }

    function updateStats(leads: any[]) {
      let overdue = 0, today = 0, tomorrow = 0, week = 0, noDate = 0;

      leads.forEach((lead: any) => {
        const cat = getFollowUpCategory(lead.fields?.['Next Follow-up'] || '');
        if (cat === 'overdue') overdue++;
        else if (cat === 'today') today++;
        else if (cat === 'tomorrow') tomorrow++;
        else if (cat === 'week') week++;
        else if (cat === 'no-date') noDate++;
      });

      (document.getElementById('tabAll') as HTMLElement).textContent = leads.length.toString();
      (document.getElementById('tabOverdue') as HTMLElement).textContent = overdue.toString();
      (document.getElementById('tabToday') as HTMLElement).textContent = today.toString();
      (document.getElementById('tabTomorrow') as HTMLElement).textContent = tomorrow.toString();
      (document.getElementById('tabWeek') as HTMLElement).textContent = (today + tomorrow + week).toString();
      (document.getElementById('tabNoDate') as HTMLElement).textContent = noDate.toString();
    }

    function renderLeads(leads: any[]) {
      if (leads.length === 0) {
        leadsTable.classList.add('hidden');
        emptyState.classList.remove('hidden');
        return;
      }

      leadsBody.innerHTML = leads.map((record: any) => {
        const fields = record.fields || {};
        const leadName = fields['Lead Name'] || '<span class="text-slate-400 italic">N/A</span>';
        const company = fields['Company'] || '';
        const contactPerson = fields['Contact Person'] || '';
        const email = fields['Email'] || '';
        const phone = fields['Phone Number'] || '';
        const source = fields['Source'] || 'N/A';
        const status = fields['Status'] || 'New';
        const assignedToEmail = fields['Assigned to'] || '';
        const assignedTo = assignedToEmail 
          ? (usersMap.get(assignedToEmail) || assignedToEmail) 
          : '<span class="text-slate-400 italic">Unassigned</span>';
        const lastContacted = fields['Last Contacted'] || '';
        const nextFollowUp = fields['Next Follow-up'] || '';
        const leadCreatedBy = fields['Lead Created By'] || '';
        const canConvert = userRole === 'admin' || userEmail === leadCreatedBy;

        const lastContactedTime = getRelativeTime(lastContacted);
        const followUpTime = getRelativeTime(nextFollowUp);

        let statusClasses = 'bg-slate-100 text-slate-800';
        if (status === 'New') statusClasses = 'bg-blue-100 text-blue-800';
        if (status === 'Contacted') statusClasses = 'bg-cyan-100 text-cyan-800';
        if (status === 'Qualified') statusClasses = 'bg-teal-100 text-teal-800';
        if (status === 'Proposal Sent') statusClasses = 'bg-purple-100 text-purple-800';
        if (status === 'Negotiation') statusClasses = 'bg-orange-100 text-orange-800';
        if (status === 'Converted') statusClasses = 'bg-green-100 text-green-800';
        if (status === 'Lost') statusClasses = 'bg-red-100 text-red-800';

        let sourceClasses = 'bg-slate-100 text-slate-800';
        if (source === 'Website') sourceClasses = 'bg-blue-100 text-blue-800';
        if (source === 'Referral') sourceClasses = 'bg-cyan-100 text-cyan-800';
        if (source === 'Cold Call') sourceClasses = 'bg-teal-100 text-teal-800';
        if (source === 'IndiaMart') sourceClasses = 'bg-pink-100 text-pink-800';
        if (source === 'Event') sourceClasses = 'bg-red-100 text-red-800';

        const isOverdue = nextFollowUp && new Date(nextFollowUp) < new Date();

        return `
          <tr class="group hover:bg-slate-50/80 transition-all border-b border-slate-100 last:border-0 cursor-pointer lead-row" data-lead-id="${record.id}">
            <td class="px-4 py-4">
              <div class="min-w-0">
                <div class="text-sm font-semibold text-slate-900 truncate">${leadName}</div>
                ${company ? `<div class="mt-0.5"><span class="text-xs text-slate-600 font-medium truncate">${company}</span></div>` : ''}
              </div>
            </td>
            <td class="px-4 py-4">
              <div class="space-y-1 min-w-0">
                ${phone ? `<div class="flex items-center gap-1.5 text-sm text-slate-700"><svg class="w-3.5 h-3.5 text-slate-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg><span class="font-medium truncate">${phone}</span></div>` : '<div class="text-xs text-slate-400">No phone</div>'}
                ${email ? `<div class="flex items-center gap-1.5 text-xs text-slate-500"><svg class="w-3 h-3 text-slate-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg><span class="truncate">${email}</span></div>` : ''}
              </div>
            </td>
            <td class="px-4 py-4">
              <span class="status-chip inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-semibold ${statusClasses} whitespace-nowrap cursor-pointer select-none hover:opacity-80 transition-opacity" data-lead-id="${record.id}">
                ${status}
                <svg class="w-3 h-3 opacity-50 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
              </span>
            </td>
            <td class="px-4 py-4">
              <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-semibold ${sourceClasses} shadow-sm whitespace-nowrap">
                ${source}
              </span>
            </td>
            <td class="px-4 py-4">
              <div class="text-sm text-slate-700 font-medium truncate">${assignedTo}</div>
            </td>
            <td class="px-4 py-4">
              ${lastContacted ? `<div class="text-xs text-slate-600 font-medium cursor-help" title="${lastContactedTime.exact}">${lastContactedTime.relative}</div>` : '<div class="text-xs text-slate-400 italic">Not contacted</div>'}
            </td>
            <td class="px-4 py-4">
              ${nextFollowUp ? `
                <div class="flex items-center gap-1.5 cursor-help" title="${followUpTime.exact}">
                  ${isOverdue ? '<div class="w-2 h-2 rounded-full bg-red-500 animate-pulse flex-shrink-0"></div>' : '<div class="w-2 h-2 rounded-full bg-green-500 flex-shrink-0"></div>'}
                  <div class="flex flex-col min-w-0">
                    <span class="text-xs font-medium ${isOverdue ? 'text-red-600' : 'text-slate-700'} truncate">${followUpTime.relative}</span>
                    ${isOverdue ? '<span class="text-xs text-red-500 font-semibold">Overdue</span>' : ''}
                  </div>
                </div>
              ` : '<div class="text-xs text-slate-400">-</div>'}
            </td>
            <td class="px-4 py-4">
              <div class="flex flex-col gap-1.5 opacity-0 group-hover:opacity-100 transition-opacity">
                <div class="flex items-center gap-1">
                  <a href="/lead-detail?id=${record.id}" class="p-1.5 rounded-lg hover:bg-blue-50 hover:shadow-sm transition-all" title="View Details">
                    <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                    </svg>
                  </a>
                  <button class="edit-lead-btn p-1.5 rounded-lg hover:bg-green-50 hover:shadow-sm transition-all" title="Edit" data-lead-id="${record.id}">
                    <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                    </svg>
                  </button>
                  ${canConvert ? `
                  <button class="convert-lead-btn p-1.5 rounded-lg hover:bg-emerald-50 hover:shadow-sm transition-all" title="Convert to Account" data-lead-id="${record.id}">
                    <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path>
                    </svg>
                  </button>
                  ` : ''}
                  <button class="delete-lead-btn p-1.5 rounded-lg hover:bg-red-50 hover:shadow-sm transition-all" title="Delete" data-lead-id="${record.id}">
                    <svg class="w-4 h-4 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                    </svg>
                  </button>
                </div>
                <div class="flex items-center gap-1 flex-wrap">
                  ${status !== 'Converted' && status !== 'Lost' ? `
                  <button class="contacted-btn px-2 py-0.5 text-xs font-semibold bg-cyan-50 text-cyan-700 border border-cyan-200 rounded-full hover:bg-cyan-100 transition-colors whitespace-nowrap" title="Mark as Contacted + set Last Contacted to today" data-lead-id="${record.id}">
                    ✓ Contacted
                  </button>` : ''}
                  ${nextFollowUp && status !== 'Converted' && status !== 'Lost' ? `
                  <button class="snooze-btn px-2 py-0.5 text-xs font-semibold bg-violet-50 text-violet-700 border border-violet-200 rounded-full hover:bg-violet-100 transition-colors whitespace-nowrap" title="Push follow-up forward by 1 day" data-lead-id="${record.id}">
                    +1 Day
                  </button>` : ''}
                </div>
              </div>
            </td>
          </tr>
        `;
      }).join('');

      leadsMobileList.innerHTML = leads.map((record: any) => {
        const fields = record.fields || {};
        const leadName = fields['Lead Name'] || 'N/A';
        const company = fields['Company'] || '';
        const phone = fields['Phone Number'] || '';
        const source = fields['Source'] || 'N/A';
        const status = fields['Status'] || 'New';
        const assignedToEmail = fields['Assigned to'] || '';
        const assignedToDisplay = assignedToEmail ? (usersMap.get(assignedToEmail) || assignedToEmail) : '';
        const nextFollowUp = fields['Next Follow-up'] || '';
        const leadCreatedBy = fields['Lead Created By'] || '';
        const canConvert = userRole === 'admin' || userEmail === leadCreatedBy;
        const followUpTime = getRelativeTime(nextFollowUp);
        const isOverdue = nextFollowUp && new Date(nextFollowUp) < new Date();

        let statusClasses = 'bg-slate-100 text-slate-800';
        if (status === 'New') statusClasses = 'bg-blue-100 text-blue-800';
        if (status === 'Contacted') statusClasses = 'bg-cyan-100 text-cyan-800';
        if (status === 'Qualified') statusClasses = 'bg-teal-100 text-teal-800';
        if (status === 'Proposal Sent') statusClasses = 'bg-purple-100 text-purple-800';
        if (status === 'Negotiation') statusClasses = 'bg-orange-100 text-orange-800';
        if (status === 'Converted') statusClasses = 'bg-green-100 text-green-800';
        if (status === 'Lost') statusClasses = 'bg-red-100 text-red-800';

        let sourceClasses = 'bg-slate-100 text-slate-600';
        if (source === 'Website') sourceClasses = 'bg-blue-100 text-blue-700';
        if (source === 'Referral') sourceClasses = 'bg-cyan-100 text-cyan-700';
        if (source === 'Cold Call') sourceClasses = 'bg-teal-100 text-teal-700';
        if (source === 'IndiaMart') sourceClasses = 'bg-pink-100 text-pink-700';
        if (source === 'Event') sourceClasses = 'bg-red-100 text-red-700';

        return `
          <div class="p-4">
            <div class="flex items-start justify-between gap-2 mb-2">
              <div class="min-w-0 flex-1">
                <div class="text-sm font-semibold text-slate-900">${leadName}</div>
                ${company ? `<div class="text-xs text-slate-500 mt-0.5">${company}</div>` : ''}
              </div>
              <span class="status-chip flex-shrink-0 inline-flex items-center gap-1 px-2 py-0.5 rounded-lg text-xs font-semibold ${statusClasses} cursor-pointer select-none" data-lead-id="${record.id}">${status}<svg class="w-3 h-3 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg></span>
            </div>
