    async function performConversion() {
      if (currentConvertingLeadId === null) return;

      const leadId = currentConvertingLeadId;
      const lead = allLeads.find((l: any) => l.id === leadId);
      if (!lead) return;

      const f = lead.fields || {};

      confirmConvertBtn.disabled = true;
      confirmConvertBtn.innerHTML = `
        <svg class="animate-spin w-4 h-4" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        Converting...
      `;
      convertError.classList.add('hidden');

      try {
        const accountName = f['Lead Name'] || f['Company'] || 'Unnamed Account';
        const accountFields: Record<string, string> = {
          'Account Name': accountName,
          'Company Name': f['Company'] || '',
          'Primary Contact': f['Contact Person'] || '',
          'Email 1': f['Email'] || '',
          'Phone Number': f['Phone Number'] || '',
          'Phone Number 2': f['Phone Number 2'] || '',
          'Phone Number 3': f['Phone Number 3'] || '',
          'Source': f['Source'] || '',
          'Description': f['Notes'] ? `Converted from Lead: ${f['Notes']}` : 'Converted from Lead',
          'Billing Street': f['Billing Street'] || '',
          'Billing City': f['Billing City'] || '',
          'Billing State': f['Billing State'] || '',
          'Billing Code': f['Billing Code'] || '',
          'Billing Country': f['Billing Country'] || '',
          'Shipping Street': f['Shipping Street'] || '',
          'Shipping City': f['Shipping City'] || '',
          'Shipping State': f['Shipping State'] || '',
          'Shipping Code': f['Shipping Code'] || '',
          'Shipping Country': f['Shipping Country'] || '',
        };

        const accountResponse = await fetch(`${API_BASE_URL}/proxy/accounts_duplicate/records`, {
          method: 'POST',
          headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
          body: JSON.stringify({ fields: accountFields })
        });

        if (!accountResponse.ok) {
          const errText = await accountResponse.text();
          throw new Error(`Failed to create account: ${errText}`);
        }

        const accountResult = await accountResponse.json();
        const accountId = accountResult.records ? accountResult.records[0]?.id : accountResult.id;

        // Update lead status to Converted
        await fetch(`${API_BASE_URL}/proxy/leads/records`, {
          method: 'PATCH',
          headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: leadId, fields: { 'Status': 'Converted' } })
        });

        // Show success state
        convertModalFooter.classList.add('hidden');
        (document.getElementById('convertSuccessText') as HTMLElement).textContent =
          `"${accountName}" has been created as an Account and the lead status has been updated to Converted.`;
        if (accountId) {
          (document.getElementById('viewAccountLink') as HTMLAnchorElement).href = `/account-detail?id=${accountId}`;
        }
        convertSuccess.classList.remove('hidden');

        loadLeads();
      } catch (error) {
        confirmConvertBtn.disabled = false;
        confirmConvertBtn.innerHTML = `
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path>
          </svg>
          Convert to Account
        `;
        (document.getElementById('convertErrorText') as HTMLElement).textContent =
          error instanceof Error ? error.message : 'Conversion failed. Please try again.';
        convertError.classList.remove('hidden');
      }
    }

    closeConvertModalBtn.addEventListener('click', closeConvertModal);
    cancelConvertBtn.addEventListener('click', closeConvertModal);
    confirmConvertBtn.addEventListener('click', performConversion);
    convertModal.addEventListener('click', (e) => { if (e.target === convertModal) closeConvertModal(); });

    // Attach button handlers (delegated event)
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;

      // Status chip → open stage popover
      const statusChip = target.closest('.status-chip') as HTMLElement;
      if (statusChip) {
        e.stopPropagation();
        const leadId = parseInt(statusChip.getAttribute('data-lead-id') || '0');
        if (leadId) openStagePopover(leadId, statusChip);
        return;
      }

      const editBtn = target.closest('.edit-lead-btn') as HTMLButtonElement;
      const deleteBtn = target.closest('.delete-lead-btn') as HTMLButtonElement;
      const convertBtn = target.closest('.convert-lead-btn') as HTMLButtonElement;
      const contactedBtn = target.closest('.contacted-btn') as HTMLButtonElement;
      const snoozeBtn = target.closest('.snooze-btn') as HTMLButtonElement;

      if (editBtn) {
        e.stopPropagation();
        const leadId = parseInt(editBtn.getAttribute('data-lead-id') || '0');
        if (leadId) openEditModal(leadId);
        return;
      }

      if (deleteBtn) {
        e.stopPropagation();
        const leadId = parseInt(deleteBtn.getAttribute('data-lead-id') || '0');
        if (leadId) deleteLead(leadId);
        return;
      }

      if (convertBtn) {
        e.stopPropagation();
        const leadId = parseInt(convertBtn.getAttribute('data-lead-id') || '0');
        if (leadId) openConvertModal(leadId);
        return;
      }

      if (contactedBtn) {
        e.stopPropagation();
        const leadId = parseInt(contactedBtn.getAttribute('data-lead-id') || '0');
        if (leadId) markContacted(leadId);
        return;
      }

      if (snoozeBtn) {
        e.stopPropagation();
        const leadId = parseInt(snoozeBtn.getAttribute('data-lead-id') || '0');
        if (leadId) snoozeFollowUp(leadId);
        return;
      }

      // Row click → navigate to detail page (only if no action was matched)
      if (!editBtn && !deleteBtn && !convertBtn && !contactedBtn) {
        const row = (target as HTMLElement).closest('.lead-row') as HTMLTableRowElement;
        if (row) {
          const leadId = row.getAttribute('data-lead-id');
          if (leadId) window.location.href = `/lead-detail?id=${leadId}`;
        }
      }
    });

    // Smart tab click handlers
    document.querySelectorAll('.smart-tab').forEach((btn) => {
      btn.addEventListener('click', () => setActiveTab((btn as HTMLButtonElement).dataset.tab || 'all'));
    });

    // Holiday / Away mode
    const holidayPanel = document.getElementById('holidayPanel') as HTMLDivElement;
    const holidayStartInput = document.getElementById('holidayStart') as HTMLInputElement;
    const holidayEndInput = document.getElementById('holidayEnd') as HTMLInputElement;
    const holidaySummary = document.getElementById('holidaySummary') as HTMLSpanElement;
    const smartTabsContainer = document.querySelector('.flex.gap-2.mb-6.flex-wrap') as HTMLDivElement;

    function updateHolidaySummary() {
      const startVal = holidayStartInput.value;
      const endVal = holidayEndInput.value;
      if (!startVal || !endVal) { holidaySummary.textContent = ''; return; }
      const start = new Date(startVal); start.setHours(0, 0, 0, 0);
      const end = new Date(endVal); end.setHours(23, 59, 59, 999);
      const count = allLeads.filter((lead: any) => {
        const followUp = lead.fields?.['Next Follow-up'];
        if (!followUp) return false;
        const d = new Date(followUp); d.setHours(0, 0, 0, 0);
        return d >= start && d <= end;
      }).length;
      holidaySummary.textContent = count === 0 ? 'No leads in this period' : `${count} lead${count !== 1 ? 's' : ''} need attention`;
    }

    function enterHolidayMode() {
      holidayModeActive = true;
      holidayPanel.classList.remove('hidden');
      smartTabsContainer.classList.add('hidden');
      // Default: tomorrow to a week from now
      const tomorrow = new Date(); tomorrow.setDate(tomorrow.getDate() + 1);
      const weekOut = new Date(); weekOut.setDate(weekOut.getDate() + 7);
      holidayStartInput.value = tomorrow.toISOString().split('T')[0];
      holidayEndInput.value = weekOut.toISOString().split('T')[0];
      updateHolidaySummary();
      applyFilters();
    }

    function exitHolidayMode() {
      holidayModeActive = false;
      holidayPanel.classList.add('hidden');
      smartTabsContainer.classList.remove('hidden');
      holidaySummary.textContent = '';
      applyFilters();
    }

    document.getElementById('holidayModeBtn')!.addEventListener('click', enterHolidayMode);
    document.getElementById('exitHolidayBtn')!.addEventListener('click', exitHolidayMode);

    holidayStartInput.addEventListener('change', () => { updateHolidaySummary(); applyFilters(); });
    holidayEndInput.addEventListener('change', () => { updateHolidaySummary(); applyFilters(); });

    // ── Stage popover ──────────────────────────────────────────
    const STAGES = ['New', 'Contacted', 'Qualified', 'Proposal Sent', 'Negotiation', 'Converted'];
    let popoverLeadId: number | null = null;
    let popoverEl: HTMLDivElement | null = null;

    function openStagePopover(leadId: number, anchor: HTMLElement) {
      closeStagePopover();
      popoverLeadId = leadId;
      const lead = allLeads.find((l: any) => l.id === leadId);
      if (!lead) return;
      const current = lead.fields?.['Status'] || 'New';

      // Create element fresh every time, appended directly to body.
      // Use position:absolute (not fixed) — fixed can silently fail when ancestor
      // has overflow:hidden. Since the window never scrolls in this layout
      // (only <main> scrolls), absolute on body stays at its viewport coords.
      popoverEl = document.createElement('div');
      Object.assign(popoverEl.style, {
        position: 'absolute',
        zIndex: '9999',
        background: 'white',
        borderRadius: '0.75rem',
        border: '1px solid #e2e8f0',
        boxShadow: '0 10px 25px -3px rgba(0,0,0,0.1),0 4px 6px -4px rgba(0,0,0,0.1)',
        padding: '0.75rem',
        width: '13rem',
        fontFamily: 'inherit',
        fontSize: 'inherit',
      });

      const stageItems = STAGES.map(stage => {
        const isCurrent = stage === current;
        return `<button class="popover-stage-btn w-full text-left flex items-center gap-2.5 px-2 py-1.5 rounded-lg text-xs font-semibold transition-colors ${isCurrent ? 'bg-indigo-50 text-indigo-700' : 'text-slate-600 hover:bg-slate-50'}" data-stage="${stage}">
          <span class="w-2 h-2 rounded-full flex-shrink-0 border ${isCurrent ? 'bg-indigo-500 border-indigo-500' : 'border-slate-300'}"></span>
          ${stage}${isCurrent ? '<span class="ml-auto text-indigo-400 font-normal">now</span>' : ''}
        </button>`;
      }).join('');

      popoverEl.innerHTML = `
        <p class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-2 px-1">Move to Stage</p>
        <div class="space-y-0.5">${stageItems}</div>
        <div class="mt-2 pt-2 border-t border-slate-100">
          <button class="popover-mark-lost w-full text-left text-xs font-semibold text-red-500 hover:text-red-700 flex items-center gap-2 px-2 py-1.5 hover:bg-red-50 rounded-lg transition-colors">
            <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            Mark as Lost
          </button>
        </div>`;

      const rect = anchor.getBoundingClientRect();
      popoverEl.style.top  = `${rect.bottom + 6}px`;
      popoverEl.style.left = `${Math.min(rect.left, window.innerWidth - 224)}px`;
      document.body.appendChild(popoverEl);

      document.querySelector('main')?.addEventListener('scroll', closeStagePopover, { once: true });

      popoverEl.querySelectorAll<HTMLButtonElement>('.popover-stage-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const newStage = btn.dataset.stage!;
          if (newStage !== current && popoverLeadId) changeLeadStatus(popoverLeadId, newStage);
          closeStagePopover();
        });
      });

      popoverEl.querySelector<HTMLButtonElement>('.popover-mark-lost')!.addEventListener('click', async (e) => {
        e.stopPropagation();
        if (!popoverLeadId) return;
        const l = allLeads.find((x: any) => x.id === popoverLeadId);
        const name = l?.fields?.['Lead Name'] || 'this lead';
        const id = popoverLeadId;
        closeStagePopover();
        if (await showConfirm(`Mark "${name}" as Lost?`, 'Mark as Lost', 'bg-orange-600 hover:bg-orange-700')) changeLeadStatus(id, 'Lost');
      });
    }

    function closeStagePopover() {
      if (popoverEl) { popoverEl.remove(); popoverEl = null; }
      popoverLeadId = null;
    }

    // Close when clicking outside
    document.addEventListener('click', (e) => {
      if (popoverEl
          && !popoverEl.contains(e.target as Node)
          && !(e.target as HTMLElement).closest('.status-chip')) {
        closeStagePopover();
      }
    });

    async function changeLeadStatus(leadId: number, newStatus: string) {
      const lead = allLeads.find((l: any) => l.id === leadId);
      if (!lead) return;
      const oldStatus = lead.fields?.['Status'];

      // Optimistic
      lead.fields['Status'] = newStatus;
      updateStats(allLeads);
      applyFilters();

      try {
        const res = await fetch(`${API_BASE_URL}/proxy/leads/records`, {
          method: 'PATCH',
          headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: leadId, fields: { 'Status': newStatus } })
        });
        if (!res.ok) throw new Error('PATCH failed');
      } catch {
        lead.fields['Status'] = oldStatus;
        updateStats(allLeads);
        applyFilters();
        showToast('Failed to update status. Please try again.', 'error');
      }
    }
    // ── End stage popover ───────────────────────────────────────

    loadUsers();
    loadUsersForModal();
    loadLeads();
  </script>

  <style>
    @media (min-width: 1024px) { #leadsMobileList { display: none !important; } }
    @media (max-width: 1023px) { #leadsDesktopTable { display: none !important; } }
  </style>
</AdminLayout>
