              <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold ${sourceClasses}">${source}</span>
              ${assignedToDisplay ? `<span class="text-xs text-slate-500">${assignedToDisplay}</span>` : ''}
            </div>
            ${nextFollowUp ? `
              <div class="flex items-center gap-1.5 mb-3">
                ${isOverdue ? '<div class="w-2 h-2 rounded-full bg-red-500 flex-shrink-0"></div>' : '<div class="w-2 h-2 rounded-full bg-green-500 flex-shrink-0"></div>'}
                <span class="text-xs ${isOverdue ? 'text-red-600 font-semibold' : 'text-slate-600'}">Follow-up: ${followUpTime.relative}${isOverdue ? ' — Overdue' : ''}</span>
              </div>
            ` : '<div class="mb-3"></div>'}
            <div class="flex items-center gap-1.5 flex-wrap">
              <a href="/lead-detail?id=${record.id}" class="px-3 py-1.5 text-xs font-semibold bg-blue-50 text-blue-700 rounded-lg border border-blue-100 hover:bg-blue-100 transition-colors">View</a>
              <button class="edit-lead-btn px-3 py-1.5 text-xs font-semibold bg-slate-100 text-slate-700 rounded-lg hover:bg-slate-200 transition-colors" data-lead-id="${record.id}">Edit</button>
              ${canConvert ? `<button class="convert-lead-btn px-3 py-1.5 text-xs font-semibold bg-emerald-50 text-emerald-700 rounded-lg hover:bg-emerald-100 transition-colors" data-lead-id="${record.id}">Convert</button>` : ''}
              ${status !== 'Converted' && status !== 'Lost' ? `<button class="contacted-btn px-3 py-1.5 text-xs font-semibold bg-cyan-50 text-cyan-700 rounded-lg hover:bg-cyan-100 transition-colors" data-lead-id="${record.id}">✓ Contacted</button>` : ''}
              ${nextFollowUp && status !== 'Converted' && status !== 'Lost' ? `<button class="snooze-btn px-3 py-1.5 text-xs font-semibold bg-violet-50 text-violet-700 rounded-lg hover:bg-violet-100 transition-colors" data-lead-id="${record.id}">+1 Day</button>` : ''}
              <button class="delete-lead-btn px-3 py-1.5 text-xs font-semibold bg-red-50 text-red-600 rounded-lg hover:bg-red-100 transition-colors ml-auto" data-lead-id="${record.id}">Delete</button>
            </div>
          </div>
        `;
      }).join('');

      emptyState.classList.add('hidden');
      leadsTable.classList.remove('hidden');
    }

    let activeTab = 'all';
    let holidayModeActive = false;

    function setActiveTab(tab: string) {
      activeTab = tab;

      document.querySelectorAll('.smart-tab').forEach((btn) => {
        const b = btn as HTMLButtonElement;
        const badge = b.querySelector('.tab-count') as HTMLElement;
        if (b.dataset.tab === tab) {
          b.classList.add('bg-slate-800', 'text-white');
          b.classList.remove('bg-white', 'text-slate-600', 'border', 'border-slate-200', 'hover:bg-slate-50');
          if (badge) { badge.classList.remove('bg-slate-100', 'text-slate-700'); badge.classList.add('bg-white/20', 'text-white'); }
        } else {
          b.classList.remove('bg-slate-800', 'text-white');
          b.classList.add('bg-white', 'text-slate-600', 'border', 'border-slate-200', 'hover:bg-slate-50');
          if (badge) { badge.classList.add('bg-slate-100', 'text-slate-700'); badge.classList.remove('bg-white/20', 'text-white'); }
        }
      });

      applyFilters();
    }

    function applyFilters() {
      const searchTerm = searchInput.value.toLowerCase();
      const statusValue = statusFilter.value;
      const sourceValue = sourceFilter.value;
      const assignedToValue = assignedToFilter.value;

      const filtered = allLeads.filter((lead: any) => {
        const fields = lead.fields || {};
        const leadName = (fields['Lead Name'] || '').toLowerCase();
        const company = (fields['Company'] || '').toLowerCase();
        const phone = (fields['Phone Number'] || '').toLowerCase();
        const email = (fields['Email'] || '').toLowerCase();
        const status = fields['Status'] || '';
        const source = fields['Source'] || '';
        const assignedTo = fields['Assigned to'] || '';

        let matchesTab = true;
        if (holidayModeActive) {
          const startVal = (document.getElementById('holidayStart') as HTMLInputElement).value;
          const endVal = (document.getElementById('holidayEnd') as HTMLInputElement).value;
          if (startVal && endVal) {
            const followUp = fields['Next Follow-up'];
            if (!followUp) {
              matchesTab = false;
            } else {
              const d = new Date(followUp);
              d.setHours(0, 0, 0, 0);
              const start = new Date(startVal); start.setHours(0, 0, 0, 0);
              const end = new Date(endVal); end.setHours(23, 59, 59, 999);
              matchesTab = d >= start && d <= end;
            }
          }
        } else if (activeTab !== 'all') {
          const cat = getFollowUpCategory(fields['Next Follow-up'] || '');
          if (activeTab === 'overdue') matchesTab = cat === 'overdue';
          else if (activeTab === 'today') matchesTab = cat === 'today';
          else if (activeTab === 'tomorrow') matchesTab = cat === 'tomorrow';
          else if (activeTab === 'week') matchesTab = cat === 'today' || cat === 'tomorrow' || cat === 'week';
          else if (activeTab === 'no-date') matchesTab = cat === 'no-date';
        }

        const matchesSearch = !searchTerm ||
          leadName.includes(searchTerm) ||
          company.includes(searchTerm) ||
          phone.includes(searchTerm) ||
          email.includes(searchTerm);

        const matchesStatus = !statusValue || status === statusValue;
        const matchesSource = !sourceValue || source === sourceValue;
        const matchesAssignedTo = !assignedToValue || assignedTo === assignedToValue;

        return matchesTab && matchesSearch && matchesStatus && matchesSource && matchesAssignedTo;
      });

      renderLeads(filtered);
    }

    function clearFilters() {
      searchInput.value = '';
      statusFilter.value = '';
      sourceFilter.value = '';
      assignedToFilter.value = '';
      renderLeads(allLeads);
    }

