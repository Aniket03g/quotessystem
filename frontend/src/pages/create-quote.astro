---
import AdminLayout from '../layouts/AdminLayout.astro';
---

<AdminLayout title="Create Quote - Grove Systems" currentPage="quotes">
  <!-- Header -->
  <div class="mb-6">
    <a href="/quotes" class="inline-flex items-center gap-2 text-sm text-slate-600 hover:text-slate-900 transition-colors mb-4">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
      </svg>
      Back to Quotes
    </a>
    <h1 class="text-2xl font-bold text-slate-800">Create New Quote</h1>
    <p class="text-sm text-slate-600 mt-1">Fill in the details to create a new quote</p>
  </div>

  <!-- Alert -->
  <div id="alert" class="hidden mb-6"></div>

  <!-- Create Quote Form -->
  <form id="createQuoteForm" class="space-y-6">
    <!-- Account Selection Card -->
    <div class="bg-white rounded-lg shadow-sm border border-slate-200 p-6">
      <h2 class="text-base font-semibold text-slate-800 mb-4">Account Information</h2>
      
      <div class="space-y-4">
        <!-- Account Search -->
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-2">Account *</label>
          <div class="relative">
            <input 
              type="text" 
              id="accountSearch" 
              placeholder="Search for an account..." 
              autocomplete="off"
              class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all"
            />
            <input type="hidden" id="selectedAccountId" required />
            <div id="accountDropdown" class="hidden absolute z-10 w-full mt-1 bg-white border border-slate-200 rounded-lg shadow-lg max-h-60 overflow-y-auto">
              <div id="accountResults" class="py-1"></div>
              <div id="accountLoading" class="hidden px-4 py-3 text-sm text-slate-500 text-center">
                <svg class="animate-spin w-4 h-4 inline-block mr-2" fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
                Searching...
              </div>
              <div id="accountEmpty" class="hidden px-4 py-3 text-sm text-slate-500 text-center">No accounts found</div>
            </div>
          </div>
        </div>

        <!-- Account Details (Always visible, populated after selection) -->
        <div class="space-y-4 pt-4 border-t border-slate-200">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <!-- Company Name -->
            <div>
              <label for="companyName" class="block text-sm font-medium text-slate-700 mb-2">Company Name</label>
              <input
                type="text"
                id="companyName"
                readonly
                class="w-full px-4 py-2.5 bg-slate-100 border border-slate-200 rounded-md text-sm text-slate-700"
                placeholder="-"
              />
            </div>

            <!-- Phone -->
            <div>
              <label for="phone" class="block text-sm font-medium text-slate-700 mb-2">Phone</label>
              <input
                type="text"
                id="phone"
                readonly
                class="w-full px-4 py-2.5 bg-slate-100 border border-slate-200 rounded-md text-sm text-slate-700"
                placeholder="-"
              />
            </div>

            <!-- Billing Street -->
            <div>
              <label for="billingStreet" class="block text-sm font-medium text-slate-700 mb-2">Billing Street</label>
              <input
                type="text"
                id="billingStreet"
                readonly
                class="w-full px-4 py-2.5 bg-slate-100 border border-slate-200 rounded-md text-sm text-slate-700"
                placeholder="-"
              />
            </div>

            <!-- Billing City -->
            <div>
              <label for="billingCity" class="block text-sm font-medium text-slate-700 mb-2">Billing City</label>
              <input
                type="text"
                id="billingCity"
                readonly
                class="w-full px-4 py-2.5 bg-slate-100 border border-slate-200 rounded-md text-sm text-slate-700"
                placeholder="-"
              />
            </div>

            <!-- Shipping City -->
            <div>
              <label for="shippingCity" class="block text-sm font-medium text-slate-700 mb-2">Shipping City</label>
              <input
                type="text"
                id="shippingCity"
                readonly
                class="w-full px-4 py-2.5 bg-slate-100 border border-slate-200 rounded-md text-sm text-slate-700"
                placeholder="-"
              />
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Quote Details Card -->
    <div class="bg-white rounded-lg shadow-sm border border-slate-200 p-6">
      <h2 class="text-base font-semibold text-slate-800 mb-4">Quote Details</h2>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- Issuing Company -->
        <div>
          <label for="issuingCompany" class="block text-sm font-medium text-slate-700 mb-2">Company *</label>
          <select
            id="issuingCompany"
            required
            class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all"
          >
            <option value="">Select company...</option>
            <option value="GreenOCare">GreenOCare</option>
            <option value="Grove Systems">Grove Systems</option>
          </select>
        </div>

        <!-- Quote Date -->
        <div>
          <label for="quoteDate" class="block text-sm font-medium text-slate-700 mb-2">Quote Date *</label>
          <input 
            type="date" 
            id="quoteDate" 
            required 
            class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all" 
          />
        </div>

        <!-- Valid Until -->
        <div>
          <label for="validUntil" class="block text-sm font-medium text-slate-700 mb-2">Valid Until *</label>
          <input 
            type="date" 
            id="validUntil" 
            required 
            class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all" 
          />
        </div>

        <!-- Quote Status -->
        <div>
          <label for="quoteStatus" class="block text-sm font-medium text-slate-700 mb-2">Quote Status *</label>
          <select 
            id="quoteStatus" 
            required 
            class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all"
          >
            <option value="Draft">Draft</option>
            <option value="Sent">Sent</option>
            <option value="Approved">Approved</option>
            <option value="Final">Final</option>
          </select>
        </div>

        <!-- Quote Type -->
        <div>
          <label for="quoteType" class="block text-sm font-medium text-slate-700 mb-2">Quote Type *</label>
          <select 
            id="quoteType" 
            required 
            class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all"
          >
            <option value="Customer">Customer</option>
            <option value="Dealer ">Dealer</option>
          </select>
        </div>
      </div>
    </div>

    <!-- Products Card -->
    <div class="bg-white rounded-lg shadow-sm border border-slate-200 p-6">
      <h2 class="text-base font-semibold text-slate-800 mb-4">Products *</h2>
      
      <div id="productsContainer" class="space-y-6">
        <div class="product-item border border-slate-200 rounded-lg p-4 space-y-4">
          <!-- Product Search Row -->
          <div class="flex gap-3 items-start">
            <div class="flex-1 relative">
              <label class="block text-xs font-medium text-slate-700 mb-1">Product *</label>
              <input 
                type="text" 
                class="product-search w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all" 
                placeholder="Search for a product..." 
                autocomplete="off"
                required
              />
            <input type="hidden" class="product-id" required />
            <input type="hidden" class="product-name" />
            <input type="hidden" class="product-price" />
            <input type="hidden" class="product-brand" />
            <input type="hidden" class="product-hsn" />
            <input type="hidden" class="product-model" />
            <input type="hidden" class="product-code" />
            <input type="hidden" class="product-tax" />
            <input type="hidden" class="product-description" />
            <input type="hidden" class="product-customer-price" />
            <input type="hidden" class="product-dealer-price" />
            <input type="hidden" class="product-warranty" />
            <div class="product-dropdown hidden absolute z-10 w-full mt-1 bg-white border border-slate-200 rounded-lg shadow-lg max-h-60 overflow-y-auto">
              <div class="product-results py-1"></div>
              <div class="product-loading hidden px-4 py-3 text-sm text-slate-500 text-center">
                <svg class="animate-spin w-4 h-4 inline-block mr-2" fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
                Searching...
              </div>
              <div class="product-empty hidden px-4 py-3 text-sm text-slate-500 text-center">No products found</div>
            </div>
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-700 mb-1">Unit Price *</label>
              <input type="number" class="product-custom-price w-32 px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all" placeholder="Price" min="0" step="0.01" required />
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-700 mb-1">Quantity *</label>
              <input type="number" class="product-quantity w-24 px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all" placeholder="Qty" min="1" required />
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-700 mb-1">Discount %</label>
              <input type="number" class="product-discount w-24 px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all" placeholder="0" min="0" max="100" step="0.01" value="0" />
            </div>
            <div class="pt-5">
              <button type="button" class="remove-product-btn p-2.5 text-red-600 hover:bg-red-50 rounded-md transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                </svg>
              </button>
            </div>
          </div>

          <!-- Product Details Grid -->
          <div class="space-y-3">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
              <div>
                <label class="block text-xs font-medium text-slate-700 mb-1">Brand</label>
                <input type="text" class="product-brand-display w-full px-3 py-2 bg-slate-100 border border-slate-200 rounded-md text-sm text-slate-700" readonly placeholder="-" />
              </div>
              <div>
                <label class="block text-xs font-medium text-slate-700 mb-1">Model No</label>
                <input type="text" class="product-code-display w-full px-3 py-2 bg-slate-100 border border-slate-200 rounded-md text-sm text-slate-700" readonly placeholder="-" />
              </div>
              <div>
                <label class="block text-xs font-medium text-slate-700 mb-1">HSN Code</label>
                <input type="text" class="product-hsn-display w-full px-3 py-2 bg-slate-100 border border-slate-200 rounded-md text-sm text-slate-700" readonly placeholder="-" />
              </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
              <div>
                <label class="block text-xs font-medium text-slate-700 mb-1">Tax</label>
                <input type="text" class="product-tax-display w-full px-3 py-2 bg-slate-100 border border-slate-200 rounded-md text-sm text-slate-700" readonly placeholder="-" />
              </div>
              <div>
                <label class="block text-xs font-medium text-slate-700 mb-1">Warranty (months)</label>
                <input type="text" class="product-warranty-display w-full px-3 py-2 bg-slate-100 border border-slate-200 rounded-md text-sm text-slate-700" readonly placeholder="-" />
              </div>
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-700 mb-1">Description</label>
              <textarea class="product-description-display w-full px-3 py-2 bg-slate-100 border border-slate-200 rounded-md text-sm text-slate-700" rows="3" readonly placeholder="-"></textarea>
            </div>
          </div>
        </div>
      </div>
      <button type="button" id="addProductBtn" class="mt-3 inline-flex items-center gap-2 px-3 py-2 text-sm text-indigo-600 hover:bg-indigo-50 rounded-md transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
        </svg>
        Add Product
      </button>
    </div>

    <!-- Notes Card -->
    <div class="bg-white rounded-lg shadow-sm border border-slate-200 p-6">
      <h2 class="text-base font-semibold text-slate-800 mb-4">Notes</h2>
      <textarea 
        id="notes" 
        rows="4" 
        class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all" 
        placeholder="Additional notes or terms..."
      ></textarea>
    </div>

    <!-- Form Actions -->
    <div class="flex gap-3 justify-end">
      <a 
        href="/quotes" 
        class="px-6 py-2.5 bg-white border border-slate-300 text-slate-700 text-sm font-medium rounded-md hover:bg-slate-50 transition-colors"
      >
        Cancel
      </a>
      <button 
        type="submit" 
        id="submitBtn"
        class="px-6 py-2.5 bg-indigo-600 text-white text-sm font-medium rounded-md hover:bg-indigo-700 transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
      >
        Create Quote
      </button>
    </div>
  </form>

  <script>
    import { getToken, logout, safeJsonParse } from '../lib/api';
    import { debounce } from '../utils/debounce';

    const API_BASE_URL = import.meta.env.PUBLIC_API_BASE_URL ||
      `${window.location.protocol}//${window.location.hostname}:8082`;
    
    const token = getToken();
    if (!token) {
      window.location.href = '/login';
    }

    function getUserEmail(): string | null {
      return localStorage.getItem('user_email');
    }

    const createQuoteForm = document.getElementById('createQuoteForm') as HTMLFormElement;
    const accountSearch = document.getElementById('accountSearch') as HTMLInputElement;
    const selectedAccountId = document.getElementById('selectedAccountId') as HTMLInputElement;
    const accountDropdown = document.getElementById('accountDropdown') as HTMLDivElement;
    const accountResults = document.getElementById('accountResults') as HTMLDivElement;
    const accountLoading = document.getElementById('accountLoading') as HTMLDivElement;
    const accountEmpty = document.getElementById('accountEmpty') as HTMLDivElement;
    const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement;
    const alertDiv = document.getElementById('alert') as HTMLDivElement;

    const companyNameInput = document.getElementById('companyName') as HTMLInputElement;
    const phoneInput = document.getElementById('phone') as HTMLInputElement;
    const billingStreetInput = document.getElementById('billingStreet') as HTMLInputElement;
    const billingCityInput = document.getElementById('billingCity') as HTMLInputElement;
    const shippingCityInput = document.getElementById('shippingCity') as HTMLInputElement;

    // Set default dates
    const today = new Date().toISOString().split('T')[0];
    const validUntil = new Date();
    validUntil.setDate(validUntil.getDate() + 30);
    (document.getElementById('quoteDate') as HTMLInputElement).value = today;
    (document.getElementById('validUntil') as HTMLInputElement).value = validUntil.toISOString().split('T')[0];

    // Pre-fill account when coming from account-detail page
    const urlParams = new URLSearchParams(window.location.search);
    const prefillAccountId = urlParams.get('accountId');
    const prefillAccountName = urlParams.get('accountName');

    if (prefillAccountId && prefillAccountName) {
      accountSearch.value = decodeURIComponent(prefillAccountName);
      selectedAccountId.value = prefillAccountId;

      try {
        const res = await fetch(
          `${API_BASE_URL}/proxy/accounts_duplicate/records/${prefillAccountId}?fields=Company Name,Phone Number,Billing Street,Billing City,Shipping City`,
          { headers: { 'Authorization': `Bearer ${token}` } }
        );
        if (res.ok) {
          const data = await safeJsonParse(res);
          const fields = data.fields || {};
          companyNameInput.value = fields['Company Name'] || '';
          phoneInput.value = fields['Phone Number'] || '';
          billingStreetInput.value = fields['Billing Street'] || '';
          billingCityInput.value = fields['Billing City'] || '';
          shippingCityInput.value = fields['Shipping City'] || '';
        }
      } catch (e) {
        console.error('[CREATE QUOTE] Error pre-filling account details:', e);
      }
    }

    function showAlert(message: string, type: 'success' | 'error') {
      alertDiv.textContent = message;
      alertDiv.className = `mb-6 p-4 rounded-lg ${
        type === 'success' 
          ? 'bg-green-50 text-green-800 border border-green-200' 
          : 'bg-red-50 text-red-800 border border-red-200'
      }`;
      alertDiv.classList.remove('hidden');
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function hideAlert() {
      alertDiv.classList.add('hidden');
    }

    // Account search functionality
    const searchAccounts = debounce(async (query: string) => {
      if (query.length < 2) {
        accountDropdown.classList.add('hidden');
        return;
      }

      accountLoading.classList.remove('hidden');
      accountEmpty.classList.add('hidden');
      accountResults.innerHTML = '';
      accountDropdown.classList.remove('hidden');

      try {
        const response = await fetch(`${API_BASE_URL}/proxy/accounts_duplicate/records?where=(Company Name,like,${encodeURIComponent(query)})&limit=10`, {
          headers: {
            'Authorization': `Bearer ${token}`,
          }
        });

        if (!response.ok) throw new Error('Failed to fetch accounts');

        const data = await safeJsonParse(response);
        const accounts = data.records || data.list || [];

        accountLoading.classList.add('hidden');

        if (accounts.length === 0) {
          accountEmpty.classList.remove('hidden');
          return;
        }

        accounts.forEach((account: any) => {
          const div = document.createElement('div');
          div.className = 'px-4 py-2 hover:bg-slate-50 cursor-pointer text-sm';
          div.textContent = account.fields?.['Company Name'] || account['Company Name'] || 'Unnamed Account';
          div.onclick = () => selectAccount(account);
          accountResults.appendChild(div);
        });
      } catch (error) {
        console.error('Account search error:', error);
        accountLoading.classList.add('hidden');
        accountEmpty.classList.remove('hidden');
      }
    }, 300);

    async function selectAccount(account: any) {
      const accountId = account.id;
      const accountName = account.fields?.['Company Name'] || account['Company Name'] || 'Unnamed Account';
      
      accountSearch.value = accountName;
      selectedAccountId.value = accountId.toString();
      accountDropdown.classList.add('hidden');

      // Fetch full account details with the specified fields
      try {
        const response = await fetch(
          `${API_BASE_URL}/proxy/accounts_duplicate/records/${accountId}?fields=Company Name,Phone Number,Billing Street,Billing City,Shipping City`,
          {
            headers: {
              'Authorization': `Bearer ${token}`,
            }
          }
        );

        if (!response.ok) throw new Error('Failed to fetch account details');

        const data = await safeJsonParse(response);
        const fields = data.fields || {};

        // Auto-populate the fields
        companyNameInput.value = fields['Company Name'] || '';
        phoneInput.value = fields['Phone Number'] || '';
        billingStreetInput.value = fields['Billing Street'] || '';
        billingCityInput.value = fields['Billing City'] || '';
        shippingCityInput.value = fields['Shipping City'] || '';
      } catch (error) {
        console.error('Error fetching account details:', error);
        showAlert('Failed to load account details', 'error');
      }
    }

    accountSearch.addEventListener('input', (e) => {
      const query = (e.target as HTMLInputElement).value;
      searchAccounts(query);
    });

    document.addEventListener('click', (e) => {
      if (!accountDropdown.contains(e.target as Node) && e.target !== accountSearch) {
        accountDropdown.classList.add('hidden');
      }
    });

    // Fetch detailed product information
    async function fetchProductDetails(productId: number, productItem: HTMLElement) {
      try {
        const response = await fetch(
          `${API_BASE_URL}/proxy/products/records/${productId}?fields=Id,Product Name,Brand,HSN/SAC Code,Model No,Tax,Description,Customer Unit Price,Dealer Unit Price,warranty`,
          {
            headers: {
              'Authorization': `Bearer ${token}`,
            }
          }
        );

        if (!response.ok) throw new Error('Failed to fetch product details');

        const data = await safeJsonParse(response);
        console.log('[PRODUCT] Full API response:', data);
        const fields = data.fields || {};
        console.log('[PRODUCT] Fields extracted:', fields);

        // Store all product details in hidden inputs
        const productNameInput = productItem.querySelector('.product-name') as HTMLInputElement;
        const productBrandInput = productItem.querySelector('.product-brand') as HTMLInputElement;
        const productHsnInput = productItem.querySelector('.product-hsn') as HTMLInputElement;
        const productModelInput = productItem.querySelector('.product-model') as HTMLInputElement;
        const productCodeInput = productItem.querySelector('.product-code') as HTMLInputElement;
        const productTaxInput = productItem.querySelector('.product-tax') as HTMLInputElement;
        const productDescriptionInput = productItem.querySelector('.product-description') as HTMLInputElement;
        const productCustomerPriceInput = productItem.querySelector('.product-customer-price') as HTMLInputElement;
        const productDealerPriceInput = productItem.querySelector('.product-dealer-price') as HTMLInputElement;
        const productWarrantyInput = productItem.querySelector('.product-warranty') as HTMLInputElement;
        const customPriceInput = productItem.querySelector('.product-custom-price') as HTMLInputElement;

        // Get visible display fields
        const brandDisplay = productItem.querySelector('.product-brand-display') as HTMLInputElement;
        const codeDisplay = productItem.querySelector('.product-code-display') as HTMLInputElement;
        const hsnDisplay = productItem.querySelector('.product-hsn-display') as HTMLInputElement;
        const taxDisplay = productItem.querySelector('.product-tax-display') as HTMLInputElement;
        const warrantyDisplay = productItem.querySelector('.product-warranty-display') as HTMLInputElement;
        const descriptionDisplay = productItem.querySelector('.product-description-display') as HTMLTextAreaElement;

        // Populate hidden inputs
        if (productNameInput) productNameInput.value = fields['Product Name'] || '';
        if (productBrandInput) productBrandInput.value = fields['Brand'] || '';
        if (productHsnInput) productHsnInput.value = fields['HSN/SAC Code'] || '';
        if (productModelInput) productModelInput.value = '';
        if (productCodeInput) productCodeInput.value = fields['Model No'] || '';
        if (productTaxInput) productTaxInput.value = fields['Tax'] || '';
        if (productDescriptionInput) productDescriptionInput.value = fields['Description'] || '';
        if (productCustomerPriceInput) productCustomerPriceInput.value = fields['Customer Unit Price'] || '0';
        if (productDealerPriceInput) productDealerPriceInput.value = fields['Dealer Unit Price'] || '0';
        if (productWarrantyInput) productWarrantyInput.value = fields['warranty'] != null ? String(fields['warranty']) : '';

        // Populate visible display fields
        if (brandDisplay) brandDisplay.value = fields['Brand'] || '-';
        if (codeDisplay) codeDisplay.value = fields['Model No'] || '-';
        if (hsnDisplay) hsnDisplay.value = fields['HSN/SAC Code'] || '-';
        if (taxDisplay) taxDisplay.value = fields['Tax'] || '-';
        if (warrantyDisplay) warrantyDisplay.value = fields['warranty'] != null ? String(fields['warranty']) : '-';
        if (descriptionDisplay) descriptionDisplay.value = fields['Description'] || '-';

        // Set the price based on current quote type
        const quoteType = (document.getElementById('quoteType') as HTMLSelectElement).value;
        console.log('[PRODUCT] Current quote type:', quoteType);
        if (quoteType === 'Customer') {
          if (customPriceInput) customPriceInput.value = fields['Customer Unit Price'] || '0';
          console.log('[PRODUCT] Set Customer price:', fields['Customer Unit Price']);
        } else if (quoteType === 'Dealer ' || quoteType === 'Dealer') {
          if (customPriceInput) customPriceInput.value = fields['Dealer Unit Price'] || '0';
          console.log('[PRODUCT] Set Dealer price:', fields['Dealer Unit Price']);
        }

        console.log('[PRODUCT] Fetched product details:', {
          name: fields['Product Name'],
          brand: fields['Brand'],
          hsn: fields['HSN/SAC Code'],
          model: '-',
          code: fields['Model No'],
          tax: fields['Tax'],
          customerPrice: fields['Customer Unit Price'],
          dealerPrice: fields['Dealer Unit Price']
        });
      } catch (error) {
        console.error('Error fetching product details:', error);
        showAlert('Failed to load product details', 'error');
      }
    }

    // Update all product prices when quote type changes
    function updateProductPricesForQuoteType() {
      const quoteType = (document.getElementById('quoteType') as HTMLSelectElement).value;
      const productItems = productsContainer.querySelectorAll('.product-item');

      productItems.forEach((item) => {
        const customerPriceInput = item.querySelector('.product-customer-price') as HTMLInputElement;
        const dealerPriceInput = item.querySelector('.product-dealer-price') as HTMLInputElement;
        const customPriceInput = item.querySelector('.product-custom-price') as HTMLInputElement;

        if (customerPriceInput && dealerPriceInput && customPriceInput) {
          if (quoteType === 'Customer') {
            customPriceInput.value = customerPriceInput.value || '0';
          } else if (quoteType === 'Dealer ' || quoteType === 'Dealer') {
            customPriceInput.value = dealerPriceInput.value || '0';
          }
        }
      });

      console.log('[QUOTE TYPE] Updated all product prices for:', quoteType);
    }

    // Listen for quote type changes
    const quoteTypeSelect = document.getElementById('quoteType') as HTMLSelectElement;
    quoteTypeSelect.addEventListener('change', updateProductPricesForQuoteType);

    // Product search functionality (same as modal)
    const productsContainer = document.getElementById('productsContainer') as HTMLDivElement;
    const addProductBtn = document.getElementById('addProductBtn') as HTMLButtonElement;

    function setupProductSearch(productItem: HTMLElement) {
      const searchInput = productItem.querySelector('.product-search') as HTMLInputElement;
      const productIdInput = productItem.querySelector('.product-id') as HTMLInputElement;
      const productNameInput = productItem.querySelector('.product-name') as HTMLInputElement;
      const productPriceInput = productItem.querySelector('.product-price') as HTMLInputElement;
      const customPriceInput = productItem.querySelector('.product-custom-price') as HTMLInputElement;
      const productBrandInput = productItem.querySelector('.product-brand') as HTMLInputElement;
      const productHsnInput = productItem.querySelector('.product-hsn') as HTMLInputElement;
      const productModelInput = productItem.querySelector('.product-model') as HTMLInputElement;
      const productCodeInput = productItem.querySelector('.product-code') as HTMLInputElement;
      const productTaxInput = productItem.querySelector('.product-tax') as HTMLInputElement;
      const productDescriptionInput = productItem.querySelector('.product-description') as HTMLInputElement;
      const productCustomerPriceInput = productItem.querySelector('.product-customer-price') as HTMLInputElement;
      const productDealerPriceInput = productItem.querySelector('.product-dealer-price') as HTMLInputElement;
      const dropdown = productItem.querySelector('.product-dropdown') as HTMLDivElement;
      const results = productItem.querySelector('.product-results') as HTMLDivElement;
      const loading = productItem.querySelector('.product-loading') as HTMLDivElement;
      const empty = productItem.querySelector('.product-empty') as HTMLDivElement;
      const removeBtn = productItem.querySelector('.remove-product-btn') as HTMLButtonElement;

      const searchProducts = debounce(async (query: string) => {
        if (query.length < 2) {
          dropdown.classList.add('hidden');
          return;
        }

        loading.classList.remove('hidden');
        empty.classList.add('hidden');
        results.innerHTML = '';
        dropdown.classList.remove('hidden');

        try {
          // Search by Product Name OR Model No
          const rawWhere = `(Product Name,like,%${query}%)~or(Model No,like,%${query}%)`;
          const encodedWhere = encodeURIComponent(rawWhere);
          const response = await fetch(`${API_BASE_URL}/proxy/products/records?where=${encodedWhere}&limit=10&fields=Id,Product Name,Model No,Customer Unit Price,Dealer Unit Price`, {
            headers: {
              'Authorization': `Bearer ${token}`,
            }
          });

          if (!response.ok) throw new Error('Failed to fetch products');

          const data = await safeJsonParse(response);
          const products = data.records || data.list || [];

          loading.classList.add('hidden');

          if (products.length === 0) {
            empty.classList.remove('hidden');
            return;
          }

          products.forEach((product: any) => {
            const div = document.createElement('div');
            div.className = 'px-4 py-2 hover:bg-slate-50 cursor-pointer text-sm';
            const productName = product.fields?.['Product Name'] || product['Product Name'] || 'Unnamed Product';
            const modelNo = product.fields?.['Model No'] || product['Model No'] || '';
            const customerPrice = product.fields?.['Customer Unit Price'] || product['Customer Unit Price'] || 0;
            const dealerPrice = product.fields?.['Dealer Unit Price'] || product['Dealer Unit Price'] || 0;
            div.innerHTML = `<div class="font-medium">${productName}${modelNo ? ` <span class="text-slate-400 font-normal">(${modelNo})</span>` : ''}</div><div class="text-xs text-slate-500">Customer: ₹${customerPrice} | Dealer: ₹${dealerPrice}</div>`;
            div.onclick = async () => {
              searchInput.value = productName;
              productIdInput.value = product.id.toString();

              // Fetch detailed product information
              await fetchProductDetails(product.id, productItem);

              // Default quantity to 1 when a product is selected
              const quantityInput = productItem.querySelector('.product-quantity') as HTMLInputElement;
              if (quantityInput && !quantityInput.value) {
                quantityInput.value = '1';
              }

              dropdown.classList.add('hidden');
            };
            results.appendChild(div);
          });
        } catch (error) {
          console.error('Product search error:', error);
          loading.classList.add('hidden');
          empty.classList.remove('hidden');
        }
      }, 300);

      searchInput.addEventListener('input', (e) => {
        const query = (e.target as HTMLInputElement).value;
        searchProducts(query);
      });

      removeBtn.addEventListener('click', () => {
        if (productsContainer.querySelectorAll('.product-item').length > 1) {
          productItem.remove();
        }
      });

      document.addEventListener('click', (e) => {
        if (!dropdown.contains(e.target as Node) && e.target !== searchInput) {
          dropdown.classList.add('hidden');
        }
      });
    }

    document.querySelectorAll('.product-item').forEach(item => setupProductSearch(item as HTMLElement));

    addProductBtn.addEventListener('click', () => {
      const newItem = productsContainer.querySelector('.product-item')!.cloneNode(true) as HTMLElement;
      newItem.querySelectorAll('input, textarea').forEach(el => (el as HTMLInputElement | HTMLTextAreaElement).value = '');
      (newItem.querySelector('.product-discount') as HTMLInputElement).value = '0';
      productsContainer.appendChild(newItem);
      setupProductSearch(newItem);
    });

    // Quote numbering: GR/2026-27/0001 or GOC/2026-27/0001, sequential per company per financial year (Apr-Mar)
    function getFinancialYear(): string {
      const now = new Date();
      const year = now.getFullYear();
      const month = now.getMonth() + 1; // 1-12
      const startYear = month >= 4 ? year : year - 1;
      const endYear = (startYear + 1) % 100;
      return `${startYear}-${endYear.toString().padStart(2, '0')}`;
    }

    async function getNextQuoteNumber(company: string): Promise<string> {
      const prefix = company === 'Grove Systems' ? 'GR' : 'GOC';
      const fy = getFinancialYear();
      const numberPrefix = `${prefix}/${fy}/`;

      const rawWhere = `(Quote Number,like,${numberPrefix}%)`;
      const encodedWhere = encodeURIComponent(rawWhere);
      const response = await fetch(`${API_BASE_URL}/proxy/quotes/records?where=${encodedWhere}&limit=1000&fields=Quote Number`, {
        headers: { 'Authorization': `Bearer ${token}` }
      });

      if (!response.ok) throw new Error('Failed to fetch existing quote numbers');

      const data = await safeJsonParse(response);
      const existing = data.records || data.list || [];
      const nextSeq = existing.length + 1;

      return `${numberPrefix}${nextSeq.toString().padStart(4, '0')}`;
    }

    // Form submission (same logic as modal)
    createQuoteForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      hideAlert();

      const accountId = parseInt(selectedAccountId.value);
      const accountName = accountSearch.value;
      const issuingCompany = (document.getElementById('issuingCompany') as HTMLSelectElement).value;
      const quoteDate = (document.getElementById('quoteDate') as HTMLInputElement).value;
      const validUntilDate = (document.getElementById('validUntil') as HTMLInputElement).value;
      const quoteStatus = (document.getElementById('quoteStatus') as HTMLSelectElement).value;
      const quoteType = (document.getElementById('quoteType') as HTMLSelectElement).value;
      const notes = (document.getElementById('notes') as HTMLTextAreaElement).value;

      if (!accountId || !accountName) {
        showAlert('Please select an account', 'error');
        return;
      }

      if (!issuingCompany) {
        showAlert('Please select a company', 'error');
        return;
      }

      const productItems = Array.from(productsContainer.querySelectorAll('.product-item'));
      const productData: Array<{ productId: number; quantity: number; unitPrice: number; productName: string; discount: number }> = [];
      let totalAmount = 0;

      console.log('\n=== QUOTE CREATION - PRODUCT DATA COLLECTION ===');
      console.log('[QUOTE CREATE] Number of product items:', productItems.length);

      for (let i = 0; i < productItems.length; i++) {
        const item = productItems[i];
        console.log(`\n[PRODUCT ${i + 1}] Extracting data...`);
        
        const productIdInput = item.querySelector('.product-id') as HTMLInputElement;
        const productNameInput = item.querySelector('.product-name') as HTMLInputElement;
        const quantityInput = item.querySelector('.product-quantity') as HTMLInputElement;
        const unitPriceInput = item.querySelector('.product-custom-price') as HTMLInputElement;
        const discountInput = item.querySelector('.product-discount') as HTMLInputElement;

        const productId = parseInt(productIdInput?.value || '0');
        const productName = productNameInput?.value || '';
        const quantity = parseInt(quantityInput?.value || '0');
        const unitPrice = parseFloat(unitPriceInput?.value || '0');
        const discount = parseFloat(discountInput?.value || '0');

        if (!productId || !quantity || !unitPrice) {
          showAlert('Please fill in all product details', 'error');
          return;
        }

        const discountAmount = (unitPrice * quantity * discount) / 100;
        const lineTotal = quantity * unitPrice - discountAmount;
        console.log(`[PRODUCT ${i + 1}] Line total: ${quantity} × ${unitPrice} - ${discount}% = ${lineTotal}`);

        productData.push({ productId, quantity, unitPrice, productName, discount });
        totalAmount += lineTotal;
        
        console.log(`[PRODUCT ${i + 1}] Running total: ${totalAmount}`);
      }

      console.log('\n[QUOTE CREATE] ✓ All products collected');
      console.log('[QUOTE CREATE] Final Total Amount:', totalAmount);
      console.log('[QUOTE CREATE] Product data:', productData);
      console.log('===========================================\n');

      submitBtn.disabled = true;
      submitBtn.textContent = 'Creating Quote...';

      try {
        const quoteNumber = await getNextQuoteNumber(issuingCompany);

        // Create quote
        const quotePayload = {
          fields: {
            'Subject': accountName,
            'Company': issuingCompany,
            'Quote Number': quoteNumber,
            'Quote Status': quoteStatus,
            'Quote Type': quoteType,
            'Quote Version': '1.0',
            'Quote Date': quoteDate,
            'Valid Until': validUntilDate,
            'Total Amount': totalAmount,
            'Notes': notes || '',
            'Quote Created By': getUserEmail() || 'Unknown User'
          }
        };

        console.log('\n=== CREATING QUOTE RECORD ===');
        console.log('[QUOTE API] Payload:', JSON.stringify(quotePayload, null, 2));
        console.log('[QUOTE API] Total Amount being sent:', totalAmount);

        const createResponse = await fetch(`${API_BASE_URL}/proxy/quotes/records`, {
          method: 'POST',
          headers: {
            'Authorization': `Bearer ${token}`,
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(quotePayload)
        });

        console.log('[QUOTE API] Response status:', createResponse.status);

        if (!createResponse.ok) {
          const errorText = await createResponse.text();
          console.error('[QUOTE API] Error response:', errorText);
          throw new Error('Failed to create quote');
        }

        const result = await safeJsonParse(createResponse);
        console.log('[QUOTE API] Response data:', result);
        
        const quoteId = result.records ? result.records[0]?.id : result.id;
        console.log('[QUOTE API] Created quote ID:', quoteId);

        if (!quoteId) throw new Error('Failed to get quote ID');

        // === NEW CASES FLOW ===
        // Step 1: Auto-create Case (silent, user never sees this)
        console.log('\n=== AUTO-CREATING CASE ===');
        const casePayload = {
          fields: {
            'Title': accountName,  // Same as quote subject
            'Status': 'Open',
            'Created': new Date().toISOString().split('T')[0],
            'Case Created By': getUserEmail() || 'Unknown User'
          }
        };
        
        console.log('[CASE] Creating case with payload:', casePayload);
        
        const caseResponse = await fetch(`${API_BASE_URL}/proxy/cases/records`, {
          method: 'POST',
          headers: {
            'Authorization': `Bearer ${token}`,
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(casePayload)
        });

        if (!caseResponse.ok) {
          const errorText = await caseResponse.text();
          console.error('[CASE] Error creating case:', errorText);
          throw new Error('Failed to create case');
        }

        const caseResult = await safeJsonParse(caseResponse);
        const caseId = caseResult.records ? caseResult.records[0]?.id : caseResult.id;
        console.log('[CASE] Created case ID:', caseId);

        if (!caseId) throw new Error('Failed to get case ID');

        // Step 2: Link Account to Case
        console.log('\n=== LINKING ACCOUNT TO CASE ===');
        console.log('[ACCOUNT LINK] Account ID:', accountId);
        console.log('[ACCOUNT LINK] Case ID:', caseId);
        
        const accountLinkUrl = `${API_BASE_URL}/proxy/cases/links/accounts_duplicate/${caseId}`;
        const accountLinkPayload = [{ id: accountId }];
        
        console.log('[ACCOUNT LINK] URL:', accountLinkUrl);
        console.log('[ACCOUNT LINK] Payload:', JSON.stringify(accountLinkPayload, null, 2));
        
        const linkAccountResponse = await fetch(accountLinkUrl, {
          method: 'POST',
          headers: {
            'Authorization': `Bearer ${token}`,
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(accountLinkPayload)
        });

        console.log('[ACCOUNT LINK] Response status:', linkAccountResponse.status);
        console.log('[ACCOUNT LINK] Response headers:', Object.fromEntries(linkAccountResponse.headers.entries()));
        
        const accountLinkResponseText = await linkAccountResponse.text();
        console.log('[ACCOUNT LINK] Response body:', accountLinkResponseText);
        
        if (!linkAccountResponse.ok) {
          console.error('[ACCOUNT LINK] ❌ Failed to link account to case');
          console.error('[ACCOUNT LINK] Error details:', accountLinkResponseText);
          throw new Error('Failed to link account to case');
        }

        console.log('[ACCOUNT LINK] ✓ Account linked to case successfully');
        console.log('=== ACCOUNT LINK COMPLETE ===\n');

        // Step 3: Link Quote to Case
        console.log('\n=== LINKING QUOTE TO CASE ===');
        console.log('[QUOTE LINK] Quote ID:', quoteId);
        console.log('[QUOTE LINK] Case ID:', caseId);
        
        const quoteLinkUrl = `${API_BASE_URL}/proxy/cases/links/quotes/${caseId}`;
        const quoteLinkPayload = [{ id: quoteId }];
        
        console.log('[QUOTE LINK] URL:', quoteLinkUrl);
        console.log('[QUOTE LINK] Payload:', JSON.stringify(quoteLinkPayload, null, 2));
        
        const linkQuoteResponse = await fetch(quoteLinkUrl, {
          method: 'POST',
          headers: {
            'Authorization': `Bearer ${token}`,
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(quoteLinkPayload)
        });

        console.log('[QUOTE LINK] Response status:', linkQuoteResponse.status);
        console.log('[QUOTE LINK] Response headers:', Object.fromEntries(linkQuoteResponse.headers.entries()));
        
        const quoteLinkResponseText = await linkQuoteResponse.text();
        console.log('[QUOTE LINK] Response body:', quoteLinkResponseText);
        
        if (!linkQuoteResponse.ok) {
          console.error('[QUOTE LINK] ❌ Failed to link quote to case');
          console.error('[QUOTE LINK] Error details:', quoteLinkResponseText);
          throw new Error('Failed to link quote to case');
        }

        console.log('[QUOTE LINK] ✓ Quote linked to case successfully');
        console.log('=== QUOTE LINK COMPLETE ===\n');
        console.log('=== CASE FLOW COMPLETE ===\n');

        // Link products
        console.log('\n=== LINKING PRODUCTS TO QUOTE ===');
        const productLinkUrl = `${API_BASE_URL}/proxy/quotes/links/products/${quoteId}`;
        const productLinkPayload = productData.map(p => ({ id: p.productId }));
        
        console.log('[PRODUCT LINK] Quote ID:', quoteId);
        console.log('[PRODUCT LINK] URL:', productLinkUrl);
        console.log('[PRODUCT LINK] Payload:', JSON.stringify(productLinkPayload, null, 2));
        console.log('[PRODUCT LINK] Number of products:', productLinkPayload.length);
        
        const productLinkResponse = await fetch(productLinkUrl, {
          method: 'POST',
          headers: {
            'Authorization': `Bearer ${token}`,
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(productLinkPayload)
        });
        
        console.log('[PRODUCT LINK] Response status:', productLinkResponse.status);
        console.log('[PRODUCT LINK] Response headers:', Object.fromEntries(productLinkResponse.headers.entries()));
        
        const productLinkResponseText = await productLinkResponse.text();
        console.log('[PRODUCT LINK] Response body:', productLinkResponseText);
        
        if (!productLinkResponse.ok) {
          console.error('[PRODUCT LINK] ❌ Failed to link products to quote');
          console.error('[PRODUCT LINK] Error details:', productLinkResponseText);
        } else {
          console.log('[PRODUCT LINK] ✓ Products linked to quote successfully');
        }
        console.log('=== PRODUCT LINK COMPLETE ===\n');

        // Create junction records
        console.log('\n=== CREATING JUNCTION TABLE RECORDS ===');
        for (let i = 0; i < productData.length; i++) {
          const product = productData[i];
          const junctionPayload = {
            fields: {
              'Quotes': quoteId,
              'Products': product.productId,
              'Quantity': product.quantity,
              'Custom Unit Price': product.unitPrice,
              'Discount': product.discount
            }
          };
          
          console.log(`[JUNCTION ${i + 1}] Creating record for product ID ${product.productId}:`, junctionPayload);
          
          const junctionResponse = await fetch(`${API_BASE_URL}/proxy/products_for_quotes/records`, {
            method: 'POST',
            headers: {
              'Authorization': `Bearer ${token}`,
              'Content-Type': 'application/json',
            },
            body: JSON.stringify(junctionPayload)
          });
          
          console.log(`[JUNCTION ${i + 1}] Response status:`, junctionResponse.status);
          
          if (!junctionResponse.ok) {
            const errorText = await junctionResponse.text();
            console.error(`[JUNCTION ${i + 1}] Error:`, errorText);
          } else {
            const junctionResult = await safeJsonParse(junctionResponse);
            console.log(`[JUNCTION ${i + 1}] Created successfully:`, junctionResult);
          }
        }
        console.log('[JUNCTION] ✓ All junction records created');
        console.log('==========================================\n');

        showAlert('Quote created successfully!', 'success');
        setTimeout(() => {
          window.location.href = `/quote-detail?id=${quoteId}`;
        }, 1000);
      } catch (error) {
        console.error('Error creating quote:', error);
        showAlert(error instanceof Error ? error.message : 'Failed to create quote', 'error');
        submitBtn.disabled = false;
        submitBtn.textContent = 'Create Quote';
      }
    });
  </script>
</AdminLayout>
