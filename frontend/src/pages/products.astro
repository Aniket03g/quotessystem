---
import AdminLayout from '../layouts/AdminLayout.astro';
---

<AdminLayout title="Products" currentPage="products">
  <!-- Page Header -->
  <div class="mb-6">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <h1 class="text-2xl font-semibold text-slate-800">Products</h1>
      </div>
      <a href="/create-product" class="inline-flex items-center gap-2 px-4 py-2 bg-indigo-600 text-white text-sm font-medium rounded-md hover:bg-indigo-700 transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
        </svg>
        New Product
      </a>
    </div>
  </div>

  <!-- Search and Filter Bar -->
  <div class="bg-white rounded-xl border border-slate-200 p-4 mb-6">
    <div class="flex flex-col lg:flex-row gap-3">
      <!-- Search -->
      <div class="flex-1 relative">
        <svg class="absolute left-3 top-3 w-5 h-5 text-slate-400 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
        <input
          type="text"
          id="searchInput"
          placeholder="Search by name or model no..."
          class="w-full pl-10 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all"
          autocomplete="off"
        />
      </div>

      <!-- Brand Filter -->
      <select
        id="brandFilter"
        class="px-3 py-2.5 bg-slate-50 border border-slate-200 rounded-lg text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all min-w-[160px]"
      >
        <option value="">All Brands</option>
      </select>

      <!-- Category Filter -->
      <select
        id="categoryFilter"
        class="px-3 py-2.5 bg-slate-50 border border-slate-200 rounded-lg text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all min-w-[180px]"
      >
        <option value="">All Categories</option>
      </select>

      <!-- Sort -->
      <select
        id="sortBy"
        class="px-3 py-2.5 bg-slate-50 border border-slate-200 rounded-lg text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all min-w-[180px]"
      >
        <option value="">Sort: Default</option>
        <option value="name-asc">Name A → Z</option>
        <option value="name-desc">Name Z → A</option>
        <option value="brand-asc">Brand A → Z</option>
        <option value="price-asc">Price Low → High</option>
        <option value="price-desc">Price High → Low</option>
      </select>

      <!-- Reset button -->
      <button
        id="resetFilters"
        class="px-4 py-2.5 text-sm text-slate-600 border border-slate-200 bg-slate-50 rounded-lg hover:bg-slate-100 transition-colors whitespace-nowrap"
      >
        Reset
      </button>
    </div>

    <!-- Status line -->
    <div class="flex items-center gap-2 mt-3">
      <div id="searchSpinner" class="hidden animate-spin w-4 h-4 text-blue-600">
        <svg class="w-full h-full" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
      </div>
      <span id="searchStatus" class="text-sm text-slate-600"></span>
    </div>
  </div>

  <!-- Products Table -->
  <div class="bg-white rounded-xl border border-slate-200 overflow-hidden">
    <!-- Loading State -->
    <div id="loading" class="hidden py-12 text-center">
      <svg class="animate-spin w-8 h-8 text-blue-600 mx-auto mb-3" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
      </svg>
      <p class="text-sm text-slate-600">Loading products...</p>
    </div>

    <!-- Error State -->
    <div id="error" class="hidden mx-6 my-4 p-4 bg-red-50 border border-red-200 rounded-lg">
      <div class="flex items-start gap-3">
        <svg class="w-5 h-5 text-red-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <p class="text-sm text-red-800" id="errorText"></p>
      </div>
    </div>

    <!-- Mobile cards -->
    <div id="productsMobileList" class="hidden divide-y divide-slate-100"></div>
    <!-- Table (desktop) -->
    <div id="productsTable" class="hidden overflow-x-auto">
      <table class="w-full table-fixed">
        <colgroup>
          <col class="w-12" />
          <col class="w-[28%]" />
          <col class="w-[14%]" />
          <col class="w-[14%]" />
          <col class="w-[12%]" />
          <col class="w-[14%]" />
          <col class="w-[8%]" />
          <col class="w-[10%]" />
        </colgroup>
        <thead class="bg-slate-50 border-b border-slate-200">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-semibold text-slate-600 uppercase tracking-wider">#</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-slate-600 uppercase tracking-wider">PRODUCT NAME</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-slate-600 uppercase tracking-wider">MODEL NO</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-slate-600 uppercase tracking-wider">BRAND</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-slate-600 uppercase tracking-wider">HSN CODE</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-slate-600 uppercase tracking-wider">CUSTOMER PRICE</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-slate-600 uppercase tracking-wider">TAX</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-slate-600 uppercase tracking-wider">STATUS</th>
          </tr>
        </thead>
        <tbody id="productsBody" class="divide-y divide-slate-200"></tbody>
      </table>
    </div>

    <!-- Empty State -->
    <div id="emptyState" class="hidden py-12 text-center">
      <svg class="w-16 h-16 text-slate-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
      </svg>
      <p class="text-slate-600 font-medium mb-1">No products found</p>
      <p class="text-sm text-slate-500">Try adjusting your search or filters</p>
    </div>
  </div>

  <script>
    import { getToken, getUserInfo, logout, safeJsonParse } from '../lib/api';

    document.addEventListener('DOMContentLoaded', () => {
      const API_BASE_URL = import.meta.env.PUBLIC_API_BASE_URL ||
        `${window.location.protocol}//${window.location.hostname}:8082`;
      const token = getToken();

      if (!token) {
        window.location.href = '/login';
        return;
      }

      const isAdmin = getUserInfo()?.role === 'admin';

      const loadingDiv = document.getElementById('loading') as HTMLDivElement;
      const errorDiv = document.getElementById('error') as HTMLDivElement;
      const productsTable = document.getElementById('productsTable') as HTMLDivElement;
      const productsMobileList = document.getElementById('productsMobileList') as HTMLDivElement;
      const productsBody = document.getElementById('productsBody') as HTMLTableSectionElement;
      const emptyState = document.getElementById('emptyState') as HTMLDivElement;
      const searchInput = document.getElementById('searchInput') as HTMLInputElement;
      const searchSpinner = document.getElementById('searchSpinner') as HTMLDivElement;
      const searchStatus = document.getElementById('searchStatus') as HTMLSpanElement;
      const brandFilter = document.getElementById('brandFilter') as HTMLSelectElement;
      const categoryFilter = document.getElementById('categoryFilter') as HTMLSelectElement;
      const sortBy = document.getElementById('sortBy') as HTMLSelectElement;
      const resetBtn = document.getElementById('resetFilters') as HTMLButtonElement;

      let allRecords: any[] = [];
      let selectedProduct: any = null;

      const storedProduct = localStorage.getItem('selectedProduct');
      if (storedProduct) {
        try { selectedProduct = JSON.parse(storedProduct); } catch {}
      }

      function populateFilters(records: any[]) {
        const brands = [...new Set(records.map(r => r.fields?.['Brand']).filter(Boolean))].sort() as string[];
        brands.forEach(brand => {
          const opt = document.createElement('option');
          opt.value = brand;
          opt.textContent = brand;
          brandFilter.appendChild(opt);
        });

        const categories = [...new Set(records.map(r => r.fields?.['Product Category']).filter(Boolean))].sort() as string[];
        categories.forEach(cat => {
          const opt = document.createElement('option');
          opt.value = cat;
          opt.textContent = cat;
          categoryFilter.appendChild(opt);
        });
      }

      function applyFilters() {
        const search = searchInput.value.toLowerCase();
        const brand = brandFilter.value;
        const category = categoryFilter.value;
        const sort = sortBy.value;

        let filtered = allRecords.filter(record => {
          const f = record.fields || {};
          if (search) {
            const name = (f['Product Name'] || '').toLowerCase();
            const model = (f['Model No'] || '').toLowerCase();
            if (!name.includes(search) && !model.includes(search)) return false;
          }
          if (brand && f['Brand'] !== brand) return false;
          if (category && f['Product Category'] !== category) return false;
          return true;
        });

        if (sort) {
          filtered = [...filtered].sort((a, b) => {
            const af = a.fields || {};
            const bf = b.fields || {};
            switch (sort) {
              case 'name-asc':  return (af['Product Name'] || '').localeCompare(bf['Product Name'] || '');
              case 'name-desc': return (bf['Product Name'] || '').localeCompare(af['Product Name'] || '');
              case 'brand-asc': return (af['Brand'] || '').localeCompare(bf['Brand'] || '');
              case 'price-asc': return parseFloat(af['Customer Unit Price'] || '0') - parseFloat(bf['Customer Unit Price'] || '0');
              case 'price-desc': return parseFloat(bf['Customer Unit Price'] || '0') - parseFloat(af['Customer Unit Price'] || '0');
              default: return 0;
            }
          });
        }

        renderTable(filtered);
      }

      function renderTable(records: any[]) {
        const isFiltered = searchInput.value || brandFilter.value || categoryFilter.value || sortBy.value;
        searchStatus.textContent = isFiltered
          ? `Showing ${records.length} of ${allRecords.length} product(s)`
          : `${records.length} product(s)`;

        if (records.length === 0) {
          productsTable.classList.add('hidden');
          productsMobileList.classList.add('hidden');
          emptyState.classList.remove('hidden');
          return;
        }

        emptyState.classList.add('hidden');

        productsBody.innerHTML = records.map((record, index) => {
          const f = record.fields || {};
          const productName = f['Product Name'] || '<span class="text-slate-400 italic">N/A</span>';
          const modelNo = f['Model No'] || '<span class="text-slate-400 italic">—</span>';
          const brand = f['Brand'] || '<span class="text-slate-400 italic">—</span>';
          const hsnCode = f['HSN/SAC Code'] || '<span class="text-slate-400 italic">—</span>';
          const unitPrice = f['Customer Unit Price'] ? parseFloat(String(f['Customer Unit Price'])) : 0;
          const tax = f['Tax'] ? parseFloat(String(f['Tax'])) : 0;
          const isActive = (f['Product Status'] || '').toLowerCase() !== 'inactive';
          const status = isActive ? 'Active' : 'Inactive';
          const isSelected = selectedProduct && selectedProduct.id === record.id;

          return `
            <tr data-product-id="${record.id}" class="cursor-pointer transition-colors hover:bg-slate-50 ${isSelected ? 'bg-blue-50 hover:bg-blue-100' : ''}">
              <td class="px-4 py-4 text-sm font-medium text-slate-900">${index + 1}</td>
              <td class="px-4 py-4 text-sm text-slate-900 truncate max-w-0">${productName}</td>
              <td class="px-4 py-4 text-sm text-slate-600 truncate max-w-0">${modelNo}</td>
              <td class="px-4 py-4 text-sm text-slate-600 truncate max-w-0">${brand}</td>
              <td class="px-4 py-4 text-sm text-slate-600 truncate max-w-0">${hsnCode}</td>
              <td class="px-4 py-4 text-sm text-slate-600">₹${unitPrice.toFixed(2)}</td>
              <td class="px-4 py-4 text-sm text-slate-600">${tax}%</td>
              <td class="px-4 py-4">
                ${isAdmin ? `
                <button class="status-toggle-btn inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium transition-colors cursor-pointer ${isActive ? 'bg-emerald-100 text-emerald-800 hover:bg-emerald-200' : 'bg-red-100 text-red-800 hover:bg-red-200'}" data-product-id="${record.id}" title="Click to mark as ${isActive ? 'Inactive' : 'Active'}">
                  ${status}
                </button>` : `
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ${isActive ? 'bg-emerald-100 text-emerald-800' : 'bg-red-100 text-red-800'}">
                  ${status}
                </span>`}
              </td>
            </tr>
          `;
        }).join('');

        productsTable.classList.remove('hidden');

        productsBody.querySelectorAll('tr').forEach((row, index) => {
          row.addEventListener('click', () => {
            selectedProduct = records[index];
            localStorage.setItem('selectedProduct', JSON.stringify(selectedProduct));
            productsBody.querySelectorAll('tr').forEach(r => r.classList.remove('bg-blue-50', 'hover:bg-blue-100'));
            row.classList.add('bg-blue-50', 'hover:bg-blue-100');
          });
        });

        productsBody.querySelectorAll<HTMLButtonElement>('.status-toggle-btn').forEach((btn) => {
          btn.addEventListener('click', (e) => {
            e.stopPropagation();
            const productId = btn.dataset.productId || '';
            const record = records.find(r => String(r.id) === productId);
            if (record) toggleProductStatus(record, btn);
          });
        });

        productsMobileList.innerHTML = records.map((record, index) => {
          const f = record.fields || {};
          const productName = f['Product Name'] || 'N/A';
          const modelNo = f['Model No'] || '';
          const brand = f['Brand'] || '';
          const unitPrice = f['Customer Unit Price'] ? parseFloat(String(f['Customer Unit Price'])) : 0;
          const tax = f['Tax'] ? parseFloat(String(f['Tax'])) : 0;
          const isActive = (f['Product Status'] || '').toLowerCase() !== 'inactive';
          const status = isActive ? 'Active' : 'Inactive';
          const isSelected = selectedProduct && selectedProduct.id === record.id;

          return `
            <div class="p-4 cursor-pointer transition-colors ${isSelected ? 'bg-blue-50' : 'hover:bg-slate-50'}" data-mobile-product-index="${index}">
              <div class="flex items-start justify-between gap-2 mb-1">
                <div class="text-sm font-semibold text-slate-900 flex-1 min-w-0">${productName}</div>
                ${isAdmin
                  ? `<button class="status-toggle-btn flex-shrink-0 inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium transition-colors cursor-pointer ${isActive ? 'bg-emerald-100 text-emerald-800 hover:bg-emerald-200' : 'bg-red-100 text-red-800 hover:bg-red-200'}" data-product-id="${record.id}" title="Click to mark as ${isActive ? 'Inactive' : 'Active'}">${status}</button>`
                  : `<span class="flex-shrink-0 inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium ${isActive ? 'bg-emerald-100 text-emerald-800' : 'bg-red-100 text-red-800'}">${status}</span>`}
              </div>
              ${modelNo ? `<div class="text-xs text-slate-500 mb-0.5">${modelNo}${brand ? ' · ' + brand : ''}</div>` : (brand ? `<div class="text-xs text-slate-500 mb-0.5">${brand}</div>` : '')}
              <div class="text-sm font-semibold text-slate-800">₹${unitPrice.toFixed(2)} <span class="text-xs font-normal text-slate-500">+ ${tax}% tax</span></div>
            </div>
          `;
        }).join('');

        productsMobileList.classList.remove('hidden');

        productsMobileList.querySelectorAll<HTMLElement>('[data-mobile-product-index]').forEach((card) => {
          card.addEventListener('click', () => {
            const index = parseInt(card.dataset.mobileProductIndex || '0');
            selectedProduct = records[index];
            localStorage.setItem('selectedProduct', JSON.stringify(selectedProduct));
            productsMobileList.querySelectorAll('[data-mobile-product-index]').forEach(c => c.classList.remove('bg-blue-50'));
            card.classList.add('bg-blue-50');
          });
        });

        productsMobileList.querySelectorAll<HTMLButtonElement>('.status-toggle-btn').forEach((btn) => {
          btn.addEventListener('click', (e) => {
            e.stopPropagation();
            const productId = btn.dataset.productId || '';
            const record = records.find(r => String(r.id) === productId);
            if (record) toggleProductStatus(record, btn);
          });
        });
      }

      const STATUS_ACTIVE_CLASSES = ['bg-emerald-100', 'text-emerald-800', 'hover:bg-emerald-200'];
      const STATUS_INACTIVE_CLASSES = ['bg-red-100', 'text-red-800', 'hover:bg-red-200'];

      function setStatusButtonVisual(btn: HTMLButtonElement, isActive: boolean) {
        btn.classList.remove(...STATUS_ACTIVE_CLASSES, ...STATUS_INACTIVE_CLASSES);
        btn.classList.add(...(isActive ? STATUS_ACTIVE_CLASSES : STATUS_INACTIVE_CLASSES));
        btn.textContent = isActive ? 'Active' : 'Inactive';
        btn.title = `Click to mark as ${isActive ? 'Inactive' : 'Active'}`;
      }

      async function toggleProductStatus(record: any, btn: HTMLButtonElement) {
        const wasActive = (record.fields['Product Status'] || '').toLowerCase() !== 'inactive';
        const oldStatus = record.fields['Product Status'];
        const newStatus = wasActive ? 'Inactive' : 'Active';

        record.fields['Product Status'] = newStatus;
        setStatusButtonVisual(btn, !wasActive);

        try {
          const res = await fetch(`${API_BASE_URL}/proxy/products/records`, {
            method: 'PATCH',
            headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: record.id, fields: { 'Product Status': newStatus } })
          });
          if (!res.ok) throw new Error('Failed to update product status');
        } catch {
          record.fields['Product Status'] = oldStatus;
          setStatusButtonVisual(btn, wasActive);
          (document.getElementById('errorText') as HTMLElement).textContent = 'Failed to update product status. Please try again.';
          errorDiv.classList.remove('hidden');
          setTimeout(() => errorDiv.classList.add('hidden'), 3000);
        }
      }

      async function loadAllProducts() {
        try {
          loadingDiv.classList.remove('hidden');
          productsTable.classList.add('hidden');
          productsMobileList.classList.add('hidden');
          emptyState.classList.add('hidden');
          errorDiv.classList.add('hidden');
          searchStatus.textContent = '';

          const response = await fetch(`${API_BASE_URL}/proxy/products/records`, {
            headers: { 'Authorization': `Bearer ${token}` },
          });

          if (response.status === 401) { logout(); return; }
          if (!response.ok) throw new Error('Failed to load products');

          const data = await safeJsonParse(response);
          allRecords = data.records || [];

          loadingDiv.classList.add('hidden');
          populateFilters(allRecords);
          applyFilters();
        } catch (error) {
          loadingDiv.classList.add('hidden');
          (document.getElementById('errorText') as HTMLElement).textContent =
            error instanceof Error ? error.message : 'Failed to load products';
          errorDiv.classList.remove('hidden');
        }
      }

      searchInput.addEventListener('input', applyFilters);
      brandFilter.addEventListener('change', applyFilters);
      categoryFilter.addEventListener('change', applyFilters);
      sortBy.addEventListener('change', applyFilters);

      resetBtn.addEventListener('click', () => {
        searchInput.value = '';
        brandFilter.value = '';
        categoryFilter.value = '';
        sortBy.value = '';
        applyFilters();
      });

      loadAllProducts();
    });
  </script>

  <style>
    @media (min-width: 1024px) { #productsMobileList { display: none !important; } }
    @media (max-width: 1023px) { #productsTable { display: none !important; } }
  </style>
</AdminLayout>
