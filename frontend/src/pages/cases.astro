---
import AdminLayout from '../layouts/AdminLayout.astro';

---

<AdminLayout title="Cases" currentPage="cases">
  <div class="container mx-auto px-4 py-8">
    <div class="bg-white rounded-lg shadow-md p-6">
      <div class="flex justify-between items-center mb-6">
        <h1 class="text-2xl font-bold">Cases</h1>
      </div>

      <!-- Cases Table -->
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Case ID</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Title</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Created</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Quotes</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
            </tr>
          </thead>
          <tbody id="casesTableBody" class="bg-white divide-y divide-gray-200">
            <tr>
              <td colspan="6" class="px-6 py-4 text-center text-gray-500">
                Loading cases...
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Pagination -->
      <div class="mt-4 flex items-center justify-between">
        <div class="text-sm text-gray-700">
          Showing <span id="showingCount">0</span> cases
        </div>
      </div>

      <!-- Error Message -->
      <div id="errorMessage" class="hidden mt-4 p-4 bg-red-50 border border-red-200 rounded-lg">
        <p class="text-red-800"></p>
      </div>
    </div>
  </div>

  <script>
    const API_BASE_URL = import.meta.env.PUBLIC_API_BASE_URL || `http://${window.location.hostname}:8082`;
    async function loadCases() {
      try {
        const token = localStorage.getItem('jwt_token');
        if (!token) {
          console.error('[CASES] No token found, redirecting to login');
          window.location.href = '/login';
          return;
        }
        
        console.log('[CASES] Token found, proceeding with API call');

        const url = `${API_BASE_URL}/proxy/cases/records?fields=Id,Title,Status,Created,Quotes`;
        console.log('[CASES] ========================================');
        console.log('[CASES] API_BASE_URL:', API_BASE_URL);
        console.log('[CASES] Full URL:', url);
        console.log('[CASES] Token present:', !!token);
        console.log('[CASES] Fetching cases...');
        
        const response = await fetch(url, {
          method: 'GET',
          headers: {
            'Authorization': `Bearer ${token}`,
            'Content-Type': 'application/json',
          },
        });

        console.log('[CASES] Response status:', response.status);
        console.log('[CASES] Response ok:', response.ok);

        if (response.status === 401) {
          console.error('[CASES] Unauthorized, redirecting to login');
          window.location.href = '/login';
          return;
        }

        if (!response.ok) {
          const errorText = await response.text();
          console.error('[CASES] Error response:', errorText);
          throw new Error(`Failed to fetch cases: ${response.status} ${errorText}`);
        }

        const data = await response.json();
        console.log('[CASES] Response data:', data);
        
        const cases = data.records || [];
        console.log('[CASES] Cases fetched:', cases.length);
        console.log('[CASES] Sample case:', cases[0]);
        console.log('[CASES] ========================================');
        
        displayCases(cases);
        document.getElementById('showingCount').textContent = cases.length;

      } catch (error) {
        console.error('[CASES] Error:', error);
        showError(error.message);
      }
    }

    function displayCases(cases) {
      const tbody = document.getElementById('casesTableBody');
      
      if (cases.length === 0) {
        tbody.innerHTML = `
          <tr>
            <td colspan="6" class="px-6 py-4 text-center text-gray-500">
              No cases found.
            </td>
          </tr>
        `;
        return;
      }

      tbody.innerHTML = cases.map(caseRecord => {
        const fields = caseRecord.fields || {};
        const caseId = caseRecord.id;
        const title = fields['Title'] || 'N/A';
        const status = fields['Status'] || 'N/A';
        const created = fields['Created'] || 'N/A';
        const quotesCount = fields['Quotes'] || 0;
        
        // Status badge color
        let statusColor = 'bg-gray-100 text-gray-800';
        if (status === 'Open') statusColor = 'bg-green-100 text-green-800';
        else if (status === 'Close') statusColor = 'bg-red-100 text-red-800';

        return `
          <tr class="hover:bg-gray-50">
            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
              ${caseId}
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
              ${title}
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm">
              <span class="px-2 py-1 ${statusColor} rounded-full text-xs font-semibold">
                ${status}
              </span>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
              ${created}
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
              <span class="px-2 py-1 bg-blue-100 text-blue-800 rounded-full text-xs font-semibold">
                ${quotesCount} quote${quotesCount !== 1 ? 's' : ''}
              </span>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm">
              <a href="/case-quotes?id=${caseId}" class="text-blue-600 hover:text-blue-800 font-medium">
                View Quotes
              </a>
            </td>
          </tr>
        `;
      }).join('');
    }

    function showError(message) {
      const errorDiv = document.getElementById('errorMessage');
      errorDiv.querySelector('p').textContent = message;
      errorDiv.classList.remove('hidden');
      
      const tbody = document.getElementById('casesTableBody');
      tbody.innerHTML = `
        <tr>
          <td colspan="6" class="px-6 py-4 text-center text-red-500">
            Error loading cases
          </td>
        </tr>
      `;
    }

    // Load cases on page load
    loadCases();
  </script>
</AdminLayout>
