---
import AdminLayout from '../layouts/AdminLayout.astro';

const API_BASE_URL = import.meta.env.PUBLIC_API_BASE_URL || 'http://localhost:8082';
---

<style is:global>
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&family=DM+Mono:wght@400;500&display=swap');

.cases-card {
  background: #fff;
  border-radius: 16px;
  border: 1px solid #e8eaed;
  box-shadow: 0 1px 4px rgba(0,0,0,0.06);
  overflow: hidden;
}

.cases-header {
  padding: 20px 28px 16px;
  border-bottom: 1px solid #f0f1f3;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.cases-title { font-size: 15px; font-weight: 600; color: #1a1d23; letter-spacing: -0.01em; }

.case-count {
  font-size: 12px; font-weight: 500; color: #8a919e;
  background: #f4f5f7; padding: 3px 9px; border-radius: 20px;
  font-family: 'DM Mono', monospace;
}

.case-item { border-bottom: 1px solid #f0f1f3; }
.case-item:last-child { border-bottom: none; }

.case-row {
  display: flex; align-items: center;
  padding: 16px 28px; cursor: pointer;
  transition: background 0.15s ease;
  user-select: none; gap: 16px;
}
.case-row:hover { background: #fafbfc; }
.case-item.open .case-row { background: #fafbfc; }

.chevron {
  width: 24px; height: 24px; border-radius: 6px;
  background: #f0f1f3; display: flex; align-items: center;
  justify-content: center; flex-shrink: 0;
  transition: background 0.15s, transform 0.25s ease;
}
.chevron svg {
  width: 12px; height: 12px; color: #6b7280;
  transition: transform 0.25s ease;
}
.case-item.open .chevron { background: #1a1d23; }
.case-item.open .chevron svg { color: #fff; transform: rotate(90deg); }

.case-id {
  font-family: 'DM Mono', monospace;
  font-size: 11px; font-weight: 500; color: #b0b7c0; width: 40px; flex-shrink: 0;
}

.case-title { flex: 1; font-size: 14px; font-weight: 500; color: #1a1d23; }

.status-pill {
  font-size: 11px; font-weight: 600;
  padding: 3px 10px; border-radius: 20px;
  letter-spacing: 0.02em; flex-shrink: 0;
}
.status-open { background: #e8f5e9; color: #2e7d32; }
.status-won  { background: #e3f2fd; color: #1565c0; }
.status-closed { background: #f3f4f6; color: #6b7280; }

.case-date {
  font-size: 12px; color: #b0b7c0;
  font-family: 'DM Mono', monospace;
  flex-shrink: 0; width: 90px; text-align: right;
}

.quote-count-badge {
  font-size: 11px; font-weight: 500; color: #8a919e;
  background: #f0f1f3; padding: 2px 8px; border-radius: 4px;
  font-family: 'DM Mono', monospace; flex-shrink: 0;
}

/* ACCORDION PANEL */
.timeline-panel {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.35s cubic-bezier(0.4, 0, 0.2, 1);
}
.case-item.open .timeline-panel { max-height: 800px; }

.timeline-inner {
  padding: 8px 28px 24px 28px;
  border-top: 1px solid #f0f1f3;
  background: #fafbfc;
}

.timeline-label {
  font-size: 11px; font-weight: 600;
  letter-spacing: 0.08em; text-transform: uppercase;
  color: #b0b7c0; margin-bottom: 20px; padding-top: 16px;
}

/* TIMELINE */
.timeline { position: relative; padding-left: 28px; }
.timeline::before {
  content: ''; position: absolute;
  left: 7px; top: 6px; bottom: 6px;
  width: 2px; background: #e8eaed; border-radius: 2px;
}

/* STAGGERED ENTRY ANIMATION */
.timeline-entry {
  position: relative; margin-bottom: 20px;
  opacity: 0; transform: translateY(8px);
  transition: opacity 0.3s ease, transform 0.3s ease;
}
.timeline-entry:last-child { margin-bottom: 0; }

.case-item.open .timeline-entry { opacity: 1; transform: translateY(0); }
.case-item.open .timeline-entry:nth-child(1) { transition-delay: 0.08s; }
.case-item.open .timeline-entry:nth-child(2) { transition-delay: 0.14s; }
.case-item.open .timeline-entry:nth-child(3) { transition-delay: 0.20s; }
.case-item.open .timeline-entry:nth-child(4) { transition-delay: 0.26s; }

/* DOTS */
.timeline-dot {
  position: absolute; left: -28px; top: 5px;
  width: 16px; height: 16px; border-radius: 50%;
  background: #fff; border: 2px solid #d1d5db;
  display: flex; align-items: center; justify-content: center; z-index: 1;
}
.timeline-dot.latest { border-color: #1a1d23; background: #1a1d23; }
.timeline-dot.latest::after { content: ''; width: 5px; height: 5px; border-radius: 50%; background: #fff; }
.timeline-dot.sent { border-color: #2196f3; }
.timeline-dot.sent::after { content: ''; width: 5px; height: 5px; border-radius: 50%; background: #2196f3; }
.timeline-dot.approved { border-color: #4caf50; }
.timeline-dot.approved::after { content: ''; width: 5px; height: 5px; border-radius: 50%; background: #4caf50; }

/* QUOTE CARDS */
.quote-card {
  background: #fff; border: 1px solid #e8eaed;
  border-radius: 10px; padding: 14px 16px;
  transition: border-color 0.15s, box-shadow 0.15s;
}
.quote-card:hover { border-color: #c8ccd2; box-shadow: 0 2px 8px rgba(0,0,0,0.06); }

.quote-card-top {
  display: flex; align-items: center;
  justify-content: space-between; margin-bottom: 8px;
}

.quote-version {
  font-family: 'DM Mono', monospace; font-size: 11px; font-weight: 500;
  color: #6b7280; background: #f4f5f7; padding: 2px 8px; border-radius: 4px;
}
.quote-version.latest-v { background: #1a1d23; color: #fff; }

.quote-status-tag { font-size: 11px; font-weight: 600; padding: 2px 8px; border-radius: 4px; }
.qs-draft    { background: #f3f4f6; color: #6b7280; }
.qs-sent     { background: #e3f2fd; color: #1565c0; }
.qs-approved { background: #e8f5e9; color: #2e7d32; }
.qs-final    { background: #e8f5e9; color: #1b5e20; }

.quote-subject { font-size: 13px; font-weight: 500; color: #1a1d23; margin-bottom: 6px; }

.quote-card-bottom {
  display: flex; align-items: center;
  justify-content: space-between; margin-top: 10px;
  padding-top: 10px; border-top: 1px solid #f4f5f7;
}

.quote-meta { display: flex; align-items: center; gap: 12px; font-size: 12px; color: #8a919e; }
.quote-amount { font-family: 'DM Mono', monospace; font-size: 12px; font-weight: 500; color: #1a1d23; }
.quote-date-small { font-size: 11px; color: #b0b7c0; font-family: 'DM Mono', monospace; }

.view-link {
  font-size: 12px; font-weight: 600; color: #1a1d23; text-decoration: none;
  display: flex; align-items: center; gap: 4px;
  border: 1px solid #e8eaed; padding: 4px 10px; border-radius: 6px;
  transition: all 0.15s;
}
.view-link:hover { background: #1a1d23; color: #fff; border-color: #1a1d23; }
</style>

<AdminLayout title="Account Details" currentPage="accounts">
  <div class="container mx-auto px-4 py-8">
    <!-- Back Button -->
    <div class="mb-6">
      <a href="/accounts" class="inline-flex items-center gap-2 text-blue-600 hover:text-blue-800">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
        </svg>
        Back to Accounts
      </a>
    </div>

    <!-- Account Details Card -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden mb-6">
      <!-- Account Header -->
      <div class="bg-gradient-to-br from-blue-50 via-slate-50 to-white px-8 py-8 border-b border-slate-200">
        <div class="flex justify-between items-start">
          <div class="flex-1">
            <div class="flex items-center gap-3 mb-2">
              <div class="w-14 h-14 bg-gradient-to-br from-blue-500 to-blue-600 rounded-xl flex items-center justify-center shadow-lg shadow-blue-500/30">
                <svg xmlns="http://www.w3.org/2000/svg" height="28px" viewBox="0 -960 960 960" width="28px" fill="#ffffff"><path d="M200-280v-280h80v280h-80Zm240 0v-280h80v280h-80ZM80-120v-80h800v80H80Zm600-160v-280h80v280h-80ZM80-640v-80l400-200 400 200v80H80Zm178-80h444-444Zm0 0h444L480-830 258-720Z"/></svg>
              </div>
              <div>
                <h1 id="accountName" class="text-3xl font-bold text-slate-900 tracking-tight">Loading...</h1>
                <div class="flex items-center gap-2 mt-1">
                  <span id="accountIndustry" class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800"></span>
                </div>
              </div>
            </div>
          </div>
          <a href="/create-quote" class="px-6 py-3 bg-gradient-to-r from-blue-600 to-blue-700 text-white rounded-xl hover:from-blue-700 hover:to-blue-800 font-semibold shadow-lg shadow-blue-500/30 hover:shadow-xl hover:shadow-blue-500/40 transition-all duration-200 flex items-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
            </svg>
            Create Quote
          </a>
        </div>
      </div>

      <!-- Account Information Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-0 divide-y md:divide-y-0 md:divide-x divide-slate-100">
        <!-- Contact Information -->
        <div class="px-8 py-7 bg-gradient-to-br from-slate-50/50 to-white">
          <div class="flex items-center gap-3 mb-6">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-blue-500 to-blue-600 flex items-center justify-center shadow-md">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
              </svg>
            </div>
            <h2 class="text-base font-bold text-slate-900 tracking-tight">Contact Information</h2>
          </div>
          <div class="space-y-5">
            <div class="group">
              <label class="text-xs font-semibold text-slate-500 uppercase tracking-wider block mb-2">Phone</label>
              <div class="flex items-center gap-3 p-3 bg-white rounded-lg border border-slate-200 hover:border-blue-300 transition-colors">
                <svg class="w-4 h-4 text-slate-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                </svg>
                <p id="accountPhone" class="text-sm font-semibold text-slate-900">-</p>
              </div>
            </div>
            <div class="group">
              <label class="text-xs font-semibold text-slate-500 uppercase tracking-wider block mb-2">Company Name</label>
              <div class="flex items-center gap-3 p-3 bg-white rounded-lg border border-slate-200 hover:border-blue-300 transition-colors">
                <svg class="w-4 h-4 text-slate-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
                </svg>
                <p id="accountCompany" class="text-sm font-medium text-gray-900">-</p>
              </div>
            </div>
            <div class="group">
              <label class="text-xs font-semibold text-slate-500 uppercase tracking-wider block mb-2">Website</label>
              <div class="flex items-center gap-3 p-3 bg-white rounded-lg border border-slate-200 hover:border-blue-300 transition-colors">
                <svg class="w-4 h-4 text-slate-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"></path>
                </svg>
                <p id="accountWebsite" class="text-sm font-medium text-slate-900">-</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Billing Address -->
        <div class="px-8 py-7 bg-gradient-to-br from-slate-50/50 to-white">
          <div class="flex items-center gap-3 mb-6">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-green-500 to-green-600 flex items-center justify-center shadow-md">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
            </div>
            <h2 class="text-base font-bold text-slate-900 tracking-tight">Billing Address</h2>
          </div>
          <div class="space-y-5">
            <div class="group">
              <label class="text-xs font-semibold text-slate-500 uppercase tracking-wider block mb-2">Street</label>
              <div class="p-3 bg-white rounded-lg border border-slate-200 hover:border-green-300 transition-colors">
                <p id="billingStreet" class="text-sm font-medium text-slate-900 leading-relaxed">-</p>
              </div>
            </div>
            <div class="grid grid-cols-2 gap-4">
              <div class="group">
                <label class="text-xs font-semibold text-slate-500 uppercase tracking-wider block mb-2">City</label>
                <div class="p-3 bg-white rounded-lg border border-slate-200 hover:border-green-300 transition-colors">
                  <p id="billingCity" class="text-sm font-medium text-slate-900">-</p>
                </div>
              </div>
              <div class="group">
                <label class="text-xs font-semibold text-slate-500 uppercase tracking-wider block mb-2">State</label>
                <div class="p-3 bg-white rounded-lg border border-slate-200 hover:border-green-300 transition-colors">
                  <p id="billingState" class="text-sm font-medium text-slate-900">-</p>
                </div>
              </div>
            </div>
            <div class="grid grid-cols-2 gap-4">
              <div class="group">
                <label class="text-xs font-semibold text-slate-500 uppercase tracking-wider block mb-2">Postal Code</label>
                <div class="p-3 bg-white rounded-lg border border-slate-200 hover:border-green-300 transition-colors">
                  <p id="billingCode" class="text-sm font-medium text-slate-900">-</p>
                </div>
              </div>
              <div class="group">
                <label class="text-xs font-semibold text-slate-500 uppercase tracking-wider block mb-2">Country</label>
                <div class="p-3 bg-white rounded-lg border border-slate-200 hover:border-green-300 transition-colors">
                  <p id="billingCountry" class="text-sm font-medium text-slate-900">-</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Cases Section -->
    <div id="casesSection" class="mb-6">
      <p class="text-gray-600">Loading cases...</p>
    </div>

    <!-- Error Message -->
    <div id="errorMessage" class="hidden mt-4 p-4 bg-red-50 border border-red-200 rounded-lg">
      <p class="text-red-800"></p>
    </div>
  </div>

  <script define:vars={{ API_BASE_URL }}>
    /**
     * Get the logged-in user's email from localStorage
     */
    function getUserEmail() {
      return localStorage.getItem('user_email');
    }

    /**
     * Get the logged-in user's role from localStorage
     */
    function getUserRole() {
      const userInfoStr = localStorage.getItem('user_info');
      if (!userInfoStr) return null;
      try {
        const userInfo = JSON.parse(userInfoStr);
        return userInfo.role || null;
      } catch {
        return null;
      }
    }

    const urlParams = new URLSearchParams(window.location.search);
    const accountId = urlParams.get('id');

    if (!accountId) {
      showError('No account ID provided');
    } else {
      loadAccountDetails(accountId);
    }

    async function loadAccountDetails(accountId) {
      try {
        const token = localStorage.getItem('jwt_token');
        if (!token) {
          console.error('[ACCOUNT DETAIL] No token found');
          window.location.href = '/login';
          return;
        }

        const fields = 'Account Name,Phone Number,Industry,Billing Street,Billing City,Billing State,Billing Code,Billing Country,Company Name,Website';
        const url = `${API_BASE_URL}/proxy/accounts_duplicate/records/${accountId}?fields=${encodeURIComponent(fields)}`;
        
        console.log('[ACCOUNT DETAIL] ========================================');
        console.log('[ACCOUNT DETAIL] Fetching account ID:', accountId);
        console.log('[ACCOUNT DETAIL] URL:', url);
        
        const response = await fetch(url, {
          method: 'GET',
          headers: {
            'Authorization': `Bearer ${token}`,
            'Content-Type': 'application/json',
          },
        });

        console.log('[ACCOUNT DETAIL] Response status:', response.status);

        if (response.status === 401) {
          window.location.href = '/login';
          return;
        }

        if (!response.ok) {
          const errorText = await response.text();
          console.error('[ACCOUNT DETAIL] Error:', errorText);
          throw new Error(`Failed to fetch account: ${response.status}`);
        }

        const data = await response.json();
        console.log('[ACCOUNT DETAIL] Account data:', data);
        console.log('[ACCOUNT DETAIL] ========================================');

        const fields_data = data.fields || {};
        
        // Display account information
        const accountName = data.fields?.['Account Name'] || 'Unknown Account';
        const accountIndustry = data.fields?.['Industry'] || '';
        const accountPhone = data.fields?.['Phone Number'] || '-';
        const accountCompany = data.fields?.['Company Name'] || '-';
        const accountWebsite = data.fields?.['Website'] || '-';
        
        // Billing Address
        const billingStreet = data.fields?.['Billing Street'] || '-';
        const billingCity = data.fields?.['Billing City'] || '-';
        const billingState = data.fields?.['Billing State'] || '-';
        const billingCode = data.fields?.['Billing Code'] || '-';
        const billingCountry = data.fields?.['Billing Country'] || '-';
        
        // Update DOM
        document.getElementById('accountName').textContent = accountName;
        document.getElementById('accountIndustry').textContent = accountIndustry;
        document.getElementById('accountPhone').textContent = accountPhone;
        document.getElementById('accountCompany').textContent = accountCompany;
        document.getElementById('accountWebsite').textContent = accountWebsite;
        
        
        document.getElementById('billingStreet').textContent = billingStreet;
        document.getElementById('billingCity').textContent = billingCity;
        document.getElementById('billingState').textContent = billingState;
        document.getElementById('billingCode').textContent = billingCode;
        document.getElementById('billingCountry').textContent = billingCountry;

        // Load cases (which includes quotes in accordion)
        await loadAccountCases(accountId, token);

      } catch (error) {
        console.error('[ACCOUNT DETAIL] Error:', error);
        showError(error.message);
      }
    }

    // Cache for quote versions per case
    const caseQuotesCache = new Map();

    async function loadAccountCases(accountId, token) {
      try {
        const userEmail = getUserEmail();
        const userRole = getUserRole();
        
        // Build URL with filtering for non-admin users
        let url = `${API_BASE_URL}/proxy/cases/records?fields=Id,Title,Status,Created,Accounts duplicate`;

        // TODO: add row-level filter once 'Case Created By' column exists in NocoDB Cases table
        if (userRole === 'admin') {
          console.log('[ACCOUNT DETAIL] Admin user detected - loading all cases');
        } else {
          console.log('[ACCOUNT DETAIL] Loading cases for user:', userEmail);
        }
        
        console.log('[ACCOUNT DETAIL] Fetching cases from:', url);
        
        const response = await fetch(url, {
          method: 'GET',
          headers: {
            'Authorization': `Bearer ${token}`,
            'Content-Type': 'application/json',
          },
        });

        if (response.ok) {
          const casesData = await response.json();
          const allCases = casesData.records || [];
          console.log('[ACCOUNT DETAIL] Total cases fetched:', allCases.length);
          
          // Filter cases that have this account linked
          const accountCases = allCases.filter(caseRecord => {
            const accountsField = caseRecord.fields?.['Accounts duplicate'];
            if (!accountsField) return false;
            
            // Check if it's an object with id or an array
            if (accountsField.id == accountId) return true;
            if (Array.isArray(accountsField) && accountsField.some(acc => acc.id == accountId)) return true;
            
            return false;
          });
          
          console.log('[ACCOUNT DETAIL] Cases for this account:', accountCases.length);
          
          if (accountCases.length > 0) {
            displayCases(accountCases);
          } else {
            document.getElementById('casesSection').innerHTML = '<p class="text-gray-600">No cases found for this account.</p>';
          }
        } else {
          console.error('[ACCOUNT DETAIL] Failed to fetch cases');
          document.getElementById('casesSection').innerHTML = '<p class="text-gray-600">Unable to load cases.</p>';
        }
      } catch (error) {
        console.error('[ACCOUNT DETAIL] Error loading cases:', error);
        document.getElementById('casesSection').innerHTML = '<p class="text-gray-600">Error loading cases.</p>';
      }
    }

    function displayCases(cases) {
      console.log('[ACCOUNT DETAIL] displayCases called with', cases.length, 'cases');
      const casesSection = document.getElementById('casesSection');
      
      if (!casesSection) {
        console.error('[ACCOUNT DETAIL] casesSection element not found!');
        return;
      }
      
      const caseCount = cases.length;
      console.log('[ACCOUNT DETAIL] Rendering accordion for', caseCount, 'cases');
      
      casesSection.innerHTML = `
        <div class="cases-card">
          <div class="cases-header">
            <span class="cases-title">Cases</span>
            <span class="case-count">${caseCount} case${caseCount !== 1 ? 's' : ''}</span>
          </div>
          ${cases.map(caseRecord => {
            const fields = caseRecord.fields || {};
            const caseId = caseRecord.id;
            const title = fields['Title'] || 'Untitled Case';
            const status = fields['Status'] || 'Open';
            const created = fields['Created'] || '';
            
            // Format date
            let formattedDate = '';
            if (created) {
              const date = new Date(created);
              formattedDate = date.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
            }
            
            // Status class
            const statusClass = status.toLowerCase() === 'won' ? 'status-won' : 
                               status.toLowerCase() === 'closed' ? 'status-closed' : 'status-open';
            
            return `
              <div class="case-item" data-case-id="${caseId}">
                <div class="case-row" onclick="toggleCase(this)">
                  <div class="chevron">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                    </svg>
                  </div>
                  <span class="case-id">#${caseId}</span>
                  <span class="case-title">${title}</span>
                  <span class="quote-count-badge" id="quote-count-${caseId}">...</span>
                  <span class="status-pill ${statusClass}">${status}</span>
                  <span class="case-date">${formattedDate}</span>
                </div>
                <div class="timeline-panel">
                  <div class="timeline-inner">
                    <div class="timeline-label">Quote Versions</div>
                    <div class="timeline" id="timeline-${caseId}">
                      <p class="text-gray-500 text-sm">Loading...</p>
                    </div>
                  </div>
                </div>
              </div>
            `;
          }).join('')}
        </div>
      `;
      
      // Preload quote counts for all cases
      cases.forEach(caseRecord => {
        loadQuoteCount(caseRecord.id);
      });
    }

    async function loadQuoteCount(caseId) {
      try {
        const token = localStorage.getItem('jwt_token');
        const url = `${API_BASE_URL}/proxy/cases/links/quotes/${caseId}?fields=Id`;
        
        const response = await fetch(url, {
          method: 'GET',
          headers: {
            'Authorization': `Bearer ${token}`,
            'Content-Type': 'application/json',
          },
        });
        
        if (response.ok) {
          const data = await response.json();
          const count = data.records?.length || 0;
          const badge = document.getElementById(`quote-count-${caseId}`);
          if (badge) {
            badge.textContent = `${count} version${count !== 1 ? 's' : ''}`;
          }
        }
      } catch (error) {
        console.error(`[ACCOUNT DETAIL] Error loading quote count for case ${caseId}:`, error);
      }
    }

    async function toggleCase(rowEl) {
      console.log('[ACCOUNT DETAIL] toggleCase called');
      if (event.target.closest('a')) return;
      
      const caseItem = rowEl.closest('.case-item');
      const caseId = caseItem.dataset.caseId;
      const isOpen = caseItem.classList.contains('open');
      
      console.log('[ACCOUNT DETAIL] Case ID:', caseId, 'isOpen:', isOpen);
      
      // Close all others
      document.querySelectorAll('.case-item.open').forEach(el => {
        if (el !== caseItem) el.classList.remove('open');
      });
      
      if (!isOpen) {
        caseItem.classList.add('open');
        
        // Lazy load quote versions if not cached
        if (!caseQuotesCache.has(caseId)) {
          await loadCaseQuotes(caseId);
        }
      } else {
        caseItem.classList.remove('open');
      }
    }
    
    // Make toggleCase globally accessible
    window.toggleCase = toggleCase;

    async function loadCaseQuotes(caseId) {
      try {
        const token = localStorage.getItem('jwt_token');
        const userEmail = getUserEmail();
        const userRole = getUserRole();
        
        const url = `${API_BASE_URL}/proxy/cases/links/quotes/${caseId}?fields=Id,Subject,Quote Version,Quote Status,Quote Date,Total Amount,Quote Created By`;
        
        console.log(`[ACCOUNT DETAIL] Loading quotes for case ${caseId}`);
        
        const response = await fetch(url, {
          method: 'GET',
          headers: {
            'Authorization': `Bearer ${token}`,
            'Content-Type': 'application/json',
          },
        });
        
        if (response.ok) {
          const data = await response.json();
          let quotes = data.records || [];
          
          // Filter quotes for non-admin users
          if (userRole !== 'admin') {
            quotes = quotes.filter(quote => {
              const createdBy = quote.fields?.['Quote Created By'];
              return createdBy === userEmail;
            });
            console.log(`[ACCOUNT DETAIL] Filtered to ${quotes.length} quotes for user ${userEmail}`);
          }
          
          // Cache the quotes
          caseQuotesCache.set(caseId, quotes);
          
          // Sort by version (newest first)
          quotes.sort((a, b) => {
            const versionA = a.fields?.['Quote Version'] || '0';
            const versionB = b.fields?.['Quote Version'] || '0';
            return versionB.localeCompare(versionA, undefined, { numeric: true });
          });
          
          displayCaseQuotes(caseId, quotes);
        } else {
          const timeline = document.getElementById(`timeline-${caseId}`);
          if (timeline) {
            timeline.innerHTML = '<p class="text-gray-500 text-sm">Failed to load quotes</p>';
          }
        }
      } catch (error) {
        console.error(`[ACCOUNT DETAIL] Error loading quotes for case ${caseId}:`, error);
        const timeline = document.getElementById(`timeline-${caseId}`);
        if (timeline) {
          timeline.innerHTML = '<p class="text-gray-500 text-sm">Error loading quotes</p>';
        }
      }
    }

    function displayCaseQuotes(caseId, quotes) {
      const timeline = document.getElementById(`timeline-${caseId}`);
      if (!timeline) return;
      
      if (quotes.length === 0) {
        timeline.innerHTML = '<p class="text-gray-500 text-sm">No quotes found for this case</p>';
        return;
      }
      
      timeline.innerHTML = quotes.map((quote, index) => {
        const fields = quote.fields || {};
        const quoteId = quote.id;
        const subject = fields['Subject'] || 'Untitled Quote';
        const version = fields['Quote Version'] || '1';
        const status = fields['Quote Status'] || 'Draft';
        const date = fields['Quote Date'] || '';
        const amount = fields['Total Amount'] || 0;
        
        const isLatest = index === 0;
        
        // Determine dot class
        let dotClass = '';
        if (status === 'Draft' && isLatest) {
          dotClass = 'latest';
        } else if (status === 'Sent') {
          dotClass = 'sent';
        } else if (status === 'Approved' || status === 'Final') {
          dotClass = 'approved';
        }
        
        // Determine status tag class
        let statusTagClass = 'qs-draft';
        if (status === 'Sent') statusTagClass = 'qs-sent';
        else if (status === 'Approved') statusTagClass = 'qs-approved';
        else if (status === 'Final') statusTagClass = 'qs-final';
        
        // Format amount
        const formattedAmount = new Intl.NumberFormat('en-IN').format(amount);
        
        // Format date
        let formattedDate = date;
        if (date) {
          const dateObj = new Date(date);
          formattedDate = dateObj.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
        }
        
        return `
          <div class="timeline-entry">
            <div class="timeline-dot ${dotClass}"></div>
            <div class="quote-card">
              <div class="quote-card-top">
                <span class="quote-version ${isLatest ? 'latest-v' : ''}">
                  v${version}${isLatest ? ' · Latest' : ''}
                </span>
                <span class="quote-status-tag ${statusTagClass}">${status}</span>
              </div>
              <div class="quote-subject">${subject}</div>
              <div class="quote-card-bottom">
                <div class="quote-meta">
                  <span>Amount</span>
                  <span class="quote-amount">₹${formattedAmount}</span>
                  <span class="quote-date-small">${formattedDate}</span>
                </div>
                <a href="/quote-detail?id=${quoteId}" class="view-link">View →</a>
              </div>
            </div>
          </div>
        `;
      }).join('');
    }

    function showError(message) {
      const errorDiv = document.getElementById('errorMessage');
      errorDiv.querySelector('p').textContent = message;
      errorDiv.classList.remove('hidden');
    }
  </script>
</AdminLayout>
