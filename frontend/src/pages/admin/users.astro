---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="User Management" currentPage="users">
  <div class="max-w-7xl mx-auto">
    <!-- Header -->
    <div class="mb-6 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 bg-slate-800 rounded-lg flex items-center justify-center">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
          </svg>
        </div>
        <div>
          <h1 class="text-2xl font-bold text-slate-800">User Management</h1>
          <p class="text-sm text-slate-600">Manage system users and permissions</p>
        </div>
      </div>
      <button
        id="createUserBtn"
        class="px-5 py-2.5 bg-indigo-600 text-white font-medium rounded-lg hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 transition-all text-sm flex items-center gap-2"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
        </svg>
        Create User
      </button>
    </div>

    <!-- Alert -->
    <div id="alert" class="hidden mb-6"></div>

    <!-- Users List View -->
    <div id="usersListView" class="bg-white rounded-lg border border-slate-200 shadow-sm">
      <div class="p-6 border-b border-slate-200">
        <div class="flex items-center justify-between">
          <div>
            <h2 class="text-lg font-semibold text-slate-800">All Users</h2>
            <p class="text-sm text-slate-600 mt-1">Total: <span id="totalUsers">0</span> users</p>
          </div>
        </div>
      </div>
      
      <!-- Loading State -->
      <div id="loadingState" class="p-8 text-center">
        <div class="inline-block animate-spin rounded-full h-8 w-8 border-b-2 border-indigo-600"></div>
        <p class="mt-2 text-sm text-slate-600">Loading users...</p>
      </div>

      <!-- Users Table -->
      <div id="usersTable" class="hidden overflow-x-auto">
        <table class="w-full">
          <thead class="bg-slate-50 border-b border-slate-200">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">User</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Email</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Role</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Status</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Created</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Actions</th>
            </tr>
          </thead>
          <tbody id="usersTableBody" class="bg-white divide-y divide-slate-200">
          </tbody>
        </table>
      </div>

      <!-- Empty State -->
      <div id="emptyState" class="hidden p-12 text-center">
        <svg class="mx-auto h-12 w-12 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
        </svg>
        <h3 class="mt-2 text-sm font-medium text-slate-900">No users found</h3>
        <p class="mt-1 text-sm text-slate-500">Get started by creating a new user.</p>
      </div>
    </div>

    <!-- Confirm Modal -->
    <div id="confirmModal" class="fixed inset-0 z-50 hidden items-center justify-center p-4">
      <div class="absolute inset-0 bg-slate-900/50 backdrop-blur-sm" id="confirmModalBackdrop"></div>
      <div class="relative bg-white rounded-2xl shadow-2xl w-full max-w-md overflow-hidden">
        <div class="px-6 py-5 flex items-start gap-4">
          <div id="confirmModalIcon" class="w-11 h-11 rounded-xl flex items-center justify-center shrink-0 mt-0.5"></div>
          <div>
            <h3 id="confirmModalTitle" class="text-base font-bold text-slate-900 mb-1"></h3>
            <p id="confirmModalBody" class="text-sm text-slate-600 leading-relaxed"></p>
          </div>
        </div>
        <div class="px-6 pb-6 flex gap-3 justify-end">
          <button id="confirmModalCancel" class="px-5 py-2.5 text-sm font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-xl transition-colors">Cancel</button>
          <button id="confirmModalConfirm" class="px-5 py-2.5 text-sm font-semibold text-white rounded-xl transition-colors"></button>
        </div>
      </div>
    </div>

    <!-- Reset Password Modal -->
    <div id="resetPasswordModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
      <div class="bg-white rounded-lg shadow-xl max-w-md w-full mx-4">
        <div class="p-6 border-b border-slate-200">
          <h3 class="text-lg font-semibold text-slate-800">Reset User Password</h3>
        </div>
        <div class="p-6">
          <p class="text-sm text-slate-600 mb-4">Generate a new secure password for <strong id="resetUserEmail"></strong>?</p>
          <div id="resetPasswordSuccess" class="hidden bg-green-50 border border-green-200 rounded-lg p-4 mb-4">
            <p class="text-sm font-medium text-green-800 mb-2">Password Reset Successfully!</p>
            <div class="flex items-center gap-2">
              <code id="resetTempPassword" class="flex-1 px-3 py-2 bg-white border border-green-300 rounded text-sm font-mono text-slate-800"></code>
              <button id="copyResetPasswordBtn" class="px-3 py-2 bg-green-600 text-white text-sm rounded hover:bg-green-700">
                Copy
              </button>
            </div>
          </div>
        </div>
        <div class="p-6 border-t border-slate-200 flex gap-3 justify-end">
          <button id="cancelResetBtn" class="px-4 py-2 border border-slate-300 text-slate-700 rounded-lg hover:bg-slate-50">Cancel</button>
          <button id="confirmResetBtn" class="px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700">Reset Password</button>
        </div>
      </div>
    </div>

    <!-- Create User Form (Hidden by default) -->
    <div id="createUserView" class="hidden bg-white rounded-lg border border-slate-200 shadow-sm">
      <div class="p-6 border-b border-slate-200 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 bg-slate-800 rounded-lg flex items-center justify-center">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
            </svg>
          </div>
          <div>
            <h2 class="text-lg font-semibold text-slate-800">Create New User</h2>
            <p class="text-sm text-slate-600">Add a new user to the system</p>
          </div>
        </div>
        <button
          id="backToListBtn"
          class="px-4 py-2 text-sm text-slate-600 hover:text-slate-800 border border-slate-300 rounded-lg hover:bg-slate-50 transition-all flex items-center gap-2"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          Back to List
        </button>
      </div>
      <!-- Form -->
      <form id="createUserForm">
        <!-- User Information Section -->
        <div class="p-6 border-b border-slate-200">
          <div class="flex items-center gap-2 mb-5">
            <svg class="w-5 h-5 text-slate-700" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"></path>
            </svg>
            <h2 class="text-lg font-semibold text-slate-800">User Information</h2>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Full Name -->
            <div>
              <label for="name" class="flex items-center gap-2 text-sm font-medium text-slate-700 mb-2">
                <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                </svg>
                Full Name
              </label>
              <input
                type="text"
                id="name"
                name="name"
                class="w-full px-4 py-2.5 border border-slate-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all text-sm"
                placeholder="Enter full name"
              />
            </div>

            <!-- Email Address -->
            <div>
              <label for="email" class="flex items-center gap-2 text-sm font-medium text-slate-700 mb-2">
                <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                </svg>
                Email Address
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full px-4 py-2.5 border border-slate-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all text-sm"
                placeholder="Enter email address"
              />
            </div>

            <!-- Password (Auto-generated info) -->
            <div>
              <label class="flex items-center gap-2 text-sm font-medium text-slate-700 mb-2">
                <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                </svg>
                Password
              </label>
              <div class="w-full px-4 py-2.5 border border-slate-300 rounded-md bg-slate-50 text-sm text-slate-500 flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                Auto-generated (min. 8 characters)
              </div>
            </div>

            <!-- Role -->
            <div>
              <label for="role" class="flex items-center gap-2 text-sm font-medium text-slate-700 mb-2">
                <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                </svg>
                Department
              </label>
              <select
                id="role"
                name="role"
                required
                class="w-full px-4 py-2.5 border border-slate-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all bg-white text-sm appearance-none cursor-pointer"
                style="background-image: url('data:image/svg+xml;charset=UTF-8,%3csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 24 24%27 fill=%27none%27 stroke=%27currentColor%27 stroke-width=%272%27 stroke-linecap=%27round%27 stroke-linejoin=%27round%27%3e%3cpolyline points=%276 9 12 15 18 9%27%3e%3c/polyline%3e%3c/svg%3e'); background-repeat: no-repeat; background-position: right 0.75rem center; background-size: 1.25em 1.25em; padding-right: 2.5rem;"
              >
                <option value="">Select Department</option>
                <option value="user">User</option>
                <option value="admin">Admin</option>
                <option value="super_admin">Super Admin</option>
              </select>
            </div>
          </div>
        </div>

        <!-- User Permissions Section (Optional - for future use) -->
        <div class="p-6 bg-slate-50 border-b border-slate-200 hidden" id="permissionsSection">
          <div class="flex items-center gap-2 mb-4">
            <svg class="w-5 h-5 text-slate-700" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"></path>
            </svg>
            <h2 class="text-lg font-semibold text-slate-800">User Permissions</h2>
          </div>
          <p class="text-sm text-slate-600 mb-4">Permissions are automatically assigned based on role</p>
        </div>

        <!-- Action Buttons -->
        <div class="p-6 flex items-center justify-end gap-3">
          <button
            type="button"
            id="resetBtn"
            class="px-5 py-2.5 bg-white border border-slate-300 text-slate-700 font-medium rounded-md hover:bg-slate-50 transition-all text-sm flex items-center gap-2"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
            Cancel
          </button>
          <button
            type="submit"
            id="submitBtn"
            class="px-6 py-2.5 bg-indigo-600 text-white font-medium rounded-md hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 transition-all disabled:opacity-50 disabled:cursor-not-allowed text-sm flex items-center gap-2"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
            </svg>
            Create User
          </button>
        </div>
      </form>
    </div>

    <!-- Success Card (Hidden by default) -->
    <div id="successCard" class="hidden bg-gradient-to-br from-green-50 to-emerald-50 rounded-xl border-2 border-green-200 p-6 mb-8">
      <div class="flex items-start gap-4 mb-4">
        <div class="w-12 h-12 bg-green-600 rounded-lg flex items-center justify-center flex-shrink-0">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
        <div class="flex-1">
          <h3 class="text-lg font-semibold text-slate-800 mb-1">User Created Successfully!</h3>
          <p class="text-sm text-slate-600 mb-4">An invitation email with login credentials has been sent to the user.</p>

          <div class="bg-white rounded-lg border border-green-200 p-4 space-y-3">
            <div>
              <p class="text-xs font-medium text-slate-500 uppercase tracking-wider mb-1">Email</p>
              <p class="text-sm font-medium text-slate-800" id="createdEmail">-</p>
            </div>
            <div>
              <p class="text-xs font-medium text-slate-500 uppercase tracking-wider mb-1">Role</p>
              <span id="createdRole" class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">User</span>
            </div>
            <div id="emailSentStatus" class="flex items-center gap-2 text-sm text-green-700">
              <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
              Invitation email sent
            </div>
            <div id="emailFailedStatus" class="hidden">
              <div class="flex items-center gap-2 text-sm text-amber-700 mb-2">
                <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                </svg>
                Email delivery failed — share the password manually
              </div>
              <div class="flex items-center gap-2">
                <code class="flex-1 px-3 py-2 bg-slate-50 border border-slate-200 rounded text-sm font-mono text-slate-800" id="tempPassword">-</code>
                <button id="copyBtn" class="px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-all" title="Copy to clipboard">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                  </svg>
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>

      <button
        id="closeSuccessBtn"
        class="w-full mt-4 px-4 py-2 bg-white border border-green-300 text-green-700 font-medium rounded-lg hover:bg-green-50 transition-all"
      >
        Create Another User
      </button>
    </div>

    <!-- Info Card -->
    <div class="bg-blue-50 rounded-xl border border-blue-200 p-6">
      <div class="flex items-start gap-4">
        <div class="w-10 h-10 bg-blue-600 rounded-lg flex items-center justify-center flex-shrink-0">
          <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
        <div>
          <h3 class="font-semibold text-slate-800 mb-2">How User Creation Works</h3>
          <ul class="text-sm text-slate-600 space-y-1">
            <li>• A secure random password (16+ characters) is automatically generated</li>
            <li>• An invitation email with login credentials is sent directly to the user</li>
            <li>• On first login, they must change their password</li>
            <li>• Until they change it, they cannot access the system</li>
          </ul>
        </div>
      </div>
    </div>
  </div>

  <script>
    import { createUser, listUsers, resetUserPassword, getToken, type CreateUserRequest, type UserListItem } from '../../lib/api';
    import { requireAdmin, isSuperAdmin } from '../../utils/jwt';

    const API_BASE_URL = import.meta.env.PUBLIC_API_BASE_URL ||
      `${window.location.protocol}//${window.location.hostname}:8082`;

    function showConfirmModal(opts: { title: string; body: string; confirmLabel: string; confirmClass: string; iconBg: string; iconSvg: string }): Promise<boolean> {
      return new Promise((resolve) => {
        const modal = document.getElementById('confirmModal')!;
        const icon = document.getElementById('confirmModalIcon')!;
        const title = document.getElementById('confirmModalTitle')!;
        const body = document.getElementById('confirmModalBody')!;
        const confirmBtn = document.getElementById('confirmModalConfirm')!;
        const cancelBtn = document.getElementById('confirmModalCancel')!;
        const backdrop = document.getElementById('confirmModalBackdrop')!;

        icon.className = `w-11 h-11 rounded-xl flex items-center justify-center shrink-0 mt-0.5 ${opts.iconBg}`;
        icon.innerHTML = opts.iconSvg;
        title.textContent = opts.title;
        body.textContent = opts.body;
        confirmBtn.className = `px-5 py-2.5 text-sm font-semibold text-white rounded-xl transition-colors ${opts.confirmClass}`;
        confirmBtn.textContent = opts.confirmLabel;

        modal.classList.remove('hidden');
        modal.classList.add('flex');

        const close = (result: boolean) => {
          modal.classList.add('hidden');
          modal.classList.remove('flex');
          confirmBtn.removeEventListener('click', onConfirm);
          cancelBtn.removeEventListener('click', onCancel);
          backdrop.removeEventListener('click', onCancel);
          resolve(result);
        };
        const onConfirm = () => close(true);
        const onCancel = () => close(false);
        confirmBtn.addEventListener('click', onConfirm);
        cancelBtn.addEventListener('click', onCancel);
        backdrop.addEventListener('click', onCancel);
      });
    }

    // Require admin access for user management
    requireAdmin();

    const currentUserIsSuperAdmin = isSuperAdmin();

    // Reset password modal elements
    const resetPasswordModal = document.getElementById('resetPasswordModal') as HTMLDivElement;
    const resetUserEmail = document.getElementById('resetUserEmail') as HTMLElement;
    const resetPasswordSuccess = document.getElementById('resetPasswordSuccess') as HTMLDivElement;
    const resetTempPassword = document.getElementById('resetTempPassword') as HTMLElement;
    const copyResetPasswordBtn = document.getElementById('copyResetPasswordBtn') as HTMLButtonElement;
    const cancelResetBtn = document.getElementById('cancelResetBtn') as HTMLButtonElement;
    const confirmResetBtn = document.getElementById('confirmResetBtn') as HTMLButtonElement;
    let currentResetUserId: number | null = null;

    // View management
    const usersListView = document.getElementById('usersListView') as HTMLDivElement;
    const createUserView = document.getElementById('createUserView') as HTMLDivElement;
    const createUserBtn = document.getElementById('createUserBtn') as HTMLButtonElement;
    const backToListBtn = document.getElementById('backToListBtn') as HTMLButtonElement;
    
    // Users list elements
    const loadingState = document.getElementById('loadingState') as HTMLDivElement;
    const usersTable = document.getElementById('usersTable') as HTMLDivElement;
    const usersTableBody = document.getElementById('usersTableBody') as HTMLTableSectionElement;
    const emptyState = document.getElementById('emptyState') as HTMLDivElement;
    const totalUsersSpan = document.getElementById('totalUsers') as HTMLSpanElement;

    function showListView() {
      usersListView.classList.remove('hidden');
      createUserView.classList.add('hidden');
      loadUsers();
    }

    function showCreateView() {
      usersListView.classList.add('hidden');
      createUserView.classList.remove('hidden');
      hideSuccess();
      hideAlert();
    }

    // Load users from backend
    async function loadUsers() {
      try {
        loadingState.classList.remove('hidden');
        usersTable.classList.add('hidden');
        emptyState.classList.add('hidden');

        const response = await listUsers();
        const users = response.users;

        totalUsersSpan.textContent = response.total.toString();

        if (users.length === 0) {
          loadingState.classList.add('hidden');
          emptyState.classList.remove('hidden');
          return;
        }

        // Populate table
        usersTableBody.innerHTML = '';
        users.forEach(user => {
          const row = document.createElement('tr');
          row.className = 'hover:bg-slate-50';
          
          const roleClass = user.role === 'super_admin'
            ? 'bg-orange-100 text-orange-800'
            : user.role === 'admin'
            ? 'bg-purple-100 text-purple-800'
            : 'bg-blue-100 text-blue-800';

          const roleLabel = user.role === 'super_admin' ? 'Super Admin' : user.role === 'admin' ? 'Admin' : 'User';

          const statusClass = user.must_change_password
            ? 'bg-yellow-100 text-yellow-800'
            : 'bg-green-100 text-green-800';

          const statusText = user.must_change_password
            ? 'Password Reset Required'
            : 'Active';

          // Role options for the change-role dropdown (super_admin can assign any role; admin can only assign user/admin)
          const roleOptions = currentUserIsSuperAdmin
            ? ['user', 'admin', 'super_admin'].filter(r => r !== user.role)
            : ['user', 'admin'].filter(r => r !== user.role);

          const roleOptionHtml = roleOptions.map(r => {
            const label = r === 'super_admin' ? 'Super Admin' : r === 'admin' ? 'Admin' : 'User';
            return `<button class="change-role-btn block w-full text-left px-3 py-1.5 text-xs hover:bg-slate-100 rounded" data-user-id="${user.id}" data-new-role="${r}">${label}</button>`;
          }).join('');

          row.innerHTML = `
            <td class="px-6 py-4 whitespace-nowrap">
              <div class="flex items-center">
                <div class="flex-shrink-0 h-10 w-10 bg-slate-200 rounded-full flex items-center justify-center">
                  <span class="text-sm font-medium text-slate-600">${user.name ? user.name.charAt(0).toUpperCase() : user.email.charAt(0).toUpperCase()}</span>
                </div>
                <div class="ml-4">
                  <div class="text-sm font-medium text-slate-900">${user.name || 'N/A'}</div>
                </div>
              </div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <div class="text-sm text-slate-900">${user.email}</div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <div class="flex items-center gap-2">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ${roleClass}">${roleLabel}</span>
                ${roleOptions.length > 0 ? `
                <div class="relative inline-block">
                  <button class="role-dropdown-btn text-xs text-slate-400 hover:text-slate-700 px-1" data-user-id="${user.id}" title="Change role">▾</button>
                  <div class="role-dropdown hidden absolute z-10 left-0 mt-1 w-32 bg-white border border-slate-200 rounded-lg shadow-lg p-1" data-dropdown-id="${user.id}">
                    ${roleOptionHtml}
                  </div>
                </div>` : ''}
              </div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ${statusClass}">
                ${statusText}
              </span>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-500">
              ${new Date(user.created_at).toLocaleDateString()}
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm">
              <div class="flex items-center gap-3">
                <button class="reset-password-btn text-indigo-600 hover:text-indigo-900 font-medium" data-user-id="${user.id}" data-user-email="${user.email}">Reset Password</button>
                <button class="delete-user-btn text-red-500 hover:text-red-700 font-medium" data-user-id="${user.id}" data-user-email="${user.email}">Delete</button>
              </div>
            </td>
          `;
          
          usersTableBody.appendChild(row);
        });

        // Add event listeners to reset password buttons
        document.querySelectorAll('.reset-password-btn').forEach(btn => {
          btn.addEventListener('click', (e) => {
            const target = e.target as HTMLButtonElement;
            currentResetUserId = parseInt(target.dataset.userId || '0');
            resetUserEmail.textContent = target.dataset.userEmail || '';
            resetPasswordSuccess.classList.add('hidden');
            resetPasswordModal.classList.remove('hidden');
          });
        });

        // Role dropdown toggle
        document.querySelectorAll('.role-dropdown-btn').forEach(btn => {
          btn.addEventListener('click', (e) => {
            e.stopPropagation();
            const userId = (btn as HTMLButtonElement).dataset.userId;
            document.querySelectorAll('.role-dropdown').forEach(d => {
              if ((d as HTMLElement).dataset.dropdownId !== userId) d.classList.add('hidden');
            });
            const dropdown = document.querySelector(`.role-dropdown[data-dropdown-id="${userId}"]`);
            dropdown?.classList.toggle('hidden');
          });
        });

        // Close dropdowns on outside click
        document.addEventListener('click', () => document.querySelectorAll('.role-dropdown').forEach(d => d.classList.add('hidden')));

        // Change role buttons
        document.querySelectorAll('.change-role-btn').forEach(btn => {
          btn.addEventListener('click', async (e) => {
            e.stopPropagation();
            const target = e.target as HTMLButtonElement;
            const userId = parseInt(target.dataset.userId || '0');
            const newRole = target.dataset.newRole || '';
            const roleLabel = newRole === 'super_admin' ? 'Super Admin' : newRole === 'admin' ? 'Admin' : 'User';
            const iconBg = newRole === 'super_admin' ? 'bg-orange-100' : newRole === 'admin' ? 'bg-purple-100' : 'bg-blue-100';
            const iconColor = newRole === 'super_admin' ? 'text-orange-600' : newRole === 'admin' ? 'text-purple-600' : 'text-blue-600';
            const btnClass = newRole === 'super_admin' ? 'bg-orange-600 hover:bg-orange-700' : newRole === 'admin' ? 'bg-purple-600 hover:bg-purple-700' : 'bg-blue-600 hover:bg-blue-700';
            const confirmed = await showConfirmModal({
              title: `Change role to ${roleLabel}?`,
              body: `This user will be updated to ${roleLabel}. They will need to log out and back in for the change to take effect.`,
              confirmLabel: `Set as ${roleLabel}`,
              confirmClass: btnClass,
              iconBg,
              iconSvg: `<svg class="w-6 h-6 ${iconColor}" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>`,
            });
            if (!confirmed) return;
            try {
              const token = getToken();
              const resp = await fetch(`${API_BASE_URL}/api/admin/users/role`, {
                method: 'PATCH',
                headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ user_id: userId, new_role: newRole }),
              });
              if (!resp.ok) { const e = await resp.json(); throw new Error(e.error || 'Failed'); }
              loadUsers();
            } catch (err) {
              showAlert(err instanceof Error ? err.message : 'Failed to update role', 'error');
            }
          });
        });

        // Delete user buttons
        document.querySelectorAll('.delete-user-btn').forEach(btn => {
          btn.addEventListener('click', async (e) => {
            const target = e.target as HTMLButtonElement;
            const userId = parseInt(target.dataset.userId || '0');
            const email = target.dataset.userEmail || '';
            const confirmed = await showConfirmModal({
              title: 'Delete this user?',
              body: `"${email}" will be permanently removed. This cannot be undone.`,
              confirmLabel: 'Delete User',
              confirmClass: 'bg-red-600 hover:bg-red-700',
              iconBg: 'bg-red-100',
              iconSvg: `<svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>`,
            });
            if (!confirmed) return;
            try {
              const token = getToken();
              const resp = await fetch(`${API_BASE_URL}/api/admin/users/delete`, {
                method: 'DELETE',
                headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ user_id: userId }),
              });
              if (!resp.ok) { const e = await resp.json(); throw new Error(e.error || 'Failed'); }
              loadUsers();
            } catch (err) {
              showAlert(err instanceof Error ? err.message : 'Failed to delete user', 'error');
            }
          });
        });

        loadingState.classList.add('hidden');
        usersTable.classList.remove('hidden');
      } catch (error) {
        loadingState.classList.add('hidden');
        showAlert(error instanceof Error ? error.message : 'Failed to load users', 'error');
      }
    }

    // Button event listeners
    createUserBtn?.addEventListener('click', showCreateView);
    backToListBtn?.addEventListener('click', showListView);

    // Load users on page load
    loadUsers();

    // Reset password modal handlers
    cancelResetBtn?.addEventListener('click', () => {
      resetPasswordModal.classList.add('hidden');
      currentResetUserId = null;
    });

    confirmResetBtn?.addEventListener('click', async () => {
      if (!currentResetUserId) return;
      
      try {
        confirmResetBtn.disabled = true;
        confirmResetBtn.textContent = 'Resetting...';

        const result = await resetUserPassword(currentResetUserId);

        confirmResetBtn.textContent = 'Sending Email...';
        const userEmail = resetUserEmail.textContent || '';
        const emailSent = await sendCredentialsEmail('reset', userEmail, '', result.temporary_password);

        resetTempPassword.textContent = result.temporary_password;
        resetPasswordSuccess.classList.remove('hidden');

        const statusMsg = resetPasswordSuccess.querySelector('p.text-sm') as HTMLElement;
        if (statusMsg) {
          statusMsg.textContent = emailSent
            ? 'Password reset and email sent to user.'
            : 'Password reset. Email failed — share the password below manually.';
        }

        confirmResetBtn.classList.add('hidden');
        loadUsers();
      } catch (error) {
        showAlert(error instanceof Error ? error.message : 'Failed to reset password', 'error');
      } finally {
        confirmResetBtn.disabled = false;
        confirmResetBtn.textContent = 'Reset Password';
      }
    });

    copyResetPasswordBtn?.addEventListener('click', async () => {
      const password = resetTempPassword.textContent || '';
      try {
        await navigator.clipboard.writeText(password);
        copyResetPasswordBtn.textContent = 'Copied!';
        setTimeout(() => {
          copyResetPasswordBtn.textContent = 'Copy';
          resetPasswordModal.classList.add('hidden');
          confirmResetBtn.classList.remove('hidden');
        }, 2000);
      } catch (error) {
        console.error('Failed to copy:', error);
      }
    });

    const form = document.getElementById('createUserForm') as HTMLFormElement;
    const alertDiv = document.getElementById('alert') as HTMLDivElement;
    const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement;
    const resetBtn = document.getElementById('resetBtn') as HTMLButtonElement;
    const successCard = document.getElementById('successCard') as HTMLDivElement;
    const closeSuccessBtn = document.getElementById('closeSuccessBtn') as HTMLButtonElement;
    const copyBtn = document.getElementById('copyBtn') as HTMLButtonElement;

    const emailInput = document.getElementById('email') as HTMLInputElement;
    const nameInput = document.getElementById('name') as HTMLInputElement;
    const roleSelect = document.getElementById('role') as HTMLSelectElement;

    function showAlert(message: string, type: 'success' | 'error') {
      alertDiv.textContent = message;
      alertDiv.className = `mb-6 p-4 rounded-lg ${
        type === 'success' 
          ? 'bg-green-50 text-green-800 border border-green-200' 
          : 'bg-red-50 text-red-800 border border-red-200'
      }`;
      alertDiv.classList.remove('hidden');
    }

    function hideAlert() {
      alertDiv.classList.add('hidden');
    }

    function showSuccess(email: string, password: string, role: string, emailSent: boolean) {
      successCard.classList.remove('hidden');
      document.getElementById('createdEmail')!.textContent = email;
      document.getElementById('tempPassword')!.textContent = password;

      const roleSpan = document.getElementById('createdRole')!;
      roleSpan.textContent = role.charAt(0).toUpperCase() + role.slice(1);
      roleSpan.className = role === 'admin'
        ? 'inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-purple-100 text-purple-800'
        : 'inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800';

      document.getElementById('emailSentStatus')!.classList.toggle('hidden', !emailSent);
      document.getElementById('emailFailedStatus')!.classList.toggle('hidden', emailSent);

      successCard.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    async function sendCredentialsEmail(type: 'welcome' | 'reset', toEmail: string, name: string, tempPassword: string) {
      const res = await fetch('/api/email/credentials', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ type, toEmail, name, tempPassword, siteUrl: window.location.origin }),
      });
      return res.ok;
    }

    function hideSuccess() {
      successCard.classList.add('hidden');
    }

    function resetForm() {
      form.reset();
      hideAlert();
    }

    // Copy password to clipboard
    copyBtn?.addEventListener('click', async () => {
      const password = document.getElementById('tempPassword')!.textContent || '';
      try {
        await navigator.clipboard.writeText(password);
        const originalHTML = copyBtn.innerHTML;
        copyBtn.innerHTML = `
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
          </svg>
        `;
        copyBtn.classList.add('bg-green-600', 'hover:bg-green-700');
        copyBtn.classList.remove('bg-blue-600', 'hover:bg-blue-700');
        
        setTimeout(() => {
          copyBtn.innerHTML = originalHTML;
          copyBtn.classList.remove('bg-green-600', 'hover:bg-green-700');
          copyBtn.classList.add('bg-blue-600', 'hover:bg-blue-700');
        }, 2000);
      } catch (error) {
        console.error('Failed to copy:', error);
      }
    });

    // Close success card and return to list
    closeSuccessBtn?.addEventListener('click', () => {
      hideSuccess();
      resetForm();
      showListView();
    });

    // Reset button
    resetBtn?.addEventListener('click', resetForm);

    // Form submission
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      hideAlert();
      hideSuccess();

      const email = emailInput.value.trim();
      const name = nameInput.value.trim();
      const role = roleSelect.value as 'user' | 'admin' | 'super_admin';

      // Validation
      if (!email) {
        showAlert('Email is required', 'error');
        return;
      }

      // Disable form
      submitBtn.disabled = true;
      submitBtn.textContent = 'Creating User...';

      try {
        submitBtn.textContent = 'Creating User...';
        const result = await createUser({ email, name, role });

        submitBtn.textContent = 'Sending Invitation...';
        const emailSent = await sendCredentialsEmail('welcome', result.email, name, result.temporary_password);

        showSuccess(result.email, result.temporary_password, result.role, emailSent);
        form.reset();
        loadUsers();
      } catch (error) {
        showAlert(error instanceof Error ? error.message : 'Failed to create user', 'error');
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Create User';
      }
    });
  </script>
</AdminLayout>
