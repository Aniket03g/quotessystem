---
import AdminLayout from '../layouts/AdminLayout.astro';

---

<AdminLayout title="Add Account" currentPage="accounts">
  <div class="max-w-4xl mx-auto">
    <!-- Page Header -->
    <div class="mb-6">
      <div class="flex items-center gap-4 mb-2">
        <a href="/accounts" class="text-slate-600 hover:text-slate-900">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
        </a>
        <h1 class="text-2xl font-semibold text-slate-800">Add New Account</h1>
      </div>
      <p class="text-slate-600 ml-10">Create a new account in the system</p>
    </div>

    <!-- Error/Success Messages -->
    <div id="errorMessage" class="hidden mb-6 p-4 bg-red-50 border border-red-200 rounded-lg">
      <div class="flex items-start gap-3">
        <svg class="w-5 h-5 text-red-600 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <p class="text-red-800 text-sm" id="errorText"></p>
      </div>
    </div>

    <div id="successMessage" class="hidden mb-6 p-4 bg-green-50 border border-green-200 rounded-lg">
      <div class="flex items-start gap-3">
        <svg class="w-5 h-5 text-green-600 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <p class="text-green-800 text-sm" id="successText"></p>
      </div>
    </div>

    <!-- Account Form -->
    <form id="accountForm" class="bg-white rounded-xl border border-slate-200 shadow-sm">
      <!-- Basic Information -->
      <div class="p-6 border-b border-slate-200">
        <h2 class="text-lg font-semibold text-slate-800 mb-4">Basic Information</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="md:col-span-2">
            <label for="accountName" class="block text-sm font-medium text-slate-700 mb-1">
              Account Name <span class="text-red-500">*</span>
            </label>
            <input 
              type="text" 
              id="accountName" 
              name="accountName" 
              required
              class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
              placeholder="Enter account name"
            />
          </div>

          <div>
            <label for="companyName" class="block text-sm font-medium text-slate-700 mb-1">
              Company Name
            </label>
            <input 
              type="text" 
              id="companyName" 
              name="companyName" 
              class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
              placeholder="Enter company name"
            />
          </div>

          <div>
            <label for="phone" class="block text-sm font-medium text-slate-700 mb-1">
              Phone <span class="text-red-500">*</span>
            </label>
            <input
              type="tel"
              id="phone"
              name="phone"
              required
              class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
              placeholder="Enter phone number"
            />
          </div>

          <div>
            <label for="gstNo" class="block text-sm font-medium text-slate-700 mb-1">
              GST No <span class="text-red-500">*</span>
            </label>
            <input
              type="text"
              id="gstNo"
              name="gstNo"
              required
              class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
              placeholder="Enter GST number"
            />
          </div>

          <div>
            <label for="email" class="block text-sm font-medium text-slate-700 mb-1">
              Email
            </label>
            <input 
              type="email" 
              id="email" 
              name="email" 
              class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
              placeholder="Enter email address"
            />
          </div>

          <div>
            <label for="website" class="block text-sm font-medium text-slate-700 mb-1">
              Website
            </label>
            <input 
              type="url" 
              id="website" 
              name="website" 
              class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
              placeholder="https://example.com"
            />
          </div>

          <div>
            <label for="industry" class="block text-sm font-medium text-slate-700 mb-1">
              Industry
            </label>
            <input 
              type="text" 
              id="industry" 
              name="industry" 
              class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
              placeholder="e.g., Technology, Finance"
            />
          </div>

          <div>
            <label for="accountType" class="block text-sm font-medium text-slate-700 mb-1">
              Account Type
            </label>
            <select 
              id="accountType" 
              name="accountType" 
              class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
            >
              <option value="">Select type</option>
              <option value="Customer">Customer</option>
              <option value="Prospect">Prospect</option>
              <option value="Partner">Partner</option>
            </select>
          </div>
        </div>
      </div>

      <!-- Billing Address -->
      <div class="p-6 border-b border-slate-200">
        <h2 class="text-lg font-semibold text-slate-800 mb-4">Billing Address</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="md:col-span-2">
            <label for="billingStreet" class="block text-sm font-medium text-slate-700 mb-1">
              Street Address
            </label>
            <textarea 
              id="billingStreet" 
              name="billingStreet" 
              rows="2"
              class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
              placeholder="Enter street address"
            ></textarea>
          </div>

          <div>
            <label for="billingCity" class="block text-sm font-medium text-slate-700 mb-1">
              City
            </label>
            <input 
              type="text" 
              id="billingCity" 
              name="billingCity" 
              class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
              placeholder="Enter city"
            />
          </div>

          <div>
            <label for="billingState" class="block text-sm font-medium text-slate-700 mb-1">
              State
            </label>
            <input 
              type="text" 
              id="billingState" 
              name="billingState" 
              class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
              placeholder="Enter state"
            />
          </div>

          <div>
            <label for="billingCode" class="block text-sm font-medium text-slate-700 mb-1">
              Postal Code
            </label>
            <input 
              type="text" 
              id="billingCode" 
              name="billingCode" 
              class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
              placeholder="Enter postal code"
            />
          </div>

          <div>
            <label for="billingCountry" class="block text-sm font-medium text-slate-700 mb-1">
              Country
            </label>
            <input 
              type="text" 
              id="billingCountry" 
              name="billingCountry" 
              class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
              placeholder="Enter country"
            />
          </div>
        </div>
      </div>

      <!-- Shipping Address -->
      <div class="p-6 border-b border-slate-200">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-lg font-semibold text-slate-800">Shipping Address</h2>
          <label class="flex items-center gap-2 cursor-pointer">
            <input 
              type="checkbox" 
              id="sameAsBilling" 
              class="w-4 h-4 text-blue-600 border-slate-300 rounded focus:ring-2 focus:ring-blue-500"
            />
            <span class="text-sm text-slate-600">Same as billing</span>
          </label>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="md:col-span-2">
            <label for="shippingStreet" class="block text-sm font-medium text-slate-700 mb-1">
              Street Address
            </label>
            <textarea 
              id="shippingStreet" 
              name="shippingStreet" 
              rows="2"
              class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
              placeholder="Enter street address"
            ></textarea>
          </div>

          <div>
            <label for="shippingCity" class="block text-sm font-medium text-slate-700 mb-1">
              City
            </label>
            <input 
              type="text" 
              id="shippingCity" 
              name="shippingCity" 
              class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
              placeholder="Enter city"
            />
          </div>

          <div>
            <label for="shippingState" class="block text-sm font-medium text-slate-700 mb-1">
              State
            </label>
            <input 
              type="text" 
              id="shippingState" 
              name="shippingState" 
              class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
              placeholder="Enter state"
            />
          </div>

          <div>
            <label for="shippingCode" class="block text-sm font-medium text-slate-700 mb-1">
              Postal Code
            </label>
            <input 
              type="text" 
              id="shippingCode" 
              name="shippingCode" 
              class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
              placeholder="Enter postal code"
            />
          </div>

          <div>
            <label for="shippingCountry" class="block text-sm font-medium text-slate-700 mb-1">
              Country
            </label>
            <input 
              type="text" 
              id="shippingCountry" 
              name="shippingCountry" 
              class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
              placeholder="Enter country"
            />
          </div>
        </div>
      </div>

      <!-- Additional Information -->
      <div class="p-6 border-b border-slate-200">
        <h2 class="text-lg font-semibold text-slate-800 mb-4">Additional Information</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label for="employees" class="block text-sm font-medium text-slate-700 mb-1">
              Number of Employees
            </label>
            <input 
              type="text" 
              id="employees" 
              name="employees" 
              class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
              placeholder="e.g., 100-500"
            />
          </div>

          <div>
            <label for="annualRevenue" class="block text-sm font-medium text-slate-700 mb-1">
              Annual Revenue
            </label>
            <input 
              type="text" 
              id="annualRevenue" 
              name="annualRevenue" 
              class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
              placeholder="e.g., $1M - $5M"
            />
          </div>

          <div class="md:col-span-2">
            <label for="description" class="block text-sm font-medium text-slate-700 mb-1">
              Description
            </label>
            <textarea 
              id="description" 
              name="description" 
              rows="3"
              class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
              placeholder="Enter account description"
            ></textarea>
          </div>
        </div>
      </div>

      <!-- Form Actions -->
      <div class="p-6 bg-slate-50 rounded-b-xl flex items-center justify-end gap-3">
        <a 
          href="/accounts" 
          class="px-4 py-2 text-slate-700 bg-white border border-slate-300 rounded-lg hover:bg-slate-50 transition-colors"
        >
          Cancel
        </a>
        <button 
          type="submit" 
          id="submitBtn"
          class="px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors font-medium disabled:opacity-50 disabled:cursor-not-allowed"
        >
          Create Account
        </button>
      </div>
    </form>
  </div>

  <script>
    const API_BASE_URL = import.meta.env.PUBLIC_API_BASE_URL || `http://${window.location.hostname}:8082`;
    const form = document.getElementById('accountForm');
    const submitBtn = document.getElementById('submitBtn');
    const errorMessage = document.getElementById('errorMessage');
    const errorText = document.getElementById('errorText');
    const successMessage = document.getElementById('successMessage');
    const successText = document.getElementById('successText');
    const sameAsBillingCheckbox = document.getElementById('sameAsBilling');

    // Copy billing address to shipping address
    sameAsBillingCheckbox.addEventListener('change', (e) => {
      if (e.target.checked) {
        document.getElementById('shippingStreet').value = document.getElementById('billingStreet').value;
        document.getElementById('shippingCity').value = document.getElementById('billingCity').value;
        document.getElementById('shippingState').value = document.getElementById('billingState').value;
        document.getElementById('shippingCode').value = document.getElementById('billingCode').value;
        document.getElementById('shippingCountry').value = document.getElementById('billingCountry').value;
      }
    });

    // Form submission
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Hide previous messages
      errorMessage.classList.add('hidden');
      successMessage.classList.add('hidden');

      // Get form data
      const formData = new FormData(form);
      const accountData = {
        fields: {
          'Account Name': formData.get('accountName'),
          'Company Name': formData.get('companyName') || '',
          'Phone Number': formData.get('phone'),
          'GST No': formData.get('gstNo'),
          'Email 1': formData.get('email') || '',
          'Website': formData.get('website') || '',
          'Industry': formData.get('industry') || '',
          'Account Type': formData.get('accountType') || '',
          'Billing Street': formData.get('billingStreet') || '',
          'Billing City': formData.get('billingCity') || '',
          'Billing State': formData.get('billingState') || '',
          'Billing Code': formData.get('billingCode') || '',
          'Billing Country': formData.get('billingCountry') || '',
          'Shipping Street': formData.get('shippingStreet') || '',
          'Shipping City': formData.get('shippingCity') || '',
          'Shipping State': formData.get('shippingState') || '',
          'Shipping Code': formData.get('shippingCode') || '',
          'Shipping Country': formData.get('shippingCountry') || '',
          'Employees': formData.get('employees') || '',
          'Annual Revenue': formData.get('annualRevenue') || '',
          'Description': formData.get('description') || '',
          'Source': 'Manual'
        }
      };

      console.log('[ADD ACCOUNT] Creating account with data:', accountData);

      // Disable submit button
      submitBtn.disabled = true;
      submitBtn.textContent = 'Creating...';

      try {
        const token = localStorage.getItem('jwt_token');
        if (!token) {
          throw new Error('No authentication token found. Please log in.');
        }

        // Check for duplicate GST No before creating
        const gstNo = accountData.fields['GST No'];
        if (gstNo) {
          const dupCheck = await fetch(
            `${API_BASE_URL}/proxy/accounts_duplicate/records?where=${encodeURIComponent(`(GST No,eq,${gstNo})`)}`,
            { headers: { 'Authorization': `Bearer ${token}` } }
          );
          if (dupCheck.ok) {
            const dupData = await dupCheck.json();
            const existing = dupData.records?.[0];
            if (existing) {
              const existingName = existing.fields?.['Account Name'] || 'Unknown';
              throw new Error(`An account with this GST number already exists: "${existingName}". Please use the existing account.`);
            }
          }
        }

        const response = await fetch(`${API_BASE_URL}/proxy/accounts_duplicate/records`, {
          method: 'POST',
          headers: {
            'Authorization': `Bearer ${token}`,
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(accountData)
        });

        if (!response.ok) {
          const errorData = await response.text();
          console.error('[ADD ACCOUNT] Error response:', errorData);
          throw new Error('Failed to create account. Please try again.');
        }

        const result = await response.json();
        console.log('[ADD ACCOUNT] Account created successfully:', result);

        const accountId = result.records ? result.records[0]?.id : result.id;

        // Show success message
        successText.textContent = 'Account created successfully!';
        successMessage.classList.remove('hidden');

        // Redirect to account detail page after 1.5 seconds
        setTimeout(() => {
          window.location.href = `/account-detail?id=${accountId}`;
        }, 1500);

      } catch (error) {
        console.error('[ADD ACCOUNT] Error:', error);
        errorText.textContent = error.message || 'Failed to create account. Please try again.';
        errorMessage.classList.remove('hidden');
        
        // Re-enable submit button
        submitBtn.disabled = false;
        submitBtn.textContent = 'Create Account';
      }
    });
  </script>
</AdminLayout>
