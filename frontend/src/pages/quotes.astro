---
import AdminLayout from '../layouts/AdminLayout.astro';
---

<AdminLayout title="Quotes" currentPage="quotes">
  <!-- Page Header -->
  <div class="mb-6">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <h1 class="text-2xl font-semibold text-slate-800">Quotes</h1>
      </div>
      <a href="/create-quote" class="inline-flex items-center gap-2 px-6 py-3 bg-green-500 text-white text-base font-semibold rounded-lg hover:bg-green-600 transition-all shadow-lg hover:shadow-xl">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
        </svg>
        Create Quote
      </a>
    </div>
  </div>

  <!-- Search and Filter Bar -->
  <div class="bg-white rounded-xl border border-slate-200 p-4 mb-6">
    <div class="flex flex-col lg:flex-row gap-3">
      <!-- Search -->
      <div class="flex-1 relative">
        <svg class="absolute left-3 top-3 w-5 h-5 text-slate-400 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
        <input
          type="text"
          id="searchInput"
          placeholder="Search by name or status..."
          class="w-full pl-10 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all"
          autocomplete="off"
        />
      </div>

      <!-- Status Filter -->
      <select
        id="statusFilter"
        class="px-3 py-2.5 bg-slate-50 border border-slate-200 rounded-lg text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all min-w-[160px]"
      >
        <option value="">All</option>
        <option value="Draft">Draft</option>
        <option value="Sent">Sent</option>
        <option value="Approved">Approved</option>
        <option value="Rejected">Rejected</option>
        <option value="Final">Final</option>
      </select>

      <!-- Quote Type Filter -->
      <select
        id="typeFilter"
        class="px-3 py-2.5 bg-slate-50 border border-slate-200 rounded-lg text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all min-w-[160px]"
      >
        <option value="">All Types</option>
        <option value="Customer">Customer</option>
        <option value="Dealer">Dealer</option>
      </select>

      <!-- Sort -->
      <select
        id="sortBy"
        class="px-3 py-2.5 bg-slate-50 border border-slate-200 rounded-lg text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all min-w-[190px]"
      >
        <option value="">Sort: Default</option>
        <option value="date-desc" selected>Date: Newest First</option>
        <option value="date-asc">Date: Oldest First</option>
        <option value="amount-desc">Amount: High → Low</option>
        <option value="amount-asc">Amount: Low → High</option>
        <option value="name-asc">Name: A → Z</option>
        <option value="name-desc">Name: Z → A</option>
      </select>

      <!-- Reset -->
      <button
        id="resetFilters"
        class="px-4 py-2.5 text-sm text-slate-600 border border-slate-200 bg-slate-50 rounded-lg hover:bg-slate-100 transition-colors whitespace-nowrap"
      >
        Reset
      </button>
    </div>

    <!-- Results count -->
    <div class="mt-3">
      <span id="searchStatus" class="text-sm text-slate-500"></span>
    </div>
  </div>

  <!-- Quotes Table -->
  <div class="bg-white rounded-xl border border-slate-200 overflow-hidden">
    <!-- Loading State -->
    <div id="loading" class="py-12 text-center">
      <svg class="animate-spin w-8 h-8 text-blue-600 mx-auto mb-3" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
      </svg>
      <p class="text-sm text-slate-600">Loading quotes...</p>
    </div>

    <!-- Error State -->
    <div id="error" class="hidden mx-6 my-4 p-4 bg-red-50 border border-red-200 rounded-lg">
      <div class="flex items-start gap-3">
        <svg class="w-5 h-5 text-red-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <p class="text-sm text-red-800" id="errorText"></p>
      </div>
    </div>

    <!-- Table -->
    <div id="quotesTable" class="hidden overflow-x-auto">
      <table class="w-full table-fixed">
        <colgroup>
          <col class="w-12" />
          <col class="w-[38%]" />
          <col class="w-[14%]" />
          <col class="w-[14%]" />
          <col class="w-[16%]" />
          <col class="w-[10%]" />
        </colgroup>
        <thead class="bg-slate-50 border-b border-slate-200">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-semibold text-slate-600 uppercase tracking-wider">#</th>
            <th class="px-6 py-3 text-left text-xs font-semibold text-slate-600 uppercase tracking-wider">QUOTE NAME</th>
            <th class="px-6 py-3 text-left text-xs font-semibold text-slate-600 uppercase tracking-wider">DATE</th>
            <th class="px-6 py-3 text-left text-xs font-semibold text-slate-600 uppercase tracking-wider">STATUS</th>
            <th class="px-6 py-3 text-left text-xs font-semibold text-slate-600 uppercase tracking-wider">TOTAL AMOUNT</th>
            <th class="px-6 py-3 text-left text-xs font-semibold text-slate-600 uppercase tracking-wider">ACTIONS</th>
          </tr>
        </thead>
        <tbody id="quotesBody" class="divide-y divide-slate-200"></tbody>
      </table>
    </div>

    <!-- Empty State -->
    <div id="emptyState" class="hidden py-12 text-center">
      <svg class="w-16 h-16 text-slate-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
      </svg>
      <p class="text-slate-600 font-medium mb-1">No quotes found</p>
      <p class="text-sm text-slate-500">Click "Create Quote" to get started</p>
    </div>
  </div>

  <script>
    import { getToken, logout, safeJsonParse, getUserInfo } from '../lib/api';
    import { debounce } from '../utils/debounce';

    const API_BASE_URL = import.meta.env.PUBLIC_API_BASE_URL ||
      `${window.location.protocol}//${window.location.hostname}:8082`;

    function showToast(message: string, type: 'success' | 'error' | 'info' = 'info') {
      const container = document.getElementById('toastContainer')!;
      const toast = document.createElement('div');
      const bg = type === 'success' ? 'bg-emerald-500' : type === 'error' ? 'bg-red-500' : 'bg-slate-700';
      const icon = type === 'success'
        ? `<svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>`
        : type === 'error'
        ? `<svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`
        : `<svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`;
      toast.setAttribute('data-toast', '');
      toast.className = `pointer-events-auto flex items-center gap-3 px-4 py-3 rounded-xl text-white text-sm font-semibold shadow-xl max-w-sm ${bg} opacity-0 translate-x-4 transition-all duration-200`;
      toast.innerHTML = `${icon}<span class="flex-1 leading-snug">${message}</span><button class="ml-2 opacity-60 hover:opacity-100 text-base leading-none transition-opacity" onclick="this.closest('[data-toast]').remove()">✕</button>`;
      container.appendChild(toast);
      requestAnimationFrame(() => requestAnimationFrame(() => toast.classList.remove('opacity-0', 'translate-x-4')));
      setTimeout(() => { toast.classList.add('opacity-0', 'translate-x-4'); setTimeout(() => toast.remove(), 200); }, 3500);
    }

    /**
     * Get the logged-in user's email from localStorage
     */
    function getUserEmail(): string | null {
      return localStorage.getItem('user_email');
    }

    /**
     * Get the logged-in user's role from localStorage
     */
    function getUserRole(): string | null {
      const userInfo = getUserInfo();
      return userInfo ? userInfo.role : null;
    }
    const token = getToken();

    if (!token) {
      window.location.href = '/login';
    }

    const loadingDiv = document.getElementById('loading') as HTMLDivElement;
    const errorDiv = document.getElementById('error') as HTMLDivElement;
    const quotesTable = document.getElementById('quotesTable') as HTMLDivElement;
    const quotesBody = document.getElementById('quotesBody') as HTMLTableSectionElement;
    const emptyState = document.getElementById('emptyState') as HTMLDivElement;
    const searchInput = document.getElementById('searchInput') as HTMLInputElement;
    const statusFilter = document.getElementById('statusFilter') as HTMLSelectElement;
    const typeFilter = document.getElementById('typeFilter') as HTMLSelectElement;
    const sortBy = document.getElementById('sortBy') as HTMLSelectElement;
    const resetFilters = document.getElementById('resetFilters') as HTMLButtonElement;
    const searchStatus = document.getElementById('searchStatus') as HTMLSpanElement;

    let latestQuotes: any[] = [];

    function applyFilters() {
      const term = searchInput.value.toLowerCase().trim();
      const status = statusFilter.value;
      const type = typeFilter.value;
      const sort = sortBy.value;

      let result = latestQuotes.filter((record: any) => {
        const fields = record.fields || {};

        if (term) {
          const subject = (fields['Subject'] || '').toLowerCase();
          const quoteStatus = (fields['Quote Status'] || '').toLowerCase();
          if (!subject.includes(term) && !quoteStatus.includes(term)) return false;
        }

        if (status && fields['Quote Status'] !== status) return false;

        if (type) {
          const quoteType = (fields['Quote Type'] || '').trim();
          if (quoteType !== type) return false;
        }

        return true;
      });

      if (sort === 'date-desc') {
        result.sort((a: any, b: any) => (b.fields['Quote Date'] || '').localeCompare(a.fields['Quote Date'] || ''));
      } else if (sort === 'date-asc') {
        result.sort((a: any, b: any) => (a.fields['Quote Date'] || '').localeCompare(b.fields['Quote Date'] || ''));
      } else if (sort === 'amount-desc') {
        result.sort((a: any, b: any) => (Number(b.fields['Total Amount']) || 0) - (Number(a.fields['Total Amount']) || 0));
      } else if (sort === 'amount-asc') {
        result.sort((a: any, b: any) => (Number(a.fields['Total Amount']) || 0) - (Number(b.fields['Total Amount']) || 0));
      } else if (sort === 'name-asc') {
        result.sort((a: any, b: any) => (a.fields['Subject'] || '').localeCompare(b.fields['Subject'] || ''));
      } else if (sort === 'name-desc') {
        result.sort((a: any, b: any) => (b.fields['Subject'] || '').localeCompare(a.fields['Subject'] || ''));
      }

      const total = latestQuotes.length;
      const shown = result.length;
      searchStatus.textContent = shown === total
        ? `${total} quote${total !== 1 ? 's' : ''}`
        : `${shown} of ${total} quote${total !== 1 ? 's' : ''}`;

      renderQuotes(result);
    }

    searchInput.addEventListener('input', applyFilters);
    statusFilter.addEventListener('change', applyFilters);
    typeFilter.addEventListener('change', applyFilters);
    sortBy.addEventListener('change', applyFilters);
    resetFilters.addEventListener('click', () => {
      searchInput.value = '';
      statusFilter.value = '';
      typeFilter.value = '';
      sortBy.value = 'date-desc';
      applyFilters();
    });

    function renderQuotes(records: any[]) {
      if (records.length === 0) {
        quotesTable.classList.add('hidden');
        emptyState.classList.remove('hidden');
        return;
      }

      emptyState.classList.add('hidden');

      quotesBody.innerHTML = records.map((record: any, index: number) => {
        const fields = record.fields || {};
        const quoteName = fields['Subject'] || '<span class="text-slate-400 italic">Untitled Quote</span>';
        const date = fields['Quote Date'] || fields['Date'] || '<span class="text-slate-400 italic">N/A</span>';
        const total = fields['Total Amount'] || fields['Total'] || 0;
        const status = fields['Quote Status'] || fields['Status'] || 'Draft';

        let statusClasses = 'bg-slate-100 text-slate-800';
        if (status === 'Sent') statusClasses = 'bg-blue-100 text-blue-800';
        if (status === 'Accepted') statusClasses = 'bg-emerald-100 text-emerald-800';
        if (status === 'Rejected') statusClasses = 'bg-red-100 text-red-800';
        if (status === 'Approved') statusClasses = 'bg-green-100 text-green-800';

        return `
          <tr class="cursor-pointer transition-all hover:bg-blue-50/50 hover:shadow-sm" onclick="window.location.href='/quote-detail?id=${record.id}'">
            <td class="px-6 py-4 text-sm font-medium text-slate-900">${index + 1}</td>
            <td class="px-6 py-4 text-sm text-slate-900">${quoteName}</td>
            <td class="px-6 py-4 text-sm text-slate-600">${date}</td>
            <td class="px-6 py-4">
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ${statusClasses}">
                ${status}
              </span>
            </td>
            <td class="px-6 py-4 text-sm font-semibold text-slate-900">₹${Number(total).toLocaleString('en-IN', { minimumFractionDigits: 0, maximumFractionDigits: 0 })}</td>
            <td class="px-6 py-4" onclick="event.stopPropagation()">
              <div class="flex gap-2">
                <button class="preview-pdf-btn p-2 rounded-lg hover:bg-blue-100 transition-colors" data-quote-id="${record.id}" title="Preview PDF">
                  <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                  </svg>
                </button>
              </div>
            </td>
          </tr>
        `;
      }).join('');

      quotesTable.classList.remove('hidden');

      document.querySelectorAll('.preview-pdf-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const quoteId = (btn as HTMLElement).getAttribute('data-quote-id');
          if (quoteId) openQuotesPdfModal(quoteId, btn as HTMLButtonElement);
        });
      });
    }

    async function loadQuotes() {
      try {
        const userEmail = getUserEmail();
        const userRole = getUserRole();

        let url = `${API_BASE_URL}/proxy/quotes/records`;

        if (userRole !== 'admin') {
          const encodedWhere = encodeURIComponent(`(Quote Created By,eq,${userEmail})`);
          url = `${url}?where=${encodedWhere}`;
        }

        const response = await fetch(url, {
          method: 'GET',
          headers: {
            'Authorization': `Bearer ${token}`,
            'Content-Type': 'application/json',
          },
        });

        if (response.status === 401) {
          logout();
          return;
        }

        if (!response.ok) throw new Error('Failed to fetch quotes');

        const data = await safeJsonParse(response);
        const allQuotes = data.records || [];

        const parentQuoteIds = new Set<number>();
        allQuotes.forEach((quote: any) => {
          const parentField = quote.fields['Parent Quote'];
          if (parentField && typeof parentField === 'object' && parentField.id) {
            parentQuoteIds.add(parentField.id);
          }
        });

        latestQuotes = allQuotes.filter((quote: any) => !parentQuoteIds.has(quote.id));

        loadingDiv.classList.add('hidden');
        applyFilters();
      } catch (error) {
        loadingDiv.classList.add('hidden');
        const errorText = errorDiv.querySelector('#errorText');
        if (errorText) {
          errorText.textContent = error instanceof Error ? error.message : 'Failed to load quotes';
        }
        errorDiv.classList.remove('hidden');
      }
    }

    /**
     * Preview quote PDF - same logic as quote-detail page
     */
    async function previewQuotePDF(quoteId: string, button?: HTMLButtonElement, deliveryTerms: string = '', paymentTerms: string = '') {
      // Store original button content
      const originalContent = button?.innerHTML;
      
      try {
        // Show loading spinner
        if (button) {
          button.disabled = true;
          button.innerHTML = `
            <svg class="animate-spin w-4 h-4 text-blue-600" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
          `;
        }
        // Fetch quote details
        const quoteResponse = await fetch(`${API_BASE_URL}/proxy/quotes/records/${quoteId}`, {
          method: 'GET',
          headers: {
            'Authorization': `Bearer ${token}`,
            'Content-Type': 'application/json',
            'Cache-Control': 'no-cache',
          },
        });

        if (!quoteResponse.ok) {
          throw new Error('Failed to fetch quote details');
        }

        const quoteData = await safeJsonParse(quoteResponse);
        const fields = quoteData.fields || {};

        // Fetch linked account
        const accountResponse = await fetch(
          `${API_BASE_URL}/proxy/quotes/links/accounts_duplicate/${quoteId}?fields=Account Name`,
          {
            method: 'GET',
            headers: {
              'Authorization': `Bearer ${token}`,
              'Content-Type': 'application/json',
              'Cache-Control': 'no-cache',
            },
          }
        );

        let accountName = 'N/A';
        if (accountResponse.ok) {
          const accountData = await safeJsonParse(accountResponse);
          const accountList = accountData.list || accountData.records || [];
          if (accountList.length > 0) {
            accountName = accountList[0].fields?.['Account Name'] || accountList[0]['Account Name'] || 'N/A';
          }
        }

        // Fetch products from junction table
        const junctionResponse = await fetch(
          `${API_BASE_URL}/proxy/products_for_quotes/records?where=(nc_76_d___Quotes_id,eq,${quoteId})&fields=Id,Quantity,Custom%20Unit%20Price,Discount,nc_76_d__Products_id`,
          {
            method: 'GET',
            headers: {
              'Authorization': `Bearer ${token}`,
              'Content-Type': 'application/json',
              'Cache-Control': 'no-cache',
            },
          }
        );

        let products: any[] = [];
        if (junctionResponse.ok) {
          const junctionData = await safeJsonParse(junctionResponse);
          const junctionRecords = junctionData.records || [];
          console.log('[PDF PREVIEW] Junction records:', junctionRecords);

          // Fetch catalog products
          const catalogResponse = await fetch(
            `${API_BASE_URL}/proxy/quotes/links/products/${quoteId}?fields=Id,Product Name,Unit Price,Brand,HSN/SAC Code,Model No,Tax,Description`,
            {
              method: 'GET',
              headers: {
                'Authorization': `Bearer ${token}`,
                'Content-Type': 'application/json',
                'Cache-Control': 'no-cache',
              },
            }
          );

          if (catalogResponse.ok) {
            const catalogData = await safeJsonParse(catalogResponse);
            const catalogProducts = catalogData.list || catalogData.records || [];
            console.log('[PDF PREVIEW] Catalog products:', catalogProducts);

            products = catalogProducts.map((catalogProduct: any) => {
              const productId = catalogProduct.id;
              const junctionMatch = junctionRecords.find(
                (jr: any) => jr.fields['nc_76_d__Products_id'] === productId
              );

              if (junctionMatch) {
                return {
                  name: catalogProduct.fields['Product Name'],
                  quantity: junctionMatch.fields['Quantity'] || 1,
                  price: junctionMatch.fields['Custom Unit Price'] || 0,
                  discount: junctionMatch.fields['Discount'] || 0,
                  tax: catalogProduct.fields['Tax'] || 0,
                  hsnCode: catalogProduct.fields['HSN/SAC Code'],
                  description: catalogProduct.fields['Description']
                };
              }
              return null;
            }).filter((p: any) => p !== null);
          }
        }

        console.log('[PDF PREVIEW] Products array:', products);
        console.log('[PDF PREVIEW] Products count:', products.length);

        // Prepare request body for PDF generation
        const requestBody = {
          id: parseInt(quoteId),
          subject: fields['Subject'] || `Quote #${quoteId}`,
          date: fields['Quote Date'] || new Date().toISOString().split('T')[0],
          version: fields['Quote Version'] || '1.0',
          total: fields['Total Amount'] || 0,
          account: {
            name: accountName
          },
          products: products,
          logo: 'greenocare',
          deliveryTerms,
          paymentTerms
        };

        console.log('[PDF PREVIEW] Request body:', JSON.stringify(requestBody, null, 2));

        // Generate PDF
        const response = await fetch('/api/quotes/pdf', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(requestBody)
        });

        if (!response.ok) {
          throw new Error(`Failed to generate PDF: ${response.status} ${response.statusText}`);
        }

        const blob = await response.blob();
        const url = window.URL.createObjectURL(blob);
        
        // Open in new tab for preview
        window.open(url, '_blank');
        
        // Clean up
        setTimeout(() => window.URL.revokeObjectURL(url), 100);
      } catch (error) {
        console.error('[PDF PREVIEW ERROR]', error);
        showToast(error instanceof Error ? error.message : 'Failed to preview PDF', 'error');
      } finally {
        // Restore button state
        if (button && originalContent) {
          button.disabled = false;
          button.innerHTML = originalContent;
        }
      }
    }

    /**
     * Download quote as PDF
     * Fetches quote details and sends to PDF generation API
     */
    async function downloadQuotePDF(quoteId: string) {
      try {
        // Fetch quote record to get basic details
        const quoteResponse = await fetch(`${API_BASE_URL}/proxy/quotes/records/${quoteId}`, {
          method: 'GET',
          headers: {
            'Authorization': `Bearer ${token}`,
            'Content-Type': 'application/json',
          },
        });

        if (!quoteResponse.ok) {
          throw new Error('Failed to fetch quote details');
        }

        const quoteData = await safeJsonParse(quoteResponse);
        const fields = quoteData.fields || {};

        // Fetch linked account
        const accountResponse = await fetch(
          `${API_BASE_URL}/proxy/quotes/links/accounts_duplicate/${quoteId}?fields=Account Name`,
          {
            method: 'GET',
            headers: {
              'Authorization': `Bearer ${token}`,
              'Content-Type': 'application/json',
            },
          }
        );

        let accountName = 'N/A';
        if (accountResponse.ok) {
          const accountData = await safeJsonParse(accountResponse);
          const accounts = accountData.list || accountData.records || [];
          if (accounts.length > 0) {
            accountName = accounts[0].fields['Account Name'] || 'N/A';
          }
        }

        // Fetch linked products
        const productsResponse = await fetch(
          `${API_BASE_URL}/proxy/quotes/links/products/${quoteId}?fields=Product Name,Unit Price,Brand,HSN/SAC Code,Model No,Tax,Description`,
          {
            method: 'GET',
            headers: {
              'Authorization': `Bearer ${token}`,
              'Content-Type': 'application/json',
            },
          }
        );

        let products: Array<{ name: string; price?: number; model?: string; tax?: string; hsnCode?: string }> = [];
        if (productsResponse.ok) {
          const productsData = await safeJsonParse(productsResponse);
          const productRecords = productsData.list || productsData.records || [];
          products = productRecords.map((record: any) => ({
            name: record.fields['Product Name'] || 'Unnamed Product',
            price: record.fields['Unit Price'] 
              ? parseFloat(String(record.fields['Unit Price'])) 
              : undefined,
            model: record.fields['Model No'] || undefined,
            tax: record.fields['Tax'] || undefined,
            hsnCode: record.fields['HSN/SAC Code'] || undefined
          }));
        }

        // Prepare quote data for PDF generation
        const pdfData = {
          id: parseInt(quoteId),
          subject: fields['Subject'] || `Quote #${quoteId}`,
          date: fields['Quote Date'] || new Date().toISOString().split('T')[0],
          version: fields['Quote Version'] || '1.0',
          total: fields['Total Amount'] || 0,
          account: {
            name: accountName
          },
          products: products
        };

        // Call PDF generation API
        const response = await fetch('/api/quotes/pdf', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(pdfData)
        });

        if (!response.ok) {
          throw new Error('Failed to generate PDF');
        }

        // Create blob from response
        const blob = await response.blob();
        
        // Create download link
        const url = window.URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `quote-${quoteId}.pdf`;
        document.body.appendChild(a);
        a.click();
        
        // Cleanup
        window.URL.revokeObjectURL(url);
        document.body.removeChild(a);
      } catch (error) {
        console.error('Failed to download PDF:', error);
        showToast('Failed to download PDF. Please try again.', 'error');
      }
    }

    let _pendingQuoteId = '';
    let _pendingButton: HTMLButtonElement | null = null;

    function openQuotesPdfModal(quoteId: string, button: HTMLButtonElement) {
      _pendingQuoteId = quoteId;
      _pendingButton = button;

      const savedDelivery = localStorage.getItem('pdfDeliveryTerms');
      const savedPayment = localStorage.getItem('pdfPaymentTerms');

      if (savedDelivery !== null) {
        previewQuotePDF(quoteId, button, savedDelivery, savedPayment || '');
        return;
      }

      (document.getElementById('qDeliveryTermsInput') as HTMLInputElement).value = '';
      (document.getElementById('qPaymentTermsInput') as HTMLInputElement).value = '';
      document.getElementById('quotesPdfModal')!.classList.remove('hidden');
    }

    document.getElementById('qPdfTermsCancel')?.addEventListener('click', () => {
      document.getElementById('quotesPdfModal')!.classList.add('hidden');
    });

    document.getElementById('qPdfTermsConfirm')?.addEventListener('click', async () => {
      const deliveryTerms = (document.getElementById('qDeliveryTermsInput') as HTMLInputElement).value.trim();
      const paymentTerms = (document.getElementById('qPaymentTermsInput') as HTMLInputElement).value.trim();
      localStorage.setItem('pdfDeliveryTerms', deliveryTerms);
      localStorage.setItem('pdfPaymentTerms', paymentTerms);
      document.getElementById('quotesPdfModal')!.classList.add('hidden');
      await previewQuotePDF(_pendingQuoteId, _pendingButton ?? undefined, deliveryTerms, paymentTerms);
    });

    // Initial load
    loadQuotes();
  </script>

  <!-- PDF Terms Modal -->
  <div id="quotesPdfModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/40">
    <div class="bg-white rounded-xl shadow-xl w-full max-w-md mx-4 p-6">
      <h3 class="text-base font-semibold text-slate-800 mb-1">PDF Terms</h3>
      <p class="text-sm text-slate-500 mb-5">Leave blank to keep the fields empty on the PDF.</p>
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">Delivery Terms</label>
          <input
            type="text"
            id="qDeliveryTermsInput"
            placeholder="e.g. Within 7 working days"
            class="w-full px-3 py-2.5 bg-slate-50 border border-slate-200 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
          />
        </div>
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">Payment Terms</label>
          <input
            type="text"
            id="qPaymentTermsInput"
            placeholder="e.g. 50% advance, 50% on delivery"
            class="w-full px-3 py-2.5 bg-slate-50 border border-slate-200 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
          />
        </div>
      </div>
      <div class="flex justify-end gap-3 mt-6">
        <button id="qPdfTermsCancel" class="px-4 py-2 text-sm text-slate600 border border-slate-200 rounded-md hover:bg-slate-50 transition-colors">
          Cancel
        </button>
        <button id="qPdfTermsConfirm" class="px-4 py-2 text-sm bg-indigo-600 text-white rounded-md hover:bg-indigo-700 transition-colors">
          Generate PDF
        </button>
      </div>
    </div>
  </div>

  <!-- Toast Container -->
  <div id="toastContainer" class="fixed top-4 right-4 z-[9999] flex flex-col gap-2 pointer-events-none"></div>
</AdminLayout>
