---
import AdminLayout from '../layouts/AdminLayout.astro';
---

<AdminLayout title="Lead Details" currentPage="leads">
  <div class="max-w-5xl mx-auto">
    <!-- Back Button -->
    <div class="mb-5">
      <a href="/leads" class="inline-flex items-center gap-2 text-slate-500 hover:text-slate-800 text-sm font-medium transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
        </svg>
        Back to Leads
      </a>
    </div>

    <!-- Loading State -->
    <div id="pageLoading" class="py-20 text-center">
      <svg class="animate-spin w-8 h-8 text-blue-600 mx-auto mb-3" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
      </svg>
      <p class="text-sm text-slate-500">Loading lead...</p>
    </div>

    <!-- Error State -->
    <div id="pageError" class="hidden p-5 bg-red-50 border border-red-200 rounded-xl text-red-800 text-sm"></div>

    <!-- Page Content -->
    <div id="pageContent" class="hidden space-y-5">

      <!-- Header Card -->
      <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm">
        <div class="bg-gradient-to-br from-indigo-50 via-slate-50 to-white px-8 py-7 border-b border-slate-200">
          <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">
            <div class="flex items-start gap-4">
              <div class="w-14 h-14 bg-gradient-to-br from-indigo-500 to-indigo-600 rounded-xl flex items-center justify-center shadow-lg shadow-indigo-500/25 flex-shrink-0">
                <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                </svg>
              </div>
              <div>
                <h1 id="detailLeadName" class="text-2xl font-bold text-slate-900 tracking-tight">—</h1>
                <p id="detailCompany" class="text-sm text-slate-500 mt-0.5"></p>
                <div class="flex flex-wrap items-center gap-2 mt-2">
                  <span id="detailLostBadge" class="hidden items-center px-2.5 py-1 rounded-lg text-xs font-semibold bg-red-100 text-red-700">Lost</span>
                  <span id="detailSource" class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-semibold"></span>
                </div>
              </div>
            </div>
            <div class="flex items-center gap-2 flex-shrink-0">
              <button id="deleteLeadBtn" class="hidden px-4 py-2.5 bg-white border border-red-200 text-red-600 rounded-xl hover:bg-red-50 text-sm font-semibold transition-all flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                </svg>
                Delete
              </button>
              <button id="sendQuoteBtn" class="hidden px-4 py-2.5 bg-indigo-600 text-white rounded-xl hover:bg-indigo-700 text-sm font-semibold transition-all items-center gap-2 shadow-lg shadow-indigo-500/25">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                </svg>
                Send Quote
              </button>
              <button id="markWonBtn" class="hidden px-4 py-2.5 bg-white border border-emerald-200 text-emerald-700 rounded-xl hover:bg-emerald-50 text-sm font-semibold transition-all items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                Mark as Won
              </button>
              <button id="markLostBtn" class="px-4 py-2.5 bg-white border border-orange-200 text-orange-600 rounded-xl hover:bg-orange-50 text-sm font-semibold transition-all flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
                Mark as Lost
              </button>
              <button id="editLeadDetailBtn" class="px-4 py-2.5 bg-white border border-slate-300 text-slate-700 rounded-xl hover:bg-slate-50 text-sm font-semibold transition-all flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                </svg>
                Edit Lead
              </button>
            </div>
          </div>
        </div>

        <!-- Pipeline Stage Track -->
        <div class="px-8 py-6 border-b border-slate-100 bg-slate-50/40">
          <p class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-5">Pipeline Stage</p>
          <div id="pipelineTrack" class="flex items-start w-full overflow-x-auto pt-2 pb-2">
            <!-- rendered by JS -->
          </div>
        </div>

        <!-- Info Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 divide-y md:divide-y-0 md:divide-x divide-slate-100">
          <!-- Left: Contact -->
          <div class="px-8 py-6 space-y-4">
            <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider">Contact</h3>

            <div>
              <p class="text-xs font-semibold text-slate-400 uppercase tracking-wide mb-1">Contact Person</p>
              <p id="detailContactPerson" class="text-sm font-medium text-slate-800">—</p>
            </div>

            <div id="detailPhoneBlock">
              <p class="text-xs font-semibold text-slate-400 uppercase tracking-wide mb-1">Phone</p>
              <div class="space-y-1">
                <p id="detailPhone" class="text-sm font-medium text-slate-800">—</p>
                <p id="detailPhone2" class="hidden text-sm text-slate-600"></p>
                <p id="detailPhone3" class="hidden text-sm text-slate-600"></p>
              </div>
            </div>

            <div>
              <p class="text-xs font-semibold text-slate-400 uppercase tracking-wide mb-1">Email</p>
              <p id="detailEmail" class="text-sm font-medium text-slate-800">—</p>
            </div>

            <div>
              <p class="text-xs font-semibold text-slate-400 uppercase tracking-wide mb-1">Assigned To</p>
              <p id="detailAssignedTo" class="text-sm font-medium text-slate-800">—</p>
            </div>

            <div>
              <p class="text-xs font-semibold text-slate-400 uppercase tracking-wide mb-1">Created By</p>
              <p id="detailCreatedBy" class="text-sm font-medium text-slate-800">—</p>
            </div>
          </div>

          <!-- Right: Activity -->
          <div class="px-8 py-6 space-y-4">
            <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider">Activity</h3>

            <div>
              <p class="text-xs font-semibold text-slate-400 uppercase tracking-wide mb-1">Last Contacted</p>
              <p id="detailLastContacted" class="text-sm font-medium text-slate-800">—</p>
            </div>

            <div>
              <p class="text-xs font-semibold text-slate-400 uppercase tracking-wide mb-1">Next Follow-up</p>
              <p id="detailNextFollowUp" class="text-sm font-medium">—</p>
            </div>

            <div id="detailPushLogRow" class="hidden">
              <p class="text-xs font-semibold text-slate-400 uppercase tracking-wide mb-2">Push History</p>
              <div id="detailPushLogList" class="space-y-2 max-h-48 overflow-y-auto"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- Notes Card -->
      <div id="detailNotesCard" class="hidden bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm px-8 py-6">
        <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-3">Notes / Requirements</h3>
        <p id="detailNotes" class="text-sm text-slate-700 whitespace-pre-wrap leading-relaxed"></p>
      </div>

      <!-- Billing Address Card -->
      <div id="detailBillingCard" class="hidden bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm px-8 py-6">
        <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-4">Billing Address</h3>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
          <div class="col-span-2 sm:col-span-3">
            <p class="text-xs font-semibold text-slate-400 uppercase tracking-wide mb-1">Street</p>
            <p id="detailBillingStreet" class="text-sm font-medium text-slate-800">—</p>
          </div>
          <div>
            <p class="text-xs font-semibold text-slate-400 uppercase tracking-wide mb-1">City</p>
            <p id="detailBillingCity" class="text-sm font-medium text-slate-800">—</p>
          </div>
          <div>
            <p class="text-xs font-semibold text-slate-400 uppercase tracking-wide mb-1">State</p>
            <p id="detailBillingState" class="text-sm font-medium text-slate-800">—</p>
          </div>
          <div>
            <p class="text-xs font-semibold text-slate-400 uppercase tracking-wide mb-1">Postal Code</p>
            <p id="detailBillingCode" class="text-sm font-medium text-slate-800">—</p>
          </div>
          <div>
            <p class="text-xs font-semibold text-slate-400 uppercase tracking-wide mb-1">Country</p>
            <p id="detailBillingCountry" class="text-sm font-medium text-slate-800">—</p>
          </div>
        </div>
      </div>

      <!-- Shipping Address Card -->
      <div id="detailShippingCard" class="hidden bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm px-8 py-6">
        <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-4">Shipping Address</h3>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
          <div class="col-span-2 sm:col-span-3">
            <p class="text-xs font-semibold text-slate-400 uppercase tracking-wide mb-1">Street</p>
            <p id="detailShippingStreet" class="text-sm font-medium text-slate-800">—</p>
          </div>
          <div>
            <p class="text-xs font-semibold text-slate-400 uppercase tracking-wide mb-1">City</p>
            <p id="detailShippingCity" class="text-sm font-medium text-slate-800">—</p>
          </div>
          <div>
            <p class="text-xs font-semibold text-slate-400 uppercase tracking-wide mb-1">State</p>
            <p id="detailShippingState" class="text-sm font-medium text-slate-800">—</p>
          </div>
          <div>
            <p class="text-xs font-semibold text-slate-400 uppercase tracking-wide mb-1">Postal Code</p>
            <p id="detailShippingCode" class="text-sm font-medium text-slate-800">—</p>
          </div>
          <div>
            <p class="text-xs font-semibold text-slate-400 uppercase tracking-wide mb-1">Country</p>
            <p id="detailShippingCountry" class="text-sm font-medium text-slate-800">—</p>
          </div>
        </div>
      </div>

    </div><!-- /pageContent -->
  </div>

  <!-- Edit Lead Modal -->
  <div id="editLeadModal" class="hidden fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-xl shadow-2xl max-w-3xl w-full max-h-[90vh] overflow-y-auto">
      <div class="sticky top-0 bg-white border-b border-slate-200 px-6 py-4 flex items-center justify-between">
        <h2 class="text-xl font-bold text-slate-800">Edit Lead</h2>
        <button id="closeEditModalBtn" class="p-2 hover:bg-slate-100 rounded-lg transition-colors">
          <svg class="w-5 h-5 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>

      <form id="editLeadForm" class="p-6 space-y-6">
        <input type="hidden" id="editLeadId" />
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-2">Lead Name *</label>
            <input type="text" id="editLeadName" required class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-2">Company</label>
            <input type="text" id="editCompany" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-2">Contact Person</label>
            <input type="text" id="editContactPerson" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-2">Phone Number *</label>
            <input type="tel" id="editPhoneNumber" required class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-2">Email</label>
            <input type="email" id="editEmail" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-2">Lead Source *</label>
            <select id="editSource" required class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
              <option value="">Select Lead Source</option>
              <option value="Website">Website</option>
              <option value="Referral">Referral</option>
              <option value="Cold Call">Cold Call</option>
              <option value="IndiaMart">IndiaMart</option>
              <option value="Event">Event</option>
            </select>
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-2">Status</label>
            <select id="editStatus" required class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
              <option value="New">New</option>
              <option value="Contacted">Contacted</option>
              <option value="Qualified">Qualified</option>
              <option value="Proposal Sent">Proposal Sent</option>
              <option value="Negotiation">Negotiation</option>
              <option value="Converted">Converted</option>
              <option value="Lost">Lost</option>
            </select>
          </div>
          <div id="editAssignedToContainer">
            <label class="block text-sm font-medium text-slate-700 mb-2">Assign To</label>
            <select id="editAssignedTo" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
              <option value="">Unassigned</option>
            </select>
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-2">Last Contacted</label>
            <input type="date" id="editLastContacted" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-2">Next Follow-up</label>
            <input type="date" id="editNextFollowUp" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
          </div>
        </div>
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-2">Notes / Requirements</label>
          <textarea id="editNotes" rows="4" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" placeholder="Additional notes..."></textarea>
        </div>
        <div class="flex gap-3 justify-end pt-4 border-t border-slate-200">
          <button type="button" id="cancelEditBtn" class="px-6 py-2.5 bg-white border border-slate-300 text-slate-700 text-sm font-medium rounded-md hover:bg-slate-50 transition-colors">Cancel</button>
          <button type="submit" id="saveEditBtn" class="px-6 py-2.5 bg-indigo-600 text-white text-sm font-medium rounded-md hover:bg-indigo-700 transition-colors disabled:opacity-50">Save Changes</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Send Quote Modal -->
  <div id="sendQuoteModal" class="hidden fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-xl shadow-2xl max-w-lg w-full max-h-[90vh] overflow-y-auto">
      <div class="sticky top-0 bg-white border-b border-slate-200 px-6 py-4 flex items-center justify-between">
        <h2 class="text-xl font-bold text-slate-800">Send Quote</h2>
        <button id="closeSendQuoteBtn" class="p-2 hover:bg-slate-100 rounded-lg transition-colors">
          <svg class="w-5 h-5 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>

      <div class="p-6 space-y-5">
        <!-- Checking for an existing account -->
        <div id="sendQuoteChecking" class="py-8 text-center">
          <svg class="animate-spin w-6 h-6 text-indigo-600 mx-auto mb-3" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          <p class="text-sm text-slate-500">Checking for an existing account…</p>
        </div>

        <div id="sendQuoteBody" class="hidden space-y-5">
          <!-- Existing account matched -->
          <div id="sendQuoteMatch" class="hidden p-4 bg-amber-50 border border-amber-200 rounded-lg">
            <p id="sendQuoteMatchTitle" class="text-sm font-semibold text-amber-900 mb-1">An account already exists</p>
            <p id="sendQuoteMatchText" class="text-xs text-amber-800 leading-relaxed"></p>
            <!-- Enough of the matched account to tell whether it is really the
                 same company, since a shared switchboard number is not proof. -->
            <div id="sendQuoteMatchDetails" class="hidden mt-3 space-y-1.5 p-3 bg-white/70 border border-amber-200 rounded-md"></div>
            <button type="button" id="sendQuoteOverrideBtn"
              class="hidden mt-3 text-xs font-semibold text-amber-900 underline underline-offset-2 hover:text-amber-950">
              Not the same company — create a new account instead
            </button>
          </div>

          <!-- New prospect account will be created -->
          <div id="sendQuoteNew" class="hidden space-y-4">
            <p class="text-sm text-slate-600 leading-relaxed">
              A <span class="font-semibold text-slate-800">Prospect</span> account will be created from this lead so the
              quote has something to attach to. It stays out of the accounts list until the deal is won.
            </p>
            <div id="sendQuotePreview" class="space-y-2 p-4 bg-slate-50 border border-slate-200 rounded-lg"></div>
            <div>
              <label for="sendQuoteGst" class="block text-sm font-medium text-slate-700 mb-2">
                GST No <span class="text-slate-400 font-normal">(printed on the quote PDF)</span>
              </label>
              <input type="text" id="sendQuoteGst" placeholder="e.g. 07AABCU9603R1ZM"
                class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
              <p class="text-xs text-slate-500 mt-1.5">Leave blank if the buyer has not shared it yet — you can add it to the account later.</p>
            </div>
          </div>

          <div id="sendQuoteError" class="hidden p-4 bg-red-50 border border-red-200 rounded-lg text-sm text-red-800"></div>
        </div>
      </div>

      <div id="sendQuoteFooter" class="hidden sticky bottom-0 bg-white border-t border-slate-200 px-6 py-4 flex gap-3 justify-end">
        <button type="button" id="cancelSendQuoteBtn" class="px-6 py-2.5 bg-white border border-slate-300 text-slate-700 text-sm font-medium rounded-md hover:bg-slate-50 transition-colors">Cancel</button>
        <button type="button" id="confirmSendQuoteBtn" class="px-6 py-2.5 bg-indigo-600 text-white text-sm font-medium rounded-md hover:bg-indigo-700 transition-colors disabled:opacity-50 flex items-center gap-2">Continue to Quote</button>
      </div>
    </div>
  </div>

  <!-- Toast Container -->
  <div id="toastContainer" class="fixed top-4 right-4 z-[9999] flex flex-col gap-2 pointer-events-none"></div>

  <!-- Confirm Dialog -->
  <div id="confirmDialog" class="hidden fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-[9998] flex items-center justify-center p-4">
    <div class="bg-white rounded-xl shadow-2xl w-full max-w-sm p-6">
      <p class="text-slate-800 font-semibold text-sm mb-5" id="confirmMessage"></p>
      <div class="flex gap-3 justify-end">
        <button id="confirmCancelBtn" class="px-4 py-2 bg-white border border-slate-300 text-slate-700 text-sm font-medium rounded-lg hover:bg-slate-50 transition-colors">Cancel</button>
        <button id="confirmOkBtn" class="px-4 py-2 text-white text-sm font-medium rounded-lg transition-colors"></button>
      </div>
    </div>
  </div>

  <script>
    import { getToken, logout, getUserInfo } from '../lib/api';

    const API_BASE_URL = import.meta.env.PUBLIC_API_BASE_URL ||
      `${window.location.protocol}//${window.location.hostname}:8082`;
    const token = getToken();

    function showConfirm(message: string, okLabel = 'Confirm', okClass = 'bg-red-600 hover:bg-red-700'): Promise<boolean> {
      return new Promise((resolve) => {
        const dialog = document.getElementById('confirmDialog') as HTMLDivElement;
        const okBtn = document.getElementById('confirmOkBtn') as HTMLButtonElement;
        const cancelBtn = document.getElementById('confirmCancelBtn') as HTMLButtonElement;
        (document.getElementById('confirmMessage') as HTMLElement).textContent = message;
        okBtn.textContent = okLabel;
        okBtn.className = `px-4 py-2 text-white text-sm font-medium rounded-lg transition-colors ${okClass}`;
        dialog.classList.remove('hidden');
        function cleanup(result: boolean) {
          dialog.classList.add('hidden');
          okBtn.removeEventListener('click', onOk);
          cancelBtn.removeEventListener('click', onCancel);
          dialog.removeEventListener('click', onOutside);
          resolve(result);
        }
        const onOk = () => cleanup(true);
        const onCancel = () => cleanup(false);
        const onOutside = (e: MouseEvent) => { if (e.target === dialog) cleanup(false); };
        okBtn.addEventListener('click', onOk);
        cancelBtn.addEventListener('click', onCancel);
        dialog.addEventListener('click', onOutside);
      });
    }

    function showToast(message: string, type: 'success' | 'error' | 'info' = 'info') {
      const container = document.getElementById('toastContainer')!;
      const toast = document.createElement('div');
      const bg = type === 'success' ? 'bg-emerald-500' : type === 'error' ? 'bg-red-500' : 'bg-slate-700';
      const icon = type === 'success'
        ? `<svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>`
        : type === 'error'
        ? `<svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`
        : `<svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`;
      toast.setAttribute('data-toast', '');
      toast.className = `pointer-events-auto flex items-center gap-3 px-4 py-3 rounded-xl text-white text-sm font-semibold shadow-xl max-w-sm ${bg} opacity-0 translate-x-4 transition-all duration-200`;
      toast.innerHTML = `${icon}<span class="flex-1 leading-snug">${message}</span><button class="ml-2 opacity-60 hover:opacity-100 text-base leading-none transition-opacity" onclick="this.closest('[data-toast]').remove()">✕</button>`;
      container.appendChild(toast);
      requestAnimationFrame(() => requestAnimationFrame(() => {
        toast.classList.remove('opacity-0', 'translate-x-4');
      }));
      setTimeout(() => {
        toast.classList.add('opacity-0', 'translate-x-4');
        setTimeout(() => toast.remove(), 200);
      }, 3500);
    }
    if (!token) { window.location.href = '/login'; }

    function getUserRole(): string | null {
      const info = getUserInfo();
      return info ? info.role : null;
    }
    function getUserEmail(): string | null {
      return localStorage.getItem('user_email');
    }

    const urlParams = new URLSearchParams(window.location.search);
    const leadId = urlParams.get('id');

    if (!leadId) {
      showError('No lead ID provided.');
    } else {
      loadLead(leadId);
    }

    let currentLead: any = null;

    const STAGES = ['New', 'Contacted', 'Qualified', 'Proposal Sent', 'Negotiation', 'Converted'];

    function renderPipelineTrack(currentStatus: string) {
      const track = document.getElementById('pipelineTrack');
      if (!track) return;
      const currentIdx = STAGES.indexOf(currentStatus);

      track.innerHTML = STAGES.map((stage, i) => {
        const isPast    = currentIdx > 0 && i < currentIdx;
        const isCurrent = i === currentIdx;

        let nodeClass: string;
        let icon: string;
        let labelClass: string;

        if (isPast) {
          nodeClass  = 'bg-indigo-600 border-indigo-600 text-white hover:bg-indigo-700 hover:scale-105 cursor-pointer';
          icon       = `<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>`;
          labelClass = 'text-slate-500 font-medium';
        } else if (isCurrent) {
          nodeClass  = 'bg-indigo-600 border-indigo-600 text-white ring-4 ring-indigo-100 scale-110 shadow-md shadow-indigo-200/60 cursor-default';
          icon       = `<div class="w-2.5 h-2.5 rounded-full bg-white"></div>`;
          labelClass = 'text-indigo-700 font-bold';
        } else {
          nodeClass  = 'bg-white border-slate-200 text-slate-300 hover:border-indigo-400 hover:text-indigo-400 hover:scale-105 cursor-pointer';
          icon       = '';
          labelClass = 'text-slate-400 font-medium';
        }

        const connectorFilled = i < currentIdx;
        const connector = i < STAGES.length - 1
          ? `<div class="flex-1 h-0.5 mt-4 mx-1 transition-colors duration-300 ${connectorFilled ? 'bg-indigo-400' : 'bg-slate-200'}"></div>`
          : '';

        return `
          <div class="flex flex-col items-center flex-shrink-0" style="min-width:56px">
            <button class="stage-node w-8 h-8 rounded-full border-2 flex items-center justify-center transition-all duration-200 ${nodeClass}"
              data-stage="${stage}" title="${isCurrent ? 'Current stage' : `Move to ${stage}`}">
              ${icon}
            </button>
            <span class="text-xs mt-1.5 text-center leading-tight ${labelClass}" style="max-width:64px">${stage}</span>
          </div>${connector}`;
      }).join('');

      track.querySelectorAll<HTMLButtonElement>('.stage-node').forEach(btn => {
        btn.addEventListener('click', () => {
          const stage = btn.dataset.stage!;
          if (stage !== currentStatus) changeStatus(stage);
        });
      });
    }

    // A lead that has been quoted owns a Prospect account (see the Send Quote
    // flow below). When the lead reaches an end state that account has to follow
    // it, otherwise a won deal stays invisible in the accounts list and a lost
    // one is indistinguishable from a live prospect.
    //
    // Every path that changes lead status routes through changeStatus(), so this
    // is the single place that decides what a status means for the account.
    const ACCOUNT_TYPE_FOR_STATUS: Record<string, string> = {
      'Converted': 'Customer',
      'Lost': 'Lost Prospect',
    };

    // Which account a quoted lead owns is recorded on the lead itself, in the
    // "Converted To Account" link written at handoff. Inferring it from the phone
    // number instead went wrong two ways: two companies sharing a switchboard
    // resolved to one another's account, and editing a lead's phone after the
    // quote went out silently severed the connection.
    function linkedAccountId(): string | null {
      const link = currentLead?.fields?.['Converted To Account'];
      return link && link.id != null ? String(link.id) : null;
    }

    async function fetchAccountById(accountId: string): Promise<any | null> {
      try {
        const res = await fetch(
          `${API_BASE_URL}/proxy/accounts_duplicate/records/${accountId}?fields=Account Name,Company Name,Account Type`,
          { headers: { 'Authorization': `Bearer ${token}` } }
        );
        if (!res.ok) return null;
        return await res.json();
      } catch {
        return null;
      }
    }

    async function syncAccountToLeadStatus(newStatus: string) {
      const nextType = ACCOUNT_TYPE_FOR_STATUS[newStatus];
      if (!nextType || !currentLead) return;

      const accountId = linkedAccountId();
      if (!accountId) return; // lead was never quoted — nothing to sync

      const account = await fetchAccountById(accountId);
      if (!account) {
        // The link exists but the account behind it no longer resolves — most
        // likely deleted. Say so rather than failing quietly, since the lead's
        // outcome has already saved.
        showToast('Lead updated, but its linked account could not be read.', 'error');
        return;
      }

      const currentType = ((account.fields || {})['Account Type'] || '').trim();
      // Only accounts this flow created may be relabelled. If the salesperson
      // picked an established Customer or Dealer at handoff, the link points at
      // it, and it must not be demoted just because this deal went cold.
      if (currentType !== 'Prospect' && currentType !== 'Lost Prospect') return;
      if (currentType === nextType) return;

      try {
        const res = await fetch(`${API_BASE_URL}/proxy/accounts_duplicate/records`, {
          method: 'PATCH',
          headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: accountId, fields: { 'Account Type': nextType } })
        });
        if (!res.ok) throw new Error('PATCH failed');
        if (nextType === 'Customer') {
          showToast('Account promoted to Customer.', 'success');
        }
      } catch {
        // The lead status itself already saved; surface the partial failure
        // rather than rolling back, so the user knows to fix the account.
        showToast('Lead updated, but the linked account could not be updated.', 'error');
      }
    }

    async function changeStatus(newStatus: string) {
      if (!currentLead) return;
      const oldStatus = currentLead.fields?.['Status'] || 'New';

      // Optimistic
      currentLead.fields['Status'] = newStatus;
      renderPipelineTrack(newStatus);
      const lostBadge = document.getElementById('detailLostBadge')!;
      lostBadge.classList.toggle('hidden', newStatus !== 'Lost');
      lostBadge.classList.toggle('inline-flex', newStatus === 'Lost');
      updateOutcomeButtons(newStatus);

      try {
        const res = await fetch(`${API_BASE_URL}/proxy/leads/records`, {
          method: 'PATCH',
          headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: currentLead.id, fields: { 'Status': newStatus } })
        });
        if (!res.ok) throw new Error('PATCH failed');
      } catch {
        currentLead.fields['Status'] = oldStatus;
        renderPipelineTrack(oldStatus);
        lostBadge.classList.toggle('hidden', oldStatus !== 'Lost');
        lostBadge.classList.toggle('inline-flex', oldStatus === 'Lost');
        updateOutcomeButtons(oldStatus);
        showToast('Failed to update status. Please try again.', 'error');
        return;
      }

      await syncAccountToLeadStatus(newStatus);
    }

    // Won/Lost/Send Quote only apply while the lead is still in play.
    function updateOutcomeButtons(status: string) {
      const settled = status === 'Lost' || status === 'Converted';
      for (const id of ['sendQuoteBtn', 'markWonBtn', 'markLostBtn']) {
        const el = document.getElementById(id);
        if (!el) continue;
        el.classList.toggle('hidden', settled);
        el.classList.toggle('flex', !settled);
      }
    }

    const fmt = (dateStr: string) => {
      if (!dateStr) return '';
      const d = new Date(dateStr);
      return d.toLocaleDateString('en-IN', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'Asia/Kolkata' });
    };

    const statusColors: Record<string, string> = {
      'New': 'bg-blue-100 text-blue-800',
      'Contacted': 'bg-cyan-100 text-cyan-800',
      'Qualified': 'bg-teal-100 text-teal-800',
      'Proposal Sent': 'bg-purple-100 text-purple-800',
      'Negotiation': 'bg-orange-100 text-orange-800',
      'Converted': 'bg-green-100 text-green-800',
      'Lost': 'bg-red-100 text-red-800',
    };
    const sourceColors: Record<string, string> = {
      'Website': 'bg-blue-100 text-blue-800',
      'Referral': 'bg-cyan-100 text-cyan-800',
      'Cold Call': 'bg-teal-100 text-teal-800',
      'IndiaMart': 'bg-pink-100 text-pink-800',
      'Event': 'bg-red-100 text-red-800',
    };

    async function loadLead(id: string) {
      try {
        const res = await fetch(`${API_BASE_URL}/proxy/leads/records/${id}`, {
          headers: { 'Authorization': `Bearer ${token}` }
        });

        if (res.status === 401) { logout(); return; }
        if (!res.ok) throw new Error(`Failed to load lead (${res.status})`);

        const data = await res.json();
        currentLead = data;
        populatePage(data);
      } catch (err: any) {
        showError(err.message || 'Failed to load lead.');
      }
    }

    async function loadUsersForEdit() {
      try {
        const res = await fetch(`${API_BASE_URL}/api/admin/users`, {
          headers: { 'Authorization': `Bearer ${token}` }
        });
        if (!res.ok) return;
        const data = await res.json();
        const select = document.getElementById('editAssignedTo') as HTMLSelectElement;
        (data.users || []).forEach((u: any) => {
          const opt = document.createElement('option');
          opt.value = u.email;
          opt.textContent = `${u.name} (${u.email})`;
          select.appendChild(opt);
        });
      } catch { /* silently ignore */ }
    }

    function populatePage(lead: any) {
      const f = lead.fields || {};
      const userRole = getUserRole();
      const userEmail = getUserEmail();

      const set = (id: string, val: string | undefined) => {
        const el = document.getElementById(id);
        if (el) el.textContent = val || '—';
      };

      // Header
      set('detailLeadName', f['Lead Name']);
      const company = f['Company'] || '';
      const companyEl = document.getElementById('detailCompany')!;
      companyEl.textContent = company;
      companyEl.classList.toggle('hidden', !company);

      const status = f['Status'] || 'New';

      // Show Lost badge or pipeline track
      const lostBadge = document.getElementById('detailLostBadge')!;
      if (status === 'Lost') {
        lostBadge.classList.remove('hidden');
        lostBadge.classList.add('inline-flex');
      } else {
        lostBadge.classList.add('hidden');
      }
      renderPipelineTrack(status);

      const sourceEl = document.getElementById('detailSource')!;
      const source = f['Source'] || '';
      if (source) {
        sourceEl.textContent = source;
        sourceEl.className = `inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-semibold ${sourceColors[source] || 'bg-slate-100 text-slate-800'}`;
      } else {
        sourceEl.classList.add('hidden');
      }

      updateOutcomeButtons(status);

      // Delete button: admin only
      if (userRole === 'admin') {
        document.getElementById('deleteLeadBtn')!.classList.remove('hidden');
        document.getElementById('deleteLeadBtn')!.classList.add('flex');
      }

      // Contact
      set('detailContactPerson', f['Contact Person']);
      set('detailPhone', f['Phone Number']);
      const phone2 = f['Phone Number 2'];
      const phone3 = f['Phone Number 3'];
      if (phone2) { const el = document.getElementById('detailPhone2')!; el.textContent = phone2; el.classList.remove('hidden'); }
      if (phone3) { const el = document.getElementById('detailPhone3')!; el.textContent = phone3; el.classList.remove('hidden'); }
      set('detailEmail', f['Email']);
      set('detailAssignedTo', f['Assigned to'] || undefined);
      set('detailCreatedBy', f['Lead Created By'] || undefined);

      // Activity
      set('detailLastContacted', fmt(f['Last Contacted']) || undefined);

      const fuEl = document.getElementById('detailNextFollowUp')!;
      const fuDate = f['Next Follow-up'];
      if (fuDate) {
        const isOverdue = new Date(fuDate) < new Date();
        fuEl.textContent = fmt(fuDate);
        fuEl.className = `text-sm font-medium ${isOverdue ? 'text-red-600' : 'text-slate-800'}`;
      }

      // Push Log: array of { by, at } recorded each time +1 Day is used on the leads list
      const rawPushLog = f['Push Log'];
      const pushLog = Array.isArray(rawPushLog)
        ? rawPushLog
        : (typeof rawPushLog === 'string' ? (() => { try { const p = JSON.parse(rawPushLog); return Array.isArray(p) ? p : []; } catch { return []; } })() : []);
      if (pushLog.length > 0) {
        const sorted = [...pushLog].sort((a: any, b: any) => new Date(b.at).getTime() - new Date(a.at).getTime());
        document.getElementById('detailPushLogList')!.innerHTML = sorted.map((e: any) => {
          const initials = (e.by || '?').slice(0, 2).toUpperCase();
          const when = e.at
            ? new Date(e.at).toLocaleString('en-IN', { day: 'numeric', month: 'short', year: 'numeric', hour: 'numeric', minute: '2-digit' })
            : 'Unknown time';
          return `
            <div class="flex items-start gap-2.5">
              <div class="w-7 h-7 rounded-full bg-violet-100 text-violet-700 flex items-center justify-center text-[10px] font-bold flex-shrink-0">${initials}</div>
              <div class="min-w-0">
                <p class="text-xs font-semibold text-slate-700 truncate">${e.by}</p>
                <p class="text-xs text-slate-400">${when}</p>
              </div>
            </div>`;
        }).join('');
        document.getElementById('detailPushLogRow')!.classList.remove('hidden');
      }

      // Notes
      const notes = f['Notes'] || '';
      if (notes) {
        (document.getElementById('detailNotes') as HTMLElement).textContent = notes;
        document.getElementById('detailNotesCard')!.classList.remove('hidden');
      }

      // Billing
      const hasBilling = f['Billing Street'] || f['Billing City'] || f['Billing State'];
      if (hasBilling) {
        set('detailBillingStreet', f['Billing Street']);
        set('detailBillingCity', f['Billing City']);
        set('detailBillingState', f['Billing State']);
        set('detailBillingCode', f['Billing Code']);
        set('detailBillingCountry', f['Billing Country']);
        document.getElementById('detailBillingCard')!.classList.remove('hidden');
      }

      // Shipping
      const hasShipping = f['Shipping Street'] || f['Shipping City'] || f['Shipping State'];
      if (hasShipping) {
        set('detailShippingStreet', f['Shipping Street']);
        set('detailShippingCity', f['Shipping City']);
        set('detailShippingState', f['Shipping State']);
        set('detailShippingCode', f['Shipping Code']);
        set('detailShippingCountry', f['Shipping Country']);
        document.getElementById('detailShippingCard')!.classList.remove('hidden');
      }

      document.getElementById('pageLoading')!.classList.add('hidden');
      document.getElementById('pageContent')!.classList.remove('hidden');
    }

    // --- Edit Modal ---
    function openEditModal() {
      if (!currentLead) return;
      const f = currentLead.fields || {};
      const userRole = getUserRole();

      (document.getElementById('editLeadId') as HTMLInputElement).value = currentLead.id;
      (document.getElementById('editLeadName') as HTMLInputElement).value = f['Lead Name'] || '';
      (document.getElementById('editCompany') as HTMLInputElement).value = f['Company'] || '';
      (document.getElementById('editContactPerson') as HTMLInputElement).value = f['Contact Person'] || '';
      (document.getElementById('editPhoneNumber') as HTMLInputElement).value = f['Phone Number'] || '';
      (document.getElementById('editEmail') as HTMLInputElement).value = f['Email'] || '';
      (document.getElementById('editSource') as HTMLSelectElement).value = f['Source'] || '';
      (document.getElementById('editStatus') as HTMLSelectElement).value = f['Status'] || 'New';
      (document.getElementById('editAssignedTo') as HTMLSelectElement).value = f['Assigned to'] || '';
      (document.getElementById('editLastContacted') as HTMLInputElement).value = f['Last Contacted'] || '';
      (document.getElementById('editNextFollowUp') as HTMLInputElement).value = f['Next Follow-up'] || '';
      (document.getElementById('editNotes') as HTMLTextAreaElement).value = f['Notes'] || '';

      const assignedSelect = document.getElementById('editAssignedTo') as HTMLSelectElement;
      if (userRole !== 'admin') {
        assignedSelect.disabled = true;
        assignedSelect.classList.add('bg-slate-200', 'cursor-not-allowed');
      } else {
        assignedSelect.disabled = false;
        assignedSelect.classList.remove('bg-slate-200', 'cursor-not-allowed');
      }

      document.getElementById('editLeadModal')!.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }

    function closeEditModal() {
      document.getElementById('editLeadModal')!.classList.add('hidden');
      document.body.style.overflow = 'auto';
    }

    document.getElementById('editLeadDetailBtn')!.addEventListener('click', openEditModal);
    document.getElementById('closeEditModalBtn')!.addEventListener('click', closeEditModal);
    document.getElementById('cancelEditBtn')!.addEventListener('click', closeEditModal);
    document.getElementById('editLeadModal')!.addEventListener('click', (e) => {
      if (e.target === document.getElementById('editLeadModal')) closeEditModal();
    });

    document.getElementById('editLeadForm')!.addEventListener('submit', async (e) => {
      e.preventDefault();
      const saveBtn = document.getElementById('saveEditBtn') as HTMLButtonElement;
      saveBtn.disabled = true;
      saveBtn.textContent = 'Saving...';

      try {
        const payload = {
          id: (document.getElementById('editLeadId') as HTMLInputElement).value,
          fields: {
            'Lead Name': (document.getElementById('editLeadName') as HTMLInputElement).value,
            'Company': (document.getElementById('editCompany') as HTMLInputElement).value || '',
            'Contact Person': (document.getElementById('editContactPerson') as HTMLInputElement).value || '',
            'Phone Number': (document.getElementById('editPhoneNumber') as HTMLInputElement).value,
            'Email': (document.getElementById('editEmail') as HTMLInputElement).value || '',
            'Source': (document.getElementById('editSource') as HTMLSelectElement).value,
            'Status': (document.getElementById('editStatus') as HTMLSelectElement).value,
            'Assigned to': (document.getElementById('editAssignedTo') as HTMLSelectElement).value || '',
            'Last Contacted': (document.getElementById('editLastContacted') as HTMLInputElement).value || null,
            'Next Follow-up': (document.getElementById('editNextFollowUp') as HTMLInputElement).value || null,
            'Notes': (document.getElementById('editNotes') as HTMLTextAreaElement).value || '',
          }
        };

        const res = await fetch(`${API_BASE_URL}/proxy/leads/records`, {
          method: 'PATCH',
          headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        if (!res.ok) throw new Error('Failed to save changes');

        closeEditModal();
        // Reload the page data to reflect changes
        await loadLead(leadId as string);
      } catch (err: any) {
        showToast(err.message || 'Failed to save changes', 'error');
      } finally {
        saveBtn.disabled = false;
        saveBtn.textContent = 'Save Changes';
      }
    });

    // --- Delete ---
    document.getElementById('deleteLeadBtn')!.addEventListener('click', async () => {
      if (!currentLead) return;
      const name = currentLead.fields?.['Lead Name'] || 'this lead';
      if (!await showConfirm(`Delete "${name}"? This cannot be undone.`, 'Delete')) return;

      try {
        const res = await fetch(`${API_BASE_URL}/proxy/leads/records`, {
          method: 'DELETE',
          headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: currentLead.id })
        });
        if (!res.ok) throw new Error('Failed to delete lead');
        window.location.href = '/leads';
      } catch (err: any) {
        showToast(err.message || 'Failed to delete lead', 'error');
      }
    });

    // --- Mark as Won / Mark as Lost ---
    // Both delegate to changeStatus() so the linked account is kept in step by
    // the same code that handles the pipeline track.
    document.getElementById('markWonBtn')!.addEventListener('click', async () => {
      if (!currentLead) return;
      if (currentLead.fields?.['Status'] === 'Converted') return;
      const name = currentLead.fields?.['Lead Name'] || 'this lead';
      if (!await showConfirm(
        `Mark "${name}" as Won? Its account becomes a Customer and appears in the accounts list.`,
        'Mark as Won', 'bg-emerald-600 hover:bg-emerald-700')) return;
      await changeStatus('Converted');
    });

    document.getElementById('markLostBtn')!.addEventListener('click', async () => {
      if (!currentLead) return;
      if (currentLead.fields?.['Status'] === 'Lost') return;
      const name = currentLead.fields?.['Lead Name'] || 'this lead';
      if (!await showConfirm(`Mark "${name}" as Lost?`, 'Mark as Lost', 'bg-orange-600 hover:bg-orange-700')) return;
      await changeStatus('Lost');
    });

    // --- Send Quote (lead → prospect account → quote) ---
    //
    // A quote cannot hang off a lead: the Cases junction links quotes to
    // Accounts Duplicate, and the PDF reads GST and the billing address from
    // the account. So quoting a lead first materialises it as an account marked
    // "Prospect", then hands off to the existing create-quote flow. On a won
    // deal the Account Type flips to Customer — no data is copied or migrated.
    const sendQuoteModal = document.getElementById('sendQuoteModal') as HTMLDivElement;
    const sendQuoteChecking = document.getElementById('sendQuoteChecking') as HTMLDivElement;
    const sendQuoteBody = document.getElementById('sendQuoteBody') as HTMLDivElement;
    const sendQuoteFooter = document.getElementById('sendQuoteFooter') as HTMLDivElement;
    const sendQuoteMatchBox = document.getElementById('sendQuoteMatch') as HTMLDivElement;
    const sendQuoteNewBox = document.getElementById('sendQuoteNew') as HTMLDivElement;
    const sendQuoteErrorBox = document.getElementById('sendQuoteError') as HTMLDivElement;
    const confirmSendQuoteBtn = document.getElementById('confirmSendQuoteBtn') as HTMLButtonElement;

    // The account this quote will be raised against, when one already exists:
    // either the one this lead was quoted against before (authoritative), or a
    // phone-number match on an account the lead may or may not actually belong to
    // (a guess, and labelled as one in the modal).
    let matchedAccount: any = null;

    async function findAccountByPhone(phone: string): Promise<any | null> {
      const trimmed = (phone || '').trim();
      if (!trimmed) return null;
      try {
        const where = encodeURIComponent(`(Phone Number,eq,${trimmed})`);
        const res = await fetch(
          `${API_BASE_URL}/proxy/accounts_duplicate/records?where=${where}&limit=1&fields=Account Name,Company Name,Account Type,GST No,Billing City`,
          { headers: { 'Authorization': `Bearer ${token}` } }
        );
        if (!res.ok) return null;
        const data = await res.json();
        const records = data.records || data.list || [];
        return records[0] || null;
      } catch {
        // A failed lookup must not block quoting — worst case we create a
        // duplicate account, which is recoverable; a hard block is not.
        return null;
      }
    }

    // Writes the Leads → "Accounts duplicate" one-to-one link. Underscores in the
    // alias are what the proxy's link resolver expects; it maps them back to the
    // field title.
    async function linkAccountToLead(accountId: string) {
      const res = await fetch(
        `${API_BASE_URL}/proxy/leads/links/Converted_To_Account/${currentLead.id}`,
        {
          method: 'POST',
          headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: Number(accountId) })
        }
      );
      if (!res.ok) {
        throw new Error(`The account was ready but could not be linked to this lead: ${await res.text()}`);
      }
    }

    async function openSendQuoteModal() {
      if (!currentLead) return;
      const f = currentLead.fields || {};

      matchedAccount = null;
      sendQuoteErrorBox.classList.add('hidden');
      sendQuoteMatchBox.classList.add('hidden');
      sendQuoteNewBox.classList.add('hidden');
      sendQuoteBody.classList.add('hidden');
      sendQuoteFooter.classList.add('hidden');
      sendQuoteChecking.classList.remove('hidden');
      sendQuoteModal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';

      // A lead that has been quoted before already owns an account: reuse that
      // one outright. Only a lead with no account yet falls back to searching by
      // phone, so a re-quote can neither spawn a duplicate nor drift onto a
      // different company that happens to share the number.
      const linkedId = linkedAccountId();
      matchedAccount = linkedId ? await fetchAccountById(linkedId) : null;
      const isLinked = !!matchedAccount;
      if (!matchedAccount) matchedAccount = await findAccountByPhone(f['Phone Number']);

      sendQuoteChecking.classList.add('hidden');
      sendQuoteBody.classList.remove('hidden');
      sendQuoteFooter.classList.remove('hidden');

      if (matchedAccount) {
        const mf = matchedAccount.fields || {};
        const name = mf['Account Name'] || mf['Company Name'] || 'An existing account';
        (document.getElementById('sendQuoteMatchTitle') as HTMLElement).textContent =
          isLinked ? 'This lead already has an account' : 'An account already exists';
        (document.getElementById('sendQuoteMatchText') as HTMLElement).innerHTML = isLinked
          ? `This lead was already quoted against <span class="font-semibold">${name}</span>.
             The new quote will be raised against the same account.`
          : `<span class="font-semibold">${name}</span> has the same phone number as this lead.
             Check it is the same company before continuing — the quote will be addressed to it,
             using its GST number and billing address.`;

        // Only a phone-number guess may be overridden. A lead that was already
        // quoted must keep its account, otherwise re-quoting would fork it into a
        // second record and the Won/Lost outcome would land on only one of them.
        const details = document.getElementById('sendQuoteMatchDetails') as HTMLElement;
        const overrideBtn = document.getElementById('sendQuoteOverrideBtn') as HTMLElement;
        if (isLinked) {
          details.classList.add('hidden');
          overrideBtn.classList.add('hidden');
        } else {
          details.innerHTML = [
            matchRow('Account Name', mf['Account Name']),
            matchRow('Company Name', mf['Company Name']),
            matchRow('GST No', mf['GST No']),
            matchRow('Billing City', mf['Billing City']),
            matchRow('Type', mf['Account Type']),
          ].join('');
          details.classList.remove('hidden');
          overrideBtn.classList.remove('hidden');
        }

        sendQuoteMatchBox.classList.remove('hidden');
        confirmSendQuoteBtn.textContent = 'Use Existing & Continue';
        return;
      }

      showNewAccountForm();
    }

    const matchRow = (label: string, value: string) => `
      <div class="flex items-start gap-3">
        <span class="text-xs font-semibold text-amber-900/70 w-28 flex-shrink-0 pt-0.5">${label}</span>
        <span class="text-xs text-amber-950">${value || '—'}</span>
      </div>`;

    // Switches the modal to "a new Prospect account will be created". Reached
    // either because nothing matched, or because the user rejected a phone match.
    function showNewAccountForm() {
      const f = currentLead?.fields || {};

      const row = (label: string, value: string) => `
        <div class="flex items-start gap-3">
          <span class="text-xs font-semibold text-slate-500 w-32 flex-shrink-0 pt-0.5">${label}</span>
          <span class="text-xs text-slate-800">${value || '—'}</span>
        </div>`;

      (document.getElementById('sendQuotePreview') as HTMLElement).innerHTML = [
        row('Account Name', f['Lead Name'] || f['Company'] || 'Unnamed Account'),
        row('Company Name', f['Company']),
        row('Primary Contact', f['Contact Person']),
        row('Phone Number', f['Phone Number']),
        row('Email', f['Email']),
        row('Billing City', f['Billing City']),
      ].join('');
      (document.getElementById('sendQuoteGst') as HTMLInputElement).value = '';
      sendQuoteMatchBox.classList.add('hidden');
      sendQuoteNewBox.classList.remove('hidden');
      confirmSendQuoteBtn.textContent = 'Create Account & Continue';
    }

    function closeSendQuoteModal() {
      sendQuoteModal.classList.add('hidden');
      document.body.style.overflow = 'auto';
    }

    async function performQuoteHandoff() {
      if (!currentLead) return;
      const f = currentLead.fields || {};

      confirmSendQuoteBtn.disabled = true;
      const originalLabel = confirmSendQuoteBtn.textContent;
      confirmSendQuoteBtn.innerHTML = `
        <svg class="animate-spin w-4 h-4" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        Preparing…`;
      sendQuoteErrorBox.classList.add('hidden');

      try {
        let accountId: string;
        let accountName: string;

        if (matchedAccount) {
          accountId = matchedAccount.id;
          const mf = matchedAccount.fields || {};
          accountName = mf['Account Name'] || mf['Company Name'] || 'Account';
        } else {
          accountName = f['Lead Name'] || f['Company'] || 'Unnamed Account';
          const gstNo = (document.getElementById('sendQuoteGst') as HTMLInputElement).value.trim();

          const accountFields: Record<string, string> = {
            'Account Name': accountName,
            'Company Name': f['Company'] || '',
            'Primary Contact': f['Contact Person'] || '',
            'Email 1': f['Email'] || '',
            'Phone Number': f['Phone Number'] || '',
            'Phone Number 2': f['Phone Number 2'] || '',
            'Phone Number 3': f['Phone Number 3'] || '',
            'GST No': gstNo,
            'Source': f['Source'] || '',
            // Marks this as a not-yet-won account so the accounts list can keep
            // it hidden until the deal closes.
            'Account Type': 'Prospect',
            'Description': f['Notes'] ? `Prospect from Lead: ${f['Notes']}` : 'Prospect from Lead',
            'Billing Street': f['Billing Street'] || '',
            'Billing City': f['Billing City'] || '',
            'Billing State': f['Billing State'] || '',
            'Billing Code': f['Billing Code'] || '',
            'Billing Country': f['Billing Country'] || '',
            'Shipping Street': f['Shipping Street'] || '',
            'Shipping City': f['Shipping City'] || '',
            'Shipping State': f['Shipping State'] || '',
            'Shipping Code': f['Shipping Code'] || '',
            'Shipping Country': f['Shipping Country'] || '',
            // Owner-scoped server-side; without this the creator cannot see it.
            'Handled By': f['Assigned to'] || f['Lead Created By'] || getUserEmail() || '',
          };

          const res = await fetch(`${API_BASE_URL}/proxy/accounts_duplicate/records`, {
            method: 'POST',
            headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
            body: JSON.stringify({ fields: accountFields })
          });
          if (!res.ok) throw new Error(`Failed to create account: ${await res.text()}`);

          const result = await res.json();
          accountId = result.records ? result.records[0]?.id : result.id;
          if (!accountId) throw new Error('Account was created but no id came back');
        }

        // Record which account this lead was quoted against, before handing off.
        // Won/Lost promotion and any later re-quote both read this link, so if it
        // is not written the lead is quoted but orphaned — better to surface that
        // here and let the user retry (which reuses the same account) than to let
        // it fail silently weeks later when the deal closes.
        await linkAccountToLead(accountId);

        // Hand off to the existing quote flow, which prefills from these params.
        // The lead is NOT advanced to "Proposal Sent" here: the user can still
        // abandon the quote form, and a lead claiming a proposal was sent when
        // none was is worse than a lead left a stage behind. create-quote moves
        // it once the quote actually exists (that is what fromLead is for).
        window.location.href =
          `/create-quote?accountId=${accountId}&accountName=${encodeURIComponent(accountName)}` +
          `&fromLead=${currentLead.id}`;
      } catch (err: any) {
        confirmSendQuoteBtn.disabled = false;
        confirmSendQuoteBtn.textContent = originalLabel;
        sendQuoteErrorBox.textContent = err.message || 'Could not prepare the quote. Please try again.';
        sendQuoteErrorBox.classList.remove('hidden');
      }
    }

    // Rejecting the phone match drops it entirely, so the handoff takes the
    // create-a-new-account path exactly as if nothing had matched.
    document.getElementById('sendQuoteOverrideBtn')!.addEventListener('click', () => {
      matchedAccount = null;
      showNewAccountForm();
    });

    document.getElementById('sendQuoteBtn')!.addEventListener('click', openSendQuoteModal);
    document.getElementById('closeSendQuoteBtn')!.addEventListener('click', closeSendQuoteModal);
    document.getElementById('cancelSendQuoteBtn')!.addEventListener('click', closeSendQuoteModal);
    confirmSendQuoteBtn.addEventListener('click', performQuoteHandoff);
    sendQuoteModal.addEventListener('click', (e) => {
      if (e.target === sendQuoteModal) closeSendQuoteModal();
    });

    function showError(msg: string) {
      document.getElementById('pageLoading')!.classList.add('hidden');
      const el = document.getElementById('pageError')!;
      el.textContent = msg;
      el.classList.remove('hidden');
    }

    loadUsersForEdit();
  </script>
</AdminLayout>
