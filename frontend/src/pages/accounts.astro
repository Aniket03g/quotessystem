---

import AdminLayout from '../layouts/AdminLayout.astro';

---



<AdminLayout title="Accounts" currentPage="accounts">

  <!-- Page Header with Stats -->
  <div class="mb-8">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
      <div>
        <h1 class="text-3xl font-bold text-slate-900 mb-1">Accounts</h1>
        <p class="text-slate-600">Manage your customer accounts and relationships</p>
      </div>
      <div>
        <a href="/add-account" class="inline-flex items-center gap-2 px-5 py-3 bg-gradient-to-r from-blue-600 to-blue-700 text-white rounded-xl hover:from-blue-700 hover:to-blue-800 transition-all shadow-lg shadow-blue-500/30 hover:shadow-xl hover:shadow-blue-500/40 font-semibold">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
          </svg>
          Add Account
        </a>
      </div>
    </div>

    <!-- Stats Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="bg-gradient-to-br from-blue-50 to-blue-100 border border-blue-200 rounded-xl p-4">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm font-medium text-blue-700 mb-1">Total Accounts</p>
            <p class="text-2xl font-bold text-blue-900" id="totalCount">0</p>
          </div>
          <div class="w-12 h-12 bg-blue-600 rounded-lg flex items-center justify-center">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
            </svg>
          </div>
        </div>
      </div>
      <div class="bg-gradient-to-br from-green-50 to-green-100 border border-green-200 rounded-xl p-4">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm font-medium text-green-700 mb-1">Active</p>
            <p class="text-2xl font-bold text-green-900" id="activeCount">0</p>
          </div>
          <div class="w-12 h-12 bg-green-600 rounded-lg flex items-center justify-center">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Search & Filter Bar -->
  <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 mb-6">
    <div class="flex flex-col lg:flex-row gap-3 items-start lg:items-center">
      <!-- Search -->
      <div class="flex-1 relative w-full">
        <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-slate-400 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
        <input
          type="text"
          id="searchInput"
          placeholder="Search by account name..."
          class="w-full pl-12 pr-4 py-3 bg-slate-50 border-2 border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 focus:bg-white transition-all"
          autocomplete="off"
        />
      </div>

      <!-- Account Type filter -->
      <select id="typeFilter" class="px-3 py-3 bg-slate-50 border-2 border-slate-200 rounded-xl text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all min-w-[150px]">
        <option value="">All Types</option>
      </select>

      <!-- State filter -->
      <select id="stateFilter" class="px-3 py-3 bg-slate-50 border-2 border-slate-200 rounded-xl text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all min-w-[160px]">
        <option value="">All States</option>
      </select>

      <!-- Sort -->
      <select id="sortBy" class="px-3 py-3 bg-slate-50 border-2 border-slate-200 rounded-xl text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all min-w-[170px]">
        <option value="">Sort: Default</option>
        <option value="name-asc">Name A → Z</option>
        <option value="name-desc">Name Z → A</option>
        <option value="state-asc">State A → Z</option>
      </select>

      <!-- Reset -->
      <button id="resetFilters" class="px-4 py-3 text-sm text-slate-600 border-2 border-slate-200 bg-slate-50 rounded-xl hover:bg-slate-100 transition-colors whitespace-nowrap">
        Reset
      </button>
    </div>
    <div class="flex items-center gap-2 mt-3">
      <div id="searchSpinner" class="hidden animate-spin w-4 h-4 text-blue-600">
        <svg class="w-full h-full" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
      </div>
      <span id="searchStatus" class="text-sm text-slate-600 font-medium"></span>
    </div>
  </div>

  <!-- Loading State -->
  <div id="loading" class="hidden py-16 text-center">
    <svg class="animate-spin w-12 h-12 text-blue-600 mx-auto mb-4" fill="none" viewBox="0 0 24 24">
      <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
      <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
    </svg>
    <p class="text-base text-slate-600 font-medium">Loading accounts...</p>
  </div>

  <!-- Error State -->
  <div id="error" class="hidden p-6 bg-red-50 border-2 border-red-200 rounded-2xl">
    <div class="flex items-start gap-4">
      <div class="w-10 h-10 bg-red-100 rounded-full flex items-center justify-center flex-shrink-0">
        <svg class="w-5 h-5 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
      </div>
      <div>
        <h3 class="text-red-900 font-semibold mb-1">Error Loading Accounts</h3>
        <p class="text-sm text-red-700" id="errorText"></p>
      </div>
    </div>
  </div>

  <!-- Table View -->
  <div id="tableView" class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
    <div id="accountsTable" class="overflow-x-auto">
      <table class="w-full">
        <thead class="bg-gradient-to-r from-slate-50 to-slate-100 border-b-2 border-slate-200">
          <tr>
            <th class="px-6 py-4 text-left text-xs font-bold text-slate-700 uppercase tracking-wider">Account Name</th>
            <th class="px-6 py-4 text-left text-xs font-bold text-slate-700 uppercase tracking-wider">Address</th>
            <th class="px-6 py-4 text-left text-xs font-bold text-slate-700 uppercase tracking-wider">Account Type</th>
            <th class="px-6 py-4 text-left text-xs font-bold text-slate-700 uppercase tracking-wider">Contact</th>
            <th class="px-6 py-4 text-left text-xs font-bold text-slate-700 uppercase tracking-wider">Phone</th>
          </tr>
        </thead>
        <tbody id="accountsBody" class="divide-y divide-slate-100"></tbody>
      </table>
    </div>
  </div>

  <!-- Empty State -->
  <div id="emptyState" class="hidden py-20 text-center">
    <div class="w-24 h-24 bg-slate-100 rounded-full flex items-center justify-center mx-auto mb-6">
      <svg class="w-12 h-12 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
      </svg>
    </div>
    <h3 class="text-xl font-bold text-slate-700 mb-2">No accounts found</h3>
    <p class="text-slate-500 mb-6">Try adjusting your search or create a new account</p>
    <a href="/add-account" class="inline-flex items-center gap-2 px-6 py-3 bg-blue-600 text-white rounded-xl hover:bg-blue-700 transition-colors font-semibold">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
      </svg>
      Add Your First Account
    </a>
  </div>

  <script>
    import { getToken, logout, safeJsonParse } from '../lib/api';
    import { debounce } from '../utils/debounce';

    const API_BASE_URL = `http://${window.location.hostname}:8082`;

    document.addEventListener('DOMContentLoaded', async () => {
      const token = getToken();
      if (!token) { window.location.href = '/login'; return; }

      const loadingDiv = document.getElementById('loading') as HTMLDivElement;
      const errorDiv = document.getElementById('error') as HTMLDivElement;
      const accountsTable = document.getElementById('accountsTable') as HTMLDivElement;
      const accountsBody = document.getElementById('accountsBody') as HTMLTableSectionElement;
      const emptyState = document.getElementById('emptyState') as HTMLDivElement;
      const searchInput = document.getElementById('searchInput') as HTMLInputElement;
      const searchSpinner = document.getElementById('searchSpinner') as HTMLDivElement;
      const searchStatus = document.getElementById('searchStatus') as HTMLSpanElement;
      const tableView = document.getElementById('tableView') as HTMLDivElement;
      const typeFilter = document.getElementById('typeFilter') as HTMLSelectElement;
      const stateFilter = document.getElementById('stateFilter') as HTMLSelectElement;
      const sortBy = document.getElementById('sortBy') as HTMLSelectElement;
      const resetFiltersBtn = document.getElementById('resetFilters') as HTMLButtonElement;

      let allAccounts: any[] = [];
      let contactsByAccount: Record<string, string> = {};

      async function loadAll() {
        try {
          loadingDiv.classList.remove('hidden');
          tableView.classList.add('hidden');
          emptyState.classList.add('hidden');
          errorDiv.classList.add('hidden');

          const headers = { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' };

          const [accountsRes, contactsRes] = await Promise.all([
            fetch(`${API_BASE_URL}/proxy/accounts_duplicate/records`, { headers }),
            fetch(`${API_BASE_URL}/proxy/contacts/records`, { headers }),
          ]);

          if (accountsRes.status === 401) { logout(); return; }

          const [accountsData, contactsData] = await Promise.all([
            safeJsonParse(accountsRes),
            contactsRes.ok ? safeJsonParse(contactsRes) : { records: [] },
          ]);

          allAccounts = accountsData.records || [];

          // Build accountId → first contact name map
          contactsByAccount = {};
          for (const c of (contactsData.records || [])) {
            const linked = c.fields?.['Accounts duplicate'];
            if (linked?.id && !contactsByAccount[linked.id]) {
              contactsByAccount[linked.id] = c.fields?.['Name'] || '';
            }
          }

          // Deduplicate: group by GST No + billing address; same company/address imported
          // multiple times (once per contact) should appear as a single row
          const groupMap = new Map();
          for (const acc of allAccounts) {
            const f = acc.fields || {};
            const gst = (f['GST No'] || '').trim().toLowerCase();
            const addr = [f['Billing Street'], f['Billing City'], f['Billing State'], f['Billing Code']]
              .map((s: string) => (s || '').trim().toLowerCase()).join('|');
            const key = gst
              ? `${gst}|${addr}`
              : `n:${(f['Account Name'] || '').trim().toLowerCase()}|${addr}` || `id:${acc.id}`;
            if (!groupMap.has(key)) groupMap.set(key, []);
            groupMap.get(key).push(acc);
          }
          allAccounts = [];
          for (const [, group] of groupMap) {
            allAccounts.push({ ...group[0], _groupIds: group.map((a: any) => a.id).join(',') });
          }

          // Populate Type dropdown from unique values in the data
          const types = [...new Set(allAccounts.map((a: any) => a.fields?.['Account Type']).filter((t: any) => t && t !== 'Partner') as string[])].sort();
          typeFilter.innerHTML = '<option value="">All Types</option>' + types.map(t => `<option value="${t}">${t}</option>`).join('');

          // Populate State dropdown from unique values in the data
          const states = [...new Set(allAccounts.map((a: any) => a.fields?.['Billing State']).filter(Boolean) as string[])].sort();
          stateFilter.innerHTML = '<option value="">All States</option>' + states.map(s => `<option value="${s}">${s}</option>`).join('');

          applyFilters();
        } catch (error) {
          console.error('[ACCOUNT LOAD ERROR]', error);
          loadingDiv.classList.add('hidden');
          const errorTextEl = document.getElementById('errorText');
          if (errorTextEl) errorTextEl.textContent = error instanceof Error ? error.message : 'Failed to load accounts';
          errorDiv.classList.remove('hidden');
        }
      }

      function applyFilters() {
        const search = searchInput.value.trim().toLowerCase();
        const type = typeFilter.value;
        const state = stateFilter.value;
        const sort = sortBy.value;

        let result = allAccounts.filter((r: any) => {
          const f = r.fields || {};
          if (search && !(f['Account Name'] || '').toLowerCase().includes(search)) return false;
          if (type && f['Account Type'] !== type) return false;
          if (state && f['Billing State'] !== state) return false;
          return true;
        });

        if (sort === 'name-asc') result.sort((a: any, b: any) => (a.fields?.['Account Name'] || '').localeCompare(b.fields?.['Account Name'] || ''));
        else if (sort === 'name-desc') result.sort((a: any, b: any) => (b.fields?.['Account Name'] || '').localeCompare(a.fields?.['Account Name'] || ''));
        else if (sort === 'state-asc') result.sort((a: any, b: any) => (a.fields?.['Billing State'] || '').localeCompare(b.fields?.['Billing State'] || ''));

        displayResults(result);
      }

      function displayResults(records: any[]) {
        loadingDiv.classList.add('hidden');
        searchSpinner.classList.add('hidden');
        searchStatus.classList.remove('text-blue-600');
        searchStatus.textContent = `Showing ${records.length} account${records.length !== 1 ? 's' : ''}`;

        const totalCountEl = document.getElementById('totalCount');
        const activeCountEl = document.getElementById('activeCount');
        if (totalCountEl) totalCountEl.textContent = allAccounts.length.toString();
        if (activeCountEl) activeCountEl.textContent = allAccounts.length.toString();

        if (records.length === 0) {
          tableView.classList.add('hidden');
          emptyState.classList.remove('hidden');
          return;
        }

        emptyState.classList.add('hidden');
        tableView.classList.remove('hidden');

        accountsBody.innerHTML = records.map((record) => {
          const fields = record.fields || {};
          const accountName = fields['Account Name'] || 'N/A';
          const addressParts = [fields['Billing Street'], fields['Billing City'], fields['Billing State']].filter(Boolean);
          const address = addressParts.length ? addressParts.join(', ') : '<span class="text-slate-400 italic">—</span>';
          const accountType = fields['Account Type'] || '<span class="text-slate-400 italic">—</span>';
          const groupIds = (record._groupIds || String(record.id)).split(',').map(Number);
          const contactName = groupIds.map((gid: number) => contactsByAccount[gid]).find(Boolean) || '<span class="text-slate-400 italic">—</span>';
          const phone = fields['Phone Number'] || '<span class="text-slate-400 italic">—</span>';
          const groupIdsParam = record._groupIds || record.id;

          return `
            <tr data-account-id="${record.id}" class="transition-colors hover:bg-blue-50">
              <td class="px-6 py-4 text-sm text-slate-900">
                <a href="/account-detail?ids=${groupIdsParam}" class="text-blue-600 hover:text-blue-800 font-semibold hover:underline">
                  ${accountName}
                </a>
              </td>
              <td class="px-6 py-4 text-sm text-slate-700">${address}</td>
              <td class="px-6 py-4 text-sm text-slate-700">${accountType}</td>
              <td class="px-6 py-4 text-sm text-slate-700">${contactName}</td>
              <td class="px-6 py-4 text-sm text-slate-700">${phone}</td>
            </tr>
          `;
        }).join('');
      }

      searchInput.addEventListener('input', debounce(() => applyFilters(), 300));
      searchInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') applyFilters(); });
      typeFilter.addEventListener('change', () => applyFilters());
      stateFilter.addEventListener('change', () => applyFilters());
      sortBy.addEventListener('change', () => applyFilters());
      resetFiltersBtn.addEventListener('click', () => {
        searchInput.value = '';
        typeFilter.value = '';
        stateFilter.value = '';
        sortBy.value = '';
        applyFilters();
      });

      loadAll();
    });
  </script>

</AdminLayout>
