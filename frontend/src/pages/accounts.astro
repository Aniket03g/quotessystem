---

import AdminLayout from '../layouts/AdminLayout.astro';

---



<AdminLayout title="Accounts" currentPage="accounts">

  <!-- Page Header with Stats -->
  <div class="mb-8">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
      <div>
        <h1 class="text-3xl font-bold text-slate-900 mb-1">Accounts</h1>
        <p class="text-slate-600">Manage your customer accounts and relationships</p>
      </div>
      <div>
        <a href="/add-account" class="inline-flex items-center gap-2 px-5 py-3 bg-gradient-to-r from-blue-600 to-blue-700 text-white rounded-xl hover:from-blue-700 hover:to-blue-800 transition-all shadow-lg shadow-blue-500/30 hover:shadow-xl hover:shadow-blue-500/40 font-semibold">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
          </svg>
          Add Account
        </a>
      </div>
    </div>
    
    <!-- Stats Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="bg-gradient-to-br from-blue-50 to-blue-100 border border-blue-200 rounded-xl p-4">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm font-medium text-blue-700 mb-1">Total Accounts</p>
            <p class="text-2xl font-bold text-blue-900" id="totalCount">0</p>
          </div>
          <div class="w-12 h-12 bg-blue-600 rounded-lg flex items-center justify-center">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
            </svg>
          </div>
        </div>
      </div>
      <div class="bg-gradient-to-br from-green-50 to-green-100 border border-green-200 rounded-xl p-4">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm font-medium text-green-700 mb-1">Active</p>
            <p class="text-2xl font-bold text-green-900" id="activeCount">0</p>
          </div>
          <div class="w-12 h-12 bg-green-600 rounded-lg flex items-center justify-center">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
        </div>
      </div>
    </div>
  </div>



  <!-- Search Bar -->
  <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 mb-6">
    <div class="flex flex-col lg:flex-row gap-4 items-center">
      <!-- Search -->
      <div class="flex-1 relative w-full">
        <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-slate-400 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
        <input 
          type="text" 
          id="searchInput" 
          placeholder="Search by account name or ID..." 
          class="w-full pl-12 pr-4 py-3.5 bg-slate-50 border-2 border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 focus:bg-white transition-all"
          autocomplete="off"
        />
      </div>
    </div>
    <!-- Search Status -->
    <div class="flex items-center gap-2 mt-3">
      <div id="searchSpinner" class="hidden animate-spin w-4 h-4 text-blue-600">
        <svg class="w-full h-full" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
      </div>
      <span id="searchStatus" class="text-sm text-slate-600 font-medium"></span>
    </div>
  </div>



  <!-- Loading State -->
  <div id="loading" class="hidden py-16 text-center">
    <svg class="animate-spin w-12 h-12 text-blue-600 mx-auto mb-4" fill="none" viewBox="0 0 24 24">
      <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
      <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
    </svg>
    <p class="text-base text-slate-600 font-medium">Loading accounts...</p>
  </div>

  <!-- Error State -->
  <div id="error" class="hidden p-6 bg-red-50 border-2 border-red-200 rounded-2xl">
    <div class="flex items-start gap-4">
      <div class="w-10 h-10 bg-red-100 rounded-full flex items-center justify-center flex-shrink-0">
        <svg class="w-5 h-5 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
      </div>
      <div>
        <h3 class="text-red-900 font-semibold mb-1">Error Loading Accounts</h3>
        <p class="text-sm text-red-700" id="errorText"></p>
      </div>
    </div>
  </div>

  <!-- Table View -->
  <div id="tableView" class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
    <div id="accountsTable" class="overflow-x-auto">
      <table class="w-full">
        <thead class="bg-gradient-to-r from-slate-50 to-slate-100 border-b-2 border-slate-200">
          <tr>
            <th class="px-6 py-4 text-left text-xs font-bold text-slate-700 uppercase tracking-wider">#</th>
            <th class="px-6 py-4 text-left text-xs font-bold text-slate-700 uppercase tracking-wider">Account Name</th>
            <th class="px-6 py-4 text-left text-xs font-bold text-slate-700 uppercase tracking-wider">Owner</th>
            <th class="px-6 py-4 text-left text-xs font-bold text-slate-700 uppercase tracking-wider">Phone</th>
            <th class="px-6 py-4 text-left text-xs font-bold text-slate-700 uppercase tracking-wider">Industry</th>
          </tr>
        </thead>
        <tbody id="accountsBody" class="divide-y divide-slate-100"></tbody>
      </table>
    </div>
  </div>

  <!-- Empty State -->
  <div id="emptyState" class="hidden py-20 text-center">
    <div class="w-24 h-24 bg-slate-100 rounded-full flex items-center justify-center mx-auto mb-6">
      <svg class="w-12 h-12 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
      </svg>
    </div>
    <h3 class="text-xl font-bold text-slate-700 mb-2">No accounts found</h3>
    <p class="text-slate-500 mb-6">Try adjusting your search or create a new account</p>
    <a href="/add-account" class="inline-flex items-center gap-2 px-6 py-3 bg-blue-600 text-white rounded-xl hover:bg-blue-700 transition-colors font-semibold">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
      </svg>
      Add Your First Account
    </a>
  </div>





  <script>

    import { getToken, logout, safeJsonParse } from '../lib/api';

    import { debounce } from '../utils/debounce';



    const API_BASE_URL = `http://${window.location.hostname}:8082`;



    document.addEventListener('DOMContentLoaded', async () => {

      const token = getToken();



      if (!token) {

        window.location.href = '/login';

        return;

      }



      const loadingDiv = document.getElementById('loading') as HTMLDivElement;
      const errorDiv = document.getElementById('error') as HTMLDivElement;
      const accountsTable = document.getElementById('accountsTable') as HTMLDivElement;
      const accountsBody = document.getElementById('accountsBody') as HTMLTableSectionElement;
      const emptyState = document.getElementById('emptyState') as HTMLDivElement;
      const searchInput = document.getElementById('searchInput') as HTMLInputElement;
      const searchSpinner = document.getElementById('searchSpinner') as HTMLDivElement;
      const searchStatus = document.getElementById('searchStatus') as HTMLDivElement;
      const tableView = document.getElementById('tableView') as HTMLDivElement;

      if (!loadingDiv || !errorDiv || !accountsTable || !accountsBody || !emptyState || !searchInput || !searchSpinner || !searchStatus) {
        console.error('[ACCOUNT LOOKUP] Some DOM elements not found');
        return;
      }



    /**

     * Build NocoDB search query with proper URL encoding

     * Supports both ID-based and name-based searches

     * - If searchTerm is numeric, search by ID

     * - Otherwise, search by Account Name

     */

    function buildSearchQuery(searchTerm: string): { url: string; isIdSearch: boolean } {

      if (!searchTerm.trim()) {

        return { url: '', isIdSearch: false };

      }



      // Check if search term is a number (ID search)

      const trimmedTerm = searchTerm.trim();

      const isNumeric = /^\d+$/.test(trimmedTerm);



      if (isNumeric) {

        // Direct ID fetch

        return { 

          url: `/${trimmedTerm}`,

          isIdSearch: true 

        };

      } else {

        // Name-based search

        const rawWhere = `(Account Name,like,%${trimmedTerm}%)`;

        const encodedWhere = encodeURIComponent(rawWhere);

        const queryString = `where=${encodedWhere}&pageSize=15`;

        return { 

          url: `?${queryString}`,

          isIdSearch: false 

        };

      }

    }



    /**

     * Search accounts via Generic Go Proxy

     * Supports both ID-based and name-based searches

     */

    async function searchAccounts(searchTerm: string) {

      try {

        searchSpinner.classList.remove('hidden');

        searchStatus.textContent = 'Searching...';

        searchStatus.classList.add('text-blue-600');

        errorDiv.classList.add('hidden');

        loadingDiv.classList.add('hidden');



        const { url: queryPath, isIdSearch } = buildSearchQuery(searchTerm);

        const url = queryPath 

          ? `${API_BASE_URL}/proxy/accounts_duplicate/records${queryPath}`

          : `${API_BASE_URL}/proxy/accounts_duplicate/records?pageSize=15`;



        console.log('[ACCOUNT LOOKUP] Search type:', isIdSearch ? 'ID' : 'Name');

        console.log('[ACCOUNT LOOKUP] URL:', url);



        const response = await fetch(url, {

          method: 'GET',

          headers: {

            'Authorization': `Bearer ${token}`,

            'Content-Type': 'application/json',

          },

        });



        if (response.status === 401) {

          logout();

          return;

        }



        if (response.status === 404 && isIdSearch) {

          console.log('[ACCOUNT LOOKUP] Account ID not found');

          displayResults([], searchTerm);

          return;

        }



        const data = await safeJsonParse(response);

        

        // Handle ID search response (single record)

        if (isIdSearch) {

          console.log('[ACCOUNT LOOKUP] ID search result:', data);

          // Wrap single record in array for display

          const records = data.id ? [data] : [];

          displayResults(records, searchTerm);

        } else {

          // Handle name search response (multiple records)

          console.log('[ACCOUNT LOOKUP] Response received, records count:', data.records?.length || 0);

          

          // Log only first 3 records for debugging

          if (data.records && data.records.length > 0) {

            console.log('[ACCOUNT LOOKUP] Sample records (first 3):', data.records.slice(0, 3));

          }

          

          displayResults(data.records || [], searchTerm);

        }

      } catch (error) {

        console.error('[ACCOUNT LOOKUP ERROR]', error);

        searchSpinner.classList.add('hidden');

        searchStatus.textContent = '';

        searchStatus.classList.remove('text-blue-600');

        const errorText = errorDiv.querySelector('#errorText');

        if (errorText) {

          errorText.textContent = error instanceof Error ? error.message : 'Search failed';

        }

        errorDiv.classList.remove('hidden');

      }

    }



    /**
     * Display search results in card or table view
     */
    function displayResults(records: any[], searchTerm: string) {
      searchSpinner.classList.add('hidden');
      searchStatus.classList.remove('text-blue-600');

      if (searchTerm) {
        searchStatus.textContent = `Found ${records.length} account(s) matching "${searchTerm}"`;
      } else {
        searchStatus.textContent = `Showing ${records.length} account(s)`;
      }

      // Update stats
      const totalCountEl = document.getElementById('totalCount');
      const activeCountEl = document.getElementById('activeCount');
      if (totalCountEl) totalCountEl.textContent = records.length.toString();
      if (activeCountEl) activeCountEl.textContent = records.length.toString();

      if (records.length === 0) {
        tableView.classList.add('hidden');
        emptyState.classList.remove('hidden');
        return;
      }

      emptyState.classList.add('hidden');
      tableView.classList.remove('hidden');

      // Render table
      accountsBody.innerHTML = records.map((record) => {
        const fields = record.fields || {};
        const accountId = record.id;
        const accountName = fields['Account Name'] || 'N/A';
        const accountOwner = fields['Account Owner'] || '<span class="text-slate-400 italic">N/A</span>';
        const phone = fields['Phone Number'] || '<span class="text-slate-400 italic">N/A</span>';
        const industry = fields['Industry'] || '<span class="text-slate-400 italic">N/A</span>';

        return `
          <tr data-account-id="${record.id}" class="transition-colors hover:bg-blue-50">
            <td class="px-6 py-4 text-sm font-semibold text-slate-900">${accountId}</td>
            <td class="px-6 py-4 text-sm text-slate-900">
              <a href="/account-detail?id=${record.id}" class="text-blue-600 hover:text-blue-800 font-semibold hover:underline">
                ${accountName}
              </a>
            </td>
            <td class="px-6 py-4 text-sm text-slate-700">${accountOwner}</td>
            <td class="px-6 py-4 text-sm text-slate-700">${phone}</td>
            <td class="px-6 py-4 text-sm text-slate-700">${industry}</td>
          </tr>
        `;
      }).join('');
    }





    // Debounced search function

    const debouncedSearch = debounce((searchTerm: string) => {

      searchAccounts(searchTerm);

    }, 400);



    // Handle search input changes

    searchInput.addEventListener('input', (e) => {

      const searchTerm = (e.target as HTMLInputElement).value;

      

      if (searchTerm) {

        searchSpinner.classList.remove('hidden');

        searchStatus.textContent = 'Searching...';

        searchStatus.classList.add('text-blue-600');

      }



      debouncedSearch(searchTerm);

    });



    // Handle Enter key in search box

    searchInput.addEventListener('keydown', (e) => {

      if (e.key === 'Enter') {

        e.preventDefault();

        const searchTerm = searchInput.value;

        searchAccounts(searchTerm);

      }

    });





    // Initial load: Show all accounts

    searchAccounts('');

    }); // Close DOMContentLoaded event listener

  </script>

</AdminLayout>

